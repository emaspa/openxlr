#!/usr/bin/make -f

export DOTNET_CLI_TELEMETRY_OPTOUT = 1
export DOTNET_NOLOGO = 1
export DOTNET_SKIP_FIRST_TIME_EXPERIENCE = 1

# Launchpad builders are offline; packaging/ppa/make-source.sh vendors
# the NuGet packages into vendor/nuget and the restore reads only that.
VENDOR = $(CURDIR)/vendor/nuget
ifneq (,$(wildcard $(VENDOR)))
RESTORE_SOURCE = --source $(VENDOR)
endif

# Local package builds can reuse the user's NuGet and Cargo caches.
# Give CI, vendored builds and builders without a writable home private caches.
PACKAGE_HOME = $(CURDIR)/debian/.home
PRIVATE_HOME_NEEDED := $(shell test -d "$$HOME" && test -w "$$HOME" && test -x "$$HOME" || echo yes)
ifneq ($(strip $(CI) $(PRIVATE_HOME_NEEDED) $(wildcard $(VENDOR) $(CURDIR)/native/deepfilter/vendor)),)
export HOME = $(PACKAGE_HOME)
export DOTNET_CLI_HOME = $(PACKAGE_HOME)
export NUGET_PACKAGES = $(PACKAGE_HOME)/.nuget/packages
export CARGO_HOME = $(PACKAGE_HOME)/.cargo
export OPENXLR_BUILD_CACHE = 0
endif

# Every package carries DeepFilterNet: the native build fails instead of
# leaving it out. It runs the distribution's cargo and rustc, not a rustup
# proxy that may be earlier on the PATH and would look for its toolchains
# under a private home. make-source.sh vendors the crates under
# native/deepfilter/vendor and puts the model in place for the offline
# builders; a build with a network (the release workflow) fetches both.
export DEEPFILTER = 1
export CARGO ?= /usr/bin/cargo
export RUSTC ?= /usr/bin/rustc

OUT = $(CURDIR)/debian/out
PKG = $(CURDIR)/debian/openxlr

%:
	dh $@

override_dh_auto_build:
	dotnet publish src/OpenXLR.Daemon -c Release -r linux-x64 \
		--self-contained false -p:RestoreLockedMode=true -p:EnableNativeLv2Host=true \
		$(RESTORE_SOURCE) -o $(OUT)/daemon
	dotnet publish src/OpenXLR.UI -c Release -r linux-x64 \
		--self-contained false -p:RestoreLockedMode=true $(RESTORE_SOURCE) -o $(OUT)/ui
	dotnet publish src/OpenXLR.Tui -c Release -r linux-x64 \
		--self-contained false -p:RestoreLockedMode=true $(RESTORE_SOURCE) -o $(OUT)/tui

override_dh_auto_install:
	install -dm755 $(PKG)/usr/lib/openxlr
	cp -r $(OUT)/daemon $(PKG)/usr/lib/openxlr/daemon
	cp -r $(OUT)/ui $(PKG)/usr/lib/openxlr/ui
	cp -r $(OUT)/tui $(PKG)/usr/lib/openxlr/tui
	# Assemblies are data; apphosts and the control launcher are executable.
	find $(PKG)/usr/lib/openxlr -type f -exec chmod 644 {} +
	chmod 755 $(PKG)/usr/lib/openxlr/daemon/OpenXLR.Daemon \
		$(PKG)/usr/lib/openxlr/daemon/openxlr-control \
		$(PKG)/usr/lib/openxlr/daemon/openxlr-lv2-host \
		$(PKG)/usr/lib/openxlr/ui/OpenXLR.UI \
		$(PKG)/usr/lib/openxlr/tui/openxlr-tui

	install -dm755 $(PKG)/usr/bin
	ln -s ../lib/openxlr/daemon/openxlr-control $(PKG)/usr/bin/openxlr-control
	printf '#!/bin/sh\nexec /usr/lib/openxlr/daemon/OpenXLR.Daemon "$$@"\n' \
		> $(PKG)/usr/bin/openxlr-daemon
	printf '#!/bin/sh\nexec /usr/lib/openxlr/ui/OpenXLR.UI "$$@"\n' \
		> $(PKG)/usr/bin/openxlr
	printf '#!/bin/sh\nexec /usr/lib/openxlr/tui/openxlr-tui "$$@"\n' \
		> $(PKG)/usr/bin/openxlr-tui
	chmod 755 $(PKG)/usr/bin/openxlr-daemon $(PKG)/usr/bin/openxlr \
		$(PKG)/usr/bin/openxlr-tui

	# Native messaging for the separately installed browser companion.
	install -Dm644 browser/native-host.json \
		$(PKG)/etc/chromium/native-messaging-hosts/com.emaspa.openxlr.browser.json
	install -Dm644 browser/native-host.json \
		$(PKG)/etc/opt/chrome/native-messaging-hosts/com.emaspa.openxlr.browser.json

	install -Dm644 packaging/70-openxlr.rules \
		$(PKG)/usr/lib/udev/rules.d/70-openxlr.rules
	install -Dm644 packaging/50-xlr-dock-capture-hold.conf \
		$(PKG)/usr/share/wireplumber/wireplumber.conf.d/50-xlr-dock-capture-hold.conf
	install -Dm644 packaging/51-openxlr-pro-raw-names.conf \
		$(PKG)/usr/share/wireplumber/wireplumber.conf.d/51-openxlr-pro-raw-names.conf
	install -Dm644 packaging/52-openxlr-mk1-capture-hold.conf \
		$(PKG)/usr/share/wireplumber/wireplumber.conf.d/52-openxlr-mk1-capture-hold.conf
	install -Dm644 packaging/53-openxlr-wave3-capture-hold.conf \
		$(PKG)/usr/share/wireplumber/wireplumber.conf.d/53-openxlr-wave3-capture-hold.conf
	install -Dm644 packaging/55-openxlr-wave3-mk2-playback.conf \
		$(PKG)/usr/share/wireplumber/wireplumber.conf.d/55-openxlr-wave3-mk2-playback.conf
	# WirePlumber 0.4 needs a Boolean rule for the declared state opt-out.
	# Install it only for that build target; 0.5 warns about old Lua rules.
	wp_version=$$(LC_ALL=C wireplumber --version) && \
	if printf '%s\n' "$$wp_version" | grep -q '^Linked with libwireplumber 0\.4\.'; then \
		install -Dm644 packaging/54-openxlr-owned-state.lua \
			$(PKG)/usr/share/wireplumber/main.lua.d/54-openxlr-owned-state.lua; \
	fi

	# The reference unit points into a source checkout; the package runs
	# the wrapper.
	sed 's|^ExecStart=.*|ExecStart=/usr/bin/openxlr-daemon|' \
		packaging/openxlr-daemon.service > $(OUT)/openxlr-daemon.service
	install -Dm644 $(OUT)/openxlr-daemon.service \
		$(PKG)/usr/lib/systemd/user/openxlr-daemon.service
	install -Dm644 packaging/pipewire-pulse-openxlr.conf \
		$(PKG)/usr/lib/systemd/user/pipewire-pulse.service.d/openxlr.conf

	install -Dm644 packaging/openxlr.desktop \
		$(PKG)/usr/share/applications/openxlr.desktop
	for size in 16 32 48 64 128 256; do \
		install -Dm644 src/OpenXLR.UI/Assets/icon-$$size.png \
			$(PKG)/usr/share/icons/hicolor/$${size}x$${size}/apps/openxlr.png \
		|| exit 1; \
	done
	install -Dm644 src/OpenXLR.UI/Assets/icon.svg \
		$(PKG)/usr/share/icons/hicolor/scalable/apps/openxlr.svg

	# OpenDeck loads plugins from the user's config dir; ship it for copying.
	install -dm755 $(PKG)/usr/share/openxlr
	cp -r plugin/com.emaspa.openxlr.sdPlugin $(PKG)/usr/share/openxlr/
	install -d $(PKG)/usr/share/gnome-shell/extensions/openxlr-focus@emaspa.github.com
	install -m644 packaging/gnome/openxlr-focus@emaspa.github.com/* \
		$(PKG)/usr/share/gnome-shell/extensions/openxlr-focus@emaspa.github.com/
	find $(PKG)/usr/share/openxlr -type f -exec chmod 644 {} +
	find $(PKG)/usr/share/openxlr -type d -exec chmod 755 {} +

override_dh_auto_clean:
	rm -rf $(OUT) $(PACKAGE_HOME) src/*/bin src/*/obj native/deepfilter/target

override_dh_auto_test:

# Starting the daemon is opt-in per user, as in the AUR package: it
# builds the PipeWire submixer for whoever runs it, so don't enable it
# globally for every account on the system.
override_dh_installsystemduser:
	dh_installsystemduser --no-enable

# The publish output is prebuilt .NET; its bundled native libraries must
# not be stripped, deduplicated or scanned for shared-library deps.
override_dh_strip:
override_dh_dwz:
override_dh_shlibdeps:
override_dh_makeshlibs:

# Hash the final compressed payload, not an intermediate publish directory.
override_dh_md5sums:
	python3 packaging/install_receipt.py --root $(PKG) --manager debian --version $$(dpkg-parsechangelog -S Version)
	dh_md5sums
