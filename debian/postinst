#!/bin/sh
set -e

if [ "$1" = "configure" ] && [ -z "$2" ]; then
    cat <<'MSG'
OpenXLR: replug your interface once so the udev rule applies.
Start the daemon:  systemctl --user enable --now openxlr-daemon
Start the mixer:   openxlr   (or from your application menu)
The package raises the open-file limits of PipeWire and pipewire-pulse
(drop-ins under /usr/lib/systemd/user/pipewire.service.d and
pipewire-pulse.service.d); they apply at your next login, or now with:
  systemctl --user daemon-reload; systemctl --user restart pipewire
(that restarts every audio service; the daemon rebuilds its graph by itself)
Stream Deck via OpenDeck:
  cp -r /usr/share/openxlr/com.emaspa.openxlr.sdPlugin ~/.config/opendeck/plugins/
MSG
fi

if [ "$1" = "configure" ] && [ -f /usr/share/wireplumber/main.lua.d/54-openxlr-owned-state.lua ]; then
    cat <<'MSG'
OpenXLR: the WirePlumber 0.4 owned-node state rule applies at your next login.
To load it now, run these from your desktop session when you can interrupt audio:
  systemctl --user restart wireplumber
  systemctl --user restart openxlr-daemon
MSG
fi

#DEBHELPER#
