{
  "openapi": "3.0.3",
  "info": {
    "title": "OpenXLR local API",
    "version": "1"
  },
  "servers": [
    {
      "url": "http://localhost",
      "description": "HTTP over the private Unix socket; this is not a TCP listener."
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "Process alive, not hardware readiness"
          }
        }
      }
    },
    "/api/v1": {
      "get": {
        "responses": {
          "200": {
            "description": "Endpoint discovery"
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted"
          }
        }
      }
    },
    "/api/v1/state": {
      "get": {
        "responses": {
          "200": {
            "description": "Combined state message, including daemonVersion (release number), daemonBuildId (module identity) and daemonBuildVersion (informational version with source commit when stamped by the build). Older daemons may omit build fields."
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted"
          }
        }
      }
    },
    "/api/v1/devices": {
      "get": {
        "responses": {
          "200": {
            "description": "connected, device, capabilities, detected and devices from the state"
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted"
          }
        }
      }
    },
    "/api/v1/profiles": {
