          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted"
          }
        }
      }
    },
    "/api/v1/mixer": {
      "get": {
        "responses": {
          "200": {
            "description": "The state's mixer. browserTabs titles are empty unless the tab is capturing or has an assigned channel; origins remain available for selection. Title-only updates are coalesced on a one-second timer. Identical tab lists cause no state event; tab lifecycle and routing changes publish immediately. Held browser streams refresh outputChannelId from their current target on each sweep."
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted"
          },
          "503": {
            "description": "Mixer off"
          }
        }
      }
    },
    "/api/v1/channels": {
      "get": {
        "responses": {
          "200": {
            "description": "Every channel"
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted"
          },
          "503": {
            "description": "Mixer off"
          }
        }
      }
    },
    "/api/v1/channels/{id}": {
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact, case-sensitive channel id"
          }
        ],
        "responses": {
          "200": {
            "description": "One channel"
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted"
          },
          "503": {
            "description": "Mixer off"
          },
          "404": {
            "description": "No such id"
          }
        }
      }
    },
    "/api/v1/mixes": {
      "get": {
        "responses": {
          "200": {
            "description": "Every mix"
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted"
          },
          "503": {
            "description": "Mixer off"
          }
        }
      }
    },
    "/api/v1/mixes/{id}": {
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact, case-sensitive mix id"
          }
        ],
        "responses": {
          "200": {
            "description": "One mix"
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted"
          },
          "503": {
            "description": "Mixer off"
          },
          "404": {
            "description": "No such id"
          }
        }
      }
    },
    "/api/v1/inserts": {
      "get": {
        "responses": {
          "200": {
            "description": "Insert chains by key"
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted"
          },
          "503": {
            "description": "Mixer off"
          }
        }
      }
    },
    "/api/v1/inserts/{id}": {
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Chain key as in the state: an XLR or capture input channel id, or mix:<id>"
          }
        ],
        "responses": {
          "200": {
            "description": "One insert chain"
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted"
          },
          "503": {
            "description": "Mixer off"
          },
          "404": {
            "description": "No such id"
          }
        }
      }
    },
    "/api/v1/soundboard": {
      "get": {
        "responses": {
          "200": {
            "description": "The state's mixer.soundboard",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Soundboard"
                }
              }
            }
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted"
          },
          "503": {
            "description": "Mixer off"
          }
        }
      }
    },
    "/api/v1/plugins": {
