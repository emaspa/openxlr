    "/api/v1/commands": {
      "post": {
        "description": "Execute the existing cmd protocol. Foreign browser origins are rejected. Maximum UTF-8 body size is 65536 bytes, including chunked requests. Browser output preservation, connected-tab assignment and activation requests are supported; getBrowserSession and syncBrowserTabs require an authenticated WebSocket whose lifetime owns the tabs.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "cmd"
                ],
                "properties": {
                  "cmd": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              },
              "examples": {
                "muteMonitoring": {
                  "summary": "Pause selected monitor outputs, with microphone sends included when opted in",
                  "value": {
                    "cmd": "setMonitorMuted",
                    "value": true
                  }
                },
                "toggleMonitoring": {
                  "summary": "Atomically toggle monitoring without reading the previous state",
                  "value": {
                    "cmd": "toggleMonitorMuted"
                  }
                },
                "preserveBrowserOutputs": {
                  "summary": "Leave Chromium-family playback at browser-selected outputs",
                  "value": {
                    "cmd": "setPreserveBrowserOutputs",
                    "value": true
                  }
                },
                "assignBrowserTab": {
                  "summary": "Remember a connected tab's website on an application channel",
                  "value": {
                    "cmd": "assignBrowserTab",
                    "session": "e3b0c44298fc4c14b9afbf4c8996fb92",
                    "tabId": 42,
                    "site": "https://teams.microsoft.com",
                    "channel": "voicechat",
                    "remember": true
                  }
                },
                "activateBrowserTab": {
                  "summary": "Ask the browser companion to bring a connected tab forward and start routing it",
                  "value": {
                    "cmd": "activateBrowserTab",
                    "session": "e3b0c44298fc4c14b9afbf4c8996fb92",
                    "tabId": 42,
                    "site": "https://teams.microsoft.com"
                  }
                },
                "forgetBrowserWebsite": {
                  "summary": "Forget the website default while retaining other tab-only overrides",
                  "value": {
                    "cmd": "assignBrowserTab",
                    "session": "e3b0c44298fc4c14b9afbf4c8996fb92",
                    "tabId": 42,
                    "site": "https://teams.microsoft.com",
                    "channel": null,
                    "remember": true
                  }
                },
                "includeMicrophonesInMonitoringPause": {
                  "summary": "Include OpenXLR microphone sends in the monitoring pause",
                  "value": {
                    "cmd": "setMonitorMuteMicrophones",
                    "value": true
                  }
                },
                "noiseRemoval": {
                  "summary": "Switch a microphone's noise removal on with DeepFilterNet, turning noise down by at most 30 dB",
                  "value": {
                    "cmd": "setNoiseRemoval",
                    "channel": "xlr1",
                    "enabled": true,
                    "engine": "deepfilternet",
                    "strength": 30
                  }
                },
                "voiceChanger": {
                  "summary": "Switch a microphone's voice changer on with the Dracula voice",
                  "value": {
                    "cmd": "setVoiceChanger",
                    "channel": "xlr1",
                    "enabled": true,
                    "voice": "dracula"
                  }
                },
                "monitorDry": {
                  "summary": "Hear a microphone in the monitor mixes before its effects, while the other mixes keep the processed voice",
                  "value": {
                    "cmd": "setMonitorDry",
                    "channel": "xlr1",
                    "value": true
                  }
                },
                "loadEqProfile": {
                  "summary": "Put the built-in Warm EQ profile on a microphone and switch its EQ on",
                  "value": {
                    "cmd": "loadEqProfile",
                    "channel": "xlr1",
                    "profile": "builtin:warm"
                  }
                },
                "compressor": {
                  "summary": "Switch a microphone's compressor on this computer on at -24 dB",
                  "value": {
                    "cmd": "setCompressor",
                    "channel": "xlr1",
                    "enabled": true,
                    "threshold": -24
                  }
                },
                "expander": {
                  "summary": "Switch a microphone's expander on this computer on at -45 dB",
                  "value": {
                    "cmd": "setExpander",
                    "channel": "xlr1",
                    "enabled": true,
                    "threshold": -45
                  }
                },
                "hardwareMixingDryRun": {
                  "summary": "Ask what hardware mixing on the Wave XLR Pro would do with the current layout, without switching",
                  "value": {
                    "cmd": "setMixing",
                    "value": "hardware",
                    "check": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Executed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or rejected command",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandResult"
                }
              }
            }
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "408": {
            "description": "Body-read deadline"
          },
          "413": {
            "description": "Body too large"
          },
          "415": {
            "description": "UTF-8 application/json required"
          },
          "429": {
            "description": "Request budget exhausted, or an HTTP command or command-backed read in flight"
          }
        }
      }
    },
    "/api/v1/events": {
      "get": {
        "description": "WebSocket upgrade over the private Unix socket, authenticated by Linux peer credentials before HTTP is read. State is sent immediately; there is no auth frame.",
        "responses": {
          "101": {
            "description": "WebSocket connected"
          },
          "400": {
            "description": "Upgrade required"
          },
          "403": {
            "description": "Foreign Origin"
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "CommandResult": {
        "type": "object",
        "required": [
          "apiVersion",
          "ok",
          "messages"
        ],
        "properties": {
          "apiVersion": {
            "type": "string",
            "enum": [
              "1"
            ]
          },
          "ok": {
            "type": "boolean"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "Soundboard": {
        "type": "object",
        "required": [
          "channel",
          "enabled",
          "available",
          "error",
          "formats",
          "clips",
          "playing",
          "auditioning",
          "pages"
        ],
        "properties": {
          "channel": {
            "type": "string",
            "nullable": true,
            "description": "sfx while that channel exists, null after it was deleted"
          },
          "enabled": {
            "type": "boolean"
          },
          "available": {
            "type": "boolean",
            "description": "False without the native plugin host"
          },
          "error": {
            "type": "string",
            "nullable": true,
            "description": "Null exactly when the board can play; otherwise why not, in one sentence"
          },
          "formats": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "wav",
                "flac",
                "ogg",
                "opus",
                "mp3"
              ]
            }
          },
          "clips": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "$ref": "#/components/schemas/SoundboardClip"
            }
          },
          "playing": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ids of the clips playing now"
          },
          "auditioning": {
            "type": "string",
            "nullable": true,
            "description": "The clip auditioned in the monitor mixes now, or null"
          },
          "pages": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 40
            },
            "description": "Every page a clip is on, in the order clients draw them: the default page, empty, first while it holds a clip, then each named page where its first clip stands"
          }
        }
      },
      "SoundboardClip": {
        "type": "object",
        "required": [
          "id",
          "name",
          "seconds",
          "gain",
          "mode",
          "loop",
          "icon",
          "colour",
          "loaded",
          "error",
          "playing",
          "status",
          "page"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 30
          },
          "gain": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "mode": {
            "type": "string",
            "enum": [
              "overlap",
              "restart",
              "toggle",
              "hold"
            ]
          },
          "loop": {
            "type": "boolean"
          },
          "icon": {
            "type": "string"
          },
          "colour": {
            "type": "string",
            "nullable": true,
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "loaded": {
            "type": "boolean"
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "playing": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "loading",
              "error",
              "off"
            ],
            "description": "ready to play, loading into the player, error with the reason in error, or off while the board cannot play"
          },
          "page": {
            "type": "string",
            "maxLength": 40,
            "description": "The page the clip is on; empty for the default page"
          }
        }
      }
    }
  },
  "x-unix-socket": {
    "path": "$XDG_RUNTIME_DIR/openxlr/control.sock",
    "fallback": "$XDG_CONFIG_HOME/openxlr/control.sock (default ~/.config)",
    "authentication": "Linux SO_PEERCRED, same effective user as the daemon. No bearer header or auth frame."
  }
}
