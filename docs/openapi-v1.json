{
  "openapi": "3.0.3",
  "info": {
    "title": "OpenXLR local API",
    "version": "1"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:37890"
    }
  ],
  "security": [
    {
      "localToken": []
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "Process alive, not hardware readiness"
          }
        }
      }
    },
    "/api/v1": {
      "get": {
        "responses": {
          "200": {
            "description": "Endpoint discovery"
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted"
          }
        }
      }
    },
    "/api/v1/state": {
      "get": {
        "responses": {
          "200": {
            "description": "Combined state message"
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted"
          }
        }
      }
    },
    "/api/v1/devices": {
      "get": {
        "responses": {
          "200": {
            "description": "connected, device, capabilities, detected and devices from the state"
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted"
          }
        }
      }
    },
    "/api/v1/profiles": {
      "get": {
        "responses": {
          "200": {
            "description": "profiles, activeProfile and recallOnConnect from the state"
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted"
          }
        }
      }
    },
    "/api/v1/mixer": {
      "get": {
        "responses": {
          "200": {
            "description": "The state's mixer"
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted"
          },
          "503": {
            "description": "Mixer off"
          }
        }
      }
    },
    "/api/v1/channels": {
      "get": {
        "responses": {
          "200": {
            "description": "Every channel"
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted"
          },
          "503": {
            "description": "Mixer off"
          }
        }
      }
    },
    "/api/v1/channels/{id}": {
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact, case-sensitive channel id"
          }
        ],
        "responses": {
          "200": {
            "description": "One channel"
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted"
          },
          "503": {
            "description": "Mixer off"
          },
          "404": {
            "description": "No such id"
          }
        }
      }
    },
    "/api/v1/mixes": {
      "get": {
        "responses": {
          "200": {
            "description": "Every mix"
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted"
          },
          "503": {
            "description": "Mixer off"
          }
        }
      }
    },
    "/api/v1/mixes/{id}": {
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact, case-sensitive mix id"
          }
        ],
        "responses": {
          "200": {
            "description": "One mix"
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted"
          },
          "503": {
            "description": "Mixer off"
          },
          "404": {
            "description": "No such id"
          }
        }
      }
    },
    "/api/v1/inserts": {
      "get": {
        "responses": {
          "200": {
            "description": "Insert chains by key"
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted"
          },
          "503": {
            "description": "Mixer off"
          }
        }
      }
    },
    "/api/v1/inserts/{id}": {
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Chain key as in the state: an XLR input channel id or mix:<id>"
          }
        ],
        "responses": {
          "200": {
            "description": "One insert chain"
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted"
          },
          "503": {
            "description": "Mixer off"
          },
          "404": {
            "description": "No such id"
          }
        }
      }
    },
    "/api/v1/plugins": {
      "get": {
        "responses": {
          "200": {
            "description": "v1 result containing plugins message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandResult"
                }
              }
            }
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "400": {
            "description": "Rejected command",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandResult"
                }
              }
            }
          },
          "429": {
            "description": "Request budget exhausted, or an HTTP command or command-backed read in flight"
          }
        }
      }
    },
    "/api/v1/plugin-setup": {
      "get": {
        "responses": {
          "200": {
            "description": "v1 result containing a pluginSetup message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandResult"
                }
              }
            }
          },
          "400": {
            "description": "Rejected command",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandResult"
                }
              }
            }
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted, or an HTTP command or command-backed read in flight"
          }
        }
      }
    },
    "/api/v1/plugin-diagnostics": {
      "get": {
        "responses": {
          "200": {
            "description": "v1 result containing a pluginDiagnostics message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandResult"
                }
              }
            }
          },
          "400": {
            "description": "Rejected command",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandResult"
                }
              }
            }
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted, or an HTTP command or command-backed read in flight"
          }
        }
      }
    },
    "/api/v1/diagnostics": {
      "get": {
        "responses": {
          "200": {
            "description": "v1 result containing a diagnostics message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandResult"
                }
              }
            }
          },
          "400": {
            "description": "Rejected command",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandResult"
                }
              }
            }
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted, or an HTTP command or command-backed read in flight"
          }
        }
      }
    },
    "/api/v1/editor-rules": {
      "get": {
        "responses": {
          "200": {
            "description": "v1 result containing a nativeEditorRules message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandResult"
                }
              }
            }
          },
          "400": {
            "description": "Rejected command",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandResult"
                }
              }
            }
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted, or an HTTP command or command-backed read in flight"
          }
        }
      }
    },
    "/api/v1/commands": {
      "post": {
        "description": "Execute the existing cmd protocol. Foreign browser origins are rejected. Maximum UTF-8 body size is 65536 bytes, including chunked requests.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "cmd"
                ],
                "properties": {
                  "cmd": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Executed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or rejected command",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandResult"
                }
              }
            }
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "408": {
            "description": "Body-read deadline"
          },
          "413": {
            "description": "Body too large"
          },
          "415": {
            "description": "UTF-8 application/json required"
          },
          "429": {
            "description": "Request budget exhausted, or an HTTP command or command-backed read in flight"
          }
        }
      }
    },
    "/api/v1/events": {
      "get": {
        "description": "WebSocket upgrade with no Authorization header. The socket is authenticated by its first frame, {\"cmd\":\"auth\",\"token\":\"<token>\"}, within five seconds; then the existing state, meters and command protocol apply. The token is the same one the HTTP routes take as a bearer.",
        "responses": {
          "101": {
            "description": "WebSocket connected"
          },
          "400": {
            "description": "Upgrade required"
          },
          "403": {
            "description": "Foreign Origin"
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "securitySchemes": {
      "localToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Per-session token read from $XDG_RUNTIME_DIR/openxlr/token, or ~/.config/openxlr/token without a runtime directory; 64 hex characters."
      }
    },
    "schemas": {
      "CommandResult": {
        "type": "object",
        "required": [
          "apiVersion",
          "ok",
          "messages"
        ],
        "properties": {
          "apiVersion": {
            "type": "string",
            "enum": [
              "1"
            ]
          },
          "ok": {
            "type": "boolean"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    }
  }
}
