                }
              }
            }
          },
          "400": {
            "description": "Rejected command",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandResult"
                }
              }
            }
          },
          "401": {
            "description": "Credential required"
          },
          "403": {
            "description": "Foreign Origin"
          },
          "429": {
            "description": "Request budget exhausted, or an HTTP command or command-backed read in flight"
          }
        }
      }
    },
    "/api/v1/plugin-diagnostics": {
      "get": {
        "responses": {
          "200": {
            "description": "v1 result containing a pluginDiagnostics message",
            "content": {
              "application/json": {
                "schema": {
