%global debug_package %{nil}
%global _build_id_links none
Name: openxlr-yabridge
Version: @VERSION@
Release: @REVISION@%{?dist}
Summary: Tested Windows plugin bridge for OpenXLR
License: GPL-3.0-only AND GPL-3.0-or-later
URL: https://github.com/emaspa/openxlr
Source0: openxlr-yabridge-@VERSION@-source.tar.xz
ExclusiveArch: x86_64
AutoProv: no
BuildRequires: python3 gcc-c++ meson ninja-build cmake pkgconf-pkg-config
BuildRequires: wine wine-devel libxcb-devel dbus-devel cargo rust
Requires: wine dbus-libs

%global __os_install_post %{__os_install_post}\
python3 openxlr-packaging/build.py receipt --source . --destdir %{buildroot} --manager rpm\
%{nil}

%description
Pinned yabridge build with the Wine editor input fix, matching bridge
libraries and private wrapper support. Supports 64-bit Windows VST3 and
CLAP plugins. Wine is supplied by the system.

%prep
%autosetup -n openxlr-yabridge-@VERSION@

%build
# Wine reports no version without a prefix it can write, and the build reads
# that version to decide whether VST3 support is safe to compile. A build root
# has no home directory, so give it one here.
export HOME=%{_builddir}
export WINEPREFIX=%{_builddir}/wine
export WINEDEBUG=-all
mkdir -p "$WINEPREFIX"
wine --version || :
# Meson builds the bridge as a cross build with winegcc as the host compiler,
# so these flags reach only the Wine host; build.py hardens the plugin
# libraries through the _FOR_BUILD flags. Winelib output carries relocations
# in a read-only segment, which the distribution's hardened link flags refuse,
# so the Wine host links with its own flags. It compiles with the protections
# the binary packages already build it with.
export CFLAGS="-O2 -g -fstack-protector-strong -fstack-clash-protection -fcf-protection -Wp,-D_FORTIFY_SOURCE=3"
export CXXFLAGS="$CFLAGS"
export LDFLAGS="-Wl,-z,notext"
python3 openxlr-packaging/build.py build --source . --output out --jobs %{_smp_build_ncpus}

%install
python3 openxlr-packaging/build.py stage --source . --output out --destdir %{buildroot} --manager rpm

%check
python3 openxlr-packaging/test-package.py %{buildroot}

%files
/usr/bin/openxlr-yabridgectl
/usr/lib/openxlr/yabridge
/usr/share/openxlr/installations/openxlr-yabridge.json
%license /usr/share/licenses/openxlr-yabridge
