#!/usr/bin/make -f

# Meson builds the bridge as a cross build with winegcc as the host compiler,
# so CPPFLAGS, CFLAGS, CXXFLAGS and LDFLAGS reach only the Wine host. The
# plugin libraries are built from the _FOR_BUILD flags, which take the full
# hardening set, and build.py adds its own after them. Winelib output keeps
# relocations in a read-only segment, which the hardened link flags refuse,
# so the Wine host links with its own flags. It compiles with the protections
# the binary packages already build it with, FORTIFY coming from CPPFLAGS.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_CFLAGS_MAINT_SET = -O2 -g -fstack-protector-strong -fstack-clash-protection -fcf-protection
export DEB_CXXFLAGS_MAINT_SET = -O2 -g -fstack-protector-strong -fstack-clash-protection -fcf-protection
export DEB_LDFLAGS_MAINT_SET = -Wl,-z,notext

%:
	dh $@

override_dh_auto_configure:
	:

# Ubuntu ships the winelib compilers as winegcc-stable and wineg++-stable, and
# the build calls them by their plain names. Put the plain names on PATH for
# the build when the distribution does not provide them.
override_dh_auto_build:
	mkdir -p debian/winetools debian/wineprefix
	for tool in wine winegcc wineg++; do \
		command -v $$tool >/dev/null || ln -sf "$$(command -v $$tool-stable)" "debian/winetools/$$tool"; \
	done
	PATH="$(CURDIR)/debian/winetools:$$PATH" \
	HOME="$(CURDIR)/debian" WINEPREFIX="$(CURDIR)/debian/wineprefix" WINEDEBUG=-all \
		python3 openxlr-packaging/build.py build --source . --output out

override_dh_auto_test:
	:

override_dh_auto_install:
	python3 openxlr-packaging/build.py stage --source . --output out --destdir debian/openxlr-yabridge --manager debian
	python3 openxlr-packaging/test-package.py debian/openxlr-yabridge

override_dh_auto_clean:
	rm -rf out debian/winetools debian/wineprefix

override_dh_dwz:
	:

override_dh_md5sums:
	python3 openxlr-packaging/build.py receipt --source . --destdir debian/openxlr-yabridge --manager debian
	dh_md5sums

# The vendored Rust crates carry a Cargo.toml.orig each, and cargo refuses to
# build without them. To dh_clean they look like leftovers from patching.
override_dh_clean:
	dh_clean -XCargo.toml.orig
