<Project>
  <PropertyGroup>
    <Version>0.2.3</Version>
    <!-- Distro-packaged .NET 10 (Arch/CachyOS) ships the ASP.NET Core shared
         framework but omits the targeting pack's prune manifest, tripping
         NETSDK1226. Disabling the prune optimization is harmless (it only trims
         framework-provided transitive packages, which we don't rely on). -->
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <!-- packages.lock.json per project: CI restores in locked mode, so a
         build only ever sees the package graph that was committed. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Every package publishes for linux-x64. Declaring it here makes a
         plain restore and a publish for that runtime agree on the lock
         file, so locked-mode restores pass in both. -->
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <!-- Source packages have no .git directory. git archive expands this
       marker so their assemblies retain the receipt's source identity. -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)../packaging/source-commit')">
    <_OpenXlrArchiveCommit>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../packaging/source-commit').Trim())</_OpenXlrArchiveCommit>
    <SourceRevisionId Condition="'$(SourceRevisionId)' == '' And $([System.Text.RegularExpressions.Regex]::IsMatch('$(_OpenXlrArchiveCommit)', '^[a-fA-F0-9]{40}$'))">$(_OpenXlrArchiveCommit)</SourceRevisionId>
  </PropertyGroup>
</Project>
