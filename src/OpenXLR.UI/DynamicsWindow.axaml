<Window xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:OpenXLR.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenXLR.UI"
        xmlns:skin="using:OpenXLR.UI.Skinning"
        x:Class="OpenXLR.UI.DynamicsWindow" x:DataType="vm:MicDynamicsViewModel"
        Title="{Binding Title}" Width="760" Height="520" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Ox.Window.Background}">
  <!-- One microphone's compressor or expander, on this computer or on its unit. Across the top its name, the
       settings button that shows the advanced settings and its switch; then, left to right, the
       input meter, the input's history with the threshold across it, the gain reduction meter,
       the compressor's make-up gain and the output meter, each with its value above and its
       name below. Every colour, size and radius is an Ox.* token; the graph reads its colours
       as the skin service's live brushes. -->
  <Window.Styles>
    <!-- the mixer's own styles: control sizing -->
    <StyleInclude Source="avares://OpenXLR.UI/MixerStyles.axaml"/>
    <Style Selector="TextBlock.dynamicsLabel">
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="MaxWidth" Value="76"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style Selector="TextBlock.dynamicsValue">
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style Selector="skin|LevelMeter.dynamics">
      <Setter Property="Orientation" Value="Vertical"/>
      <Setter Property="Width" Value="18"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">
    <!-- The name, whose microphone it is, the settings button and the switch -->
    <Grid DockPanel.Dock="Top" Name="DynamicsHeader" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
      <Panel Width="30" Height="30" VerticalAlignment="Center">
        <!-- our own marks: a transfer curve bending flat above its knee, or steep below it -->
        <Path Name="CompressorMark" Data="M3,3 H27 V27 H3 Z M3,27 L15,15 L27,10" Stroke="{DynamicResource Ox.Text.Primary}" StrokeThickness="2"
              StrokeJoin="Round" IsVisible="{Binding IsCompressor}"/>
        <Path Name="ExpanderMark" Data="M3,3 H27 V27 H3 Z M10,27 L15,15 L27,3" Stroke="{DynamicResource Ox.Text.Primary}" StrokeThickness="2"
              StrokeJoin="Round" IsVisible="{Binding !IsCompressor}"/>
      </Panel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Name="DynamicsName" Text="{Binding Name}" Classes="title" TextTrimming="CharacterEllipsis"/>
        <TextBlock Name="DynamicsSubtitle" Text="{Binding Subtitle}" Classes="hint" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <ToggleButton Grid.Column="2" Name="DynamicsSettings" IsChecked="{Binding ShowsAdvanced, Mode=TwoWay}" VerticalAlignment="Center"
                    AutomationProperties.Name="{loc:Text Key=DynamicsSettings}" ToolTip.Tip="{loc:Text Key=DynamicsSettingsTip}">
        <!-- three sliders, each with its knob -->
        <Path Data="M2,4 H18 M2,10 H18 M2,16 H18 M6,1.5 V6.5 M13,7.5 V12.5 M8,13.5 V18.5" Width="20" Height="20"
              Stroke="{Binding $parent[ToggleButton].Foreground}" StrokeThickness="2" StrokeLineCap="Round"/>
      </ToggleButton>
      <ToggleButton Grid.Column="3" Name="DynamicsSwitch" Content="{loc:Text Key=DynamicsSwitch}" VerticalAlignment="Center"
                    IsChecked="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding Available}"
                    AutomationProperties.Name="{Binding SwitchName}" ToolTip.Tip="{loc:Text Key=DynamicsSwitchTip}"/>
    </Grid>

    <!-- Where it runs, while the microphone's unit can run a compressor and an expander itself.
         Two sides of one switch, as in the EQ editor: the lit side is the daemon's choice, a press
         asks for its side, and one choice covers the compressor and the expander -->
    <WrapPanel DockPanel.Dock="Top" Name="DynamicsProcessing" IsVisible="{Binding HasProcessingChoice}" ItemSpacing="6" LineSpacing="4" Margin="0,8,0,0">
      <TextBlock Name="DynamicsProcessingLabel" Text="{loc:Text Key=DynamicsProcessingLabel}" VerticalAlignment="Center"/>
      <ToggleButton Name="DynamicsOnUnit" Content="{loc:Text Key=EqProcessingDevice}" IsChecked="{Binding ProcessOnDevice, Mode=OneWay}"
                    IsEnabled="{Binding CanProcessOnDevice}" ToolTip.ShowOnDisabled="True"
                    Click="OnProcessOnUnit" ToolTip.Tip="{Binding ProcessOnDeviceTip}"/>
      <ToggleButton Name="DynamicsInSoftware" Content="{loc:Text Key=EqProcessingSoftware}" IsChecked="{Binding ProcessInSoftware, Mode=OneWay}"
                    Click="OnProcessInSoftware" ToolTip.Tip="{loc:Text Key=DynamicsProcessingSoftwareTip}"/>
    </WrapPanel>

    <!-- why the unit the microphone is on does not run them itself -->
    <TextBlock DockPanel.Dock="Top" Name="DynamicsDeviceNote" Text="{Binding DeviceNote}" IsVisible="{Binding HasDeviceNote}"
               Classes="hint" TextWrapping="Wrap" Margin="0,8,0,0"/>

    <!-- Why it does not run, or where the levels come from -->
    <TextBlock DockPanel.Dock="Top" Name="DynamicsStatus" Text="{Binding Status}" Classes="hint" Classes.warn="{Binding HasError}"
               TextWrapping="Wrap" Margin="0,8,0,0" IsVisible="{Binding HasStatus}"/>

    <!-- Where it sits, and how it relates to the unit -->
    <TextBlock DockPanel.Dock="Bottom" Name="DynamicsNote" Text="{Binding Note}" Classes="hint" TextWrapping="Wrap" Margin="0,10,0,0"/>

    <!-- The advanced settings, behind the settings button -->
    <ItemsControl DockPanel.Dock="Bottom" Name="DynamicsAdvanced" ItemsSource="{Binding Advanced}" IsVisible="{Binding ShowsAdvanced}" Margin="0,12,0,0"
                  Grid.IsSharedSizeScope="True">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:DynamicsParameterViewModel">
          <!-- the labels share one width, at least the scaled minimum, so the sliders line up at any text size -->
          <Grid ColumnSpacing="10" IsVisible="{Binding Shown}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="DynamicsLabel"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" MinWidth="{DynamicResource UiText.Width120}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Slider Grid.Column="1" Name="DynamicsParameter" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                    SmallChange="{Binding Step}" LargeChange="{Binding Step}" vm:FaderInput.Step="{Binding Step}"
                    Value="{Binding Value, Mode=TwoWay}" AutomationProperties.Name="{Binding Label}" ToolTip.Tip="{Binding Tip}"/>
            <TextBlock Grid.Column="2" Name="DynamicsParameterText" Text="{Binding Text}" Classes="val" VerticalAlignment="Center" TextAlignment="Right"/>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- The meters and the graph, each with its value above and its name below -->
    <Grid Name="DynamicsBody" ColumnDefinitions="Auto,*,Auto,Auto,Auto" RowDefinitions="Auto,*,Auto" ColumnSpacing="16" Margin="0,14,0,0">
      <!-- the input and the gain reduction exist only in software: the unit reports neither -->
      <TextBlock Name="DynamicsInputText" Text="{Binding InputText}" Classes="val dynamicsValue" IsVisible="{Binding ShowsStageMeters}"/>
      <skin:LevelMeter Grid.Row="1" Name="DynamicsInputMeter" Classes="dynamics" Level="{Binding InputLevel}"
                       AutomationProperties.Name="{Binding InputName}" IsVisible="{Binding ShowsStageMeters}"/>
      <TextBlock Grid.Row="2" Text="{loc:Text Key=DynamicsInput}" Classes="body dynamicsLabel" IsVisible="{Binding ShowsStageMeters}"/>

      <TextBlock Grid.Column="1" Name="DynamicsThresholdText" Text="{Binding Threshold.Text}" Classes="val dynamicsValue" HorizontalAlignment="Right"/>
      <vm:DynamicsGraph Grid.Row="1" Grid.Column="1" Name="DynamicsGraph" MinWidth="200" MinHeight="140"
                        History="{Binding History}" Threshold="{Binding Threshold.Value, Mode=TwoWay}"
                        Floor="{Binding Threshold.Minimum}" MaximumThreshold="{Binding Threshold.Maximum}"
                        GraphStyle="{Binding GraphStyle}"
                        LabelFontSize="{DynamicResource Ox.Eq.LabelFontSize}" CornerRadius="{DynamicResource Ox.Eq.CornerRadius}"
                        LineThickness="{DynamicResource Ox.Dynamics.LineThickness}"
                        AutomationProperties.Name="{loc:Text Key=DynamicsThreshold}" ToolTip.Tip="{Binding Threshold.Tip}"/>
      <TextBlock Grid.Row="2" Grid.Column="1" Text="{loc:Text Key=DynamicsThreshold}" Classes="body dynamicsLabel" HorizontalAlignment="Right"/>

      <TextBlock Grid.Column="2" Name="DynamicsReductionText" Text="{Binding ReductionText}" Classes="val dynamicsValue" IsVisible="{Binding ShowsStageMeters}"/>
      <!-- gain reduction fills from the top, the way it takes level away -->
      <skin:LevelMeter Grid.Row="1" Grid.Column="2" Name="DynamicsReductionMeter" Classes="dynamics" Level="{Binding ReductionLevel}"
                       RenderTransform="scale(1,-1)" Fill="{DynamicResource Ox.Dynamics.Reduction}"
                       Warning="{DynamicResource Ox.Dynamics.Reduction}" Hot="{DynamicResource Ox.Dynamics.Reduction}"
                       AutomationProperties.Name="{Binding ReductionName}" IsVisible="{Binding ShowsStageMeters}"/>
      <TextBlock Grid.Row="2" Grid.Column="2" Text="{loc:Text Key=DynamicsReduction}" Classes="body dynamicsLabel" IsVisible="{Binding ShowsStageMeters}"/>

      <TextBlock Grid.Column="3" Name="DynamicsMakeupText" Text="{Binding Makeup.Text, FallbackValue=''}" Classes="val dynamicsValue"
                 IsVisible="{Binding HasMakeup}"/>
      <!-- as tall as its row: the mixer's fixed upright fader length would run past the value and the name -->
      <Slider Grid.Row="1" Grid.Column="3" Name="DynamicsMakeup" Orientation="Vertical" HorizontalAlignment="Center" IsVisible="{Binding HasMakeup}"
              Height="NaN" VerticalAlignment="Stretch"
              Minimum="{Binding Makeup.Minimum, FallbackValue=0}" Maximum="{Binding Makeup.Maximum, FallbackValue=24}"
              SmallChange="{Binding Makeup.Step, FallbackValue=0.5}" LargeChange="3" vm:FaderInput.Step="{Binding Makeup.Step, FallbackValue=0.5}"
              Value="{Binding Makeup.Value, Mode=TwoWay, FallbackValue=0}"
              AutomationProperties.Name="{loc:Text Key=DynamicsMakeup}" ToolTip.Tip="{Binding Makeup.Tip, FallbackValue=''}"/>
      <TextBlock Grid.Row="2" Grid.Column="3" Name="DynamicsMakeupLabel" Text="{loc:Text Key=DynamicsMakeup}" Classes="body dynamicsLabel" IsVisible="{Binding HasMakeup}"/>

      <TextBlock Grid.Column="4" Name="DynamicsOutputText" Text="{Binding OutputText}" Classes="val dynamicsValue"/>
      <skin:LevelMeter Grid.Row="1" Grid.Column="4" Name="DynamicsOutputMeter" Classes="dynamics" Level="{Binding OutputLevel}"
                       AutomationProperties.Name="{Binding OutputName}"/>
      <TextBlock Grid.Row="2" Grid.Column="4" Text="{loc:Text Key=DynamicsOutput}" Classes="body dynamicsLabel"/>
    </Grid>
  </DockPanel>
</Window>
