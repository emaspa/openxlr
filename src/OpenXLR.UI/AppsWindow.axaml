<Window xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:OpenXLR.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenXLR.UI"
        xmlns:skin="using:OpenXLR.UI.Skinning"
        x:Class="OpenXLR.UI.AppsWindow"
        x:DataType="vm:MainViewModel"
        Title="{loc:Text Key=OpenXLRApplications}" Width="620" SizeToContent="Height" MaxHeight="700" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Ox.Window.Background}" CanResize="False">

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="14"/>
    </Style>
  </Window.Styles>

  <!-- The card that adds an application and the Close button are docked to the
       bottom, so the list of known applications takes what is left and scrolls
       inside it. Sized to its content up to the screen's working area (the code
       behind caps it), a long list used to push those controls off the bottom
       of a window that cannot be resized. -->
  <DockPanel Margin="14" LastChildFill="True">
    <Button DockPanel.Dock="Bottom" Content="{loc:Text Key=Close}" HorizontalAlignment="Right" Padding="18,6"
            Margin="0,8,0,0" Click="OnClose"/>
    <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,8,0,0">
      <StackPanel Spacing="6">
        <TextBlock Text="{loc:Text Key=ADDINSTALLEDAPPLICATION}" Classes="h"/>
        <TextBlock Text="{loc:Text Key=PreAssignAChannelToAnAppThat}"
                   FontSize="11" Foreground="{DynamicResource Ox.Text.Muted}" TextWrapping="Wrap"/>
        <Grid ColumnDefinitions="*,8,130,8,Auto">
          <ComboBox Name="InstalledPicker" HorizontalAlignment="Stretch" MaxDropDownHeight="380"
                    PlaceholderText="{loc:Text Key=ChooseAnApplication}"/>
          <ComboBox Name="ChannelPicker" Grid.Column="2" HorizontalAlignment="Stretch"
                    PlaceholderText="{loc:Text Key=Channel}"/>
          <Button Grid.Column="4" Content="{loc:Text Key=Add}" Padding="14,4" Click="OnAdd"/>
        </Grid>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" Text="{loc:Text Key=KNOWNAPPLICATIONS}" Classes="h" Margin="0,0,0,6"/>
        <TextBlock DockPanel.Dock="Top" Text="{loc:Text Key=EveryAppOpenXLRHasRoutedPlayingOrSilent}"
                   FontSize="11" Foreground="{DynamicResource Ox.Text.Muted}" TextWrapping="Wrap"
                   Margin="0,0,0,6"/>
        <ScrollViewer Name="KnownApps" MinHeight="96" VerticalScrollBarVisibility="Auto">
          <!-- the overlay scrollbar would sit on the Forget column -->
          <ItemsControl ItemsSource="{Binding Apps}" Margin="0,0,16,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AppStreamViewModel">
                <Grid ColumnDefinitions="10,8,*,130,8,Auto" Margin="0,3">
                  <skin:StatusLed IsOn="{Binding Active}"
                                  AutomationProperties.Name="{loc:Text Key=StreamState}"
                                  ToolTip.Tip="{Binding StatusText}"/>
                  <TextBlock Grid.Column="2" Text="{Binding Label}" Foreground="{DynamicResource Ox.Text.Primary}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Identity}"/>
                  <ComboBox Grid.Column="3" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding Channels}"
                            SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"/>
                  <Button Grid.Column="5" Content="{loc:Text Key=Forget}" Padding="10,3" FontSize="12"
                          Click="OnForget"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
