<Window xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:OpenXLR.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenXLR.UI"
        x:Class="OpenXLR.UI.SoundCheckWindow" x:DataType="vm:SoundCheckViewModel"
        Title="{loc:Text Key=SoundCheck}" Width="520" Height="360" MinWidth="360" MinHeight="280"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Ox.Window.Background}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16" Spacing="12">
      <TextBlock Text="{loc:Text Key=SoundCheck}" Classes="h"/>
      <TextBlock Text="{loc:Text Key=RecordUpToTenSecondsOfYour}"
                 Foreground="{DynamicResource Ox.Text.Primary}" TextWrapping="Wrap"/>
      <TextBlock Text="{loc:Text Key=TheRecordingStaysInMemoryItIsCapturedBeforeSoftwareEffectsButAfterTheI}"
                 Foreground="{DynamicResource Ox.Text.Secondary}" TextWrapping="Wrap"/>
      <TextBlock Name="SoundCheckStatus" Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource Ox.Text.Primary}"/>
      <WrapPanel>
        <Button Content="{loc:Text Key=Record}" IsEnabled="{Binding CanRecord}" Click="OnRecord" Margin="0,0,8,8"/>
        <Button Content="{loc:Text Key=LoopSample}" IsEnabled="{Binding CanLoop}" Click="OnLoop" Margin="0,0,8,8"/>
        <Button Content="{loc:Text Key=HearLiveMic}" IsEnabled="{Binding CanStop}" Click="OnLive" Margin="0,0,8,8"/>
        <Button Content="{loc:Text Key=StopAndDiscard}" IsEnabled="{Binding CanStop}" Click="OnStop" Margin="0,0,8,8"/>
      </WrapPanel>
      <TextBlock Text="{loc:Text Key=StopOrCloseThisWindowToRestoreTheMicrophoneAndDiscardTheSampleTheSessi}"
                 Foreground="{DynamicResource Ox.Text.Secondary}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource Ox.Text.Warning}"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </StackPanel>
  </ScrollViewer>
</Window>
