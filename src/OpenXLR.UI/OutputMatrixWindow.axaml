<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenXLR.UI"
        x:Class="OpenXLR.UI.OutputMatrixWindow" x:DataType="vm:MainViewModel"
        Title="OpenXLR Output matrix" Width="1000" Height="620" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Ox.Window.Background}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,16">
      <TextBlock Text="Output matrix" FontSize="{DynamicResource Ox.Title.FontSize}"
                 FontWeight="{DynamicResource Ox.Title.FontWeight}"/>
      <TextBlock Text="Each row is a selected output. Adjust how much of each mix it hears. Off disconnects that mix. Shared hardware jacks appear together because they carry the same audio bus."
                 TextWrapping="Wrap" Foreground="{DynamicResource Ox.Text.Secondary}"/>
      <TextBlock Text="Select an output in the main window's MONITOR card to add a row."
                 IsVisible="{Binding !HasMatrixOutputs}" TextWrapping="Wrap"/>
    </StackPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="Close" Click="OnClose"/>
      <Button Content="Manual" Padding="10,4" HorizontalAlignment="Left" Click="OnManual"
              ToolTip.Tip="Open the manual section on the output matrix"/>
    </DockPanel>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding OutputMatrix}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:OutputMatrixRow">
            <Border Classes="card" Margin="0,0,0,10" Padding="12">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding Label}" FontWeight="{DynamicResource Ox.Label.FontWeight}"/>
                <ItemsControl ItemsSource="{Binding Routes}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:OutputRouteViewModel">
                      <Border Classes="tile" Width="160" Padding="10" Margin="0,0,8,0">
                        <StackPanel Spacing="8">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                          <Slider Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                                  Value="{Binding Level, Mode=TwoWay}" ToolTip.Tip="{Binding LevelText}"/>
                          <TextBlock Text="{Binding LevelText}" HorizontalAlignment="Right"
                                     FontFamily="{DynamicResource Ox.Value.FontFamily}"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
