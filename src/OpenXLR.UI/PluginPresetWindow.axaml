<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenXLR.UI"
        x:Class="OpenXLR.UI.PluginPresetWindow" x:DataType="vm:PluginPresetViewModel"
        Title="{Binding Label, StringFormat='{}{0} presets'}" Width="520" Height="420" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Ox.Window.Background}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="PresetControls" Margin="16" Spacing="8">
      <TextBlock Classes="body" Text="{Binding Label}" TextWrapping="Wrap"/>
      <TextBlock Text="Presets for this plugin only, from the same store as the chain presets. Loading one changes this effect and leaves the rest of the chain alone."
                 TextWrapping="Wrap" Foreground="{DynamicResource Ox.Text.Secondary}"/>
      <TextBlock Classes="h" Text="New preset name"/>
      <TextBox Text="{Binding Name, Mode=TwoWay}" MaxLength="80" AutomationProperties.Name="New preset name"/>
      <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Selected, Mode=TwoWay}" HorizontalAlignment="Stretch"
                PlaceholderText="Choose a preset"/>
      <WrapPanel ItemSpacing="6" LineSpacing="6">
        <Button Content="Save preset" Click="OnSave"/>
        <Button Content="Load preset" Click="OnLoad"/>
        <Button Content="Import preset" Click="OnImport"/>
        <Button Content="Export preset" Click="OnExport"/>
        <Button Content="Delete preset" Click="OnDelete"/>
      </WrapPanel>
      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource Ox.Text.Warning}"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </StackPanel>
  </ScrollViewer>
</Window>
