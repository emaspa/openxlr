<Window xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:OpenXLR.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenXLR.UI"
        x:Class="OpenXLR.UI.MixerSetupWindow"
        x:DataType="vm:MainViewModel"
        Title="{loc:Text Key=OpenXLRMixerLayout}" Width="760" Height="640" MinWidth="600" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Ox.Window.Background}">
  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="14"/>
    </Style>
    <Style Selector="Button.small">
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="FontSize" Value="{DynamicResource UiText.FontSize12}"/>
      <Setter Property="MinWidth" Value="0"/>
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12" Spacing="4">
      <TextBlock Text="{loc:Text Key=MixerLayout}" FontSize="{DynamicResource UiText.FontSize20}" FontWeight="Bold" Foreground="{DynamicResource Ox.Text.Primary}"/>
      <TextBlock Text="{loc:Text Key=ApplicationChannelsAreThePlaybackDevicesYouRoute}"
                 FontSize="{DynamicResource UiText.FontSize11}" Foreground="{DynamicResource Ox.Text.Secondary}" TextWrapping="Wrap"/>
      <TextBlock Name="Note" FontSize="{DynamicResource UiText.FontSize11}" Foreground="{DynamicResource Ox.Text.Alert}" TextWrapping="Wrap"
                 IsVisible="False"/>
      <!-- the daemon's own notes for this window: the open-file limit, and a mix renamed since start -->
      <DockPanel IsVisible="{Binding LayoutWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <Button DockPanel.Dock="Right" Content="{loc:Text Key=Manual}" Padding="10,3" FontSize="{DynamicResource UiText.FontSize12}" VerticalAlignment="Center"
                Click="OnFileLimitManual" ToolTip.Tip="{loc:Text Key=OpenTheManualSectionOnThePipewirePulse}"/>
        <TextBlock Text="{Binding LayoutWarning}" FontSize="{DynamicResource UiText.FontSize11}" Foreground="{DynamicResource Ox.Text.Alert}" TextWrapping="Wrap"
                   VerticalAlignment="Center" Margin="0,0,12,0"/>
      </DockPanel>
      <DockPanel IsVisible="{Binding RenamedSinceStart}">
        <Button DockPanel.Dock="Right" Content="{loc:Text Key=RestartDaemon}" Padding="10,3" FontSize="{DynamicResource UiText.FontSize12}"
                IsEnabled="{Binding DaemonRestart.CanRestart}" VerticalAlignment="Center"
                Click="OnRestartDaemon" ToolTip.Tip="systemctl --user restart openxlr-daemon"/>
        <TextBlock Text="{loc:Text Key=ARenamedVirtualMicrophoneKeepsItsOldName}"
                   FontSize="{DynamicResource UiText.FontSize11}" Foreground="{DynamicResource Ox.Text.Alert}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
      </DockPanel>
    </StackPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="{loc:Text Key=Close}" Padding="18,6" Click="OnClose"/>
      <WrapPanel ItemSpacing="8" LineSpacing="4" VerticalAlignment="Center">
        <Button Name="ExclusiveGroupsButton" Content="{loc:Text Key=ExclusiveGroups}"
                IsEnabled="{Binding CanEditLayout}" Click="OnExclusiveGroups"
                ToolTip.Tip="{loc:Text Key=ChannelsOfWhichOnlyOneIsHeard}"/>
        <Button Name="DuckingButton" Content="{loc:Text Key=Ducking}" IsVisible="{Binding Ducking.IsReported}"
                Click="OnDucking" ToolTip.Tip="{loc:Text Key=DuckingKeysButtonTip}"/>
      </WrapPanel>
    </DockPanel>

    <Grid ColumnDefinitions="*,12,*">
      <Border Classes="card">
        <DockPanel>
          <Button DockPanel.Dock="Bottom" Content="{loc:Text Key=AddCaptureInput}" Margin="0,8,0,0"
                  HorizontalAlignment="Left" IsEnabled="{Binding CanEditLayout}" Click="OnAddCapture"/>
          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,8,Auto" RowDefinitions="Auto,6,Auto" Margin="0,10,0,0">
            <TextBox Name="ChannelName" PlaceholderText="{loc:Text Key=NewChannelEGPodcast}" MaxLength="60"
                     KeyDown="OnChannelNameKey"/>
            <Button Grid.Column="2" Content="{loc:Text Key=AddChannel}" Padding="12,4"
                    IsEnabled="{Binding CanEditLayout}" Click="OnAddChannel"/>
            <ComboBox Grid.Row="2" Name="NewChannelIcon" MaxDropDownHeight="360" HorizontalAlignment="Left" MinWidth="200"
                      AutomationProperties.Name="{loc:Text Key=NewChannelIcon}" ToolTip.Tip="{loc:Text Key=NewChannelIcon}"/>
          </Grid>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{loc:Text Key=CHANNELS}" Classes="h"/>
            <TextBlock Text="{loc:Text Key=ANewChannelStartsMutedInEvery}"
                       FontSize="{DynamicResource UiText.FontSize11}" Foreground="{DynamicResource Ox.Text.Muted}" TextWrapping="Wrap"/>
            <!-- the headphone jacks are hardware, not channels: an icon and a colour, nothing else -->
            <WrapPanel Margin="0,6,0,0">
              <TextBlock Text="{loc:Text Key=HeadphoneOutputs}" FontSize="{DynamicResource UiText.FontSize11}" Foreground="{DynamicResource Ox.Text.Secondary}"
                         VerticalAlignment="Center" Margin="0,0,8,4"/>
              <Button Name="Phones1AppearanceButton" Classes="small" Tag="phones1" Click="OnAppearance" Margin="0,0,6,4"
                      AutomationProperties.Name="{loc:Text Key=Phones1Appearance}" ToolTip.Tip="{loc:Text Key=IconAndColour}">
                <Grid ColumnDefinitions="Auto,*" DataContext="{Binding Phones1Appearance}" x:DataType="vm:LayoutAppearanceViewModel">
                  <vm:LayoutIconBlock Icon="{Binding Icon}" Fallback="{Binding DefaultIcon}" IsVisible="{Binding HasIcon}"
                                      Margin="0,0,5,0" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{loc:Text Key=Phones1}" VerticalAlignment="Center"/>
                </Grid>
              </Button>
              <Button Name="Phones2AppearanceButton" Classes="small" Tag="phones2" Click="OnAppearance" Margin="0,0,6,4"
                      IsVisible="{Binding HasHp2}"
                      AutomationProperties.Name="{loc:Text Key=Phones2Appearance}" ToolTip.Tip="{loc:Text Key=IconAndColour}">
                <Grid ColumnDefinitions="Auto,*" DataContext="{Binding Phones2Appearance}" x:DataType="vm:LayoutAppearanceViewModel">
                  <vm:LayoutIconBlock Icon="{Binding Icon}" Fallback="{Binding DefaultIcon}" IsVisible="{Binding HasIcon}"
                                      Margin="0,0,5,0" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{loc:Text Key=Phones2}" VerticalAlignment="Center"/>
                </Grid>
              </Button>
            </WrapPanel>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Channels}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChannelViewModel">
                  <Border Classes="tile" Padding="10,7" Margin="0,0,0,6"
                          IsVisible="{Binding Visible}">
                    <Grid ColumnDefinitions="*,Auto,4,Auto,8,Auto,4,Auto">
                      <StackPanel VerticalAlignment="Center">
                        <Grid ColumnDefinitions="Auto,*">
                          <vm:LayoutIconBlock Icon="{Binding Appearance.Icon}" Fallback="{Binding Appearance.DefaultIcon}"
                                              Foreground="{DynamicResource Ox.Text.Primary}" Margin="0,0,6,0"
                                              IsVisible="{Binding Appearance.HasIcon}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource Ox.Text.Primary}" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <TextBlock Text="{Binding Id}" Foreground="{DynamicResource Ox.Text.Muted}" FontFamily="monospace" FontSize="{DynamicResource UiText.FontSize10}"/>
                        <TextBlock Text="{Binding CaptureLabel}" Foreground="{DynamicResource Ox.Text.Secondary}"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CaptureSource}"
                                   IsVisible="{Binding CaptureSource, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        <TextBlock Text="{loc:Text Key=HiddenInTheMixer}" Foreground="{DynamicResource Ox.Text.Muted}" FontSize="{DynamicResource UiText.FontSize10}"
                                   IsVisible="{Binding Appearance.Hidden}"/>
                        <Button Content="{loc:Text Key=MixerAppearance}" Classes="small" HorizontalAlignment="Left" Margin="0,4,0,0"
                                Click="OnAppearance" ToolTip.Tip="{loc:Text Key=IconColourAndWhetherTheStripShows}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{loc:Text Key=HardwareInput}" Foreground="{DynamicResource Ox.Text.Muted}" FontSize="{DynamicResource UiText.FontSize11}"
                                 VerticalAlignment="Center" IsVisible="{Binding IsHardware}"/>
                      <Button Grid.Column="1" Content="▲" Classes="small" ToolTip.Tip="{loc:Text Key=MoveUp}"
                              IsVisible="{Binding IsEditable}" Click="OnChannelUp"/>
                      <Button Grid.Column="3" Content="▼" Classes="small" ToolTip.Tip="{loc:Text Key=MoveDown}"
                              IsVisible="{Binding IsEditable}" Click="OnChannelDown"/>
                      <Button Grid.Column="5" Content="{loc:Text Key=Rename}" Classes="small"
                              IsVisible="{Binding IsEditable}" Click="OnRenameChannel"/>
                      <Button Grid.Column="7" Content="{loc:Text Key=Delete}" Classes="small danger"
                              IsVisible="{Binding IsEditable}" Click="OnDeleteChannel"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Classes="card">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
            <TextBox Name="MixName" PlaceholderText="{loc:Text Key=NewMixEGRecordingOrHeadphones}" MaxLength="60"
                     KeyDown="OnMixNameKey"/>
            <WrapPanel>
              <ComboBox Name="NewMixKind" SelectedIndex="0" AutomationProperties.Name="{loc:Text Key=MixType}" Margin="0,0,8,4">
                <ComboBoxItem Content="{loc:Text Key=VirtualMicrophone}"/>
                <ComboBoxItem Content="{loc:Text Key=MonitorMix}"/>
              </ComboBox>
              <ComboBox Name="NewMixIcon" MaxDropDownHeight="360" MinWidth="200" Margin="0,0,8,4"
                        AutomationProperties.Name="{loc:Text Key=NewMixIcon}" ToolTip.Tip="{loc:Text Key=NewMixIcon}"/>
              <Button Name="AddMix" Content="{loc:Text Key=AddMix}" Padding="12,4"
                      IsEnabled="{Binding CanEditLayout}" Click="OnAddMix"/>
            </WrapPanel>
          </StackPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{loc:Text Key=MIXES}" Classes="h"/>
            <TextBlock Text="{loc:Text Key=EachMixHasItsOwnMasterSends}"
                       FontSize="{DynamicResource UiText.FontSize11}" Foreground="{DynamicResource Ox.Text.Muted}" TextWrapping="Wrap"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Mixes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MixViewModel">
                  <Border Classes="tile" Padding="10,7" Margin="0,0,0,6"
                          IsVisible="{Binding Visible}">
                    <Grid ColumnDefinitions="*,Auto,4,Auto,8,Auto,4,Auto">
                      <StackPanel VerticalAlignment="Center">
                        <Grid ColumnDefinitions="Auto,*">
                          <vm:LayoutIconBlock Icon="{Binding Appearance.Icon}" Fallback="{Binding Appearance.DefaultIcon}"
                                              Foreground="{DynamicResource Ox.Text.Primary}" Margin="0,0,6,0"
                                              IsVisible="{Binding Appearance.HasIcon}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource Ox.Text.Primary}" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <TextBlock Text="{Binding Id}" Foreground="{DynamicResource Ox.Text.Muted}" FontFamily="monospace" FontSize="{DynamicResource UiText.FontSize10}"/>
                        <TextBlock Text="{loc:Text Key=HiddenInTheMixer}" Foreground="{DynamicResource Ox.Text.Muted}" FontSize="{DynamicResource UiText.FontSize10}"
                                   IsVisible="{Binding Appearance.Hidden}"/>
                        <Button Content="{loc:Text Key=MixerAppearance}" Classes="small" HorizontalAlignment="Left" Margin="0,4,0,0"
                                Click="OnAppearance" ToolTip.Tip="{loc:Text Key=IconColourAndWhetherTheMixShows}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding KindLabel}" Foreground="{DynamicResource Ox.Text.Muted}" FontSize="{DynamicResource UiText.FontSize11}"
                                 VerticalAlignment="Center" IsVisible="{Binding !IsEditable}"/>
                      <Button Grid.Column="1" Content="▲" Classes="small" ToolTip.Tip="{loc:Text Key=MoveUp}"
                              IsVisible="{Binding IsEditable}" Click="OnMixUp"/>
                      <Button Grid.Column="3" Content="▼" Classes="small" ToolTip.Tip="{loc:Text Key=MoveDown}"
                              IsVisible="{Binding IsEditable}" Click="OnMixDown"/>
                      <Button Grid.Column="5" Content="{loc:Text Key=Rename}" Classes="small"
                              IsVisible="{Binding IsEditable}" Click="OnRenameMix"/>
                      <Button Grid.Column="7" Content="{loc:Text Key=Delete}" Classes="small danger"
                              IsVisible="{Binding IsEditable}" IsEnabled="{Binding IsDeletable}" Click="OnDeleteMix"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
