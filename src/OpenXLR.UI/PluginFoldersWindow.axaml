<Window xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:OpenXLR.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenXLR.UI"
        x:Class="OpenXLR.UI.PluginFoldersWindow"
        x:DataType="vm:OptionsViewModel"
        Title="{loc:Text Key=PluginManager}" Width="760" Height="820" MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Ox.Window.Background}">
  <Grid Margin="18" RowDefinitions="*,12,Auto">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8" Margin="0,0,12,0">
        <TextBlock Text="{loc:Text Key=PluginFolders}" Classes="title"/>
        <TextBlock Text="{loc:Text Key=LV2CLAPAndVST3PluginsAreFound}"
                   Classes="hint" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding SearchPathWarning}" Classes="warn" TextWrapping="Wrap"
                   IsVisible="{Binding SearchPathWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <ListBox Name="SearchDirectoryList" ItemsSource="{Binding SearchDirectories}" Height="190"
                 SelectionMode="Single" SelectionChanged="OnSearchPathSelected"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PluginSearchDirectoryItem">
              <StackPanel Margin="0,4,12,4">
                <TextBlock Text="{Binding Path}" Classes="body" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Detail}" Classes="hint"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel Orientation="Horizontal">
          <ComboBox Name="SearchFormat" Margin="0,0,8,4" MinWidth="90"/>
          <Button Name="AddSearchPath" Content="{loc:Text Key=AddPluginFolder}" Padding="14,5" Margin="0,0,8,4" Click="OnAddSearchPath"/>
          <Button Name="RemoveSearchPath" Content="{loc:Text Key=RemoveAddedFolder}" Padding="14,5" Margin="0,0,8,4" Click="OnRemoveSearchPath" IsEnabled="False"/>
          <Button Name="RescanAll" Content="{loc:Text Key=RescanAllPlugins}" Padding="14,5" Margin="0,0,0,4" Click="OnRescanAll"/>
        </WrapPanel>
        <TextBlock Text="{loc:Text Key=ARescanReadsEveryFormatAgainAnd}"
                   Classes="hint" TextWrapping="Wrap"/>
        <TextBlock Text="{loc:Text Key=WindowsVST3AndCLAPPlugins}" Classes="title" Margin="0,12,0,0"/>
        <TextBlock Text="{Binding WindowsPlugins}" Classes="hint" TextWrapping="Wrap"/>
        <TextBlock Text="{loc:Text Key=ChooseAFolderThenSelectAnIndividualPlugin}"
                   FontSize="12" Foreground="{DynamicResource Ox.Text.Secondary}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding WindowsImportNote}" IsVisible="{Binding WindowsImportNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   FontSize="12" Foreground="{DynamicResource Ox.Text.Secondary}" TextWrapping="Wrap"/>
        <TextBlock Text="{loc:Text Key=TheseFoldersAndExclusionsAreSharedWithOther}"
                   IsVisible="{Binding SystemBridge}" FontSize="12" Foreground="{DynamicResource Ox.Text.Warning}" TextWrapping="Wrap"/>
        <Border Background="{DynamicResource Ox.Card.Background}" CornerRadius="8" Padding="8" Height="240">
          <Grid>
            <ListBox Name="FolderList" ItemsSource="{Binding WindowsDirectories}"
                     SelectionMode="Single" SelectionChanged="OnSelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4,12,4" FontSize="12"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{loc:Text Key=NoRegisteredFolders}" IsVisible="{Binding !HasWindowsDirectories}"
                       Margin="8" Foreground="{DynamicResource Ox.Text.Secondary}" IsHitTestVisible="False"/>
          </Grid>
        </Border>
        <WrapPanel Orientation="Horizontal">
          <Button Name="AddFolder" Content="{loc:Text Key=AddFolder}" Padding="14,5" Margin="0,0,8,4" Click="OnAddFolder"/>
          <Button Name="RemoveFolder" Content="{loc:Text Key=RemoveFromList}" Padding="14,5" Margin="0,0,8,4" Click="OnRemoveFolder" IsEnabled="False"/>
          <Button Name="RescanFolders" Content="{loc:Text Key=Rescan}" Padding="14,5" Margin="0,0,0,4" Click="OnRescan"/>
        </WrapPanel>
        <Border Background="{DynamicResource Ox.Card.Background}" CornerRadius="8" Padding="8" Height="190">
          <Grid>
            <ListBox Name="PluginList" SelectionMode="Single" SelectionChanged="OnPluginSelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:WindowsPluginEntry">
                  <Grid ColumnDefinitions="*,8,45,8,64" Margin="0,5,12,5">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}"/>
                    <TextBlock Grid.Column="2" Text="{Binding FormatLabel}" FontSize="11" Foreground="{DynamicResource Ox.Text.Secondary}"/>
                    <TextBlock Grid.Column="4" Text="{Binding Status}" FontSize="11"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Name="EmptyPlugins" Text="{loc:Text Key=SelectAFolderToSeeItsPlugins}" Margin="8"
                       Foreground="{DynamicResource Ox.Text.Secondary}" IsHitTestVisible="False" TextWrapping="Wrap"/>
          </Grid>
        </Border>
        <WrapPanel Orientation="Horizontal">
          <Button Name="RemoveUses" Content="{loc:Text Key=RemoveFromAllChains}" Padding="14,5" Margin="0,0,8,4"
                  Click="OnRemoveUses" IsVisible="False"/>
          <Button Name="TogglePlugin" Content="{loc:Text Key=DisableInOpenXLR}" Padding="14,5" Margin="0,0,8,4" Click="OnTogglePlugin" IsEnabled="False"/>
          <Button Name="DeletePlugin" Content="{loc:Text Key=DeleteFile}" Padding="14,5" Margin="0,0,8,4" Click="OnDeletePlugin" IsEnabled="False"/>
          <Button Name="WineUninstaller" Content="{loc:Text Key=WineUninstaller}" Padding="14,5" Margin="0,0,0,4" Click="OnWineUninstaller" IsVisible="False"/>
        </WrapPanel>
        <TextBlock Name="PluginDetail" Text="{loc:Text Key=SelectAPluginToManageIt}" FontSize="12" Foreground="{DynamicResource Ox.Text.Secondary}" TextWrapping="Wrap"/>
        <TextBlock Text="{loc:Text Key=DisablingKeepsTheFilesDeleteFilePermanentlyRemoves}"
                   FontSize="12" Foreground="{DynamicResource Ox.Text.Secondary}" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" ColumnDefinitions="*,12,Auto">
      <ScrollViewer MaxHeight="80" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <TextBlock Name="Status" FontSize="12" Foreground="{DynamicResource Ox.Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
      </ScrollViewer>
      <Button Grid.Column="2" Name="CloseButton" Content="{loc:Text Key=Close}" Padding="18,6" Click="OnClose"/>
    </Grid>
  </Grid>
</Window>
