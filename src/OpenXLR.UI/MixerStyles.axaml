<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skin="using:OpenXLR.UI.Skinning">
    <!-- Arrange mode: a handle on each section and on each tile whose place
         can change. Hardware inputs and Monitor A/B and Aux keep their place. -->
    <Style Selector="Button.reorderHandle">
      <Setter Property="IsVisible" Value="False"/>
      <Setter Property="Padding" Value="4,1"/>
      <Setter Property="MinHeight" Value="{DynamicResource Ox.Mixer.SmallControlMinSize}"/>
      <Setter Property="MinWidth" Value="{DynamicResource Ox.Mixer.SmallControlMinSize}"/>
      <Setter Property="FontSize" Value="{DynamicResource Ox.Label.FontSize}"/>
      <Setter Property="Cursor" Value="SizeAll"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Window.arranging Button.reorderHandle">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Window.arranging Button.reorderHandle.fixedPlace">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <!-- A button that reads as a link: the header's way to the binding dialog. -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Ox.Link.Foreground}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="2,1"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="{DynamicResource Ox.Mixer.SmallControlMinSize}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Ox.Link.ForegroundPointerOver}"/>
    </Style>
    <Style Selector="Button.reorderTarget">
      <Setter Property="Foreground" Value="{DynamicResource Ox.Accent}"/>
      <Setter Property="Background" Value="{DynamicResource Ox.Control.BackgroundPointerOver}"/>
    </Style>
    <!-- A colour chosen for one channel or mix in the layout editor is that
         item's own data, not a skin value; without one the skin's applies. -->
    <Style Selector="TextBlock.layoutAccent">
      <Setter Property="Foreground" Value="{ReflectionBinding Appearance.Accent}"/>
    </Style>
    <!-- Control sizing. Every size here is a skin token, raised by Touch
         sizing; in Standard with no skin value the framework's own size
         stays. These come first, so the class styles below still win. -->
    <Style Selector="Button, ToggleButton, DropDownButton, ComboBox, ComboBoxItem, CheckBox, TextBox, Slider">
      <Setter Property="MinHeight" Value="{DynamicResource Ox.Mixer.ControlMinSize}"/>
      <Setter Property="MinWidth" Value="{DynamicResource Ox.Mixer.ControlMinSize}"/>
    </Style>
    <Style Selector="Window.large-targets Button, Window.large-targets ToggleButton, Window.large-targets DropDownButton">
      <Setter Property="MinHeight" Value="{DynamicResource Ox.Mixer.ControlMinSize}"/>
      <Setter Property="MinWidth" Value="{DynamicResource Ox.Mixer.ControlMinSize}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Slider">
      <Setter Property="MinHeight" Value="{DynamicResource Ox.Mixer.SliderMinHeight}"/>
    </Style>
    <!-- An upright fader is as long as the strip token says and as wide as a
         flat one is tall; the height minimum belongs to the flat ones. -->
    <Style Selector="Slider:vertical">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="MinWidth" Value="{DynamicResource Ox.Mixer.SliderMinHeight}"/>
      <Setter Property="Height" Value="{DynamicResource Ox.Mixer.VerticalFaderLength}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <!-- Fluent's horizontal template reserves two spacer rows around its
         track, and its vertical one two spacer columns. Enlarged targets span
         those instead of being clipped. -->
    <Style Selector="Window.large-targets Slider:horizontal /template/ Track#PART_Track">
      <Setter Property="Grid.Row" Value="0"/>
      <Setter Property="Grid.RowSpan" Value="3"/>
    </Style>
    <Style Selector="Window.large-targets Slider:vertical /template/ Track#PART_Track">
      <Setter Property="Grid.Column" Value="0"/>
      <Setter Property="Grid.ColumnSpan" Value="3"/>
    </Style>
    <!-- The strips of an input rack and of the mix banks. -->
    <Style Selector="Border.strip">
      <Setter Property="Padding" Value="6"/>
    </Style>
    <Style Selector="Border.strip.upright">
      <Setter Property="Width" Value="{DynamicResource Ox.Mixer.StripWidth}"/>
    </Style>
    <Style Selector="Slider /template/ Thumb">
      <Setter Property="MinHeight" Value="{DynamicResource Ox.Mixer.ControlMinSize}"/>
      <Setter Property="MinWidth" Value="{DynamicResource Ox.Mixer.ControlMinSize}"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="12,9"/>
    </Style>
    <!-- compact device-control rows: shorter sliders and buttons than the
         theme default so the fixed cards stay small (the submixer keeps its
         own sizing) -->
    <Style Selector="StackPanel.dev Slider">
      <Setter Property="MinHeight" Value="{DynamicResource Ox.Mixer.SmallControlMinSize}"/>
      <Setter Property="Height" Value="{DynamicResource Ox.Mixer.DeviceSliderHeight}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="StackPanel.dev ToggleButton">
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="FontSize" Value="{DynamicResource UiText.FontSize12}"/>
      <Setter Property="MinHeight" Value="{DynamicResource Ox.Mixer.SmallControlMinSize}"/>
    </Style>
    <!-- collapsible tiles: a flat expander whose header looks like the old card title -->
    <Style Selector="Expander.section">
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="{DynamicResource Ox.Mixer.SmallControlMinSize}"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="IsExpanded" Value="True"/>
    </Style>
    <!-- a capture microphone's meter is one bar: the second keeps its room, so the
         strip lines up with stereo ones, and is neither drawn nor read out -->
    <Style Selector="skin|LevelMeter.monoSpare">
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="AutomationProperties.AccessibilityView" Value="Raw"/>
    </Style>
    <!-- a channel or mix hidden in the layout editor, drawn because Show hidden is on -->
    <Style Selector=":is(Control).revealed">
      <Setter Property="Opacity" Value="{DynamicResource Ox.Mixer.HiddenOpacity}"/>
    </Style>
    <Style Selector="ToggleButton">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="8,5"/>
    </Style>
    <!-- the small controls on an insert row: N (own process), B (bypass) and
         the cog that opens the plugin's controls. They stay narrow enough for
         the row but keep at least the skin's insert target size, so they are
         easy to hit and their letter is readable. -->
    <Style Selector="ToggleButton.insertmini">
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="MinWidth" Value="{DynamicResource Ox.Mixer.InsertControlMinSize}"/>
      <Setter Property="MinHeight" Value="{DynamicResource Ox.Mixer.InsertControlMinSize}"/>
      <Setter Property="FontSize" Value="{DynamicResource UiText.FontSize12}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.insertmini">
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="MinWidth" Value="{DynamicResource Ox.Mixer.InsertControlMinSize}"/>
      <Setter Property="MinHeight" Value="{DynamicResource Ox.Mixer.InsertControlMinSize}"/>
      <Setter Property="FontSize" Value="{DynamicResource UiText.FontSize12}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
</Styles>
