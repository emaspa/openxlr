<Window xmlns="https://github.com/avaloniaui"
        xmlns:skin="using:OpenXLR.UI.Skinning"
        xmlns:loc="using:OpenXLR.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenXLR.UI"
        x:Class="OpenXLR.UI.SoundClipWindow" x:DataType="vm:SoundClipEditViewModel"
        Title="{Binding Title}" Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Classes="dialog">
  <!-- One clip's name, gain, press mode, loop, icon, colour and page. Save sends what changed. -->
  <StackPanel Margin="18" Spacing="10">
    <!-- why the player cannot hold the clip, in full -->
    <TextBlock Name="SoundClipError" Text="{Binding ClipError}" IsVisible="{Binding HasClipError}" Classes="warn" TextWrapping="Wrap"/>
    <TextBlock Text="{loc:Text Key=SoundClipName}" Classes="h"/>
    <TextBox Name="SoundClipName" Text="{Binding Name, Mode=TwoWay}" MaxLength="60"
             AutomationProperties.Name="{loc:Text Key=SoundClipName}"/>

    <TextBlock Text="{loc:Text Key=SoundClipGain}" Classes="h"/>
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <Slider Name="SoundClipGain" vm:FaderInput.Step="1" Minimum="0" Maximum="100" Value="{Binding GainPercent, Mode=TwoWay}"
              AutomationProperties.Name="{loc:Text Key=SoundClipGain}" ToolTip.Tip="{loc:Text Key=SoundClipGainHint}"/>
      <skin:LitText Grid.Column="1" Text="{Binding GainText}" Classes="val" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right"/>
    </Grid>

    <TextBlock Text="{loc:Text Key=SoundClipMode}" Classes="h"/>
    <ComboBox Name="SoundClipMode" ItemsSource="{Binding ModeNames}" SelectedIndex="{Binding ModeIndex, Mode=TwoWay}"
              HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Text Key=SoundClipMode}"/>
    <TextBlock Name="SoundClipModeHint" Text="{Binding ModeHint}" Classes="hint" TextWrapping="Wrap"/>
    <CheckBox Name="SoundClipLoop" IsChecked="{Binding Loop, Mode=TwoWay}">
      <TextBlock Text="{loc:Text Key=SoundClipLoop}" TextWrapping="Wrap"/>
    </CheckBox>

    <TextBlock Text="{loc:Text Key=Icon}" Classes="h"/>
    <ComboBox Name="SoundClipIcon" MinWidth="200" MaxDropDownHeight="360" HorizontalAlignment="Left"
              AutomationProperties.Name="{loc:Text Key=Icon}"/>
    <TextBlock Text="{loc:Text Key=Colour}" Classes="h"/>
    <!-- the palette, which fills the field below; the field still takes a colour of the user's own -->
    <WrapPanel Name="SoundClipSwatches" ItemSpacing="2" LineSpacing="2"/>
    <TextBox Name="SoundClipColour" Text="{Binding Colour, Mode=TwoWay}" MaxLength="7"
             PlaceholderText="{loc:Text Key=SoundClipColourPlaceholder}" AutomationProperties.Name="{loc:Text Key=Colour}"/>

    <TextBlock Text="{loc:Text Key=SoundClipPage}" Classes="h"/>
    <TextBox Name="SoundClipPage" Text="{Binding Page, Mode=TwoWay}" MaxLength="40" PlaceholderText="{Binding MainPage}"
             AutomationProperties.Name="{loc:Text Key=SoundClipPage}"/>
    <TextBlock Name="SoundClipPageHint" Text="{Binding PageHint}" Classes="hint" TextWrapping="Wrap"/>

    <TextBlock Name="SoundClipNote" Text="{Binding Note}" IsVisible="{Binding HasNote}" Classes="warn" TextWrapping="Wrap"/>
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <Button Grid.Column="1" Name="SoundClipCancel" Content="{loc:Text Key=Cancel}" IsCancel="True" Click="OnCancel"/>
      <Button Grid.Column="2" Name="SoundClipSave" Content="{loc:Text Key=Save}" IsDefault="True" Click="OnSave"/>
    </Grid>
  </StackPanel>
</Window>
