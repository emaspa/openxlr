<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:OpenXLR.UI.Localization"
             xmlns:vm="using:OpenXLR.UI"
             xmlns:skin="using:OpenXLR.UI.Skinning"
             xmlns:layout="using:OpenXLR.UI.Layout"
             xmlns:views="using:OpenXLR.UI.Views"
             x:Class="OpenXLR.UI.Views.MixMatrixView"
             x:DataType="layout:MixMatrixViewModel">

  <!-- The submixer as a matrix: a head per mix across the top, a row per
       channel under it, and in each row the channel's head and one cell per
       mix. Cells share one width, so the columns line up,
       and every row Ox.Matrix.RowHeight tall, except a row whose head stacks
       an input's gain over its volume, which takes what the two faders need,
       its cells with it. The row heads are the
       INPUTS panel's own controls; the cells and column heads are bound to
       the mixer's own sends and mixes. Every colour, size and radius is an
       Ox.* token. -->

  <UserControl.Styles>
    <Style Selector="Border.matrixHead">
      <Setter Property="Height" Value="{DynamicResource Ox.Matrix.RowHeight}"/>
    </Style>
    <Style Selector="Border.matrixCell">
      <Setter Property="Width" Value="{DynamicResource MatrixCellWidth}"/>
      <Setter Property="Height" Value="{DynamicResource Ox.Matrix.RowHeight}"/>
      <Setter Property="Padding" Value="4,0"/>
    </Style>
    <!-- a row whose head stacks a gain over the channel's volume, or the EQ over the chain, is as
         tall as the two need and never shorter than the row height; its cells follow the head -->
    <Style Selector="Border.matrixHead.stacked">
      <Setter Property="Height" Value="NaN"/>
      <Setter Property="MinHeight" Value="{DynamicResource Ox.Matrix.RowHeight}"/>
    </Style>
    <Style Selector="Border.matrixCell.stacked">
      <Setter Property="Height" Value="NaN"/>
      <Setter Property="MinHeight" Value="{DynamicResource Ox.Matrix.RowHeight}"/>
    </Style>
    <!-- a muted send: the cell tinted and its mute lettered in the muted colour, or its fader and level
         faded while the mute keeps its own colour, so the cell greys out and still says it is muted -->
    <Style Selector="Border.matrixCell.tinted">
      <Setter Property="Background" Value="{DynamicResource Ox.Matrix.MutedBackground}"/>
    </Style>
    <Style Selector="Border.matrixCell.tinted ToggleButton.matrixMute:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource Ox.Matrix.MutedForeground}"/>
    </Style>
    <Style Selector="Border.matrixCell.dimmed layout|MeterFader">
      <Setter Property="Opacity" Value="{DynamicResource Ox.Matrix.MutedOpacity}"/>
    </Style>
    <Style Selector="Border.matrixCell.dimmed TextBlock.val">
      <Setter Property="Opacity" Value="{DynamicResource Ox.Matrix.MutedOpacity}"/>
    </Style>
    <!-- after .dimmed, so a muted cell in a revealed column still reads as hidden -->
    <Style Selector="Border.matrixCell.revealed">
      <Setter Property="Opacity" Value="{DynamicResource Ox.Mixer.HiddenOpacity}"/>
    </Style>
    <Style Selector="Border.matrixColumn">
      <Setter Property="Width" Value="{DynamicResource MatrixCellWidth}"/>
    </Style>
    <!-- the readout sits under the processing button, or in the middle of the name column when the
         row shows none, as Aux In's and Line In's do -->
    <Style Selector="TextBlock#MatrixReadout.under">
      <Setter Property="Grid.Row" Value="1"/>
    </Style>
    <Style Selector="TextBlock#MatrixReadout.centred">
      <Setter Property="Grid.RowSpan" Value="2"/>
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- The target over an input row's name and binding line. It draws no face, so
         the row's own lettering shows through it whatever button appearance the
         skin chose, and outlines itself under the pointer and with focus. -->
    <ControlTheme x:Key="MatrixBindingTarget" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Target" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"/>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource Ox.Link.Foreground}"/>
      </Style>
      <Style Selector="^:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource Ox.Link.Foreground}"/>
      </Style>
    </ControlTheme>

    <!-- The processing part's flyout: the INPUTS panel's switches for the input the
         row carries, bound to the same properties under the same capability rules
         and styled as they are there, the Voice Tune strength under them while Voice
         Tune is on, an additional interface's switches, XLR 1's software low
         cut and ClipGuard, the microphone's noise removal and a capture input's
         Own clock. The mute stays the row head's own part. -->
    <DataTemplate x:Key="ProcessingSwitches" x:DataType="layout:MatrixRowViewModel">
      <!-- as wide as the switches need, at most the width the monitor picker's flyout gives its rows, so they wrap as in INPUTS -->
      <StackPanel Classes="dev" Spacing="6" Name="MatrixProcessingPanel" MaxWidth="400">
        <TextBlock Text="{Binding Channel.Name}" Classes="h" TextTrimming="CharacterEllipsis"/>
        <StackPanel Spacing="4" IsVisible="{Binding CarriesUnit}">
          <WrapPanel Name="MatrixUnitSwitches" ItemSpacing="6" LineSpacing="4">
            <ToggleButton Content="{loc:Text Key=LowCut}" IsChecked="{Binding Unit.LowCut, Mode=TwoWay}" IsVisible="{Binding Unit.CapLowCut, FallbackValue=False}"/>
            <ToggleButton Content="{loc:Text Key=Expander}" IsChecked="{Binding Unit.Expander, Mode=TwoWay}" IsVisible="{Binding Unit.CapExpander, FallbackValue=False}"/>
            <ToggleButton Content="{loc:Text Key=VoiceTune}" IsChecked="{Binding Unit.VoiceTune, Mode=TwoWay}" IsVisible="{Binding Unit.CapVoiceTune, FallbackValue=False}"/>
            <ToggleButton Content="{loc:Text Key=Phantom}" IsChecked="{Binding Unit.Phantom, Mode=TwoWay}" IsVisible="{Binding Unit.CapPhantom, FallbackValue=False}"/>
            <ToggleButton Content="{loc:Text Key=ClipGuard}" IsChecked="{Binding Unit.ClipGuard, Mode=TwoWay}" IsVisible="{Binding Unit.CapClipGuard, FallbackValue=False}"/>
            <ToggleButton Content="{loc:Text Key=Compressor}" IsChecked="{Binding Unit.Compressor, Mode=TwoWay}" IsVisible="{Binding Unit.CapCompressor, FallbackValue=False}"/>
            <ToggleButton Content="{loc:Text Key=RawCapture}" IsChecked="{Binding Unit.RawCapture, Mode=TwoWay}" IsVisible="{Binding Unit.CapRawCapture, FallbackValue=False}"
                          ToolTip.Tip="{loc:Text Key=RawCaptureTip}"/>
          </WrapPanel>
          <Grid Name="MatrixVoiceTuneStrength" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" IsVisible="{Binding Unit.VoiceTune, FallbackValue=False}">
            <TextBlock Text="{loc:Text Key=VTStrength}" Classes="h" VerticalAlignment="Center"/>
            <Slider Grid.Column="1" vm:FaderInput.Step="1" Minimum="0" Maximum="100"
                    Value="{Binding Unit.VoiceTuneStrength, Mode=TwoWay}" AutomationProperties.Name="{loc:Text Key=VTStrength}"/>
            <TextBlock Grid.Column="2" Text="{Binding Unit.VoiceTuneStrengthText}" Classes="val" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
        <Panel IsVisible="{Binding CarriesExtraUnit}">
          <views:WaveUnitControls Name="MatrixExtraSwitches" Part="Switches" ShowsMute="False" DataContext="{Binding ExtraUnit}"/>
        </Panel>
        <WrapPanel Name="MatrixSoftwareSwitches" ItemSpacing="6" LineSpacing="4" IsVisible="{Binding ShowsSoftware}">
          <ToggleButton Content="{Binding Main.SoftLowCutText}" IsVisible="{Binding Main.ShowSoftLowCut}"
                        IsChecked="{Binding Main.SoftLowCutOn, Mode=OneWay}" Click="OnCycleSoftLowCut"
                        ToolTip.Tip="{loc:Text Key=HostSideLowCutForThisDeviceIts}"/>
          <ToggleButton Content="{loc:Text Key=ClipGuard}" IsVisible="{Binding Main.ShowSoftClipGuard}"
                        IsChecked="{Binding Main.SoftClipGuard, Mode=TwoWay}"
                        IsEnabled="{Binding Main.SoftClipGuardAvailable}"
                        ToolTip.Tip="{Binding Main.SoftClipGuardTip}"/>
        </WrapPanel>
        <Panel IsVisible="{Binding ShowsNoise}">
          <views:NoiseRemovalControls Name="MatrixNoise" DataContext="{Binding Channel.Noise}"/>
        </Panel>
        <Panel IsVisible="{Binding ShowsDynamics}">
          <views:DynamicsControls Name="MatrixDynamics" DataContext="{Binding Channel.Dynamics}"/>
        </Panel>
        <!-- a capture input's device on a clock of its own, with what the bridge does under it -->
        <StackPanel Name="MatrixOwnClockPanel" Spacing="2" IsVisible="{Binding ShowsOwnClock}">
          <CheckBox Name="MatrixOwnClock" Content="{loc:Text Key=CaptureOwnClock}" HorizontalAlignment="Left"
                    IsChecked="{Binding Channel.OwnClock, Mode=TwoWay}" ToolTip.Tip="{loc:Text Key=CaptureOwnClockTip}"/>
          <TextBlock Text="{Binding Channel.OwnClockStatus}" Classes="hint" FontSize="{DynamicResource UiText.FontSize11}"
                     TextWrapping="Wrap" IsVisible="{Binding Channel.HasOwnClockStatus}"/>
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <!-- A row head, by what the channel is. -->
    <layout:StripTemplateSelector x:Key="RowHeads">
      <!-- XLR 1: its binding under its name, its hardware gain over its meter, its mute and its chain, under the
           INPUTS panel's rules; the gain and mute only while it carries the interface's microphone -->
      <DataTemplate x:Key="xlr1" x:DataType="layout:MatrixRowViewModel">
        <Border Classes="tile matrixHead" Name="MatrixRowHead" Classes.stacked="{Binding Tall}">
          <DockPanel>
              <!-- the name column: a grid, not a horizontal stack, so the name gets what the icon and the handle leave and trims -->
              <Border DockPanel.Dock="{Binding IdentityDock}" Width="{DynamicResource Ox.Matrix.NameWidth}" Padding="6,0"
                      Name="MatrixRowName">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="4" VerticalAlignment="Center">
                  <Button Grid.RowSpan="2" Classes="ghost reorderHandle alongY" Classes.fixedPlace="{Binding HandleHidden}"
                          Content="↕" Tag="{Binding Channel}"
                          AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=MoveItem}}"
                          ToolTip.Tip="{loc:Text Key=DragOntoAnotherChannelYouCanEdit}"/>
                  <vm:LayoutIconBlock Grid.Column="1" Icon="{Binding Channel.Appearance.Icon}" Fallback="{Binding Channel.Appearance.DefaultIcon}" Classes="strip"
                             Classes.layoutAccent="{Binding Channel.Appearance.HasColour}" VerticalAlignment="Center"
                             IsVisible="{Binding ShowsIcon}" AutomationProperties.Name="{Binding Channel.Name}" ToolTip.Tip="{Binding Channel.Name}"/>
                  <TextBlock Grid.Column="2" Text="{Binding Channel.Name}" Classes="strip" Classes.layoutAccent="{Binding Channel.Appearance.HasColour}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsVisible="{Binding ShowsName}" ToolTip.Tip="{Binding Channel.Name}"/>
                  <!-- the strip's binding under its name: what feeds it, lit while linked. The
                       name and this line are one target over them that opens the binding
                       dialog, so a row keeps its height with a touch-sized target. -->
                  <Grid Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="4"
                        Name="MatrixBindingLine" IsVisible="{Binding ShowsBinding}" IsHitTestVisible="False">
                    <skin:StatusLed IsOn="{Binding Channel.BindingConnected}" VerticalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw"/>
                    <TextBlock Grid.Column="1" Text="{Binding Channel.BindingLabel}" Classes="hint" FontSize="{DynamicResource UiText.FontSize11}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </Grid>
                  <Button Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" Name="MatrixBinding" Theme="{StaticResource MatrixBindingTarget}"
                          IsVisible="{Binding ShowsBinding}" Click="OnBinding"
                          AutomationProperties.Name="{Binding Channel.BindingChipName}" ToolTip.Tip="{Binding Channel.BindingTip}"/>
                  <!-- the microphone's switches behind one button at the end of the name column, wherever the
                       order puts the part, so the source controls keep their room: lettered as a lit chain while
                       one is on, with the interface's phantom power lamp, lit while phantom power is on; under it
                       the input's gain, which reads the channel's volume while the volume fader moves -->
                  <Button Grid.Column="3" Name="MatrixProcessing" Classes="matrixProcessing fx" Classes.fxOn="{Binding ProcessingOn}"
                          Padding="5,2" FontSize="{DynamicResource UiText.FontSize11}" VerticalAlignment="Center" MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                          MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" IsVisible="{Binding ShowsSwitchesButton}"
                          AutomationProperties.Name="{Binding ProcessingName}" ToolTip.Tip="{loc:Text Key=MatrixProcessingTip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <skin:StatusLed Name="MatrixPhantom" Kind="Power" IsOn="{Binding PhantomOn}" IsVisible="{Binding HasPhantom}"
                                      AutomationProperties.AccessibilityView="Raw"/>
                      <TextBlock Text="{loc:Text Key=MatrixProcessing}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Flyout>
                      <Flyout Placement="BottomEdgeAlignedLeft">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProcessingSwitches}"/>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                  <!-- a capture input whose only switch is Own clock: the switch itself, lit while it is on, no flyout -->
                  <Button Grid.Column="3" Name="MatrixOwnClockButton" Classes="matrixProcessing fx" Classes.fxOn="{Binding Channel.OwnClock}"
                          Padding="5,2" FontSize="{DynamicResource UiText.FontSize11}" VerticalAlignment="Center" MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                          MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" IsVisible="{Binding ShowsOwnClockButton}" Click="OnToggleOwnClock"
                          Content="{loc:Text Key=CaptureOwnClock}" AutomationProperties.Name="{Binding OwnClockName}" ToolTip.Tip="{Binding OwnClockTip}"/>
                  <TextBlock Grid.Column="3" Name="MatrixReadout" Text="{Binding Readout}" Classes="val" FontSize="{DynamicResource UiText.FontSize11}"
                             Classes.under="{Binding ShowsProcessing}" Classes.centred="{Binding !ShowsProcessing}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowsReadout}"
                             AutomationProperties.Name="{Binding ReadoutName}" ToolTip.Tip="{Binding ReadoutName}"/>
                </Grid>
              </Border>
            <Border Width="{DynamicResource MatrixCellWidth}" Padding="4,0" Name="MatrixSource">
              <Panel>
              <layout:StripPanel Spec="{Binding Spec}" Spacing="4" VerticalAlignment="Center">
                <StackPanel layout:StripPanel.Part="meter" Orientation="Vertical" Spacing="1" VerticalAlignment="Center"
                            ToolTip.Tip="{loc:Text Key=ChannelMeterTip}">
                  <skin:LevelMeter Orientation="Horizontal" Level="{Binding Channel.MeterL}" AutomationProperties.Name="{Binding LeftLevelName}"/>
                  <skin:LevelMeter Orientation="Horizontal" Level="{Binding Channel.MeterR}" AutomationProperties.Name="{Binding RightLevelName}"/>
                </StackPanel>
                <StackPanel layout:StripPanel.Part="gain" Name="MatrixLevels" Spacing="2" VerticalAlignment="Center">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" IsVisible="{Binding HasGainFader}">
                    <layout:MeterFader ShowsMeter="{Binding MeterUnderFader}" LeftLevel="{Binding Channel.MeterL}" RightLevel="{Binding Channel.MeterR}"
                                       LeftName="{Binding LeftLevelName}" RightName="{Binding RightLevelName}" VerticalAlignment="Center"
                                       IsVisible="{Binding CarriesUnit}">
                      <Slider Classes="matrixFader" vm:FaderInput.Step="1" Minimum="0" Maximum="{Binding Main.GainMaxDb}"
                              Value="{Binding Main.GainDb, Mode=TwoWay}" IsEnabled="{Binding !Main.GainLocked}"
                              AutomationProperties.Name="{Binding Main.UnitInput1.GainName}"/>
                    </layout:MeterFader>
                    <!-- an additional interface's gain, while this row carries that interface's input -->
                    <layout:MeterFader ShowsMeter="{Binding MeterUnderFader}" LeftLevel="{Binding Channel.MeterL}" RightLevel="{Binding Channel.MeterR}"
                                       LeftName="{Binding LeftLevelName}" RightName="{Binding RightLevelName}" VerticalAlignment="Center"
                                       IsVisible="{Binding CarriesExtraUnit}">
                      <Slider Name="MatrixExtraGain" Classes="matrixFader" vm:FaderInput.Step="1" Minimum="0" Maximum="{Binding ExtraUnit.GainMaxDb, FallbackValue=80}"
                              Value="{Binding ExtraUnit.GainDb, Mode=TwoWay}" IsEnabled="{Binding ExtraUnit.CanAdjustGain, FallbackValue=False}"
                              AutomationProperties.Name="{Binding ExtraUnit.GainName}"/>
                    </layout:MeterFader>
                  </Grid>
                  <!-- the channel's own volume, under the gain where the row has one, the meter under it
                       otherwise; while the Wave XLR Pro's direct path carries this channel to the jacks, a
                       mark says it reaches the mixes only -->
                  <Grid Name="MatrixVolumeLine" ColumnDefinitions="*,Auto" ColumnSpacing="4" IsVisible="{Binding ShowsVolume}">
                    <layout:MeterFader ShowsMeter="{Binding VolumeShowsMeter}" LeftLevel="{Binding Channel.MeterL}" RightLevel="{Binding Channel.MeterR}"
                                       LeftName="{Binding LeftLevelName}" RightName="{Binding RightLevelName}" VerticalAlignment="Center">
                      <Slider Name="MatrixVolume" Classes="matrixFader" vm:FaderInput.Step="0.01" Minimum="0" Maximum="1"
                              vm:FaderInput.IsAdjusting="{Binding VolumeAdjusting, Mode=OneWayToSource}"
                              Value="{Binding Channel.Volume, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=ChannelVolumeName}}"
                              ToolTip.Tip="{Binding Channel.VolumeTip}"/>
                    </layout:MeterFader>
                    <TextBlock Grid.Column="1" Name="MatrixVolumeNote" Text="&#x24D8;" Classes="h" FontSize="{DynamicResource UiText.FontSize12}" VerticalAlignment="Center"
                               Cursor="Help" IsVisible="{Binding Channel.DirectMonitored}" ToolTip.Tip="{Binding Channel.VolumeTip}"
                               AutomationProperties.Name="{loc:Text Key=ChannelVolumeMixesOnly}"/>
                  </Grid>
                </StackPanel>
                <Panel layout:StripPanel.Part="mute" VerticalAlignment="Center">
                  <ToggleButton Classes="mute mutemini matrixMute" IsVisible="{Binding CarriesUnit}" IsChecked="{Binding Main.Mute, Mode=TwoWay}"
                                IsEnabled="{Binding !Main.PhantomSettling}" Padding="5,2" FontSize="{DynamicResource UiText.FontSize11}" VerticalAlignment="Center"
                                MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                                AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=MixMuteName}}"
                                ToolTip.Tip="{loc:Text Key=TheDeviceMutesThisInputForAbout13}"/>
                  <ToggleButton Name="MatrixExtraMute" Classes="mute mutemini matrixMute" IsChecked="{Binding ExtraUnit.Mute, Mode=TwoWay}"
                                IsEnabled="{Binding ExtraUnit.CanMute, FallbackValue=False}" Padding="5,2" FontSize="{DynamicResource UiText.FontSize11}" VerticalAlignment="Center"
                                MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}" IsVisible="{Binding CarriesExtraUnit}"
                                AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=MixMuteName}}"
                                ToolTip.Tip="{loc:Text Key=TheDeviceMutesThisInputForAbout13}"/>
                </Panel>
                <!-- the microphone's EQ over its plugin chain, in the order the signal meets them; one over the
                     other, so the part takes no more of the source column's width than the chain alone did -->
                <StackPanel layout:StripPanel.Part="effects" Name="MatrixEffectsPart" Spacing="2" VerticalAlignment="Center">
                  <Button Name="MatrixEq" Classes="matrixEq fx" Content="{loc:Text Key=Eq}"
                          Classes.fxOn="{Binding Channel.Eq.IsLit, FallbackValue=False}" Classes.fxOff="{Binding Channel.Eq.IsFaulty, FallbackValue=False}"
                          Padding="5,2" FontSize="{DynamicResource UiText.FontSize11}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}" IsVisible="{Binding ShowsEq}" Click="OnEq"
                          AutomationProperties.Name="{Binding Channel.Eq.ButtonName, FallbackValue=''}" ToolTip.Tip="{Binding Channel.Eq.ButtonTip, FallbackValue=''}"/>
                  <Button Classes="matrixEffects fx" Content="{loc:Text Key=MatrixEffects}"
                          Classes.fxOn="{Binding Main.Inserts.IsProcessing}" Classes.fxOff="{Binding Main.Inserts.IsOff}"
                          Padding="5,2" FontSize="{DynamicResource UiText.FontSize11}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                          IsVisible="{Binding Main.HasMixer}" Click="OnXlrInserts"
                          AutomationProperties.Name="{Binding Main.Inserts.ButtonText}" ToolTip.Tip="{loc:Text Key=PluginsProcessingXLR1BeforeItReachesThe}"/>
                </StackPanel>
              </layout:StripPanel>
              <!-- the channel's volume, while its fader moves and for a second after, where the row has no
                   readout to show it in: a chip in the buttons' own face at the top of the column, as a send's
                   level is over its cell, drawn over the head so the row keeps its height and widths -->
              <Border Name="MatrixVolumeOverFader" Classes="matrixValueChip" HorizontalAlignment="Center" VerticalAlignment="Top"
                      IsHitTestVisible="False" Padding="5,0" IsVisible="{Binding ShowsVolumeChip}"
                      Background="{DynamicResource Ox.Control.Background}" BorderBrush="{DynamicResource Ox.Control.BorderBrush}"
                      BorderThickness="{DynamicResource Ox.Control.BorderThickness}" CornerRadius="{DynamicResource Ox.Control.CornerRadius}">
                <TextBlock Text="{Binding Channel.VolumeText}" FontSize="{DynamicResource UiText.FontSize11}" Foreground="{DynamicResource Ox.Control.Foreground}"/>
              </Border>
              </Panel>
            </Border>
          </DockPanel>
        </Border>
      </DataTemplate>
      <!-- XLR 2: the same with the second input's properties, shown only on an interface with two -->
      <DataTemplate x:Key="xlr2" x:DataType="layout:MatrixRowViewModel">
        <Border Classes="tile matrixHead" Name="MatrixRowHead" Classes.stacked="{Binding Tall}">
          <DockPanel>
              <!-- the name column: a grid, not a horizontal stack, so the name gets what the icon and the handle leave and trims -->
              <Border DockPanel.Dock="{Binding IdentityDock}" Width="{DynamicResource Ox.Matrix.NameWidth}" Padding="6,0"
                      Name="MatrixRowName">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="4" VerticalAlignment="Center">
                  <Button Grid.RowSpan="2" Classes="ghost reorderHandle alongY" Classes.fixedPlace="{Binding HandleHidden}"
                          Content="↕" Tag="{Binding Channel}"
                          AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=MoveItem}}"
                          ToolTip.Tip="{loc:Text Key=DragOntoAnotherChannelYouCanEdit}"/>
                  <vm:LayoutIconBlock Grid.Column="1" Icon="{Binding Channel.Appearance.Icon}" Fallback="{Binding Channel.Appearance.DefaultIcon}" Classes="strip"
                             Classes.layoutAccent="{Binding Channel.Appearance.HasColour}" VerticalAlignment="Center"
                             IsVisible="{Binding ShowsIcon}" AutomationProperties.Name="{Binding Channel.Name}" ToolTip.Tip="{Binding Channel.Name}"/>
                  <TextBlock Grid.Column="2" Text="{Binding Channel.Name}" Classes="strip" Classes.layoutAccent="{Binding Channel.Appearance.HasColour}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsVisible="{Binding ShowsName}" ToolTip.Tip="{Binding Channel.Name}"/>
                  <!-- the strip's binding under its name: what feeds it, lit while linked. The
                       name and this line are one target over them that opens the binding
                       dialog, so a row keeps its height with a touch-sized target. -->
                  <Grid Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="4"
                        Name="MatrixBindingLine" IsVisible="{Binding ShowsBinding}" IsHitTestVisible="False">
                    <skin:StatusLed IsOn="{Binding Channel.BindingConnected}" VerticalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw"/>
                    <TextBlock Grid.Column="1" Text="{Binding Channel.BindingLabel}" Classes="hint" FontSize="{DynamicResource UiText.FontSize11}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </Grid>
                  <Button Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" Name="MatrixBinding" Theme="{StaticResource MatrixBindingTarget}"
                          IsVisible="{Binding ShowsBinding}" Click="OnBinding"
                          AutomationProperties.Name="{Binding Channel.BindingChipName}" ToolTip.Tip="{Binding Channel.BindingTip}"/>
                  <!-- the microphone's switches behind one button at the end of the name column, wherever the
                       order puts the part, so the source controls keep their room: lettered as a lit chain while
                       one is on, with the interface's phantom power lamp, lit while phantom power is on; under it
                       the input's gain, which reads the channel's volume while the volume fader moves -->
                  <Button Grid.Column="3" Name="MatrixProcessing" Classes="matrixProcessing fx" Classes.fxOn="{Binding ProcessingOn}"
                          Padding="5,2" FontSize="{DynamicResource UiText.FontSize11}" VerticalAlignment="Center" MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                          MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" IsVisible="{Binding ShowsSwitchesButton}"
                          AutomationProperties.Name="{Binding ProcessingName}" ToolTip.Tip="{loc:Text Key=MatrixProcessingTip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <skin:StatusLed Name="MatrixPhantom" Kind="Power" IsOn="{Binding PhantomOn}" IsVisible="{Binding HasPhantom}"
                                      AutomationProperties.AccessibilityView="Raw"/>
                      <TextBlock Text="{loc:Text Key=MatrixProcessing}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Flyout>
                      <Flyout Placement="BottomEdgeAlignedLeft">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProcessingSwitches}"/>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                  <!-- a capture input whose only switch is Own clock: the switch itself, lit while it is on, no flyout -->
                  <Button Grid.Column="3" Name="MatrixOwnClockButton" Classes="matrixProcessing fx" Classes.fxOn="{Binding Channel.OwnClock}"
                          Padding="5,2" FontSize="{DynamicResource UiText.FontSize11}" VerticalAlignment="Center" MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                          MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" IsVisible="{Binding ShowsOwnClockButton}" Click="OnToggleOwnClock"
                          Content="{loc:Text Key=CaptureOwnClock}" AutomationProperties.Name="{Binding OwnClockName}" ToolTip.Tip="{Binding OwnClockTip}"/>
                  <TextBlock Grid.Column="3" Name="MatrixReadout" Text="{Binding Readout}" Classes="val" FontSize="{DynamicResource UiText.FontSize11}"
                             Classes.under="{Binding ShowsProcessing}" Classes.centred="{Binding !ShowsProcessing}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowsReadout}"
                             AutomationProperties.Name="{Binding ReadoutName}" ToolTip.Tip="{Binding ReadoutName}"/>
                </Grid>
              </Border>
            <Border Width="{DynamicResource MatrixCellWidth}" Padding="4,0" Name="MatrixSource">
              <Panel>
              <layout:StripPanel Spec="{Binding Spec}" Spacing="4" VerticalAlignment="Center">
                <StackPanel layout:StripPanel.Part="meter" Orientation="Vertical" Spacing="1" VerticalAlignment="Center"
                            ToolTip.Tip="{loc:Text Key=ChannelMeterTip}">
                  <skin:LevelMeter Orientation="Horizontal" Level="{Binding Channel.MeterL}" AutomationProperties.Name="{Binding LeftLevelName}"/>
                  <skin:LevelMeter Orientation="Horizontal" Level="{Binding Channel.MeterR}" AutomationProperties.Name="{Binding RightLevelName}"/>
                </StackPanel>
                <StackPanel layout:StripPanel.Part="gain" Name="MatrixLevels" Spacing="2" VerticalAlignment="Center">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" IsVisible="{Binding HasGainFader}">
                    <layout:MeterFader ShowsMeter="{Binding MeterUnderFader}" LeftLevel="{Binding Channel.MeterL}" RightLevel="{Binding Channel.MeterR}"
                                       LeftName="{Binding LeftLevelName}" RightName="{Binding RightLevelName}" VerticalAlignment="Center"
                                       IsVisible="{Binding CarriesUnit}">
                      <Slider Classes="matrixFader" vm:FaderInput.Step="1" Minimum="0" Maximum="{Binding Main.GainMaxDb}"
                              Value="{Binding Main.Gain2Db, Mode=TwoWay}" IsEnabled="{Binding !Main.GainLocked}"
                              AutomationProperties.Name="{loc:Text Key=XLR2Gain}"/>
                    </layout:MeterFader>
                    <!-- an additional interface's gain, while this row carries that interface's input -->
                    <layout:MeterFader ShowsMeter="{Binding MeterUnderFader}" LeftLevel="{Binding Channel.MeterL}" RightLevel="{Binding Channel.MeterR}"
                                       LeftName="{Binding LeftLevelName}" RightName="{Binding RightLevelName}" VerticalAlignment="Center"
                                       IsVisible="{Binding CarriesExtraUnit}">
                      <Slider Name="MatrixExtraGain" Classes="matrixFader" vm:FaderInput.Step="1" Minimum="0" Maximum="{Binding ExtraUnit.GainMaxDb, FallbackValue=80}"
                              Value="{Binding ExtraUnit.GainDb, Mode=TwoWay}" IsEnabled="{Binding ExtraUnit.CanAdjustGain, FallbackValue=False}"
                              AutomationProperties.Name="{Binding ExtraUnit.GainName}"/>
                    </layout:MeterFader>
                  </Grid>
                  <!-- the channel's own volume, under the gain where the row has one, the meter under it
                       otherwise; while the Wave XLR Pro's direct path carries this channel to the jacks, a
                       mark says it reaches the mixes only -->
                  <Grid Name="MatrixVolumeLine" ColumnDefinitions="*,Auto" ColumnSpacing="4" IsVisible="{Binding ShowsVolume}">
                    <layout:MeterFader ShowsMeter="{Binding VolumeShowsMeter}" LeftLevel="{Binding Channel.MeterL}" RightLevel="{Binding Channel.MeterR}"
                                       LeftName="{Binding LeftLevelName}" RightName="{Binding RightLevelName}" VerticalAlignment="Center">
                      <Slider Name="MatrixVolume" Classes="matrixFader" vm:FaderInput.Step="0.01" Minimum="0" Maximum="1"
                              vm:FaderInput.IsAdjusting="{Binding VolumeAdjusting, Mode=OneWayToSource}"
                              Value="{Binding Channel.Volume, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=ChannelVolumeName}}"
                              ToolTip.Tip="{Binding Channel.VolumeTip}"/>
                    </layout:MeterFader>
                    <TextBlock Grid.Column="1" Name="MatrixVolumeNote" Text="&#x24D8;" Classes="h" FontSize="{DynamicResource UiText.FontSize12}" VerticalAlignment="Center"
                               Cursor="Help" IsVisible="{Binding Channel.DirectMonitored}" ToolTip.Tip="{Binding Channel.VolumeTip}"
                               AutomationProperties.Name="{loc:Text Key=ChannelVolumeMixesOnly}"/>
                  </Grid>
                </StackPanel>
                <Panel layout:StripPanel.Part="mute" VerticalAlignment="Center">
                  <ToggleButton Classes="mute mutemini matrixMute" IsVisible="{Binding CarriesUnit}" IsChecked="{Binding Main.Mute2, Mode=TwoWay}"
                                IsEnabled="{Binding !Main.PhantomSettling2}" Padding="5,2" FontSize="{DynamicResource UiText.FontSize11}" VerticalAlignment="Center"
                                MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                                AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=MixMuteName}}"
                                ToolTip.Tip="{loc:Text Key=TheDeviceMutesThisInputForAbout13}"/>
                  <ToggleButton Name="MatrixExtraMute" Classes="mute mutemini matrixMute" IsChecked="{Binding ExtraUnit.Mute, Mode=TwoWay}"
                                IsEnabled="{Binding ExtraUnit.CanMute, FallbackValue=False}" Padding="5,2" FontSize="{DynamicResource UiText.FontSize11}" VerticalAlignment="Center"
                                MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}" IsVisible="{Binding CarriesExtraUnit}"
                                AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=MixMuteName}}"
                                ToolTip.Tip="{loc:Text Key=TheDeviceMutesThisInputForAbout13}"/>
                </Panel>
                <!-- the microphone's EQ over its plugin chain, in the order the signal meets them; one over the
                     other, so the part takes no more of the source column's width than the chain alone did -->
                <StackPanel layout:StripPanel.Part="effects" Name="MatrixEffectsPart" Spacing="2" VerticalAlignment="Center">
                  <Button Name="MatrixEq" Classes="matrixEq fx" Content="{loc:Text Key=Eq}"
                          Classes.fxOn="{Binding Channel.Eq.IsLit, FallbackValue=False}" Classes.fxOff="{Binding Channel.Eq.IsFaulty, FallbackValue=False}"
                          Padding="5,2" FontSize="{DynamicResource UiText.FontSize11}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}" IsVisible="{Binding ShowsEq}" Click="OnEq"
                          AutomationProperties.Name="{Binding Channel.Eq.ButtonName, FallbackValue=''}" ToolTip.Tip="{Binding Channel.Eq.ButtonTip, FallbackValue=''}"/>
                  <Button Classes="matrixEffects fx" Content="{loc:Text Key=MatrixEffects}"
                          Classes.fxOn="{Binding Main.Inserts2.IsProcessing}" Classes.fxOff="{Binding Main.Inserts2.IsOff}"
                          Padding="5,2" FontSize="{DynamicResource UiText.FontSize11}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                          IsVisible="{Binding Main.HasMixer}" Click="OnXlrInserts"
                          AutomationProperties.Name="{Binding Main.Inserts2.ButtonText}" ToolTip.Tip="{loc:Text Key=PluginsProcessingXLR2BeforeItReachesThe}"/>
                </StackPanel>
              </layout:StripPanel>
              <!-- the channel's volume, while its fader moves and for a second after, where the row has no
                   readout to show it in: a chip in the buttons' own face at the top of the column, as a send's
                   level is over its cell, drawn over the head so the row keeps its height and widths -->
              <Border Name="MatrixVolumeOverFader" Classes="matrixValueChip" HorizontalAlignment="Center" VerticalAlignment="Top"
                      IsHitTestVisible="False" Padding="5,0" IsVisible="{Binding ShowsVolumeChip}"
                      Background="{DynamicResource Ox.Control.Background}" BorderBrush="{DynamicResource Ox.Control.BorderBrush}"
                      BorderThickness="{DynamicResource Ox.Control.BorderThickness}" CornerRadius="{DynamicResource Ox.Control.CornerRadius}">
                <TextBlock Text="{Binding Channel.VolumeText}" FontSize="{DynamicResource UiText.FontSize11}" Foreground="{DynamicResource Ox.Control.Foreground}"/>
              </Border>
              </Panel>
            </Border>
          </DockPanel>
        </Border>
      </DataTemplate>
      <!-- Aux In: its level over its meter and the level lock, where the interface has the stage -->
      <DataTemplate x:Key="aux" x:DataType="layout:MatrixRowViewModel">
        <Border Classes="tile matrixHead" Name="MatrixRowHead" Classes.stacked="{Binding Tall}">
          <DockPanel>
              <!-- the name column: a grid, not a horizontal stack, so the name gets what the icon and the handle leave and trims -->
              <Border DockPanel.Dock="{Binding IdentityDock}" Width="{DynamicResource Ox.Matrix.NameWidth}" Padding="6,0"
                      Name="MatrixRowName">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="4" VerticalAlignment="Center">
                  <Button Grid.RowSpan="2" Classes="ghost reorderHandle alongY" Classes.fixedPlace="{Binding HandleHidden}"
                          Content="↕" Tag="{Binding Channel}"
                          AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=MoveItem}}"
                          ToolTip.Tip="{loc:Text Key=DragOntoAnotherChannelYouCanEdit}"/>
                  <vm:LayoutIconBlock Grid.Column="1" Icon="{Binding Channel.Appearance.Icon}" Fallback="{Binding Channel.Appearance.DefaultIcon}" Classes="strip"
                             Classes.layoutAccent="{Binding Channel.Appearance.HasColour}" VerticalAlignment="Center"
                             IsVisible="{Binding ShowsIcon}" AutomationProperties.Name="{Binding Channel.Name}" ToolTip.Tip="{Binding Channel.Name}"/>
                  <TextBlock Grid.Column="2" Text="{Binding Channel.Name}" Classes="strip" Classes.layoutAccent="{Binding Channel.Appearance.HasColour}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsVisible="{Binding ShowsName}" ToolTip.Tip="{Binding Channel.Name}"/>
                  <!-- the level, which reads the channel's volume while the volume fader moves and for a second after -->
                  <TextBlock Grid.Column="3" Grid.RowSpan="2" Name="MatrixReadout" Text="{Binding Readout}" Classes="val" FontSize="{DynamicResource UiText.FontSize11}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowsReadout}"
                             AutomationProperties.Name="{Binding ReadoutName}" ToolTip.Tip="{Binding ReadoutName}"/>
                </Grid>
              </Border>
            <Border Width="{DynamicResource MatrixCellWidth}" Padding="4,0" Name="MatrixSource">
              <Panel>
              <layout:StripPanel Spec="{Binding Spec}" Spacing="4" VerticalAlignment="Center">
                <StackPanel layout:StripPanel.Part="meter" Orientation="Vertical" Spacing="1" VerticalAlignment="Center"
                            ToolTip.Tip="{loc:Text Key=ChannelMeterTip}">
                  <skin:LevelMeter Orientation="Horizontal" Level="{Binding Channel.MeterL}" AutomationProperties.Name="{Binding LeftLevelName}"/>
                  <skin:LevelMeter Orientation="Horizontal" Level="{Binding Channel.MeterR}" AutomationProperties.Name="{Binding RightLevelName}"/>
                </StackPanel>
                <StackPanel layout:StripPanel.Part="gain" Name="MatrixLevels" Spacing="2" VerticalAlignment="Center">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" IsVisible="{Binding HasGainFader}">
                    <layout:MeterFader ShowsMeter="{Binding MeterUnderFader}" LeftLevel="{Binding Channel.MeterL}" RightLevel="{Binding Channel.MeterR}"
                                       LeftName="{Binding LeftLevelName}" RightName="{Binding RightLevelName}" VerticalAlignment="Center">
                      <Slider Classes="matrixFader" vm:FaderInput.Step="1" Minimum="-60" Maximum="0"
                              Value="{Binding Main.AuxLevelDb, Mode=TwoWay}"
                              AutomationProperties.Name="{loc:Text Key=USBAuxIn}"/>
                    </layout:MeterFader>
                    <ToggleButton Grid.Column="1" Content="{loc:Text Key=Lock}" IsChecked="{Binding Main.AuxLevelLock, Mode=TwoWay}"
                                  Padding="5,2" FontSize="{DynamicResource UiText.FontSize11}" VerticalAlignment="Center" MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                                  AutomationProperties.Name="{loc:Text Key=LevelLock}" ToolTip.Tip="{loc:Text Key=LevelLock}"/>
                  </Grid>
                  <!-- the channel's own volume, under the gain where the row has one, the meter under it
                       otherwise; while the Wave XLR Pro's direct path carries this channel to the jacks, a
                       mark says it reaches the mixes only -->
                  <Grid Name="MatrixVolumeLine" ColumnDefinitions="*,Auto" ColumnSpacing="4" IsVisible="{Binding ShowsVolume}">
                    <layout:MeterFader ShowsMeter="{Binding VolumeShowsMeter}" LeftLevel="{Binding Channel.MeterL}" RightLevel="{Binding Channel.MeterR}"
                                       LeftName="{Binding LeftLevelName}" RightName="{Binding RightLevelName}" VerticalAlignment="Center">
                      <Slider Name="MatrixVolume" Classes="matrixFader" vm:FaderInput.Step="0.01" Minimum="0" Maximum="1"
                              vm:FaderInput.IsAdjusting="{Binding VolumeAdjusting, Mode=OneWayToSource}"
                              Value="{Binding Channel.Volume, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=ChannelVolumeName}}"
                              ToolTip.Tip="{Binding Channel.VolumeTip}"/>
                    </layout:MeterFader>
                    <TextBlock Grid.Column="1" Name="MatrixVolumeNote" Text="&#x24D8;" Classes="h" FontSize="{DynamicResource UiText.FontSize12}" VerticalAlignment="Center"
                               Cursor="Help" IsVisible="{Binding Channel.DirectMonitored}" ToolTip.Tip="{Binding Channel.VolumeTip}"
                               AutomationProperties.Name="{loc:Text Key=ChannelVolumeMixesOnly}"/>
                  </Grid>
                </StackPanel>
              </layout:StripPanel>
              <!-- the channel's volume, while its fader moves and for a second after, where the row has no
                   readout to show it in: a chip in the buttons' own face at the top of the column, as a send's
                   level is over its cell, drawn over the head so the row keeps its height and widths -->
              <Border Name="MatrixVolumeOverFader" Classes="matrixValueChip" HorizontalAlignment="Center" VerticalAlignment="Top"
                      IsHitTestVisible="False" Padding="5,0" IsVisible="{Binding ShowsVolumeChip}"
                      Background="{DynamicResource Ox.Control.Background}" BorderBrush="{DynamicResource Ox.Control.BorderBrush}"
                      BorderThickness="{DynamicResource Ox.Control.BorderThickness}" CornerRadius="{DynamicResource Ox.Control.CornerRadius}">
                <TextBlock Text="{Binding Channel.VolumeText}" FontSize="{DynamicResource UiText.FontSize11}" Foreground="{DynamicResource Ox.Control.Foreground}"/>
              </Border>
              </Panel>
            </Border>
          </DockPanel>
        </Border>
      </DataTemplate>
      <!-- Line In: its gain over its meter and its level lock, where the interface has the input -->
      <DataTemplate x:Key="line" x:DataType="layout:MatrixRowViewModel">
        <Border Classes="tile matrixHead" Name="MatrixRowHead" Classes.stacked="{Binding Tall}">
          <DockPanel>
              <!-- the name column: a grid, not a horizontal stack, so the name gets what the icon and the handle leave and trims -->
              <Border DockPanel.Dock="{Binding IdentityDock}" Width="{DynamicResource Ox.Matrix.NameWidth}" Padding="6,0"
                      Name="MatrixRowName">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="4" VerticalAlignment="Center">
                  <Button Grid.RowSpan="2" Classes="ghost reorderHandle alongY" Classes.fixedPlace="{Binding HandleHidden}"
                          Content="↕" Tag="{Binding Channel}"
                          AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=MoveItem}}"
                          ToolTip.Tip="{loc:Text Key=DragOntoAnotherChannelYouCanEdit}"/>
                  <vm:LayoutIconBlock Grid.Column="1" Icon="{Binding Channel.Appearance.Icon}" Fallback="{Binding Channel.Appearance.DefaultIcon}" Classes="strip"
                             Classes.layoutAccent="{Binding Channel.Appearance.HasColour}" VerticalAlignment="Center"
                             IsVisible="{Binding ShowsIcon}" AutomationProperties.Name="{Binding Channel.Name}" ToolTip.Tip="{Binding Channel.Name}"/>
                  <TextBlock Grid.Column="2" Text="{Binding Channel.Name}" Classes="strip" Classes.layoutAccent="{Binding Channel.Appearance.HasColour}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsVisible="{Binding ShowsName}" ToolTip.Tip="{Binding Channel.Name}"/>
                  <!-- the gain, which reads the channel's volume while the volume fader moves and for a second after -->
                  <TextBlock Grid.Column="3" Grid.RowSpan="2" Name="MatrixReadout" Text="{Binding Readout}" Classes="val" FontSize="{DynamicResource UiText.FontSize11}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowsReadout}"
                             AutomationProperties.Name="{Binding ReadoutName}" ToolTip.Tip="{Binding ReadoutName}"/>
                </Grid>
              </Border>
            <Border Width="{DynamicResource MatrixCellWidth}" Padding="4,0" Name="MatrixSource">
              <Panel>
              <layout:StripPanel Spec="{Binding Spec}" Spacing="4" VerticalAlignment="Center">
                <StackPanel layout:StripPanel.Part="meter" Orientation="Vertical" Spacing="1" VerticalAlignment="Center"
                            ToolTip.Tip="{loc:Text Key=ChannelMeterTip}">
                  <skin:LevelMeter Orientation="Horizontal" Level="{Binding Channel.MeterL}" AutomationProperties.Name="{Binding LeftLevelName}"/>
                  <skin:LevelMeter Orientation="Horizontal" Level="{Binding Channel.MeterR}" AutomationProperties.Name="{Binding RightLevelName}"/>
                </StackPanel>
                <StackPanel layout:StripPanel.Part="gain" Name="MatrixLevels" Spacing="2" VerticalAlignment="Center">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" IsVisible="{Binding HasGainFader}">
                    <layout:MeterFader ShowsMeter="{Binding MeterUnderFader}" LeftLevel="{Binding Channel.MeterL}" RightLevel="{Binding Channel.MeterR}"
                                       LeftName="{Binding LeftLevelName}" RightName="{Binding RightLevelName}" VerticalAlignment="Center">
                      <Slider Classes="matrixFader" vm:FaderInput.Step="1" Minimum="0" Maximum="{Binding Main.LineInGainMaxDb}"
                              Value="{Binding Main.LineInGainSliderDb, Mode=TwoWay}"
                              AutomationProperties.Name="{loc:Text Key=LineInGain}"/>
                    </layout:MeterFader>
                    <ToggleButton Grid.Column="1" Name="MatrixLineInLock" Content="{loc:Text Key=Lock}" IsChecked="{Binding Main.LineInLevelLock, Mode=TwoWay}"
                                  Padding="5,2" FontSize="{DynamicResource UiText.FontSize11}" VerticalAlignment="Center" MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                                  AutomationProperties.Name="{loc:Text Key=LevelLock}" ToolTip.Tip="{loc:Text Key=LevelLock}"/>
                  </Grid>
                  <!-- the channel's own volume, under the gain where the row has one, the meter under it
                       otherwise; while the Wave XLR Pro's direct path carries this channel to the jacks, a
                       mark says it reaches the mixes only -->
                  <Grid Name="MatrixVolumeLine" ColumnDefinitions="*,Auto" ColumnSpacing="4" IsVisible="{Binding ShowsVolume}">
                    <layout:MeterFader ShowsMeter="{Binding VolumeShowsMeter}" LeftLevel="{Binding Channel.MeterL}" RightLevel="{Binding Channel.MeterR}"
                                       LeftName="{Binding LeftLevelName}" RightName="{Binding RightLevelName}" VerticalAlignment="Center">
                      <Slider Name="MatrixVolume" Classes="matrixFader" vm:FaderInput.Step="0.01" Minimum="0" Maximum="1"
                              vm:FaderInput.IsAdjusting="{Binding VolumeAdjusting, Mode=OneWayToSource}"
                              Value="{Binding Channel.Volume, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=ChannelVolumeName}}"
                              ToolTip.Tip="{Binding Channel.VolumeTip}"/>
                    </layout:MeterFader>
                    <TextBlock Grid.Column="1" Name="MatrixVolumeNote" Text="&#x24D8;" Classes="h" FontSize="{DynamicResource UiText.FontSize12}" VerticalAlignment="Center"
                               Cursor="Help" IsVisible="{Binding Channel.DirectMonitored}" ToolTip.Tip="{Binding Channel.VolumeTip}"
                               AutomationProperties.Name="{loc:Text Key=ChannelVolumeMixesOnly}"/>
                  </Grid>
                </StackPanel>
              </layout:StripPanel>
              <!-- the channel's volume, while its fader moves and for a second after, where the row has no
                   readout to show it in: a chip in the buttons' own face at the top of the column, as a send's
                   level is over its cell, drawn over the head so the row keeps its height and widths -->
              <Border Name="MatrixVolumeOverFader" Classes="matrixValueChip" HorizontalAlignment="Center" VerticalAlignment="Top"
                      IsHitTestVisible="False" Padding="5,0" IsVisible="{Binding ShowsVolumeChip}"
                      Background="{DynamicResource Ox.Control.Background}" BorderBrush="{DynamicResource Ox.Control.BorderBrush}"
                      BorderThickness="{DynamicResource Ox.Control.BorderThickness}" CornerRadius="{DynamicResource Ox.Control.CornerRadius}">
                <TextBlock Text="{Binding Channel.VolumeText}" FontSize="{DynamicResource UiText.FontSize11}" Foreground="{DynamicResource Ox.Control.Foreground}"/>
              </Border>
              </Panel>
            </Border>
          </DockPanel>
        </Border>
      </DataTemplate>
      <!-- an application or capture channel: its name, its meter and its own volume, the meter under the volume as under a
           microphone's gain; a capture channel carrying the interface's microphone draws the interface's gain and mute too,
           the gain over the volume -->
      <DataTemplate x:Key="channel" x:DataType="layout:MatrixRowViewModel">
        <Border Classes="tile matrixHead" Name="MatrixRowHead" Classes.stacked="{Binding Tall}">
          <DockPanel>
              <!-- the name column: a grid, not a horizontal stack, so the name gets what the icon and the handle leave and trims -->
              <Border DockPanel.Dock="{Binding IdentityDock}" Width="{DynamicResource Ox.Matrix.NameWidth}" Padding="6,0"
                      Name="MatrixRowName">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="4" VerticalAlignment="Center">
                  <Button Grid.RowSpan="2" Classes="ghost reorderHandle alongY" Classes.fixedPlace="{Binding HandleHidden}"
                          Content="↕" Tag="{Binding Channel}"
                          AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=MoveItem}}"
                          ToolTip.Tip="{loc:Text Key=DragOntoAnotherChannelYouCanEdit}"/>
                  <vm:LayoutIconBlock Grid.Column="1" Icon="{Binding Channel.Appearance.Icon}" Fallback="{Binding Channel.Appearance.DefaultIcon}" Classes="strip"
                             Classes.layoutAccent="{Binding Channel.Appearance.HasColour}" VerticalAlignment="Center"
                             IsVisible="{Binding ShowsIcon}" AutomationProperties.Name="{Binding Channel.Name}" ToolTip.Tip="{Binding Channel.Name}"/>
                  <TextBlock Grid.Column="2" Text="{Binding Channel.Name}" Classes="strip" Classes.layoutAccent="{Binding Channel.Appearance.HasColour}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" IsVisible="{Binding ShowsName}" ToolTip.Tip="{Binding Channel.Name}"/>
                  <!-- a capture input's source under its name, opening its binding dialog.
                       A skin whose order leaves the part out gets the connection line. -->
                  <Grid Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="4"
                        Name="MatrixCaptureBinding" IsVisible="{Binding ShowsBinding}" IsHitTestVisible="False">
                    <skin:StatusLed IsOn="{Binding Channel.CaptureConnected}" VerticalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw"/>
                    <TextBlock Grid.Column="1" Text="{Binding Channel.BindingLabel}" Classes="hint" FontSize="{DynamicResource UiText.FontSize11}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </Grid>
                  <Button Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" Name="MatrixBinding" Theme="{StaticResource MatrixBindingTarget}"
                          IsVisible="{Binding ShowsBinding}" Click="OnBinding"
                          AutomationProperties.Name="{Binding Channel.BindingChipName}" ToolTip.Tip="{Binding Channel.BindingTip}"/>
                  <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding Channel.CaptureLabel}" Classes="hint" FontSize="{DynamicResource UiText.FontSize11}"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Channel.CaptureLabel}"
                             IsVisible="{Binding ShowsCaptureLabel}"/>
                  <!-- the microphone's switches behind one button at the end of the name column, wherever the
                       order puts the part, so the source controls keep their room: lettered as a lit chain while
                       one is on, with the interface's phantom power lamp, lit while phantom power is on; under it
                       the input's gain, which reads the channel's volume while the volume fader moves -->
                  <Button Grid.Column="3" Name="MatrixProcessing" Classes="matrixProcessing fx" Classes.fxOn="{Binding ProcessingOn}"
                          Padding="5,2" FontSize="{DynamicResource UiText.FontSize11}" VerticalAlignment="Center" MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                          MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" IsVisible="{Binding ShowsSwitchesButton}"
                          AutomationProperties.Name="{Binding ProcessingName}" ToolTip.Tip="{loc:Text Key=MatrixProcessingTip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <skin:StatusLed Name="MatrixPhantom" Kind="Power" IsOn="{Binding PhantomOn}" IsVisible="{Binding HasPhantom}"
                                      AutomationProperties.AccessibilityView="Raw"/>
                      <TextBlock Text="{loc:Text Key=MatrixProcessing}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Flyout>
                      <Flyout Placement="BottomEdgeAlignedLeft">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProcessingSwitches}"/>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                  <!-- a capture input whose only switch is Own clock: the switch itself, lit while it is on, no flyout -->
                  <Button Grid.Column="3" Name="MatrixOwnClockButton" Classes="matrixProcessing fx" Classes.fxOn="{Binding Channel.OwnClock}"
                          Padding="5,2" FontSize="{DynamicResource UiText.FontSize11}" VerticalAlignment="Center" MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                          MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" IsVisible="{Binding ShowsOwnClockButton}" Click="OnToggleOwnClock"
                          Content="{loc:Text Key=CaptureOwnClock}" AutomationProperties.Name="{Binding OwnClockName}" ToolTip.Tip="{Binding OwnClockTip}"/>
                  <TextBlock Grid.Column="3" Name="MatrixReadout" Text="{Binding Readout}" Classes="val" FontSize="{DynamicResource UiText.FontSize11}"
                             Classes.under="{Binding ShowsProcessing}" Classes.centred="{Binding !ShowsProcessing}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowsReadout}"
                             AutomationProperties.Name="{Binding ReadoutName}" ToolTip.Tip="{Binding ReadoutName}"/>
                </Grid>
              </Border>
            <Border Width="{DynamicResource MatrixCellWidth}" Padding="4,0" Name="MatrixSource">
              <Panel>
              <layout:StripPanel Spec="{Binding Spec}" Spacing="4" VerticalAlignment="Center">
                <StackPanel layout:StripPanel.Part="meter" Orientation="Vertical" Spacing="1" VerticalAlignment="Center"
                            ToolTip.Tip="{loc:Text Key=ChannelMeterTip}">
                  <skin:LevelMeter Orientation="Horizontal" Level="{Binding Channel.MeterL}" AutomationProperties.Name="{Binding LeftLevelName}"/>
                  <skin:LevelMeter Orientation="Horizontal" Level="{Binding Channel.MeterR}" Classes.monoSpare="{Binding Channel.MonoMeter}" AutomationProperties.Name="{Binding RightLevelName}"/>
                </StackPanel>
                <StackPanel layout:StripPanel.Part="gain" Name="MatrixLevels" Spacing="2" VerticalAlignment="Center">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" IsVisible="{Binding HasGainFader}">
                    <!-- the interface's gain, while this capture channel carries the interface's microphone -->
                    <layout:MeterFader ShowsMeter="{Binding MeterUnderFader}" LeftLevel="{Binding Channel.MeterL}" RightLevel="{Binding Channel.MeterR}" Mono="{Binding Channel.MonoMeter}"
                                       LeftName="{Binding LeftLevelName}" RightName="{Binding RightLevelName}" VerticalAlignment="Center"
                                       IsVisible="{Binding CarriesUnit}">
                      <Slider Name="MatrixUnitGain" Classes="matrixFader" vm:FaderInput.Step="1" Minimum="0" Maximum="{Binding Unit.GainMaxDb, FallbackValue=80}"
                              Value="{Binding Unit.GainDb, Mode=TwoWay}" IsEnabled="{Binding !Unit.GainLocked, FallbackValue=False}"
                              AutomationProperties.Name="{Binding Unit.GainName}"/>
                    </layout:MeterFader>
                    <!-- an additional interface's gain, while this row carries that interface's input -->
                    <layout:MeterFader ShowsMeter="{Binding MeterUnderFader}" LeftLevel="{Binding Channel.MeterL}" RightLevel="{Binding Channel.MeterR}" Mono="{Binding Channel.MonoMeter}"
                                       LeftName="{Binding LeftLevelName}" RightName="{Binding RightLevelName}" VerticalAlignment="Center"
                                       IsVisible="{Binding CarriesExtraUnit}">
                      <Slider Name="MatrixExtraGain" Classes="matrixFader" vm:FaderInput.Step="1" Minimum="0" Maximum="{Binding ExtraUnit.GainMaxDb, FallbackValue=80}"
                              Value="{Binding ExtraUnit.GainDb, Mode=TwoWay}" IsEnabled="{Binding ExtraUnit.CanAdjustGain, FallbackValue=False}"
                              AutomationProperties.Name="{Binding ExtraUnit.GainName}"/>
                    </layout:MeterFader>
                    <!-- a capture input's own gain, its source's volume, on a source OpenXLR does not drive; the range
                         before the value, so the fader never clamps the gain to a range it is about to leave -->
                    <layout:MeterFader ShowsMeter="{Binding MeterUnderFader}" LeftLevel="{Binding Channel.MeterL}" RightLevel="{Binding Channel.MeterR}" Mono="{Binding Channel.MonoMeter}"
                                       LeftName="{Binding LeftLevelName}" RightName="{Binding RightLevelName}" VerticalAlignment="Center"
                                       IsVisible="{Binding ShowsCaptureGain}">
                      <Slider Name="MatrixCaptureGain" Classes="matrixFader" vm:FaderInput.Step="1"
                              Minimum="{Binding Channel.CaptureGainMinDb}" Maximum="{Binding Channel.CaptureGainMaxDb}"
                              Value="{Binding Channel.CaptureGainDb, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding Channel.CaptureGainName}" ToolTip.Tip="{Binding Channel.CaptureGainTip}"/>
                    </layout:MeterFader>
                  </Grid>
                  <!-- the channel's own volume, under the gain where the row has one, the meter under it
                       otherwise; while the Wave XLR Pro's direct path carries this channel to the jacks, a
                       mark says it reaches the mixes only -->
                  <Grid Name="MatrixVolumeLine" ColumnDefinitions="*,Auto" ColumnSpacing="4" IsVisible="{Binding ShowsVolume}">
                    <layout:MeterFader ShowsMeter="{Binding VolumeShowsMeter}" LeftLevel="{Binding Channel.MeterL}" RightLevel="{Binding Channel.MeterR}" Mono="{Binding Channel.MonoMeter}"
                                       LeftName="{Binding LeftLevelName}" RightName="{Binding RightLevelName}" VerticalAlignment="Center">
                      <Slider Name="MatrixVolume" Classes="matrixFader" vm:FaderInput.Step="0.01" Minimum="0" Maximum="1"
                              vm:FaderInput.IsAdjusting="{Binding VolumeAdjusting, Mode=OneWayToSource}"
                              Value="{Binding Channel.Volume, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=ChannelVolumeName}}"
                              ToolTip.Tip="{Binding Channel.VolumeTip}"/>
                    </layout:MeterFader>
                    <TextBlock Grid.Column="1" Name="MatrixVolumeNote" Text="&#x24D8;" Classes="h" FontSize="{DynamicResource UiText.FontSize12}" VerticalAlignment="Center"
                               Cursor="Help" IsVisible="{Binding Channel.DirectMonitored}" ToolTip.Tip="{Binding Channel.VolumeTip}"
                               AutomationProperties.Name="{loc:Text Key=ChannelVolumeMixesOnly}"/>
                  </Grid>
                </StackPanel>
                <Panel layout:StripPanel.Part="mute" VerticalAlignment="Center">
                  <ToggleButton Classes="mute mutemini matrixMute" IsVisible="{Binding CarriesUnit}" IsChecked="{Binding Unit.Mute, Mode=TwoWay}"
                                IsEnabled="{Binding !Unit.PhantomSettling, FallbackValue=False}" Padding="5,2" FontSize="{DynamicResource UiText.FontSize11}" VerticalAlignment="Center"
                                MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                                AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=MixMuteName}}"
                                ToolTip.Tip="{loc:Text Key=TheDeviceMutesThisInputForAbout13}"/>
                  <ToggleButton Name="MatrixExtraMute" Classes="mute mutemini matrixMute" IsChecked="{Binding ExtraUnit.Mute, Mode=TwoWay}"
                                IsEnabled="{Binding ExtraUnit.CanMute, FallbackValue=False}" Padding="5,2" FontSize="{DynamicResource UiText.FontSize11}" VerticalAlignment="Center"
                                MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}" IsVisible="{Binding CarriesExtraUnit}"
                                AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=MixMuteName}}"
                                ToolTip.Tip="{loc:Text Key=TheDeviceMutesThisInputForAbout13}"/>
                  <!-- a capture input's own mute, its source's, on a row that draws the source's gain -->
                  <ToggleButton Name="MatrixCaptureMute" Classes="mute mutemini matrixMute" IsChecked="{Binding Channel.CaptureMuted, Mode=TwoWay}"
                                Padding="5,2" FontSize="{DynamicResource UiText.FontSize11}" VerticalAlignment="Center"
                                MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}" IsVisible="{Binding ShowsCaptureMute}"
                                AutomationProperties.Name="{Binding Channel.CaptureMuteName}" ToolTip.Tip="{loc:Text Key=CaptureMuteTip}"/>
                </Panel>
                <!-- a capture input's plugin chain, the button an XLR row has, with the microphone's
                     EQ over it on a capture input the daemon reports one for, as on XLR 1.
                     The part is in the row's spec only while the daemon reports the input's chain
                     width, and the strip panel alone decides whether a part is shown. -->
                <StackPanel layout:StripPanel.Part="effects" Name="MatrixCaptureEffectsPart" Spacing="2" VerticalAlignment="Center">
                  <Button Name="MatrixEq" Classes="matrixEq fx" Content="{loc:Text Key=Eq}"
                          Classes.fxOn="{Binding Channel.Eq.IsLit, FallbackValue=False}" Classes.fxOff="{Binding Channel.Eq.IsFaulty, FallbackValue=False}"
                          Padding="5,2" FontSize="{DynamicResource UiText.FontSize11}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}" IsVisible="{Binding ShowsEq}" Click="OnEq"
                          AutomationProperties.Name="{Binding Channel.Eq.ButtonName, FallbackValue=''}" ToolTip.Tip="{Binding Channel.Eq.ButtonTip, FallbackValue=''}"/>
                  <Button Name="MatrixCaptureInserts" Classes="matrixEffects fx" Content="{loc:Text Key=MatrixEffects}"
                          Classes.fxOn="{Binding Inserts.IsProcessing, FallbackValue=False}" Classes.fxOff="{Binding Inserts.IsOff, FallbackValue=False}"
                          Padding="5,2" FontSize="{DynamicResource UiText.FontSize11}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                          Click="OnXlrInserts" AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=InsertsTitle}}"
                          ToolTip.Tip="{loc:Text Key=InputChainHint}"/>
                </StackPanel>
              </layout:StripPanel>
              <!-- the channel's volume, while its fader moves and for a second after, where the row has no
                   readout to show it in: a chip in the buttons' own face at the top of the column, as a send's
                   level is over its cell, drawn over the head so the row keeps its height and widths -->
              <Border Name="MatrixVolumeOverFader" Classes="matrixValueChip" HorizontalAlignment="Center" VerticalAlignment="Top"
                      IsHitTestVisible="False" Padding="5,0" IsVisible="{Binding ShowsVolumeChip}"
                      Background="{DynamicResource Ox.Control.Background}" BorderBrush="{DynamicResource Ox.Control.BorderBrush}"
                      BorderThickness="{DynamicResource Ox.Control.BorderThickness}" CornerRadius="{DynamicResource Ox.Control.CornerRadius}">
                <TextBlock Text="{Binding Channel.VolumeText}" FontSize="{DynamicResource UiText.FontSize11}" Foreground="{DynamicResource Ox.Control.Foreground}"/>
              </Border>
              </Panel>
            </Border>
          </DockPanel>
        </Border>
      </DataTemplate>
    </layout:StripTemplateSelector>
  </UserControl.Resources>

  <!-- The whole matrix scrolls sideways inside its card when it is wider;
       the row heads scroll with it, so focus runs row by row, head first. -->
  <ScrollViewer Name="MatrixScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <!-- room under the last row for the sideways scroll bar, which is drawn over the content -->
    <StackPanel Name="MatrixLines" Spacing="{x:Static skin:SkinLayoutDefaults.MatrixSpacing}" HorizontalAlignment="Left" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" Spacing="{x:Static skin:SkinLayoutDefaults.MatrixSpacing}">
        <!-- the corner over the row heads: as wide as a head, so the columns stand over their cells -->
        <Border Classes="tile" Name="MatrixCorner" Background="Transparent" BorderBrush="Transparent">
          <StackPanel Orientation="Horizontal">
            <Panel Width="{DynamicResource Ox.Matrix.NameWidth}"/>
            <Panel Width="{DynamicResource MatrixCellWidth}"/>
          </StackPanel>
        </Border>
        <ItemsControl Name="MatrixColumns" ItemsSource="{Binding Columns}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="{x:Static skin:SkinLayoutDefaults.MatrixSpacing}"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="layout:MatrixColumnViewModel">
              <Border Classes="tile matrixColumn" Name="MatrixColumn" Padding="6,6,6,4" Classes.revealed="{Binding Mix.Revealed}">
                <DockPanel>
                  <!-- a thin line in the mix's own colour, where the layout editor gave it one -->
                  <Border DockPanel.Dock="Bottom" Height="2" Margin="0,4,0,0" CornerRadius="1" Name="MatrixColumnLine"
                          Background="{Binding Mix.Appearance.Accent}" IsVisible="{Binding Mix.Appearance.HasColour}"/>
                  <layout:StripPanel DockPanel.Dock="{Binding ControlsDock}" Spec="{Binding ControlSpec}" Spacing="4"
                                     IsVisible="{Binding HasControls}" Margin="0,4">
                    <layout:MeterFader layout:StripPanel.Part="master" ShowsMeter="{Binding Matrix.MeterUnderFader}"
                                       LeftLevel="{Binding Mix.MeterL}" RightLevel="{Binding Mix.MeterR}"
                                       LeftName="{loc:Text Key=LeftLevel}" RightName="{loc:Text Key=RightLevel}" VerticalAlignment="Center">
                      <Slider Name="MatrixMaster" Classes="matrixFader" vm:FaderInput.Step="0.01" Minimum="0" Maximum="{Binding Mix.VolumeRange.Maximum}"
                              vm:FaderInput.IsAdjusting="{Binding VolumeAdjusting, Mode=OneWayToSource}"
                              Value="{Binding Mix.Volume, Mode=TwoWay}" AutomationProperties.Name="{Binding MasterName}"/>
                    </layout:MeterFader>
                    <ToggleButton layout:StripPanel.Part="mute" Classes="mute mutemini matrixMute" IsChecked="{Binding Mix.Muted, Mode=TwoWay}"
                                  Padding="5,2" FontSize="{DynamicResource UiText.FontSize11}" VerticalAlignment="Center" MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                                  AutomationProperties.Name="{Binding MuteName}" ToolTip.Tip="{Binding MuteName}"/>
                    <!-- the mix's EQ over its plugin chain, in the order the signal meets them, one over
                         the other as a microphone row has them, so the part keeps the chain's width -->
                    <StackPanel layout:StripPanel.Part="effects" Name="MatrixMixEffectsPart" Spacing="2" VerticalAlignment="Center">
                      <Button Name="MatrixMixEq" Classes="matrixEq fx" Content="{loc:Text Key=Eq}"
                              Classes.fxOn="{Binding Mix.Eq.IsLit, FallbackValue=False}" Classes.fxOff="{Binding Mix.Eq.IsFaulty, FallbackValue=False}"
                              Padding="5,2" FontSize="{DynamicResource UiText.FontSize11}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}" IsVisible="{Binding Mix.HasEq}"
                              IsEnabled="{Binding Mix.Eq.CanOpen, FallbackValue=False}" ToolTip.ShowOnDisabled="True" Click="OnMixEq"
                              AutomationProperties.Name="{Binding Mix.Eq.ButtonName, FallbackValue=''}" ToolTip.Tip="{Binding Mix.Eq.ButtonTip, FallbackValue=''}"/>
                      <Button Classes="matrixEffects fx" Content="{loc:Text Key=MatrixEffects}"
                              Classes.fxOn="{Binding Mix.Inserts.IsProcessing}" Classes.fxOff="{Binding Mix.Inserts.IsOff}"
                              Padding="5,2" FontSize="{DynamicResource UiText.FontSize11}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                              Click="OnMixInserts" AutomationProperties.Name="{Binding Mix.Inserts.ButtonText}"
                              ToolTip.Tip="{Binding Mix.Inserts.ButtonTip}"/>
                    </StackPanel>
                  </layout:StripPanel>
                  <layout:StripPanel Spec="{Binding TextSpec}" Spacing="1">
                    <Grid layout:StripPanel.Part="identity" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                      <vm:LayoutIconBlock Icon="{Binding Mix.Appearance.Icon}" Fallback="{Binding Mix.Appearance.DefaultIcon}" Classes="strip" Classes.layoutAccent="{Binding Mix.Appearance.HasColour}"
                                 VerticalAlignment="Center" IsVisible="{Binding ShowsIcon}"
                                 AutomationProperties.Name="{Binding Mix.Name}" ToolTip.Tip="{Binding Mix.Name}"/>
                      <TextBlock Grid.Column="1" Text="{Binding Mix.Name}" Classes="strip" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" IsVisible="{Binding ShowsName}" ToolTip.Tip="{Binding Mix.Name}"/>
                      <!-- A monitor mix's dry switch, at the head's right edge as the FX button below sits
                           at the strip's, and before the move handle while that shows: grey while off, green
                           while on, and the volume in place of "Dry" while the master moves. -->
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- the dry switch again, before the maximizer's chip while that is on, so the chip
                             and its amount hold the right edge; the same switch, one shown at a time -->
                        <ToggleButton Name="MatrixDryChipLead" Classes="dryChip" Classes.showsVolume="{Binding ShowsVolumeChip}" Padding="5,0"
                                      VerticalAlignment="Center" IsVisible="{Binding DryLeadsMaximizer}"
                                      IsChecked="{Binding Mix.MonitorDry, Mode=TwoWay}" Content="{Binding DryChipText}"
                                      FontSize="{DynamicResource UiText.FontSize11}"
                                      AutomationProperties.Name="{Binding DryName}" ToolTip.Tip="{loc:Text Key=MonitorDryTip}"/>
                        <!-- The Wave XLR Pro's maximizer while hardware mixing builds the mix on the unit, in
                             the head beside the dry switch so the strip keeps its size: "Max", grey while off
                             and green while on, the amount in its flyout. -->
                        <Button Name="MatrixMixMaximizer" Classes="maxChip" Classes.on="{Binding Mix.MaximizerOn}" Padding="5,0"
                                VerticalAlignment="Center" FontSize="{DynamicResource UiText.FontSize11}" IsVisible="{Binding Mix.ShowMaximizer}"
                                IsEnabled="{Binding Mix.CanMaximize}" ToolTip.ShowOnDisabled="True"
                                Content="{loc:Text Key=Maximizer}"
                                AutomationProperties.Name="{Binding Mix.Name, StringFormat={loc:Text Key=MaximizerName}}" ToolTip.Tip="{Binding Mix.MaximizerTip}">
                          <Button.Flyout>
                            <Flyout Placement="Bottom">
                              <StackPanel Name="MatrixMixMaximizerPanel" Width="240" Spacing="6">
                                <TextBlock Text="{loc:Text Key=MaximizerTitle}" Classes="h" FontSize="{DynamicResource UiText.FontSize11}"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                  <Slider Name="MatrixMixMaximizerAmount" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                                          TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Mix.Maximizer, Mode=TwoWay}"
                                          AutomationProperties.Name="{Binding Mix.Name, StringFormat={loc:Text Key=MaximizerName}}"/>
                                  <TextBlock Grid.Column="1" Text="{Binding Mix.MaximizerText}" Classes="val" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{Binding Mix.MaximizerReductionText}" Classes="val" FontSize="{DynamicResource UiText.FontSize11}"/>
                                <TextBlock Text="{loc:Text Key=MaximizerTip}" Classes="h" FontSize="{DynamicResource UiText.FontSize11}" TextWrapping="Wrap"/>
                              </StackPanel>
                            </Flyout>
                          </Button.Flyout>
                        </Button>
                        <ToggleButton Name="MatrixDryChip" Classes="dryChip" Classes.showsVolume="{Binding ShowsVolumeChip}" Padding="5,0"
                                      VerticalAlignment="Center" IsVisible="{Binding DryTrailsMaximizer}"
                                      IsChecked="{Binding Mix.MonitorDry, Mode=TwoWay}" Content="{Binding DryChipText}"
                                      FontSize="{DynamicResource UiText.FontSize11}"
                                      AutomationProperties.Name="{Binding DryName}" ToolTip.Tip="{loc:Text Key=MonitorDryTip}"/>
                        <Button Name="MatrixColumnHandle" Classes="ghost reorderHandle" Classes.fixedPlace="{Binding HandleHidden}"
                                Content="↔" Tag="{Binding Mix}"
                                AutomationProperties.Name="{Binding Mix.Name, StringFormat={loc:Text Key=MoveItem}}"
                                ToolTip.Tip="{loc:Text Key=DragOntoAnotherChannelYouCanEdit}"/>
                      </StackPanel>
                      <!-- the mix's volume while its master moves and for a second after, in the chip a send's
                           level uses: opposite the name, drawn over the move handle and the end of a long name,
                           so the head keeps its size -->
                      <Border Grid.Column="1" Grid.ColumnSpan="2" Name="MatrixMasterChip" Classes="matrixValueChip" IsHitTestVisible="False" Padding="5,0"
                              HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding ShowsVolumeOnlyChip}"
                              Background="{DynamicResource Ox.Control.Background}" BorderBrush="{DynamicResource Ox.Control.BorderBrush}"
                              BorderThickness="{DynamicResource Ox.Control.BorderThickness}" CornerRadius="{DynamicResource Ox.Control.CornerRadius}">
                        <TextBlock Text="{Binding Mix.VolumeText}" FontSize="{DynamicResource UiText.FontSize11}" Foreground="{DynamicResource Ox.Control.Foreground}"/>
                      </Border>
                    </Grid>
                    <!-- what the mix plays to, and while the unit's maximizer is on its amount under the
                         Max chip, which then stands last before the move handle -->
                    <Grid layout:StripPanel.Part="outputs" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                      <TextBlock Text="{Binding OutputsText}" Classes="hint" FontSize="{DynamicResource UiText.FontSize11}"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OutputsText}"/>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <StackPanel.IsVisible>
                          <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="Mix.ShowMaximizer"/>
                            <Binding Path="Mix.MaximizerOn"/>
                          </MultiBinding>
                        </StackPanel.IsVisible>
                        <TextBlock Name="MatrixMixMaximizerLevel" Text="{Binding Mix.MaximizerText}" Classes="hint" FontSize="{DynamicResource UiText.FontSize11}"
                                   MinWidth="{Binding #MatrixMixMaximizer.Bounds.Width}" TextAlignment="Center"
                                   AutomationProperties.Name="{Binding Mix.Name, StringFormat={loc:Text Key=MaximizerName}}"/>
                        <Panel Width="{Binding #MatrixColumnHandle.Bounds.Width}" IsVisible="{Binding #MatrixColumnHandle.IsVisible}"/>
                      </StackPanel>
                    </Grid>
                  </layout:StripPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <ItemsControl Name="MatrixRows" ItemsSource="{Binding Rows}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="{x:Static skin:SkinLayoutDefaults.MatrixSpacing}"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="layout:MatrixRowViewModel">
            <StackPanel Orientation="Horizontal" Spacing="{x:Static skin:SkinLayoutDefaults.MatrixSpacing}" Name="MatrixRow">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RowHeads}" Focusable="False"
                              Classes.revealed="{Binding Channel.Revealed}"/>
              <ItemsControl ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="{x:Static skin:SkinLayoutDefaults.MatrixSpacing}"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="layout:MatrixCellViewModel">
                    <Border Classes="tile matrixCell" Name="MatrixCell" Classes.tinted="{Binding Tinted}" Classes.stacked="{Binding Row.Tall}"
                            Classes.dimmed="{Binding Dimmed}" Classes.empty="{Binding IsEmpty}" Classes.revealed="{Binding Send.Revealed}">
                      <Panel>
                      <layout:StripPanel Spec="{Binding Spec}" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding HasSend}">
                        <ToggleButton layout:StripPanel.Part="mute" Classes="mute mutemini matrixMute" IsChecked="{Binding Send.Muted, Mode=TwoWay}"
                                      Padding="5,2" FontSize="{DynamicResource UiText.FontSize11}" VerticalAlignment="Center"
                                      MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                                      AutomationProperties.Name="{Binding MuteName}" ToolTip.Tip="{Binding MuteName}"/>
                        <layout:MeterFader layout:StripPanel.Part="fader" ShowsMeter="{Binding MeterUnderFader}"
                                           LeftLevel="{Binding Channel.MeterL}" RightLevel="{Binding Channel.MeterR}" Mono="{Binding Channel.MonoMeter}"
                                           LeftName="{Binding LeftLevelName}" RightName="{Binding RightLevelName}"
                                           VerticalAlignment="Center" ToolTip.Tip="{loc:Text Key=ChannelMeterTip}">
                          <Slider Classes="matrixFader" vm:FaderInput.Step="0.01" vm:FaderInput.IsAdjusting="{Binding Adjusting, Mode=OneWayToSource}" Minimum="0" Maximum="1"
                                  Value="{Binding Send.Level, Mode=TwoWay}" AutomationProperties.Name="{Binding SendName}"/>
                        </layout:MeterFader>
                        <TextBlock layout:StripPanel.Part="value" Text="{Binding Send.LevelText}" Classes="val" FontSize="{DynamicResource UiText.FontSize11}"
                                   MinWidth="22" TextAlignment="Right" VerticalAlignment="Center"/>
                      </layout:StripPanel>
                      <!-- the send's level over the fader, where the skin puts it there: a chip in the
                           buttons' own face at the top of the cell, only while the fader is being moved -->
                      <Border Name="MatrixValueOverFader" Classes="matrixValueChip" HorizontalAlignment="Center" VerticalAlignment="Top"
                              IsHitTestVisible="False" Padding="5,0" IsVisible="{Binding ShowsValueChip}"
                              Background="{DynamicResource Ox.Control.Background}" BorderBrush="{DynamicResource Ox.Control.BorderBrush}"
                              BorderThickness="{DynamicResource Ox.Control.BorderThickness}" CornerRadius="{DynamicResource Ox.Control.CornerRadius}">
                        <TextBlock Text="{Binding Send.LevelText}" FontSize="{DynamicResource UiText.FontSize11}" Foreground="{DynamicResource Ox.Control.Foreground}"/>
                      </Border>
                      </Panel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
