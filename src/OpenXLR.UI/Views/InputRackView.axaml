<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:OpenXLR.UI.Localization"
             xmlns:vm="using:OpenXLR.UI"
             xmlns:skin="using:OpenXLR.UI.Skinning"
             xmlns:layout="using:OpenXLR.UI.Layout"
             xmlns:views="using:OpenXLR.UI.Views"
             x:Class="OpenXLR.UI.Views.InputRackView"
             x:DataType="layout:InputRackViewModel">

  <!-- INPUTS as a rack of strips, one per channel in the mixer's order. The
       hardware controls are the INPUTS panel's, bound to the same properties
       with the same capability, lock and phantom settling rules; a skin only
       orders the parts and leaves some out. The interface's gain and switches
       are on the strip that carries its microphone: XLR 1 or XLR 2, or a
       capture channel on the interface's own node while that strip is bound
       to another source. -->

  <UserControl.Resources>
    <!-- One plugin of an input's chain at a glance, as the INPUTS panel shows it. -->
    <DataTemplate x:Key="InsertRow" x:DataType="vm:InsertViewModel">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,3">
        <skin:StatusLed IsOn="{Binding IsActive}" Kind="Insert" Margin="0,0,8,0"
                        AutomationProperties.Name="{loc:Text Key=PluginState}"/>
        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
              ColumnSpacing="8" VerticalAlignment="Center" ClipToBounds="True">
          <TextBlock Text="{Binding Label}" Classes="insertName body" FontSize="{DynamicResource UiText.FontSize12}"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}"/>
          <TextBlock Grid.Column="1" Text="{Binding StateText}" Classes="h" FontSize="{DynamicResource UiText.FontSize11}"/>
          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Error}" Classes="warn"
                     FontSize="{DynamicResource UiText.FontSize11}" TextWrapping="Wrap" IsVisible="{Binding HasError}"/>
        </Grid>
        <ToggleButton Grid.Column="2" Content="{loc:Text Key=NativeHostLetter}" Classes="insertmini"
                      IsChecked="{Binding NativeHost, Mode=TwoWay}"
                      IsVisible="{Binding CanChooseNativeHost}"
                      IsEnabled="{Binding CanTurnNativeHostOn}"
                      Margin="4,0,0,0"
                      AutomationProperties.Name="{loc:Text Key=RunThisPluginInItsOwnProcess}"
                      ToolTip.Tip="{loc:Text Key=RunThisPluginInItsOwnProcessWhich}"/>
        <ToggleButton Grid.Column="3" Content="{loc:Text Key=BypassLetter}" Classes="insertmini bypass"
                      IsChecked="{Binding Bypass, Mode=TwoWay}"
                      Margin="4,0,2,0"
                      AutomationProperties.Name="{loc:Text Key=BypassThisPlugin}"
                      ToolTip.Tip="{loc:Text Key=Bypass}"/>
        <Button Grid.Column="4" Content="⚙" Classes="insertmini"
                AutomationProperties.Name="{loc:Text Key=OpenThisPluginSControls}"
                Click="OnInsertControls" ToolTip.Tip="{Binding ControlsHint}"/>
      </Grid>
    </DataTemplate>

    <layout:StripTemplateSelector x:Key="InputRows">
      <!-- XLR 1: its binding, the gain with its lock, every switch the interface has, the voice tune strength,
           its software low cut and ClipGuard and the chain -->
      <DataTemplate x:Key="xlr1" x:DataType="layout:InputStripViewModel">
        <Border Classes="tile strip" Name="InputStrip" IsVisible="{Binding Shown}" Classes.revealed="{Binding Channel.Revealed}">
          <DockPanel>
            <Button DockPanel.Dock="Top" Classes="ghost reorderHandle alongY" Classes.fixedPlace="{Binding HandleHidden}"
                    Content="↕" Tag="{Binding Channel}" HorizontalAlignment="Left" Margin="0,0,0,4"
                    AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=MoveItem}}"
                    ToolTip.Tip="{loc:Text Key=DragOntoAnotherChannelYouCanEdit}"/>
            <layout:StripPanel Spec="{Binding Spec}" Spacing="6">
              <!-- a grid, not a horizontal stack: the name gets what the icon leaves and trims, whatever the font -->
              <Grid layout:StripPanel.Part="identity" ColumnDefinitions="Auto,*" ColumnSpacing="6">
                <vm:LayoutIconBlock Icon="{Binding Channel.Appearance.Icon}" Fallback="{Binding Channel.Appearance.DefaultIcon}" Classes="strip" Classes.layoutAccent="{Binding Channel.Appearance.HasColour}"
                           IsVisible="{Binding ShowsIcon}" AutomationProperties.Name="{Binding Channel.Name}" ToolTip.Tip="{Binding Channel.Name}"/>
                <TextBlock Grid.Column="1" Text="{Binding Channel.Name}" Classes="strip" Classes.layoutAccent="{Binding Channel.Appearance.HasColour}"
                           TextTrimming="CharacterEllipsis" IsVisible="{Binding ShowsName}" ToolTip.Tip="{Binding Channel.Name}"/>
              </Grid>
              <!-- what feeds the strip, the interface's jack or another source, and why it is silent -->
              <StackPanel layout:StripPanel.Part="binding" Spacing="2">
                <views:BindingChip DataContext="{Binding Channel}" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding Channel.BindingWarning}" Classes="hint" FontSize="{DynamicResource UiText.FontSize11}" TextWrapping="Wrap"
                           IsVisible="{Binding Channel.HasBindingWarning}"/>
              </StackPanel>
              <StackPanel layout:StripPanel.Part="meter" Orientation="{Binding Spec.MeterPairOrientation}" Spacing="1">
                <skin:LevelMeter Orientation="{Binding Spec.MeterOrientation}" Level="{Binding Channel.MeterL}" AutomationProperties.Name="{Binding LeftLevelName}"/>
                <skin:LevelMeter Orientation="{Binding Spec.MeterOrientation}" Level="{Binding Channel.MeterR}" AutomationProperties.Name="{Binding RightLevelName}"/>
              </StackPanel>
              <StackPanel layout:StripPanel.Part="gain" Classes="dev" Spacing="4">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" IsVisible="{Binding CarriesUnit}">
                  <Slider Name="RackGain" vm:FaderInput.Step="1" Minimum="0" Maximum="{Binding Main.GainMaxDb}"
                          Value="{Binding Main.GainDb, Mode=TwoWay}" IsEnabled="{Binding !Main.GainLocked}"
                          AutomationProperties.Name="{Binding Main.UnitInput1.GainName}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Main.GainText}" Classes="val" VerticalAlignment="Center"/>
                  <ToggleButton Grid.Column="2" Content="{loc:Text Key=Lock}" Classes="mute" FontSize="{DynamicResource UiText.FontSize11}" Padding="8,2"
                                MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}" IsVisible="{Binding Main.ShowGainLock}"
                                IsChecked="{Binding Main.GainLocked, Mode=TwoWay}" VerticalAlignment="Center"
                                ToolTip.Tip="{loc:Text Key=GainLockTheDaemonRejectsEveryGainChange}"/>
                </Grid>
                <!-- an additional interface's gain, while this strip carries that interface's input -->
                <Panel IsVisible="{Binding CarriesExtraUnit}">
                  <views:WaveUnitControls Name="RackExtraGain" Part="Gain" DataContext="{Binding ExtraUnit}"/>
                </Panel>
                <!-- the channel's own volume, after the interface's gain; while the Wave XLR Pro's
                     direct path carries this channel to the jacks, a mark says it reaches the mixes only -->
                <Grid Name="RackVolume" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" IsVisible="{Binding ShowsVolume}">
                  <Slider vm:FaderInput.Step="0.01" Minimum="0" Maximum="1" Value="{Binding Channel.Volume, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=ChannelVolumeName}}"
                          ToolTip.Tip="{Binding Channel.VolumeTip}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Channel.VolumeText}" Classes="val" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Name="RackVolumeNote" Text="&#x24D8;" Classes="h" FontSize="{DynamicResource UiText.FontSize12}" VerticalAlignment="Center"
                             Cursor="Help" IsVisible="{Binding Channel.DirectMonitored}" ToolTip.Tip="{Binding Channel.VolumeTip}"
                             AutomationProperties.Name="{loc:Text Key=ChannelVolumeMixesOnly}"/>
                </Grid>
              </StackPanel>
              <StackPanel layout:StripPanel.Part="hardware-controls" Classes="dev" Spacing="4">
                <!-- the interface's switches, while XLR 1 carries its microphone -->
                <StackPanel Spacing="4" IsVisible="{Binding CarriesUnit}">
                  <WrapPanel Name="RackInputControls" ItemSpacing="6" LineSpacing="4">
                    <ToggleButton Content="{Binding Main.MuteLabel}" Classes="mute" IsChecked="{Binding Main.Mute, Mode=TwoWay}"
                                  IsEnabled="{Binding !Main.PhantomSettling}"
                                  ToolTip.Tip="{loc:Text Key=TheDeviceMutesThisInputForAbout13}"/>
                    <ToggleButton Content="{loc:Text Key=LowCut}" IsChecked="{Binding Main.LowCut, Mode=TwoWay}" IsVisible="{Binding Main.CapLowCut}"/>
                    <ToggleButton Content="{loc:Text Key=Expander}" IsChecked="{Binding Main.Expander, Mode=TwoWay}" IsVisible="{Binding Main.CapExpander}"/>
                    <ToggleButton Content="{loc:Text Key=VoiceTune}" IsChecked="{Binding Main.VoiceTune, Mode=TwoWay}" IsVisible="{Binding Main.CapVoiceTune}"/>
                    <ToggleButton Name="RackPhantom" Content="{loc:Text Key=Phantom}" IsChecked="{Binding Main.Phantom, Mode=TwoWay}" IsVisible="{Binding Main.CapPhantom}"/>
                    <ToggleButton Content="{loc:Text Key=ClipGuard}" IsChecked="{Binding Main.ClipGuard, Mode=TwoWay}" IsVisible="{Binding Main.CapClipGuard}"/>
                    <ToggleButton Content="{loc:Text Key=Compressor}" IsChecked="{Binding Main.Compressor, Mode=TwoWay}" IsVisible="{Binding Main.CapCompressor}"/>
                  </WrapPanel>
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" IsVisible="{Binding Main.VoiceTune}">
                    <TextBlock Text="{loc:Text Key=VTStrength}" Classes="h" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" vm:FaderInput.Step="1" Minimum="0" Maximum="100"
                            Value="{Binding Main.VoiceTuneStrength, Mode=TwoWay}" AutomationProperties.Name="{loc:Text Key=VTStrength}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Main.VoiceTuneStrengthText}" Classes="val" VerticalAlignment="Center"/>
                  </Grid>
                </StackPanel>
                <!-- an additional interface's switches, while this strip carries that interface's input -->
                <Panel IsVisible="{Binding CarriesExtraUnit}">
                  <views:WaveUnitControls Name="RackExtraSwitches" Part="Switches" DataContext="{Binding ExtraUnit}"/>
                </Panel>
                <!-- XLR 1's own software low cut and ClipGuard, whatever feeds it -->
                <WrapPanel Name="RackSoftwareControls" ItemSpacing="6" LineSpacing="4">
                  <ToggleButton Content="{Binding Main.SoftLowCutText}" IsVisible="{Binding Main.ShowSoftLowCut}"
                                IsChecked="{Binding Main.SoftLowCutOn, Mode=OneWay}" Click="OnCycleSoftLowCut"
                                ToolTip.Tip="{loc:Text Key=HostSideLowCutForThisDeviceIts}"/>
                  <ToggleButton Content="{loc:Text Key=ClipGuard}" IsVisible="{Binding Main.ShowSoftClipGuard}"
                                IsChecked="{Binding Main.SoftClipGuard, Mode=TwoWay}"
                                IsEnabled="{Binding Main.SoftClipGuardAvailable}"
                                ToolTip.Tip="{Binding Main.SoftClipGuardTip}"/>
                </WrapPanel>
              </StackPanel>
              <StackPanel layout:StripPanel.Part="effects" Spacing="4">
                <StackPanel Spacing="4" IsVisible="{Binding Main.HasMixer}">
                  <!-- the microphone's EQ and noise removal, then its plugin chain -->
                  <WrapPanel Name="RackEffects" ItemSpacing="6" LineSpacing="4">
                    <Button Name="RackEq" Content="{loc:Text Key=Eq}" Classes="fx" Classes.fxOn="{Binding Channel.Eq.IsLit, FallbackValue=False}"
                            Classes.fxOff="{Binding Channel.Eq.IsFaulty, FallbackValue=False}"
                            Padding="12,3" FontSize="{DynamicResource UiText.FontSize12}" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                            IsVisible="{Binding Channel.HasEq}" Click="OnEq"
                            AutomationProperties.Name="{Binding Channel.Eq.ButtonName, FallbackValue=''}" ToolTip.Tip="{Binding Channel.Eq.ButtonTip, FallbackValue=''}"/>
                    <Button Name="RackNoise" Content="{loc:Text Key=NoiseButton}" Classes="fx"
                            Padding="12,3" FontSize="{DynamicResource UiText.FontSize12}" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                            Classes.fxOn="{Binding Channel.Noise.IsLit, FallbackValue=False}" Classes.fxOff="{Binding Channel.Noise.IsFaulty, FallbackValue=False}"
                            IsVisible="{Binding Channel.HasNoise, FallbackValue=False}"
                            AutomationProperties.Name="{Binding Channel.Noise.ButtonName, FallbackValue=''}" ToolTip.Tip="{loc:Text Key=NoiseButtonTip}">
                      <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                          <StackPanel Classes="dev" MaxWidth="360">
                            <views:NoiseRemovalControls DataContext="{Binding Channel.Noise}"/>
                          </StackPanel>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                    <Button Name="RackDynamics" Content="{loc:Text Key=Dynamics}" Classes="fx"
                            Padding="12,3" FontSize="{DynamicResource UiText.FontSize12}" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                            Classes.fxOn="{Binding Channel.Dynamics.IsLit, FallbackValue=False}" Classes.fxOff="{Binding Channel.Dynamics.IsFaulty, FallbackValue=False}"
                            IsVisible="{Binding Channel.HasDynamics, FallbackValue=False}"
                            AutomationProperties.Name="{Binding Channel.Dynamics.ButtonName, FallbackValue=''}" ToolTip.Tip="{loc:Text Key=DynamicsButtonTip}">
                      <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                          <StackPanel Classes="dev" MaxWidth="360">
                            <views:DynamicsControls DataContext="{Binding Channel.Dynamics}"/>
                          </StackPanel>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                    <Button Content="{Binding Main.Inserts.ButtonText}" Classes="fx" Classes.fxOn="{Binding Main.Inserts.IsProcessing}" Classes.fxOff="{Binding Main.Inserts.IsOff}"
                            Padding="12,3" FontSize="{DynamicResource UiText.FontSize12}"
                            MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                            Click="OnXlrInserts" ToolTip.Tip="{loc:Text Key=PluginsProcessingXLR1BeforeItReachesThe}"/>
                  </WrapPanel>
                  <ItemsControl ItemsSource="{Binding Main.Inserts.Items}" IsVisible="{Binding Main.Inserts.HasItems}"
                                ItemTemplate="{StaticResource InsertRow}"/>
                </StackPanel>
              </StackPanel>
            </layout:StripPanel>
          </DockPanel>
        </Border>
      </DataTemplate>

      <!-- XLR 2: the same, with the second input's properties, shown on an interface with two or bound to a source -->
      <DataTemplate x:Key="xlr2" x:DataType="layout:InputStripViewModel">
        <Border Classes="tile strip" Name="InputStrip" IsVisible="{Binding Shown}" Classes.revealed="{Binding Channel.Revealed}">
          <DockPanel>
            <Button DockPanel.Dock="Top" Classes="ghost reorderHandle alongY" Classes.fixedPlace="{Binding HandleHidden}"
                    Content="↕" Tag="{Binding Channel}" HorizontalAlignment="Left" Margin="0,0,0,4"
                    AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=MoveItem}}"
                    ToolTip.Tip="{loc:Text Key=DragOntoAnotherChannelYouCanEdit}"/>
            <layout:StripPanel Spec="{Binding Spec}" Spacing="6">
              <!-- a grid, not a horizontal stack: the name gets what the icon leaves and trims, whatever the font -->
              <Grid layout:StripPanel.Part="identity" ColumnDefinitions="Auto,*" ColumnSpacing="6">
                <vm:LayoutIconBlock Icon="{Binding Channel.Appearance.Icon}" Fallback="{Binding Channel.Appearance.DefaultIcon}" Classes="strip" Classes.layoutAccent="{Binding Channel.Appearance.HasColour}"
                           IsVisible="{Binding ShowsIcon}" AutomationProperties.Name="{Binding Channel.Name}" ToolTip.Tip="{Binding Channel.Name}"/>
                <TextBlock Grid.Column="1" Text="{Binding Channel.Name}" Classes="strip" Classes.layoutAccent="{Binding Channel.Appearance.HasColour}"
                           TextTrimming="CharacterEllipsis" IsVisible="{Binding ShowsName}" ToolTip.Tip="{Binding Channel.Name}"/>
              </Grid>
              <!-- what feeds the strip, the interface's jack or another source, and why it is silent -->
              <StackPanel layout:StripPanel.Part="binding" Spacing="2">
                <views:BindingChip DataContext="{Binding Channel}" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding Channel.BindingWarning}" Classes="hint" FontSize="{DynamicResource UiText.FontSize11}" TextWrapping="Wrap"
                           IsVisible="{Binding Channel.HasBindingWarning}"/>
              </StackPanel>
              <StackPanel layout:StripPanel.Part="meter" Orientation="{Binding Spec.MeterPairOrientation}" Spacing="1">
                <skin:LevelMeter Orientation="{Binding Spec.MeterOrientation}" Level="{Binding Channel.MeterL}" AutomationProperties.Name="{Binding LeftLevelName}"/>
                <skin:LevelMeter Orientation="{Binding Spec.MeterOrientation}" Level="{Binding Channel.MeterR}" AutomationProperties.Name="{Binding RightLevelName}"/>
              </StackPanel>
              <StackPanel layout:StripPanel.Part="gain" Classes="dev" Spacing="4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding CarriesUnit}">
                  <Slider vm:FaderInput.Step="1" Minimum="0" Maximum="{Binding Main.GainMaxDb}"
                          Value="{Binding Main.Gain2Db, Mode=TwoWay}" IsEnabled="{Binding !Main.GainLocked}"
                          AutomationProperties.Name="{loc:Text Key=XLR2Gain}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Main.Gain2Text}" Classes="val" VerticalAlignment="Center"/>
                </Grid>
                <!-- an additional interface's gain, while this strip carries that interface's input -->
                <Panel IsVisible="{Binding CarriesExtraUnit}">
                  <views:WaveUnitControls Name="RackExtraGain" Part="Gain" DataContext="{Binding ExtraUnit}"/>
                </Panel>
                <!-- the channel's own volume, after the interface's gain; while the Wave XLR Pro's
                     direct path carries this channel to the jacks, a mark says it reaches the mixes only -->
                <Grid Name="RackVolume" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" IsVisible="{Binding ShowsVolume}">
                  <Slider vm:FaderInput.Step="0.01" Minimum="0" Maximum="1" Value="{Binding Channel.Volume, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=ChannelVolumeName}}"
                          ToolTip.Tip="{Binding Channel.VolumeTip}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Channel.VolumeText}" Classes="val" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Name="RackVolumeNote" Text="&#x24D8;" Classes="h" FontSize="{DynamicResource UiText.FontSize12}" VerticalAlignment="Center"
                             Cursor="Help" IsVisible="{Binding Channel.DirectMonitored}" ToolTip.Tip="{Binding Channel.VolumeTip}"
                             AutomationProperties.Name="{loc:Text Key=ChannelVolumeMixesOnly}"/>
                </Grid>
              </StackPanel>
              <StackPanel layout:StripPanel.Part="hardware-controls" Classes="dev" Spacing="4">
                <StackPanel Spacing="4" IsVisible="{Binding CarriesUnit}">
                  <WrapPanel Name="RackInput2Controls" ItemSpacing="6" LineSpacing="4">
                    <ToggleButton Content="{Binding Main.Mute2Label}" Classes="mute" IsChecked="{Binding Main.Mute2, Mode=TwoWay}"
                                  IsEnabled="{Binding !Main.PhantomSettling2}"
                                  ToolTip.Tip="{loc:Text Key=TheDeviceMutesThisInputForAbout13}"/>
                    <ToggleButton Content="{loc:Text Key=LowCut}" IsChecked="{Binding Main.LowCut2, Mode=TwoWay}"/>
                    <ToggleButton Content="{loc:Text Key=Expander}" IsChecked="{Binding Main.Expander2, Mode=TwoWay}"/>
                    <ToggleButton Content="{loc:Text Key=VoiceTune}" IsChecked="{Binding Main.VoiceTune2, Mode=TwoWay}"/>
                    <ToggleButton Content="{loc:Text Key=Phantom}" IsChecked="{Binding Main.Phantom2, Mode=TwoWay}"/>
                    <ToggleButton Content="{loc:Text Key=ClipGuard}" IsChecked="{Binding Main.ClipGuard2, Mode=TwoWay}"/>
                    <ToggleButton Content="{loc:Text Key=Compressor}" IsChecked="{Binding Main.Compressor2, Mode=TwoWay}"/>
                  </WrapPanel>
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" IsVisible="{Binding Main.VoiceTune2}">
                    <TextBlock Text="{loc:Text Key=VTStrength}" Classes="h" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" vm:FaderInput.Step="1" Minimum="0" Maximum="100"
                            Value="{Binding Main.VoiceTuneStrength2, Mode=TwoWay}" AutomationProperties.Name="{loc:Text Key=VTStrength}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Main.VoiceTuneStrength2Text}" Classes="val" VerticalAlignment="Center"/>
                  </Grid>
                </StackPanel>
                <!-- an additional interface's switches, while this strip carries that interface's input -->
                <Panel IsVisible="{Binding CarriesExtraUnit}">
                  <views:WaveUnitControls Name="RackExtraSwitches" Part="Switches" DataContext="{Binding ExtraUnit}"/>
                </Panel>
              </StackPanel>
              <StackPanel layout:StripPanel.Part="effects" Spacing="4">
                <StackPanel Spacing="4" IsVisible="{Binding Main.HasMixer}">
                  <!-- the microphone's EQ and noise removal, then its plugin chain -->
                  <WrapPanel Name="RackEffects" ItemSpacing="6" LineSpacing="4">
                    <Button Name="RackEq" Content="{loc:Text Key=Eq}" Classes="fx" Classes.fxOn="{Binding Channel.Eq.IsLit, FallbackValue=False}"
                            Classes.fxOff="{Binding Channel.Eq.IsFaulty, FallbackValue=False}"
                            Padding="12,3" FontSize="{DynamicResource UiText.FontSize12}" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                            IsVisible="{Binding Channel.HasEq}" Click="OnEq"
                            AutomationProperties.Name="{Binding Channel.Eq.ButtonName, FallbackValue=''}" ToolTip.Tip="{Binding Channel.Eq.ButtonTip, FallbackValue=''}"/>
                    <Button Name="RackNoise" Content="{loc:Text Key=NoiseButton}" Classes="fx"
                            Padding="12,3" FontSize="{DynamicResource UiText.FontSize12}" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                            Classes.fxOn="{Binding Channel.Noise.IsLit, FallbackValue=False}" Classes.fxOff="{Binding Channel.Noise.IsFaulty, FallbackValue=False}"
                            IsVisible="{Binding Channel.HasNoise, FallbackValue=False}"
                            AutomationProperties.Name="{Binding Channel.Noise.ButtonName, FallbackValue=''}" ToolTip.Tip="{loc:Text Key=NoiseButtonTip}">
                      <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                          <StackPanel Classes="dev" MaxWidth="360">
                            <views:NoiseRemovalControls DataContext="{Binding Channel.Noise}"/>
                          </StackPanel>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                    <Button Name="RackDynamics" Content="{loc:Text Key=Dynamics}" Classes="fx"
                            Padding="12,3" FontSize="{DynamicResource UiText.FontSize12}" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                            Classes.fxOn="{Binding Channel.Dynamics.IsLit, FallbackValue=False}" Classes.fxOff="{Binding Channel.Dynamics.IsFaulty, FallbackValue=False}"
                            IsVisible="{Binding Channel.HasDynamics, FallbackValue=False}"
                            AutomationProperties.Name="{Binding Channel.Dynamics.ButtonName, FallbackValue=''}" ToolTip.Tip="{loc:Text Key=DynamicsButtonTip}">
                      <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                          <StackPanel Classes="dev" MaxWidth="360">
                            <views:DynamicsControls DataContext="{Binding Channel.Dynamics}"/>
                          </StackPanel>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                    <Button Content="{Binding Main.Inserts2.ButtonText}" Classes="fx" Classes.fxOn="{Binding Main.Inserts2.IsProcessing}" Classes.fxOff="{Binding Main.Inserts2.IsOff}"
                            Padding="12,3" FontSize="{DynamicResource UiText.FontSize12}"
                            MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                            Click="OnXlrInserts" ToolTip.Tip="{loc:Text Key=PluginsProcessingXLR2BeforeItReachesThe}"/>
                  </WrapPanel>
                  <ItemsControl ItemsSource="{Binding Main.Inserts2.Items}" IsVisible="{Binding Main.Inserts2.HasItems}"
                                ItemTemplate="{StaticResource InsertRow}"/>
                </StackPanel>
              </StackPanel>
            </layout:StripPanel>
          </DockPanel>
        </Border>
      </DataTemplate>

      <!-- Aux In: the USB Aux level and its lock, where the interface has the stage -->
      <DataTemplate x:Key="aux" x:DataType="layout:InputStripViewModel">
        <Border Classes="tile strip" Name="InputStrip" IsVisible="{Binding Shown}" Classes.revealed="{Binding Channel.Revealed}">
          <DockPanel>
            <Button DockPanel.Dock="Top" Classes="ghost reorderHandle alongY" Classes.fixedPlace="{Binding HandleHidden}"
                    Content="↕" Tag="{Binding Channel}" HorizontalAlignment="Left" Margin="0,0,0,4"
                    AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=MoveItem}}"
                    ToolTip.Tip="{loc:Text Key=DragOntoAnotherChannelYouCanEdit}"/>
            <layout:StripPanel Spec="{Binding Spec}" Spacing="6">
              <!-- a grid, not a horizontal stack: the name gets what the icon leaves and trims, whatever the font -->
              <Grid layout:StripPanel.Part="identity" ColumnDefinitions="Auto,*" ColumnSpacing="6">
                <vm:LayoutIconBlock Icon="{Binding Channel.Appearance.Icon}" Fallback="{Binding Channel.Appearance.DefaultIcon}" Classes="strip" Classes.layoutAccent="{Binding Channel.Appearance.HasColour}"
                           IsVisible="{Binding ShowsIcon}" AutomationProperties.Name="{Binding Channel.Name}" ToolTip.Tip="{Binding Channel.Name}"/>
                <TextBlock Grid.Column="1" Text="{Binding Channel.Name}" Classes="strip" Classes.layoutAccent="{Binding Channel.Appearance.HasColour}"
                           TextTrimming="CharacterEllipsis" IsVisible="{Binding ShowsName}" ToolTip.Tip="{Binding Channel.Name}"/>
              </Grid>
              <StackPanel layout:StripPanel.Part="meter" Orientation="{Binding Spec.MeterPairOrientation}" Spacing="1">
                <skin:LevelMeter Orientation="{Binding Spec.MeterOrientation}" Level="{Binding Channel.MeterL}" AutomationProperties.Name="{Binding LeftLevelName}"/>
                <skin:LevelMeter Orientation="{Binding Spec.MeterOrientation}" Level="{Binding Channel.MeterR}" AutomationProperties.Name="{Binding RightLevelName}"/>
              </StackPanel>
              <StackPanel layout:StripPanel.Part="gain" Classes="dev" Spacing="4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding Main.CapAuxInput}">
                  <Slider vm:FaderInput.Step="1" Minimum="-60" Maximum="0" Value="{Binding Main.AuxLevelDb, Mode=TwoWay}"
                          AutomationProperties.Name="{loc:Text Key=USBAuxIn}"/>
                  <!-- the level, or the channel's volume while its fader moves and for a second after -->
                  <TextBlock Grid.Column="1" Name="RackGainReadout" Text="{Binding Channel.Readout}" Classes="val" VerticalAlignment="Center"
                             AutomationProperties.Name="{Binding Channel.ReadoutName}" ToolTip.Tip="{Binding Channel.ReadoutName}"/>
                </Grid>
                <!-- the channel's own volume, after the Aux In level -->
                <Grid Name="RackVolume" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" IsVisible="{Binding ShowsVolume}">
                  <Slider vm:FaderInput.Step="0.01" Minimum="0" Maximum="1" Value="{Binding Channel.Volume, Mode=TwoWay}"
                          vm:FaderInput.IsAdjusting="{Binding Channel.VolumeAdjusting, Mode=OneWayToSource}"
                          AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=ChannelVolumeName}}"
                          ToolTip.Tip="{Binding Channel.VolumeTip}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Channel.VolumeText}" Classes="val" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Name="RackVolumeNote" Text="&#x24D8;" Classes="h" FontSize="{DynamicResource UiText.FontSize12}" VerticalAlignment="Center"
                             Cursor="Help" IsVisible="{Binding Channel.DirectMonitored}" ToolTip.Tip="{Binding Channel.VolumeTip}"
                             AutomationProperties.Name="{loc:Text Key=ChannelVolumeMixesOnly}"/>
                </Grid>
              </StackPanel>
              <StackPanel layout:StripPanel.Part="hardware-controls" Classes="dev" IsVisible="{Binding Main.CapAuxInput}">
                <ToggleButton Content="{loc:Text Key=LevelLock}" IsChecked="{Binding Main.AuxLevelLock, Mode=TwoWay}" HorizontalAlignment="Left"/>
              </StackPanel>
            </layout:StripPanel>
          </DockPanel>
        </Border>
      </DataTemplate>

      <!-- Line In: the Wave XLR Pro's analog Line In, its gain and its level lock, where the interface has the input -->
      <DataTemplate x:Key="line" x:DataType="layout:InputStripViewModel">
        <Border Classes="tile strip" Name="InputStrip" IsVisible="{Binding Shown}" Classes.revealed="{Binding Channel.Revealed}">
          <DockPanel>
            <Button DockPanel.Dock="Top" Classes="ghost reorderHandle alongY" Classes.fixedPlace="{Binding HandleHidden}"
                    Content="↕" Tag="{Binding Channel}" HorizontalAlignment="Left" Margin="0,0,0,4"
                    AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=MoveItem}}"
                    ToolTip.Tip="{loc:Text Key=DragOntoAnotherChannelYouCanEdit}"/>
            <layout:StripPanel Spec="{Binding Spec}" Spacing="6">
              <!-- a grid, not a horizontal stack: the name gets what the icon leaves and trims, whatever the font -->
              <Grid layout:StripPanel.Part="identity" ColumnDefinitions="Auto,*" ColumnSpacing="6">
                <vm:LayoutIconBlock Icon="{Binding Channel.Appearance.Icon}" Fallback="{Binding Channel.Appearance.DefaultIcon}" Classes="strip" Classes.layoutAccent="{Binding Channel.Appearance.HasColour}"
                           IsVisible="{Binding ShowsIcon}" AutomationProperties.Name="{Binding Channel.Name}" ToolTip.Tip="{Binding Channel.Name}"/>
                <TextBlock Grid.Column="1" Text="{Binding Channel.Name}" Classes="strip" Classes.layoutAccent="{Binding Channel.Appearance.HasColour}"
                           TextTrimming="CharacterEllipsis" IsVisible="{Binding ShowsName}" ToolTip.Tip="{Binding Channel.Name}"/>
              </Grid>
              <StackPanel layout:StripPanel.Part="meter" Orientation="{Binding Spec.MeterPairOrientation}" Spacing="1">
                <skin:LevelMeter Orientation="{Binding Spec.MeterOrientation}" Level="{Binding Channel.MeterL}" AutomationProperties.Name="{Binding LeftLevelName}"/>
                <skin:LevelMeter Orientation="{Binding Spec.MeterOrientation}" Level="{Binding Channel.MeterR}" AutomationProperties.Name="{Binding RightLevelName}"/>
              </StackPanel>
              <StackPanel layout:StripPanel.Part="gain" Classes="dev" Spacing="4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding Main.CapLineInput}">
                  <Slider vm:FaderInput.Step="1" Minimum="0" Maximum="{Binding Main.LineInGainMaxDb}" Value="{Binding Main.LineInGainSliderDb, Mode=TwoWay}"
                          AutomationProperties.Name="{loc:Text Key=LineInGain}"/>
                  <!-- the gain, or the channel's volume while its fader moves and for a second after -->
                  <TextBlock Grid.Column="1" Name="RackGainReadout" Text="{Binding Channel.Readout}" Classes="val" VerticalAlignment="Center"
                             AutomationProperties.Name="{Binding Channel.ReadoutName}" ToolTip.Tip="{Binding Channel.ReadoutName}"/>
                </Grid>
                <!-- the channel's own volume, after the Line In gain -->
                <Grid Name="RackVolume" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" IsVisible="{Binding ShowsVolume}">
                  <Slider vm:FaderInput.Step="0.01" Minimum="0" Maximum="1" Value="{Binding Channel.Volume, Mode=TwoWay}"
                          vm:FaderInput.IsAdjusting="{Binding Channel.VolumeAdjusting, Mode=OneWayToSource}"
                          AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=ChannelVolumeName}}"
                          ToolTip.Tip="{Binding Channel.VolumeTip}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Channel.VolumeText}" Classes="val" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Name="RackVolumeNote" Text="&#x24D8;" Classes="h" FontSize="{DynamicResource UiText.FontSize12}" VerticalAlignment="Center"
                             Cursor="Help" IsVisible="{Binding Channel.DirectMonitored}" ToolTip.Tip="{Binding Channel.VolumeTip}"
                             AutomationProperties.Name="{loc:Text Key=ChannelVolumeMixesOnly}"/>
                </Grid>
              </StackPanel>
              <StackPanel layout:StripPanel.Part="hardware-controls" Classes="dev" IsVisible="{Binding Main.CapLineInput}">
                <ToggleButton Name="RackLineInLock" Content="{loc:Text Key=LevelLock}" IsChecked="{Binding Main.LineInLevelLock, Mode=TwoWay}" HorizontalAlignment="Left"/>
              </StackPanel>
            </layout:StripPanel>
          </DockPanel>
        </Border>
      </DataTemplate>

      <!-- an application or capture channel: its name, its meter and its own volume, and
           the interface's gain and switches on a capture channel that carries its microphone -->
      <DataTemplate x:Key="channel" x:DataType="layout:InputStripViewModel">
        <Border Classes="tile strip" Name="InputStrip" IsVisible="{Binding Shown}" Classes.revealed="{Binding Channel.Revealed}">
          <DockPanel>
            <Button DockPanel.Dock="Top" Classes="ghost reorderHandle alongY" Classes.fixedPlace="{Binding HandleHidden}"
                    Content="↕" Tag="{Binding Channel}" HorizontalAlignment="Left" Margin="0,0,0,4"
                    AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=MoveItem}}"
                    ToolTip.Tip="{loc:Text Key=DragOntoAnotherChannelYouCanEdit}"/>
            <layout:StripPanel Spec="{Binding Spec}" Spacing="6">
              <StackPanel layout:StripPanel.Part="identity" Spacing="2">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                  <vm:LayoutIconBlock Icon="{Binding Channel.Appearance.Icon}" Fallback="{Binding Channel.Appearance.DefaultIcon}" Classes="strip" Classes.layoutAccent="{Binding Channel.Appearance.HasColour}"
                             IsVisible="{Binding ShowsIcon}" AutomationProperties.Name="{Binding Channel.Name}" ToolTip.Tip="{Binding Channel.Name}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Channel.Name}" Classes="strip" Classes.layoutAccent="{Binding Channel.Appearance.HasColour}"
                             TextTrimming="CharacterEllipsis" IsVisible="{Binding ShowsName}" ToolTip.Tip="{Binding Channel.Name}"/>
                </Grid>
                <!-- the connection line, while the skin leaves the source chip out -->
                <TextBlock Text="{Binding Channel.CaptureLabel}" Classes="h" FontSize="{DynamicResource UiText.FontSize11}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding ShowsCaptureLabel}"/>
              </StackPanel>
              <StackPanel layout:StripPanel.Part="binding" Spacing="2">
                <views:CaptureSourceChip DataContext="{Binding Channel}" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding Channel.BindingWarning}" Classes="hint" FontSize="{DynamicResource UiText.FontSize11}"
                           TextWrapping="Wrap" IsVisible="{Binding Channel.HasBindingWarning}"/>
              </StackPanel>
              <StackPanel layout:StripPanel.Part="meter" Orientation="{Binding Spec.MeterPairOrientation}" Spacing="1">
                <skin:LevelMeter Orientation="{Binding Spec.MeterOrientation}" Level="{Binding Channel.MeterL}" AutomationProperties.Name="{Binding LeftLevelName}"/>
                <skin:LevelMeter Orientation="{Binding Spec.MeterOrientation}" Level="{Binding Channel.MeterR}" Classes.monoSpare="{Binding Channel.MonoMeter}" AutomationProperties.Name="{Binding RightLevelName}"/>
              </StackPanel>
              <StackPanel layout:StripPanel.Part="gain" Classes="dev" Spacing="4">
                <!-- the interface's gain, while this capture channel carries its microphone -->
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" IsVisible="{Binding CarriesUnit}">
                  <Slider Name="RackUnitGain" vm:FaderInput.Step="1" Minimum="0" Maximum="{Binding Unit.GainMaxDb, FallbackValue=80}"
                          Value="{Binding Unit.GainDb, Mode=TwoWay}" IsEnabled="{Binding !Unit.GainLocked, FallbackValue=False}"
                          AutomationProperties.Name="{Binding Unit.GainName}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Unit.GainText}" Classes="val" VerticalAlignment="Center"/>
                  <ToggleButton Grid.Column="2" Content="{loc:Text Key=Lock}" Classes="mute" FontSize="{DynamicResource UiText.FontSize11}" Padding="8,2"
                                MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}" IsVisible="{Binding Unit.ShowGainLock, FallbackValue=False}"
                                IsChecked="{Binding Main.GainLocked, Mode=TwoWay}" VerticalAlignment="Center"
                                ToolTip.Tip="{loc:Text Key=GainLockTheDaemonRejectsEveryGainChange}"/>
                </Grid>
                <!-- an additional interface's gain, while this strip carries that interface's input -->
                <Panel IsVisible="{Binding CarriesExtraUnit}">
                  <views:WaveUnitControls Name="RackExtraGain" Part="Gain" DataContext="{Binding ExtraUnit}"/>
                </Panel>
                <!-- a capture input's own gain, its source's volume, on a source OpenXLR does not drive; the
                     range before the value, so the slider never clamps the gain to a range it is about to leave -->
                <Grid Name="RackCaptureGain" ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding ShowsCaptureGain}">
                  <Slider vm:FaderInput.Step="1" Minimum="{Binding Channel.CaptureGainMinDb}" Maximum="{Binding Channel.CaptureGainMaxDb}"
                          Value="{Binding Channel.CaptureGainDb, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding Channel.CaptureGainName}" ToolTip.Tip="{Binding Channel.CaptureGainTip}"/>
                  <!-- the gain, or the channel's volume while its fader moves and for a second after -->
                  <TextBlock Grid.Column="1" Name="RackGainReadout" Text="{Binding Channel.Readout}" Classes="val" VerticalAlignment="Center"
                             AutomationProperties.Name="{Binding Channel.ReadoutName}" ToolTip.Tip="{Binding Channel.ReadoutName}"/>
                </Grid>
                <!-- the channel's own volume, after the interface's gain; while the Wave XLR Pro's
                     direct path carries this channel to the jacks, a mark says it reaches the mixes only -->
                <Grid Name="RackVolume" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" IsVisible="{Binding ShowsVolume}">
                  <Slider vm:FaderInput.Step="0.01" Minimum="0" Maximum="1" Value="{Binding Channel.Volume, Mode=TwoWay}"
                          vm:FaderInput.IsAdjusting="{Binding Channel.VolumeAdjusting, Mode=OneWayToSource}"
                          AutomationProperties.Name="{Binding Channel.Name, StringFormat={loc:Text Key=ChannelVolumeName}}"
                          ToolTip.Tip="{Binding Channel.VolumeTip}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Channel.VolumeText}" Classes="val" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Name="RackVolumeNote" Text="&#x24D8;" Classes="h" FontSize="{DynamicResource UiText.FontSize12}" VerticalAlignment="Center"
                             Cursor="Help" IsVisible="{Binding Channel.DirectMonitored}" ToolTip.Tip="{Binding Channel.VolumeTip}"
                             AutomationProperties.Name="{loc:Text Key=ChannelVolumeMixesOnly}"/>
                </Grid>
              </StackPanel>
              <!-- the interface's switches, while this capture channel carries its microphone -->
              <StackPanel layout:StripPanel.Part="hardware-controls" Classes="dev" Spacing="4">
                <StackPanel Spacing="4" IsVisible="{Binding CarriesUnit}">
                  <WrapPanel Name="RackUnitControls" ItemSpacing="6" LineSpacing="4">
                    <ToggleButton Content="{Binding Unit.MuteLabel}" Classes="mute" IsChecked="{Binding Unit.Mute, Mode=TwoWay}"
                                  IsEnabled="{Binding !Unit.PhantomSettling, FallbackValue=False}"
                                  ToolTip.Tip="{loc:Text Key=TheDeviceMutesThisInputForAbout13}"/>
                    <ToggleButton Content="{loc:Text Key=LowCut}" IsChecked="{Binding Unit.LowCut, Mode=TwoWay}" IsVisible="{Binding Unit.CapLowCut, FallbackValue=False}"/>
                    <ToggleButton Content="{loc:Text Key=Expander}" IsChecked="{Binding Unit.Expander, Mode=TwoWay}" IsVisible="{Binding Unit.CapExpander, FallbackValue=False}"/>
                    <ToggleButton Content="{loc:Text Key=VoiceTune}" IsChecked="{Binding Unit.VoiceTune, Mode=TwoWay}" IsVisible="{Binding Unit.CapVoiceTune, FallbackValue=False}"/>
                    <ToggleButton Content="{loc:Text Key=Phantom}" IsChecked="{Binding Unit.Phantom, Mode=TwoWay}" IsVisible="{Binding Unit.CapPhantom, FallbackValue=False}"/>
                    <ToggleButton Content="{loc:Text Key=ClipGuard}" IsChecked="{Binding Unit.ClipGuard, Mode=TwoWay}" IsVisible="{Binding Unit.CapClipGuard, FallbackValue=False}"/>
                    <ToggleButton Content="{loc:Text Key=Compressor}" IsChecked="{Binding Unit.Compressor, Mode=TwoWay}" IsVisible="{Binding Unit.CapCompressor, FallbackValue=False}"/>
                  </WrapPanel>
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" IsVisible="{Binding Unit.VoiceTune, FallbackValue=False}">
                    <TextBlock Text="{loc:Text Key=VTStrength}" Classes="h" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" vm:FaderInput.Step="1" Minimum="0" Maximum="100"
                            Value="{Binding Unit.VoiceTuneStrength, Mode=TwoWay}" AutomationProperties.Name="{loc:Text Key=VTStrength}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Unit.VoiceTuneStrengthText}" Classes="val" VerticalAlignment="Center"/>
                  </Grid>
                </StackPanel>
                <!-- an additional interface's switches, while this strip carries that interface's input -->
                <Panel IsVisible="{Binding CarriesExtraUnit}">
                  <views:WaveUnitControls Name="RackExtraSwitches" Part="Switches" DataContext="{Binding ExtraUnit}"/>
                </Panel>
              </StackPanel>
              <!-- the microphone's EQ and noise removal, on a capture input the daemon reports them for, then its plugin chain -->
              <StackPanel layout:StripPanel.Part="effects" Name="RackCaptureEffects" Spacing="4">
                <WrapPanel Name="RackCaptureFx" ItemSpacing="6" LineSpacing="4">
                  <Button Name="RackEq" Content="{loc:Text Key=Eq}" Classes="fx" Classes.fxOn="{Binding Channel.Eq.IsLit, FallbackValue=False}"
                          Classes.fxOff="{Binding Channel.Eq.IsFaulty, FallbackValue=False}"
                          Padding="12,3" FontSize="{DynamicResource UiText.FontSize12}" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                          IsVisible="{Binding Channel.HasEq}" Click="OnEq"
                          AutomationProperties.Name="{Binding Channel.Eq.ButtonName, FallbackValue=''}" ToolTip.Tip="{Binding Channel.Eq.ButtonTip, FallbackValue=''}"/>
                  <Button Name="RackNoise" Content="{loc:Text Key=NoiseButton}" Classes="fx"
                          Padding="12,3" FontSize="{DynamicResource UiText.FontSize12}" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                          Classes.fxOn="{Binding Channel.Noise.IsLit, FallbackValue=False}" Classes.fxOff="{Binding Channel.Noise.IsFaulty, FallbackValue=False}"
                          IsVisible="{Binding Channel.HasNoise, FallbackValue=False}"
                          AutomationProperties.Name="{Binding Channel.Noise.ButtonName, FallbackValue=''}" ToolTip.Tip="{loc:Text Key=NoiseButtonTip}">
                    <Button.Flyout>
                      <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel Classes="dev" MaxWidth="360">
                          <views:NoiseRemovalControls DataContext="{Binding Channel.Noise}"/>
                        </StackPanel>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                  <Button Name="RackDynamics" Content="{loc:Text Key=Dynamics}" Classes="fx"
                          Padding="12,3" FontSize="{DynamicResource UiText.FontSize12}" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                          Classes.fxOn="{Binding Channel.Dynamics.IsLit, FallbackValue=False}" Classes.fxOff="{Binding Channel.Dynamics.IsFaulty, FallbackValue=False}"
                          IsVisible="{Binding Channel.HasDynamics, FallbackValue=False}"
                          AutomationProperties.Name="{Binding Channel.Dynamics.ButtonName, FallbackValue=''}" ToolTip.Tip="{loc:Text Key=DynamicsButtonTip}">
                    <Button.Flyout>
                      <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel Classes="dev" MaxWidth="360">
                          <views:DynamicsControls DataContext="{Binding Channel.Dynamics}"/>
                        </StackPanel>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </WrapPanel>
                <views:CaptureInsertsView DataContext="{Binding Channel}"/>
              </StackPanel>
            </layout:StripPanel>
          </DockPanel>
        </Border>
      </DataTemplate>
    </layout:StripTemplateSelector>
  </UserControl.Resources>

  <ItemsControl Name="RackStrips" ItemsSource="{Binding Strips}" ItemTemplate="{StaticResource InputRows}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
  </ItemsControl>
</UserControl>
