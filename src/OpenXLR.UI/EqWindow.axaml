<Window xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:OpenXLR.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenXLR.UI"
        x:Class="OpenXLR.UI.EqWindow" x:DataType="vm:MicEqViewModel"
        Title="{Binding Title}" Width="820" Height="600" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Ox.Window.Background}">
  <!-- A microphone's EQ: the switch, the comparison and the clipboard across the
       top, the saved profiles, the response graph, a row of fields per band and what runs it.
       Every colour, size and radius is an Ox.* token; the graph reads its
       colours as the skin service's live brushes. -->
  <Window.Styles>
    <!-- A narrow editor keeps the values whole: the number fields drop their spin buttons
         and still step with the arrow keys and the wheel. -->
    <Style Selector="Window.narrow NumericUpDown">
      <Setter Property="ShowButtonSpinner" Value="False"/>
    </Style>
  </Window.Styles>
  <Grid Margin="12" RowDefinitions="Auto,Auto,*,*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,8">
      <TextBlock Text="{Binding Title}" Classes="h" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <!-- the unit's own DSP runs this EQ -->
      <Border Grid.Column="1" Name="EqHardwareBadge" IsVisible="{Binding OnDevice}" VerticalAlignment="Center"
              Background="{DynamicResource Ox.Badge.Background}" CornerRadius="{DynamicResource Ox.Eq.CornerRadius}" Padding="8,2"
              ToolTip.Tip="{Binding DeviceBadgeTip}" AutomationProperties.Name="{Binding DeviceBadgeTip}">
        <TextBlock Text="{loc:Text Key=EqHardwareBadge}" Foreground="{DynamicResource Ox.Text.Info}"
                   FontSize="{DynamicResource Ox.Eq.LabelFontSize}" FontWeight="{DynamicResource Ox.Label.FontWeight}"/>
      </Border>
      <WrapPanel Grid.Column="2" Name="EqActions" ItemSpacing="6" LineSpacing="4" HorizontalAlignment="Right">
        <ToggleButton Name="EqSwitch" Content="{loc:Text Key=EqSwitch}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                      AutomationProperties.Name="{Binding ButtonName}" ToolTip.Tip="{loc:Text Key=EqSwitchTip}"/>
        <ToggleButton Name="EqCompare" Content="{loc:Text Key=EqCompare}" IsChecked="{Binding Comparing, Mode=TwoWay}"
                      IsEnabled="{Binding Enabled}" ToolTip.Tip="{loc:Text Key=EqCompareTip}"/>
        <Button Name="EqCopy" Content="{loc:Text Key=EqCopy}" Click="OnCopy" ToolTip.Tip="{loc:Text Key=EqCopyTip}"/>
        <Button Name="EqPaste" Content="{loc:Text Key=EqPaste}" Click="OnPaste" IsEnabled="{Binding CanPaste}"
                ToolTip.Tip="{loc:Text Key=EqPasteTip}"/>
        <Button Name="EqReset" Content="{loc:Text Key=EqReset}" Click="OnReset" ToolTip.Tip="{loc:Text Key=EqResetTip}"/>
      </WrapPanel>
    </Grid>

    <!-- The footer: where the EQ runs while the microphone is on a unit that can
         run it, why the unit does not, and what runs it now. -->
    <!-- EQ profiles: the built-in ones first, marked as built in, then the saved ones,
         each a set of bands to load on any microphone. Picking one loads it, and the list
         shows the profile the EQ holds. The row has its own model, set by the window, over
         the daemon's list that every editor shares. -->
    <StackPanel Grid.Row="1" Name="EqProfileRow" x:DataType="vm:EqProfilesViewModel" Margin="0,0,0,8" Spacing="4">
      <WrapPanel Name="EqProfileActions" ItemSpacing="6" LineSpacing="4">
        <TextBlock Name="EqProfileLabel" Text="{loc:Text Key=EqProfileLabel}" VerticalAlignment="Center"/>
        <ComboBox Name="EqProfileList" Width="220" ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                  PlaceholderText="{loc:Text Key=EqProfileChoose}" AutomationProperties.Name="{loc:Text Key=EqProfileListName}"
                  ToolTip.Tip="{loc:Text Key=EqProfileListTip}" VerticalAlignment="Center"/>
        <Button Name="EqProfileSave" Content="{loc:Text Key=Save}" Click="OnProfileSave" ToolTip.Tip="{loc:Text Key=EqProfileSaveTip}"/>
        <Button Name="EqProfileRename" Content="{loc:Text Key=Rename}" Click="OnProfileRename" IsEnabled="{Binding HasSavedSelection}"
                ToolTip.Tip="{loc:Text Key=EqProfileRenameTip}"/>
        <Button Name="EqProfileDelete" Content="{loc:Text Key=Delete}" Click="OnProfileDelete" IsEnabled="{Binding HasSavedSelection}"
                ToolTip.Tip="{loc:Text Key=EqProfileDeleteTip}"/>
      </WrapPanel>
      <TextBlock Name="EqProfileError" Text="{Binding Error}" IsVisible="{Binding HasError}" Classes="hint warn" TextWrapping="Wrap"/>
    </StackPanel>

    <StackPanel Grid.Row="4" Name="EqFooter">
      <WrapPanel Name="EqProcessing" IsVisible="{Binding HasProcessingChoice}" ItemSpacing="6" LineSpacing="4" Margin="0,8,0,0">
        <TextBlock Name="EqProcessingLabel" Text="{loc:Text Key=EqProcessingLabel}" VerticalAlignment="Center"/>
        <!-- two sides of one switch: the lit side is the daemon's choice, and a press asks for its side;
             a unit that cannot take the EQ lights the software side and leaves its own side off -->
        <ToggleButton Name="EqOnUnit" Content="{loc:Text Key=EqProcessingDevice}" IsChecked="{Binding ProcessOnDevice, Mode=OneWay}"
                      IsEnabled="{Binding CanProcessOnDevice}" ToolTip.ShowOnDisabled="True"
                      Click="OnProcessOnUnit" ToolTip.Tip="{Binding ProcessOnDeviceTip}"/>
        <ToggleButton Name="EqInSoftware" Content="{loc:Text Key=EqProcessingSoftware}" IsChecked="{Binding ProcessInSoftware, Mode=OneWay}"
                      Click="OnProcessInSoftware" ToolTip.Tip="{loc:Text Key=EqProcessingSoftwareTip}"/>
      </WrapPanel>
      <!-- why the unit the microphone is on does not run the EQ itself -->
      <TextBlock Name="EqDeviceNote" Text="{Binding EditorNote}" IsVisible="{Binding HasEditorNote}"
                 Classes="hint" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <!-- what runs the EQ, or why nothing does -->
      <TextBlock Name="EqStatus" Text="{Binding Status}" Classes="hint" Classes.warn="{Binding HasError}"
                 TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>

    <!-- a row of fields per band: the graph and these edit the same values -->
    <ScrollViewer Grid.Row="3" Name="EqBandScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
    <StackPanel Name="EqBands" Spacing="4" Grid.IsSharedSizeScope="True">
      <Button Name="EqAddBand" Content="{loc:Text Key=EqAddBand}" Click="OnAddBand" IsVisible="{Binding VariableBands}"
              IsEnabled="{Binding CanAddBand}" HorizontalAlignment="Left"/>
      <Grid ColumnSpacing="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28"/><ColumnDefinition Width="40"/><ColumnDefinition Width="140"/>
                <ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="EqDeleteColumn"/>
              </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="1" Text="{loc:Text Key=EqColumnOn}" Classes="hint" FontSize="{DynamicResource Ox.Ui.FontSize11}" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="2" Text="{loc:Text Key=EqColumnType}" Classes="hint" FontSize="{DynamicResource Ox.Ui.FontSize11}" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="3" Text="{loc:Text Key=EqColumnFrequency}" Classes="hint" FontSize="{DynamicResource Ox.Ui.FontSize11}" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="4" Text="{loc:Text Key=EqColumnGain}" Classes="hint" FontSize="{DynamicResource Ox.Ui.FontSize11}" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="5" Text="{loc:Text Key=EqColumnQ}" Classes="hint" FontSize="{DynamicResource Ox.Ui.FontSize11}" TextTrimming="CharacterEllipsis"/>
      </Grid>
      <ItemsControl ItemsSource="{Binding Bands}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Spacing="4"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:EqBandViewModel">
            <Grid Name="EqBandRow" ColumnSpacing="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28"/><ColumnDefinition Width="40"/><ColumnDefinition Width="140"/>
                <ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="EqDeleteColumn"/>
              </Grid.ColumnDefinitions>
              <!-- the band's number in its colour, as on its handle -->
              <Panel Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Ellipse Fill="{Binding Number, Converter={x:Static vm:Converters.EqBandColour}}"/>
                <TextBlock Text="{Binding Number}" FontWeight="Bold" FontSize="{DynamicResource Ox.Ui.FontSize12}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Ox.Eq.Background}"/>
              </Panel>
              <Button Grid.Column="6" Name="EqRemoveBand" Content="{loc:Text Key=EqRemoveBand}" Click="OnRemoveBand"
                      IsVisible="{Binding Owner.VariableBands}" IsEnabled="{Binding Owner.CanRemoveBand}"
                      AutomationProperties.Name="{Binding RemoveName}" ToolTip.Tip="{Binding RemoveName}"/>
              <CheckBox Grid.Column="1" Name="EqBandSwitch" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding SwitchName}" ToolTip.Tip="{Binding SwitchName}"/>
              <ComboBox Grid.Column="2" Name="EqBandType" ItemsSource="{x:Static vm:EqTypeChoice.All}" SelectedItem="{Binding TypeChoice, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center" AutomationProperties.Name="{Binding TypeFieldName}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:EqTypeChoice">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" ToolTip.Tip="{Binding Hint}">
                      <Path Data="{Binding Icon, Converter={x:Static vm:Converters.EqTypeIcon}}" Width="16" Height="16" Stretch="Uniform"
                            Stroke="{DynamicResource Ox.Text.Primary}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                            VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </Grid>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <NumericUpDown Grid.Column="3" Name="EqBandFrequency" Value="{Binding FrequencyValue, Mode=TwoWay}" Increment="1" FormatString="0"
                             Minimum="{Binding FrequencyMinimum}" Maximum="{Binding FrequencyMaximum}" VerticalAlignment="Center"
                             AutomationProperties.Name="{Binding FrequencyName}"/>
              <NumericUpDown Grid.Column="4" Name="EqBandGain" Value="{Binding GainValue, Mode=TwoWay}" Increment="{Binding GainIncrement}"
                             FormatString="+0.00;-0.00;0.00" Minimum="{Binding GainMinimum}" Maximum="{Binding GainMaximum}"
                             IsEnabled="{Binding UsesGain}" VerticalAlignment="Center" AutomationProperties.Name="{Binding GainName}"/>
              <NumericUpDown Grid.Column="5" Name="EqBandQ" Value="{Binding QValue, Mode=TwoWay}" Increment="0.01" FormatString="0.00"
                             Minimum="{Binding QMinimum}" Maximum="{Binding QMaximum}" VerticalAlignment="Center"
                             AutomationProperties.Name="{Binding QName}"/>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    </ScrollViewer>

    <vm:EqGraph Grid.Row="2" Name="EqGraph" MinHeight="160"
                CurveThickness="{DynamicResource Ox.Eq.CurveThickness}" BandCurveThickness="{DynamicResource Ox.Eq.BandCurveThickness}"
                HandleSize="{DynamicResource Ox.Eq.HandleSize}" LabelFontSize="{DynamicResource Ox.Eq.LabelFontSize}"
                CornerRadius="{DynamicResource Ox.Eq.CornerRadius}" MinimumTarget="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                AutomationProperties.Name="{loc:Text Key=EqGraphName}"/>
  </Grid>
</Window>
