<Window xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:OpenXLR.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenXLR.UI"
        xmlns:skin="using:OpenXLR.UI.Skinning"
        x:Class="OpenXLR.UI.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="OpenXLR" Width="1040" Height="900" MinHeight="480"
        Icon="avares://OpenXLR.UI/Assets/icon.png">

  <!-- The window's ground, its cards, its labels, its meters and its fader
       caps come from the application's Ox.* appearance tokens (App.axaml and
       Skinning/SkinTokens.cs). What is left here is this window's own layout. -->
  <Window.Styles>
    <!-- Arrange mode: a handle on each section and on each tile whose place
         can change. Hardware inputs and Monitor A/B and Aux keep their place. -->
    <Style Selector="Button.reorderHandle">
      <Setter Property="IsVisible" Value="False"/>
      <Setter Property="Padding" Value="4,1"/>
      <Setter Property="MinHeight" Value="{DynamicResource Ox.Mixer.SmallControlMinSize}"/>
      <Setter Property="MinWidth" Value="{DynamicResource Ox.Mixer.SmallControlMinSize}"/>
      <Setter Property="FontSize" Value="{DynamicResource Ox.Label.FontSize}"/>
      <Setter Property="Cursor" Value="SizeAll"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Window.arranging Button.reorderHandle">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Window.arranging Button.reorderHandle.fixedPlace">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Button.reorderTarget">
      <Setter Property="Foreground" Value="{DynamicResource Ox.Accent}"/>
      <Setter Property="Background" Value="{DynamicResource Ox.Control.BackgroundPointerOver}"/>
    </Style>
    <!-- A colour chosen for one channel or mix in the layout editor is that
         item's own data, not a skin value; without one the skin's applies. -->
    <Style Selector="TextBlock.layoutAccent">
      <Setter Property="Foreground" Value="{ReflectionBinding Appearance.Accent}"/>
    </Style>
  </Window.Styles>
  <Window.Resources>
    <ControlTheme x:Key="TileExpanderTheme" TargetType="Expander">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Template">
        <ControlTemplate>
          <DockPanel>
            <!-- ClickMode=Press: the default Release mode re-hit-tests the
                 pointer position on release through a path that misses over
                 the chevron glyph at fractional display scaling, silently
                 dropping the click; the press pipeline is reliable -->
            <ToggleButton DockPanel.Dock="Top" HorizontalAlignment="Stretch" Cursor="Hand"
                          ClickMode="Press"
                          IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Grid ColumnDefinitions="*,Auto" Background="Transparent" Margin="0,0,0,4">
                    <ContentPresenter Content="{Binding $parent[Expander].Header}"
                                      VerticalAlignment="Center"/>
                    <!-- decorative: hit-testable glyph ink makes the button's
                         release-position check flaky, eating the click -->
                    <TextBlock Grid.Column="1" Classes="h" VerticalAlignment="Center" IsHitTestVisible="False"
                               Text="{Binding $parent[Expander].IsExpanded, Converter={x:Static vm:Converters.Chevron}}"/>
                  </Grid>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              IsVisible="{TemplateBinding IsExpanded}"/>
          </DockPanel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Window.Resources>

  <Window.Styles>
    <!-- Control sizing. Every size here is a skin token, raised by Touch
         sizing; in Standard with no skin value the framework's own size
         stays. These come first, so the class styles below still win. -->
    <Style Selector="Button, ToggleButton, DropDownButton, ComboBox, ComboBoxItem, CheckBox, TextBox, Slider">
      <Setter Property="MinHeight" Value="{DynamicResource Ox.Mixer.ControlMinSize}"/>
      <Setter Property="MinWidth" Value="{DynamicResource Ox.Mixer.ControlMinSize}"/>
    </Style>
    <Style Selector="Window.large-targets Button, Window.large-targets ToggleButton, Window.large-targets DropDownButton">
      <Setter Property="MinHeight" Value="{DynamicResource Ox.Mixer.ControlMinSize}"/>
      <Setter Property="MinWidth" Value="{DynamicResource Ox.Mixer.ControlMinSize}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Slider">
      <Setter Property="MinHeight" Value="{DynamicResource Ox.Mixer.SliderMinHeight}"/>
    </Style>
    <!-- Fluent's horizontal template reserves two spacer rows around its
         track. Enlarged targets span those rows instead of being clipped. -->
    <Style Selector="Window.large-targets Slider /template/ Track#PART_Track">
      <Setter Property="Grid.Row" Value="0"/>
      <Setter Property="Grid.RowSpan" Value="3"/>
    </Style>
    <Style Selector="Slider /template/ Thumb">
      <Setter Property="MinHeight" Value="{DynamicResource Ox.Mixer.ControlMinSize}"/>
      <Setter Property="MinWidth" Value="{DynamicResource Ox.Mixer.ControlMinSize}"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="12,9"/>
    </Style>
    <!-- compact device-control rows: shorter sliders and buttons than the
         theme default so the fixed cards stay small (the submixer keeps its
         own sizing) -->
    <Style Selector="StackPanel.dev Slider">
      <Setter Property="MinHeight" Value="{DynamicResource Ox.Mixer.SmallControlMinSize}"/>
      <Setter Property="Height" Value="{DynamicResource Ox.Mixer.DeviceSliderHeight}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="StackPanel.dev ToggleButton">
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="{DynamicResource Ox.Mixer.SmallControlMinSize}"/>
    </Style>
    <!-- collapsible tiles: a flat expander whose header looks like the old card title -->
    <Style Selector="Expander.section">
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="{DynamicResource Ox.Mixer.SmallControlMinSize}"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="IsExpanded" Value="True"/>
    </Style>
    <Style Selector="ToggleButton">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="8,5"/>
    </Style>
    <!-- the small controls on an insert row: N (own process), B (bypass) and
         the cog that opens the plugin's controls. They stay narrow enough for
         the row but keep at least the skin's insert target size, so they are
         easy to hit and their letter is readable. -->
    <Style Selector="ToggleButton.insertmini">
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="MinWidth" Value="{DynamicResource Ox.Mixer.InsertControlMinSize}"/>
      <Setter Property="MinHeight" Value="{DynamicResource Ox.Mixer.InsertControlMinSize}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.insertmini">
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="MinWidth" Value="{DynamicResource Ox.Mixer.InsertControlMinSize}"/>
      <Setter Property="MinHeight" Value="{DynamicResource Ox.Mixer.InsertControlMinSize}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <!-- The cards follow the window width, so a wide window shows more strips
       and tiles before anything scrolls. Every card sizes to its content; the
       page scrolls when the window is shorter. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Name="MixerContent" Margin="16" HorizontalAlignment="Stretch">

    <!-- header -->
    <Border Classes="card" Margin="0,0,0,8">
      <Grid Name="WindowHeader" ColumnDefinitions="Auto,8,Auto,*" RowDefinitions="Auto,Auto">
        <Button Name="OptionsButton" Grid.RowSpan="2" Content="⚙" FontSize="18" Padding="8,4"
                VerticalAlignment="Center" Classes="ghost"
                Click="OnOptions" ToolTip.Tip="{loc:Text Key=Options}"/>
        <TextBlock Grid.Column="2" Text="OpenXLR" Classes="title" VerticalAlignment="Center"/>
        <Grid Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*"
              ColumnSpacing="6" Margin="0,2,0,0">
            <skin:StatusLed IsOn="{Binding DeviceConnected}"
                            AutomationProperties.Name="{loc:Text Key=InterfaceConnection}"/>
            <TextBlock Name="DeviceStatus" Grid.Column="1" Text="{Binding StatusLine}" Classes="h"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusLine}"
                       IsVisible="{Binding !HasMultipleDevices}"/>
            <DropDownButton Name="DevicePicker" Grid.Column="1" Content="{Binding ActiveDeviceName}" FontSize="11" Padding="6,1"
                            MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalAlignment="Center" HorizontalAlignment="Left" Classes="ghost"
                            IsVisible="{Binding HasMultipleDevices}"
                            ToolTip.Tip="{Binding ActiveDeviceName, StringFormat={loc:Text Key=SelectInterfaceTip}}">
              <DropDownButton.ContentTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
              </DropDownButton.ContentTemplate>
              <DropDownButton.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <ItemsControl ItemsSource="{Binding DetectedDevices}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DetectedDeviceItem">
                        <Button Content="{Binding Name}" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left" FontSize="12"
                                Classes="ghost" Click="OnPickDevice" Tag="{Binding}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Flyout>
              </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>
        <WrapPanel Name="HeaderActions" Grid.Column="3" ItemSpacing="8" LineSpacing="4" Margin="8,0,0,0"
                   HorizontalAlignment="Right" ItemsAlignment="End" VerticalAlignment="Center">
          <DropDownButton Content="{loc:Text Key=Profiles}" Padding="10,3" FontSize="12" Classes="ghost"
                          ToolTip.Tip="{loc:Text Key=SaveAndRecallCompleteScenesHardwareDSPPlus}">
            <DropDownButton.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel MinWidth="240" Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Name="ProfileNameBox" PlaceholderText="{loc:Text Key=ProfileName}" FontSize="12"/>
                    <Button Grid.Column="1" Content="{loc:Text Key=Save}" Margin="6,0,0,0" FontSize="12"
                            Click="OnProfileSave"/>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Grid ColumnDefinitions="*,Auto">
                          <Button Content="{Binding}" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left" FontSize="12"
                                  Classes="ghost" Click="OnProfileLoad"
                                  ToolTip.Tip="{loc:Text Key=LoadThisProfile}"/>
                          <Button Grid.Column="1" Content="&#x2715;" FontSize="11" Padding="6,3"
                                  Classes="ghost" Click="OnProfileDelete"
                                  Tag="{Binding}" ToolTip.Tip="{loc:Text Key=DeleteThisProfile}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{loc:Text Key=NoProfilesSavedYet}" Classes="h" FontSize="11"
                             IsVisible="{Binding !Profiles.Count}"/>
                  <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0" IsVisible="{Binding !!Profiles.Count}"
                        ToolTip.Tip="{loc:Text Key=RecalledWhenTheInterfaceConnectsDaemonStartA}">
                    <TextBlock Text="{loc:Text Key=OnConnect}" Classes="h" FontSize="11" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" Margin="8,0,0,0" FontSize="12" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding RecallChoices}"
                              SelectedItem="{Binding RecallOnConnectChoice}"/>
                  </Grid>
                </StackPanel>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>
          <Button Content="{loc:Text Key=Flow}" Padding="10,3" FontSize="12" Classes="ghost"
                  Click="OnFlow" ToolTip.Tip="{loc:Text Key=ShowTheLiveAudioRoutingGraph}"/>
          <Button Content="{loc:Text Key=RestartDaemon}" Padding="10,3" FontSize="12" Classes="ghost"
                  IsEnabled="{Binding DaemonRestart.CanRestart}" Click="OnRestartDaemon"
                  ToolTip.Tip="{loc:Text Key=RestartTheOpenXLRUserServiceAudioWillBe}"/>
          <TextBlock Name="HeaderVersion" Text="v0.0.0" Classes="h" VerticalAlignment="Center"/>
          <Button Content="{loc:Text Key=DesktopKeys}" Padding="10,3" FontSize="{DynamicResource Ox.Label.FontSize}" Classes="ghost" Click="OnDesktopKeys"/>
          <Button Content="{loc:Text Key=About}" Padding="10,3" FontSize="12" Classes="ghost"
                  Click="OnAbout"/>
        </WrapPanel>
      </Grid>
    </Border>

    <TextBlock Text="{Binding DaemonRestart.Status}" Classes="h" TextWrapping="Wrap"
               Margin="0,0,0,8" IsVisible="{Binding DaemonRestart.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    <TextBlock Text="{Binding DaemonWarning}" Classes="alert" TextWrapping="Wrap" FontSize="12"
               Margin="0,0,0,8" IsVisible="{Binding DaemonWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

    <Border Classes="card" Margin="0,0,0,8" IsVisible="{Binding Updates.BannerVisible}">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="{Binding Updates.Title}" Classes="info"
                   TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="{loc:Text Key=ViewChanges}" Click="OnUpdates"/>
        <Button Grid.Column="2" Content="{loc:Text Key=Dismiss}" Click="OnDismissUpdate" Classes="ghost"/>
      </Grid>
    </Border>

    <!-- a daemon left running across an upgrade offers the old version's controls -->
    <Border Classes="card" Margin="0,0,0,8" IsVisible="{Binding DaemonVersionMismatch}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{loc:Text Key=RestartDaemon}" Padding="10,3" FontSize="12"
                IsEnabled="{Binding DaemonRestart.CanRestart}"
                VerticalAlignment="Center" Click="OnRestartDaemon"
                ToolTip.Tip="systemctl --user restart openxlr-daemon"/>
        <TextBlock Text="{Binding DaemonVersionNote}" Classes="h" TextWrapping="Wrap"
                   VerticalAlignment="Center" Margin="0,0,12,0"/>
      </DockPanel>
    </Border>

    <WrapPanel Margin="0,0,0,8">
      <ToggleButton Name="ArrangeButton" Content="{loc:Text Key=Arrange}" Click="OnArrange" Padding="8,1" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                    IsVisible="{Binding !IsMiniView}"
                    FontSize="{DynamicResource Ox.Label.FontSize}"
                    ToolTip.Tip="{loc:Text Key=ShowHandlesToMoveSectionsChannelsAnd}"/>
      <Button Name="ResetSectionsButton" Content="{loc:Text Key=ResetSections}" Click="OnResetSections" Padding="8,1" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}"
              IsVisible="False" Margin="8,0,0,0" FontSize="{DynamicResource Ox.Label.FontSize}"
              ToolTip.Tip="{loc:Text Key=PutTheFiveSectionsBackInTheir}"/>
    </WrapPanel>
    <TextBlock Name="ArrangementNote" Classes="note" TextWrapping="Wrap" IsVisible="False" Margin="0,0,0,8"
               Text="{loc:Text Key=DragAHandleOntoAnotherSectionOr}"/>

    <!-- the five sections, in the order saved in ui.json -->
    <StackPanel Name="SectionCards" Spacing="8">
    <!-- device controls -->
    <Border Classes="card" IsVisible="{Binding ShowDetailedSections}">
      <Expander Name="InputsTile" Classes="section" Theme="{StaticResource TileExpanderTheme}" IsExpanded="True">
        <Expander.Header><StackPanel Orientation="Horizontal" Spacing="6">
          <Button Classes="ghost reorderHandle" Content="↕" Tag="InputsTile" AutomationProperties.Name="{loc:Text Key=MoveInputs}"
          ToolTip.Tip="{loc:Text Key=DragToAnotherSectionArrowKeysMove}"/>
          <TextBlock Text="{loc:Text Key=INPUTS}" Classes="h" VerticalAlignment="Center"/>
        </StackPanel></Expander.Header>
      <StackPanel Classes="dev" Spacing="4">

        <!-- XLR 1 -->
        <Grid ColumnDefinitions="90,*,64,Auto">
          <TextBlock Text="{loc:Text Key=XLR1Gain}" Classes="h" VerticalAlignment="Center"/>
          <Slider Grid.Column="1" Minimum="0" Maximum="80" TickFrequency="1" IsSnapToTickEnabled="True"
                  Value="{Binding GainDb, Mode=TwoWay}" IsEnabled="{Binding !GainLocked}"/>
          <TextBlock Grid.Column="2" Text="{Binding GainText}" Classes="val" VerticalAlignment="Center"
                     HorizontalAlignment="Right"/>
          <ToggleButton Grid.Column="3" Content="{loc:Text Key=Lock}" Classes="mute" FontSize="11" Padding="8,2"
                        Margin="6,0,0,0" MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}" IsVisible="{Binding ShowGainLock}"
                        IsChecked="{Binding GainLocked, Mode=TwoWay}" VerticalAlignment="Center"
                        ToolTip.Tip="{loc:Text Key=GainLockTheDaemonRejectsEveryGainChange}"/>
        </Grid>
        <WrapPanel Name="InputControls" ItemSpacing="6" LineSpacing="4">
          <ToggleButton Content="{Binding MuteLabel}" Classes="mute" IsChecked="{Binding Mute, Mode=TwoWay}"
                        IsEnabled="{Binding !PhantomSettling}"
                        ToolTip.Tip="{loc:Text Key=TheDeviceMutesThisInputForAbout13}"/>
          <ToggleButton Content="{loc:Text Key=LowCut}"    IsChecked="{Binding LowCut, Mode=TwoWay}"     IsVisible="{Binding CapLowCut}"/>
          <ToggleButton Content="{Binding SoftLowCutText}" IsVisible="{Binding ShowSoftLowCut}"
                        IsChecked="{Binding SoftLowCutOn, Mode=OneWay}" Click="OnCycleSoftLowCut"
                        ToolTip.Tip="{loc:Text Key=HostSideLowCutForThisDeviceIts}"/>
          <ToggleButton Content="{loc:Text Key=ClipGuard}" IsVisible="{Binding ShowSoftClipGuard}"
                        IsChecked="{Binding SoftClipGuard, Mode=TwoWay}"
                        IsEnabled="{Binding SoftClipGuardAvailable}"
                        ToolTip.Tip="{Binding SoftClipGuardTip}"/>
          <ToggleButton Content="{loc:Text Key=Expander}"   IsChecked="{Binding Expander, Mode=TwoWay}"   IsVisible="{Binding CapExpander}"/>
          <ToggleButton Content="{loc:Text Key=VoiceTune}" IsChecked="{Binding VoiceTune, Mode=TwoWay}"  IsVisible="{Binding CapVoiceTune}"/>
          <ToggleButton Content="{loc:Text Key=Phantom}"  IsChecked="{Binding Phantom, Mode=TwoWay}"    IsVisible="{Binding CapPhantom}"/>
          <ToggleButton Content="{loc:Text Key=ClipGuard}" IsChecked="{Binding ClipGuard, Mode=TwoWay}" IsVisible="{Binding CapClipGuard}"/>
          <ToggleButton Content="{loc:Text Key=Compressor}" IsChecked="{Binding Compressor, Mode=TwoWay}"
                        IsVisible="{Binding CapCompressor}"/>
        </WrapPanel>
        <Grid ColumnDefinitions="90,*,64" IsVisible="{Binding VoiceTune}">
          <TextBlock Text="{loc:Text Key=VTStrength}" Classes="h" VerticalAlignment="Center"/>
          <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                  Value="{Binding VoiceTuneStrength, Mode=TwoWay}"/>
          <TextBlock Grid.Column="2" Text="{Binding VoiceTuneStrengthText}" Classes="val"
                     VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <!-- XLR 1 plugin inserts: plugins in the mic path, after the
             software low cut and ClipGuard, heard by every mix. The chain
             window adds, reorders and removes; each plugin's controls open
             in their own window. -->
        <StackPanel Spacing="4" Margin="0,4,0,0" IsVisible="{Binding HasMixer}">
          <Grid ColumnDefinitions="90,*,Auto">
            <TextBlock Text="{loc:Text Key=Inserts}" Classes="h" VerticalAlignment="Center"
                       ToolTip.Tip="{loc:Text Key=PluginsProcessingXLR1BeforeItReachesThe}"/>
            <Button Grid.Column="2" Content="{Binding Inserts.ButtonText}" Padding="12,3" FontSize="12" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                    Click="OnXlrInserts" ToolTip.Tip="{loc:Text Key=PluginsProcessingXLR1BeforeItReachesThe}"/>
          </Grid>
          <!-- the chain at a glance: LED, name, bypass, controls; adding,
               ordering and removing live in the chain window -->
          <ItemsControl ItemsSource="{Binding Inserts.Items}" IsVisible="{Binding Inserts.HasItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InsertViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,3">
                  <skin:StatusLed IsOn="{Binding IsActive}" Kind="Insert" Margin="0,0,8,0"
                                  AutomationProperties.Name="{loc:Text Key=PluginState}"/>
                  <Grid Grid.Column="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                        ColumnSpacing="8" VerticalAlignment="Center" ClipToBounds="True">
                    <TextBlock Text="{Binding Label}" Classes="insertName body" FontSize="12"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}"/>
                    <TextBlock Grid.Column="1" Text="{Binding StateText}" Classes="h" FontSize="11"/>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Error}" Classes="warn"
                               FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasError}"/>
                  </Grid>
                  <ToggleButton Grid.Column="2" Content="{loc:Text Key=NativeHostLetter}" Classes="insertmini"
                                IsChecked="{Binding NativeHost, Mode=TwoWay}"
                                IsVisible="{Binding CanChooseNativeHost}"
                                IsEnabled="{Binding CanTurnNativeHostOn}"
                                Margin="4,0,0,0"
                                AutomationProperties.Name="{loc:Text Key=RunThisPluginInItsOwnProcess}"
                                ToolTip.Tip="{loc:Text Key=RunThisPluginInItsOwnProcessWhich}"/>
                  <ToggleButton Grid.Column="3" Content="{loc:Text Key=BypassLetter}" Classes="insertmini bypass"
                                IsChecked="{Binding Bypass, Mode=TwoWay}"
                                Margin="4,0,2,0"
                                AutomationProperties.Name="{loc:Text Key=BypassThisPlugin}"
                                ToolTip.Tip="{loc:Text Key=Bypass}"/>
                  <Button Grid.Column="4" Content="⚙" Classes="insertmini"
                          AutomationProperties.Name="{loc:Text Key=OpenThisPluginSControls}"
                          Click="OnInsertControls" ToolTip.Tip="{Binding ControlsHint}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- XLR 2 -->
        <Grid ColumnDefinitions="90,*,64" Margin="0,2,0,0" IsVisible="{Binding HasXlr2}">
          <TextBlock Text="{loc:Text Key=XLR2Gain}" Classes="h" VerticalAlignment="Center"/>
          <Slider Grid.Column="1" Minimum="0" Maximum="80" TickFrequency="1" IsSnapToTickEnabled="True"
                  Value="{Binding Gain2Db, Mode=TwoWay}" IsEnabled="{Binding !GainLocked}"/>
          <TextBlock Grid.Column="2" Text="{Binding Gain2Text}" Classes="val" VerticalAlignment="Center"
                     HorizontalAlignment="Right"/>
        </Grid>
        <WrapPanel Name="Input2Controls" ItemSpacing="6" LineSpacing="4" IsVisible="{Binding HasXlr2}">
          <ToggleButton Content="{Binding Mute2Label}" Classes="mute" IsChecked="{Binding Mute2, Mode=TwoWay}"
                        IsEnabled="{Binding !PhantomSettling2}"
                        ToolTip.Tip="{loc:Text Key=TheDeviceMutesThisInputForAbout13}"/>
          <ToggleButton Content="{loc:Text Key=LowCut}"    IsChecked="{Binding LowCut2, Mode=TwoWay}"/>
          <ToggleButton Content="{loc:Text Key=Expander}"   IsChecked="{Binding Expander2, Mode=TwoWay}"/>
          <ToggleButton Content="{loc:Text Key=VoiceTune}" IsChecked="{Binding VoiceTune2, Mode=TwoWay}"/>
          <ToggleButton Content="{loc:Text Key=Phantom}"  IsChecked="{Binding Phantom2, Mode=TwoWay}"/>
          <ToggleButton Content="{loc:Text Key=ClipGuard}" IsChecked="{Binding ClipGuard2, Mode=TwoWay}"/>
          <ToggleButton Content="{loc:Text Key=Compressor}" IsChecked="{Binding Compressor2, Mode=TwoWay}"/>
        </WrapPanel>
        <!-- XLR 2 plugin inserts: same chain concept, its own mono filter-chain -->
        <StackPanel IsVisible="{Binding HasXlr2}">
        <StackPanel Spacing="4" Margin="0,4,0,0" IsVisible="{Binding HasMixer}">
          <Grid ColumnDefinitions="90,*,Auto">
            <TextBlock Text="{loc:Text Key=Inserts}" Classes="h" VerticalAlignment="Center"
                       ToolTip.Tip="{loc:Text Key=PluginsProcessingXLR2BeforeItReachesThe}"/>
            <Button Grid.Column="2" Content="{Binding Inserts2.ButtonText}" Padding="12,3" FontSize="12" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                    Tag="xlr2" Click="OnXlrInserts" ToolTip.Tip="{loc:Text Key=PluginsProcessingXLR2BeforeItReachesThe}"/>
          </Grid>
          <!-- the chain at a glance: LED, name, bypass, controls; adding,
               ordering and removing live in the chain window -->
          <ItemsControl ItemsSource="{Binding Inserts2.Items}" IsVisible="{Binding Inserts2.HasItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InsertViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,3">
                  <skin:StatusLed IsOn="{Binding IsActive}" Kind="Insert" Margin="0,0,8,0"
                                  AutomationProperties.Name="{loc:Text Key=PluginState}"/>
                  <Grid Grid.Column="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                        ColumnSpacing="8" VerticalAlignment="Center" ClipToBounds="True">
                    <TextBlock Text="{Binding Label}" Classes="insertName body" FontSize="12"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}"/>
                    <TextBlock Grid.Column="1" Text="{Binding StateText}" Classes="h" FontSize="11"/>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Error}" Classes="warn"
                               FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasError}"/>
                  </Grid>
                  <ToggleButton Grid.Column="2" Content="{loc:Text Key=NativeHostLetter}" Classes="insertmini"
                                IsChecked="{Binding NativeHost, Mode=TwoWay}"
                                IsVisible="{Binding CanChooseNativeHost}"
                                IsEnabled="{Binding CanTurnNativeHostOn}"
                                Margin="4,0,0,0"
                                AutomationProperties.Name="{loc:Text Key=RunThisPluginInItsOwnProcess}"
                                ToolTip.Tip="{loc:Text Key=RunThisPluginInItsOwnProcessWhich}"/>
                  <ToggleButton Grid.Column="3" Content="{loc:Text Key=BypassLetter}" Classes="insertmini bypass"
                                IsChecked="{Binding Bypass, Mode=TwoWay}"
                                Margin="4,0,2,0"
                                AutomationProperties.Name="{loc:Text Key=BypassThisPlugin}"
                                ToolTip.Tip="{loc:Text Key=Bypass}"/>
                  <Button Grid.Column="4" Content="⚙" Classes="insertmini"
                          AutomationProperties.Name="{loc:Text Key=OpenThisPluginSControls}"
                          Click="OnInsertControls" ToolTip.Tip="{Binding ControlsHint}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        </StackPanel>

        <Grid ColumnDefinitions="90,*,64" IsVisible="{Binding VoiceTune2}">
          <TextBlock Text="{loc:Text Key=VTStrength}" Classes="h" VerticalAlignment="Center"/>
          <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                  Value="{Binding VoiceTuneStrength2, Mode=TwoWay}"/>
          <TextBlock Grid.Column="2" Text="{Binding VoiceTuneStrength2Text}" Classes="val"
                     VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <!-- USB Aux input stage -->
        <Grid ColumnDefinitions="90,*,64,20,110" Margin="0,2,0,0" IsVisible="{Binding CapAuxInput}">
          <TextBlock Text="{loc:Text Key=USBAuxIn}" Classes="h" VerticalAlignment="Center"/>
          <Slider Grid.Column="1" Minimum="-60" Maximum="0"
                  Value="{Binding AuxLevelDb, Mode=TwoWay}"/>
          <TextBlock Grid.Column="2" Text="{Binding AuxLevelText}" Classes="val" VerticalAlignment="Center"
                     HorizontalAlignment="Right"/>
          <ToggleButton Grid.Column="4" Content="{loc:Text Key=LevelLock}" IsChecked="{Binding AuxLevelLock, Mode=TwoWay}"/>
        </Grid>
      </StackPanel>
      </Expander>
    </Border>

    <!-- headphone outputs (jack 1 on the front of the unit, jack 2 on the back) -->
    <Border Classes="card" IsVisible="{Binding ShowDetailedSections}">
      <Expander Name="HeadphonesTile" Classes="section" Theme="{StaticResource TileExpanderTheme}" IsExpanded="True">
        <Expander.Header><StackPanel Orientation="Horizontal" Spacing="6">
          <Button Classes="ghost reorderHandle" Content="↕" Tag="HeadphonesTile" AutomationProperties.Name="{loc:Text Key=MoveHeadphones}"
          ToolTip.Tip="{loc:Text Key=DragToAnotherSectionArrowKeysMove}"/>
          <TextBlock Text="{loc:Text Key=HEADPHONES}" Classes="h" VerticalAlignment="Center"/>
        </StackPanel></Expander.Header>
      <StackPanel Classes="dev" Spacing="4">
        <Grid ColumnDefinitions="90,*,64,20,90,*,64">
          <TextBlock Text="{loc:Text Key=Phones1}" Classes="h" VerticalAlignment="Center" ToolTip.Tip="{loc:Text Key=FrontJack}"/>
          <Slider Grid.Column="1" Minimum="0" Maximum="100"
                  Value="{Binding HpPercent, Mode=TwoWay}"/>
          <TextBlock Grid.Column="2" Text="{Binding HpText}" Classes="val" VerticalAlignment="Center"
                     HorizontalAlignment="Right"/>
          <TextBlock Grid.Column="4" Text="{loc:Text Key=Phones2}" Classes="h" VerticalAlignment="Center" ToolTip.Tip="{loc:Text Key=RearJack}"
                     IsVisible="{Binding HasHp2}"/>
          <Slider Grid.Column="5" Minimum="0" Maximum="100"
                  Value="{Binding Hp2Percent, Mode=TwoWay}" IsVisible="{Binding HasHp2}"/>
          <TextBlock Grid.Column="6" Text="{Binding Hp2Text}" Classes="val" VerticalAlignment="Center"
                     HorizontalAlignment="Right" IsVisible="{Binding HasHp2}"/>
        </Grid>
        <!-- hardware zero-latency blend between mic direct and PC playback;
             the value column fits the widest readout, "mic +100" -->
        <Grid ColumnDefinitions="90,*,74" IsVisible="{Binding CapCrossfade}">
          <TextBlock Text="{loc:Text Key=MicPC}" Classes="h" VerticalAlignment="Center"
                     ToolTip.Tip="{loc:Text Key=DirectMonitorBlendLeftOnlyYourMicRight}"/>
          <Slider Grid.Column="1" Minimum="0" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True"
                  Value="{Binding Crossfade, Mode=TwoWay}"/>
          <TextBlock Grid.Column="2" Text="{Binding CrossfadeText}" Classes="val"
                     VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
        <UniformGrid Columns="7">
          <ToggleButton Content="{loc:Text Key=LowImp}" IsChecked="{Binding LowImpedance, Mode=TwoWay}" Margin="0,0,6,0"
                        IsVisible="{Binding CapLowImpedance}"/>
        </UniformGrid>
      </StackPanel>
      </Expander>
    </Border>

    <!-- monitor destination: the device you hear the Monitor mix on -->
    <Border Classes="card" IsVisible="{Binding HasMixer}">
      <Expander Name="MonitorTile" Classes="section" Theme="{StaticResource TileExpanderTheme}" IsExpanded="True">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Classes="ghost reorderHandle" Content="↕" Tag="MonitorTile" AutomationProperties.Name="{loc:Text Key=MoveMonitor}"
                    ToolTip.Tip="{loc:Text Key=DragToAnotherSectionArrowKeysMove}"/>
            <TextBlock Text="{loc:Text Key=MONITOR}" Classes="h" VerticalAlignment="Center"/>
            <ToggleButton Name="OutputBoost" Content="150%" IsChecked="{Binding OutputVolumeRange.Boost, Mode=TwoWay}"
                          Padding="8,1" FontSize="{DynamicResource Ox.Label.FontSize}" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalAlignment="Center"
                          ToolTip.Tip="{loc:Text Key=AllowOutputVolumeAbove100UpTo}"/>
            <TextBlock Text="&#x24D8;" Classes="h" FontSize="12" VerticalAlignment="Center" Margin="0,-1,0,0" Cursor="Help"
                       ToolTip.Tip="{loc:Text Key=TickTheOutputsYouWantToHearChoose}"/>
          </StackPanel>
        </Expander.Header>
      <StackPanel Classes="dev" Spacing="4">
        <Grid ColumnDefinitions="90,*,20,90,*,64">
          <TextBlock Text="{loc:Text Key=Devices}" Classes="h" VerticalAlignment="Center"/>
          <DropDownButton Grid.Column="1" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          Content="{Binding MonitorSummary}">
            <DropDownButton.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <ItemsControl ItemsSource="{Binding MonitorOutputs}" Width="400">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MonitorOutputItem">
                      <!-- fixed row width under the flyout presenter's default
                           maximum (456 px including its padding): the label
                           trims, the feed picker keeps its place, nothing clips -->
                      <Grid ColumnDefinitions="*,120">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Padding="8,4"
                                  HorizontalAlignment="Stretch" ToolTip.Tip="{Binding Label}">
                          <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                        </CheckBox>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Feeds}" SelectedItem="{Binding Feed}"
                                  FontSize="11" HorizontalAlignment="Stretch" Margin="8,0,0,0" VerticalAlignment="Center"
                                  IsVisible="{Binding IsSelected}"
                                  ToolTip.Tip="{loc:Text Key=WhichMixThisOutputHears}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>

          <TextBlock Grid.Column="3" Text="{loc:Text Key=Volume}" Classes="h" VerticalAlignment="Center"/>
          <Slider Name="OutputVolumeSlider" Grid.Column="4" Minimum="0" Maximum="{Binding OutputVolumeRange.Maximum}" Value="{Binding OutputVolume, Mode=TwoWay}"/>
          <TextBlock Grid.Column="5" Text="{Binding OutputVolumeText}" Classes="val"
                     VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
        <TextBlock Text="{Binding VolumeRangeError}" IsVisible="{Binding HasVolumeRangeError}"
                   Classes="h" TextWrapping="Wrap"/>
      </StackPanel>
      </Expander>
    </Border>

    <!-- running applications and the channel each is routed to -->
    <Border Classes="card" IsVisible="{Binding ShowApplications}">
      <Expander Name="ApplicationsTile" Classes="section" Theme="{StaticResource TileExpanderTheme}" IsExpanded="True">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="ghost reorderHandle" Content="↕" Tag="ApplicationsTile" AutomationProperties.Name="{loc:Text Key=MoveApplications}"
                    ToolTip.Tip="{loc:Text Key=DragToAnotherSectionArrowKeysMove}"/>
            <TextBlock Text="{loc:Text Key=APPLICATIONS}" Classes="h" VerticalAlignment="Center"/>
            <Button Name="ManageApps" Content="{loc:Text Key=Manage}" Padding="8,1" FontSize="11" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalAlignment="Center"
                    IsEnabled="{Binding HasApps}" Click="OnManageApps"/>
          </StackPanel>
        </Expander.Header>
        <ItemsControl Name="ApplicationRows" ItemsSource="{Binding ActiveApps}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AppStreamViewModel">
              <Border Classes="tile" Padding="8,6" Margin="0,0,4,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <skin:StatusLed IsOn="{Binding Active}"
                                  AutomationProperties.Name="{loc:Text Key=StreamState}"
                                  ToolTip.Tip="{Binding StatusText}"/>
                  <TextBlock Text="{Binding Label}" Classes="body" VerticalAlignment="Center"/>
                  <ComboBox ItemsSource="{Binding Channels}" MinWidth="110"
                            SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Expander>
    </Border>

    <!-- mixer -->
    <Border Classes="card">
      <Expander Name="SubmixerTile" Classes="section" Theme="{StaticResource TileExpanderTheme}" IsExpanded="True">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="ghost reorderHandle" Content="↕" Tag="SubmixerTile" AutomationProperties.Name="{loc:Text Key=MoveSubmixer}"
                    ToolTip.Tip="{loc:Text Key=DragToAnotherSectionArrowKeysMove}"/>
            <TextBlock Text="{loc:Text Key=SUBMIXER}" Classes="h" VerticalAlignment="Center"/>
            <Button Content="{loc:Text Key=EditLayout}" Padding="8,1" FontSize="11" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalAlignment="Center"
                    IsVisible="{Binding HasMixer}" IsEnabled="{Binding CanEditLayout}" Click="OnEditLayout"
                    ToolTip.Tip="{loc:Text Key=AddRenameReorderAndRemoveApplicationChannelsAnd}"/>
          </StackPanel>
        </Expander.Header>
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding MixerPlaceholder}" TextWrapping="Wrap"
                   Classes="note" IsVisible="{Binding !HasMixer}"/>

        <!-- the compact and mini views' choices; the view itself is chosen in Options -->
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8" IsVisible="{Binding ShowChannelSelector}">
          <WrapPanel>
            <ComboBox Name="CompactChannelPicker" ItemsSource="{Binding Channels}" Margin="0,0,8,4"
                      SelectedItem="{Binding SelectedCompactChannel, Mode=TwoWay}" MinWidth="150" MaxWidth="300"
                      AutomationProperties.Name="{loc:Text Key=ChannelShown}" ToolTip.Tip="{loc:Text Key=TheChannelThisViewShowsHiddenChannels}">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ChannelViewModel"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Name="CompactMixPicker" ItemsSource="{Binding Mixes}" Margin="0,0,8,4"
                      SelectedItem="{Binding SelectedCompactMix, Mode=TwoWay}" MinWidth="150" MaxWidth="300"
                      IsVisible="{Binding ShowMixSelector}" AutomationProperties.Name="{loc:Text Key=MixShown}"
                      ToolTip.Tip="{loc:Text Key=TheMixThisViewShowsItsMaster}">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:MixViewModel"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </WrapPanel>
          <TextBlock Text="{Binding ViewPreferenceError}" Classes="warn" TextWrapping="Wrap"
                     IsVisible="{Binding ViewPreferenceError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>

        <!-- master row -->
        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Mixes}" IsVisible="{Binding HasMixer}"
                      Margin="0,10,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MixViewModel">
              <Border Classes="tile" Padding="10" Margin="0,0,8,8" Width="{DynamicResource Ox.Mixer.MixWidth}"
                      IsVisible="{Binding DisplayVisible}">
                <StackPanel Spacing="6">
                  <Button Classes="ghost reorderHandle" Classes.fixedPlace="{Binding !IsEditable}" Content="↔" Tag="{Binding}"
                          HorizontalAlignment="Left" AutomationProperties.Name="{Binding Name, StringFormat={loc:Text Key=MoveItem}}"
                          ToolTip.Tip="{loc:Text Key=DragOntoAnotherMixYouAddedArrow}"/>
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="{Binding Appearance.Icon}" Classes="strip" Classes.layoutAccent="{Binding Appearance.HasColour}"
                               IsVisible="{Binding Appearance.HasIcon}" Margin="0,0,6,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="strip" Classes.layoutAccent="{Binding Appearance.HasColour}"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding VolumeText}" Classes="val"/>
                  </Grid>
                  <StackPanel Spacing="1">
                    <skin:LevelMeter Level="{Binding MeterL}" AutomationProperties.Name="{loc:Text Key=LeftLevel}"/>
                    <skin:LevelMeter Level="{Binding MeterR}" AutomationProperties.Name="{loc:Text Key=RightLevel}"/>
                  </StackPanel>
                  <Slider Minimum="0" Maximum="{Binding VolumeRange.Maximum}" Value="{Binding Volume, Mode=TwoWay}"/>
                  <Grid ColumnDefinitions="*,Auto">
                    <ToggleButton Content="{loc:Text Key=Mute}" Classes="mute" IsChecked="{Binding Muted, Mode=TwoWay}"/>
                    <ToggleButton Grid.Column="1" Content="150%" IsChecked="{Binding VolumeRange.Boost, Mode=TwoWay}"
                                  IsVisible="{Binding IsMonitor}" Margin="6,0,0,0"
                                  ToolTip.Tip="{loc:Text Key=AllowThisMonitorMixAbove100Up}"/>
                  </Grid>
                  <Button Content="{Binding Inserts.ButtonText}" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center" Padding="8,4" FontSize="12" Click="OnMixInserts"
                          ToolTip.Tip="{loc:Text Key=StereoPluginsProcessingThisMixBeforeItReaches}"/>
                  <!-- the chain at a glance: LED, name, bypass, controls; adding,
                       ordering and removing live in the chain window -->
                  <ItemsControl ItemsSource="{Binding Inserts.Items}" IsVisible="{Binding Inserts.HasItems}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:InsertViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,2,0,0">
                          <skin:StatusLed IsOn="{Binding IsActive}" Kind="Insert" Margin="0,0,6,0"
                                          AutomationProperties.Name="{loc:Text Key=PluginState}"/>
                          <TextBlock Grid.Column="1" Text="{Binding Label}" Classes="insertName body"
                                     FontSize="11" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}"/>
                          <ToggleButton Grid.Column="2" Content="{loc:Text Key=NativeHostLetter}" Classes="insertmini"
                                        IsChecked="{Binding NativeHost, Mode=TwoWay}"
                                        IsVisible="{Binding CanChooseNativeHost}"
                                        IsEnabled="{Binding CanTurnNativeHostOn}"
                                        Margin="4,0,0,0" HorizontalAlignment="Right"
                                        AutomationProperties.Name="{loc:Text Key=RunThisPluginInItsOwnProcess}"
                                        ToolTip.Tip="{loc:Text Key=RunThisPluginInItsOwnProcessWhich}"/>
                          <ToggleButton Grid.Column="3" Content="{loc:Text Key=BypassLetter}" Classes="insertmini bypass"
                                        IsChecked="{Binding Bypass, Mode=TwoWay}"
                                        Margin="4,0,2,0" HorizontalAlignment="Right"
                                        AutomationProperties.Name="{loc:Text Key=BypassThisPlugin}"
                                        ToolTip.Tip="{loc:Text Key=Bypass}"/>
                          <Button Grid.Column="4" Content="⚙" Classes="insertmini"
                                  AutomationProperties.Name="{loc:Text Key=OpenThisPluginSControls}"
                                  Click="OnInsertControls" ToolTip.Tip="{Binding ControlsHint}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ToggleButton Content="{loc:Text Key=ToUSBAuxPort}" IsChecked="{Binding AuxPortEnabled, Mode=TwoWay}"
                                IsVisible="{Binding ShowAuxPortToggle}"
                                ToolTip.Tip="{loc:Text Key=SendThisMixToTheSecondComputerOn}"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- channel strips: one column per channel, one fader per mix -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding HasMixer}">
          <!-- MinHeight keeps every send visible; the ScrollViewer scrolls when
               the window is too short rather than clipping the strips. -->
          <ItemsControl ItemsSource="{Binding Channels}" MinHeight="290">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ChannelViewModel">
                <Border Classes="tile" Padding="10" Margin="0,0,8,0" Width="{DynamicResource Ox.Mixer.ChannelWidth}"
                        IsVisible="{Binding DisplayVisible}">
                  <StackPanel Spacing="8">
                    <Button Classes="ghost reorderHandle" Classes.fixedPlace="{Binding !IsEditable}" Content="↔" Tag="{Binding}"
                            HorizontalAlignment="Left" AutomationProperties.Name="{Binding Name, StringFormat={loc:Text Key=MoveItem}}"
                            ToolTip.Tip="{loc:Text Key=DragOntoAnotherChannelYouCanEdit}"/>
                    <TextBlock Text="{Binding Appearance.Icon}" Classes="strip" Classes.layoutAccent="{Binding Appearance.HasColour}"
                               HorizontalAlignment="Center" IsVisible="{Binding Appearance.HasIcon}"/>
                    <TextBlock Text="{Binding Name}" Classes="strip" Classes.layoutAccent="{Binding Appearance.HasColour}"
                               HorizontalAlignment="Center"/>
                    <!-- stereo level meter (L over R), dB scale -->
                    <StackPanel Spacing="1">
                      <skin:LevelMeter Level="{Binding MeterL}" AutomationProperties.Name="{loc:Text Key=LeftLevel}"/>
                      <skin:LevelMeter Level="{Binding MeterR}" AutomationProperties.Name="{loc:Text Key=RightLevel}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Sends}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SendViewModel">
                          <StackPanel Margin="0,0,0,8" Spacing="1" IsVisible="{Binding DisplayVisible}">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding MixName}" Classes="h" FontSize="11"/>
                              <TextBlock Grid.Column="1" Text="{Binding LevelText}" Classes="val" FontSize="11"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                              <Slider Minimum="0" Maximum="1" Value="{Binding Level, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                              <ToggleButton Grid.Column="1" Classes="mute mutemini" IsChecked="{Binding Muted, Mode=TwoWay}"
                                            Padding="7,2" FontSize="11" MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalAlignment="Center"/>
                            </Grid>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
      </Expander>
    </Border>
    </StackPanel>
  </StackPanel>
  </ScrollViewer>
</Window>
