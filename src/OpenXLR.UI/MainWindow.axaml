<Window xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:OpenXLR.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenXLR.UI"
        xmlns:skin="using:OpenXLR.UI.Skinning"
        xmlns:layout="using:OpenXLR.UI.Layout"
        xmlns:views="using:OpenXLR.UI.Views"
        x:Class="OpenXLR.UI.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="OpenXLR" Width="1040" Height="900" MinHeight="480"
        Icon="avares://OpenXLR.UI/Assets/icon.png">

  <!-- The window's ground, its cards, its labels, its meters and its fader
       caps come from the application's Ox.* appearance tokens (App.axaml and
       Skinning/SkinTokens.cs). What is left here is this window's own layout. -->

  <Window.Styles>
    <StyleInclude Source="avares://OpenXLR.UI/MixerStyles.axaml"/>
  </Window.Styles>
  <Window.Resources>
    <!-- APPLICATIONS' templates. A chip per application, wrapping across
         the section, is the classic one; a line per application, the name
         shortening beside its channel picker, fits a narrow column. The
         columns template lays tiles of one width out in columns of a skin's
         length (Layout/ApplicationColumnsPanel, made in code since the length
         comes from the skin). All bind the same application objects, show the
         application's icon before its name, and the picker is the only control. -->
    <ItemsPanelTemplate x:Key="ApplicationChipsPanel"><WrapPanel/></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="ApplicationListPanel"><StackPanel Spacing="4"/></ItemsPanelTemplate>
    <DataTemplate x:Key="ApplicationChip" x:DataType="vm:AppStreamViewModel">
      <Border Classes="tile" Name="ApplicationChip" Padding="8,6" Margin="0,0,4,8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <skin:StatusLed IsOn="{Binding Active}"
                          AutomationProperties.Name="{loc:Text Key=StreamState}"
                          ToolTip.Tip="{Binding StatusText}"/>
          <views:ApplicationIconView Icon="{Binding Icon}" Label="{Binding Label}"/>
          <TextBlock Text="{Binding Label}" Classes="body" VerticalAlignment="Center"/>
          <ComboBox Name="ApplicationChannel" ItemsSource="{Binding Channels}" MinWidth="110"
                    SelectedItem="{Binding SelectedChannel, Mode=TwoWay}" ToolTip.Tip="{Binding BrowserHeldNote}"
                    AutomationProperties.Name="{Binding Label, StringFormat={loc:Text Key=ApplicationChannelName}}"/>
        </StackPanel>
      </Border>
    </DataTemplate>
    <!-- The columns' tile: the chip's parts, every one the same width so the
         tiles of a column line up. The name has the skin's
         Ox.AppColumns.NameWidth; a longer one is clipped and glides to its end
         while the pointer is over the tile. The picker is as wide as the
         longest channel it lists, which the invisible copies of every channel
         name under the selection set, and the shared size group keeps the
         pickers of all tiles one width even when one shows no selection. -->
    <DataTemplate x:Key="ApplicationTile" x:DataType="vm:AppStreamViewModel">
      <Border Classes="tile" Name="ApplicationTile" Padding="8,6" Margin="0,0,4,8">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto" SharedSizeGroup="ApplicationChannel"/>
          </Grid.ColumnDefinitions>
          <skin:StatusLed IsOn="{Binding Active}" VerticalAlignment="Center"
                          AutomationProperties.Name="{loc:Text Key=StreamState}"
                          ToolTip.Tip="{Binding StatusText}"/>
          <views:ApplicationIconView Grid.Column="1" Icon="{Binding Icon}" Label="{Binding Label}"/>
          <layout:ScrollingName Grid.Column="2" Name="ApplicationName" VerticalAlignment="Center"
                                Width="{DynamicResource Ox.AppColumns.NameWidth}"
                                Scrolls="{Binding $parent[Border].IsPointerOver}" ToolTip.Tip="{Binding Label}">
            <TextBlock Text="{Binding Label}" Classes="body" VerticalAlignment="Center"/>
          </layout:ScrollingName>
          <ComboBox Grid.Column="3" Name="ApplicationChannel" ItemsSource="{Binding Channels}" MinWidth="110"
                    HorizontalAlignment="Stretch"
                    SelectedItem="{Binding SelectedChannel, Mode=TwoWay}" ToolTip.Tip="{Binding BrowserHeldNote}"
                    AutomationProperties.Name="{Binding Label, StringFormat={loc:Text Key=ApplicationChannelName}}">
            <ComboBox.SelectionBoxItemTemplate>
              <DataTemplate x:DataType="vm:ChannelChoice">
                <Panel>
                  <ItemsControl Name="ApplicationChannelSizer" ItemsSource="{Binding $parent[ComboBox].ItemsSource}"
                                Opacity="0" IsHitTestVisible="False" Focusable="False"
                                AutomationProperties.AccessibilityView="Raw">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Panel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ChannelChoice"><TextBlock Text="{Binding Name}"/></DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding Name}"/>
                </Panel>
              </DataTemplate>
            </ComboBox.SelectionBoxItemTemplate>
          </ComboBox>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ApplicationLine" x:DataType="vm:AppStreamViewModel">
      <Border Classes="tile" Name="ApplicationLine" Padding="8,4">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
          <skin:StatusLed IsOn="{Binding Active}" VerticalAlignment="Center"
                          AutomationProperties.Name="{loc:Text Key=StreamState}"
                          ToolTip.Tip="{Binding StatusText}"/>
          <views:ApplicationIconView Grid.Column="1" Icon="{Binding Icon}" Label="{Binding Label}"/>
          <TextBlock Grid.Column="2" Text="{Binding Label}" Classes="body" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}"/>
          <ComboBox Grid.Column="3" Name="ApplicationChannel" ItemsSource="{Binding Channels}" MinWidth="110" MaxWidth="160"
                    SelectedItem="{Binding SelectedChannel, Mode=TwoWay}" ToolTip.Tip="{Binding BrowserHeldNote}"
                    AutomationProperties.Name="{Binding Label, StringFormat={loc:Text Key=ApplicationChannelName}}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ChannelChoice">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
      </Border>
    </DataTemplate>
    <ControlTheme x:Key="TileExpanderTheme" TargetType="Expander">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Template">
        <ControlTemplate>
          <DockPanel>
            <!-- ClickMode=Press: the default Release mode re-hit-tests the
                 pointer position on release through a path that misses over
                 the chevron glyph at fractional display scaling, silently
                 dropping the click; the press pipeline is reliable -->
            <ToggleButton DockPanel.Dock="Top" HorizontalAlignment="Stretch" Cursor="Hand"
                          ClickMode="Press"
                          IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Grid ColumnDefinitions="*,Auto" Background="Transparent" Margin="0,0,0,4">
                    <ContentPresenter Content="{Binding $parent[Expander].Header}"
                                      VerticalAlignment="Center"/>
                    <!-- decorative: hit-testable glyph ink makes the button's
                         release-position check flaky, eating the click -->
                    <TextBlock Grid.Column="1" Classes="h" VerticalAlignment="Center" IsHitTestVisible="False"
                               Text="{Binding $parent[Expander].IsExpanded, Converter={x:Static vm:Converters.Chevron}}"/>
                  </Grid>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              IsVisible="{TemplateBinding IsExpanded}"/>
          </DockPanel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Window.Resources>



  <!-- The cards follow the window width, so a wide window shows more strips
       and tiles before anything scrolls. Every card sizes to its content; the
       page scrolls when the window is shorter. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Name="MixerContent" Margin="16" HorizontalAlignment="Stretch">

    <!-- header: the "header" region. Without a place in the skin's tree it
         heads the page; Options in it is always shown, the way back. -->
    <Border Name="HeaderCard" Classes="card" Margin="0,0,0,8">
      <Grid Name="WindowHeader" ColumnDefinitions="Auto,8,Auto,*" RowDefinitions="Auto,Auto">
        <Button Name="OptionsButton" Grid.RowSpan="2" Content="⚙" FontSize="18" Padding="8,4"
                VerticalAlignment="Center" Classes="ghost"
                Click="OnOptions" ToolTip.Tip="{loc:Text Key=Options}"/>
        <TextBlock Grid.Column="2" Text="OpenXLR" Classes="title" VerticalAlignment="Center"/>
        <Grid Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*"
              ColumnSpacing="6" Margin="0,2,0,0">
            <skin:StatusLed IsOn="{Binding DeviceConnected}"
                            AutomationProperties.Name="{loc:Text Key=InterfaceConnection}"/>
            <TextBlock Name="DeviceStatus" Grid.Column="1" Text="{Binding StatusLine}" Classes="h"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusLine}"
                       IsVisible="{Binding ShowDeviceStatus}"/>
            <!-- no supported interface attached while XLR 1 waits for one: a way to give it another microphone -->
            <Grid Name="NoInterface" Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="4" IsVisible="{Binding ShowChooseMicrophone}">
              <TextBlock Text="{loc:Text Key=NoInterface}" Classes="h" VerticalAlignment="Center"/>
              <Button Name="ChooseMicrophoneLink" Grid.Column="1" Classes="link" Click="OnChooseMicrophone" IsVisible="{Binding ShowChooseMicrophone}"
                      ToolTip.Tip="{Binding ChooseMicrophoneText}">
                <TextBlock Text="{Binding ChooseMicrophoneText}" FontSize="{DynamicResource Ox.Label.FontSize}"
                           TextTrimming="CharacterEllipsis"/>
              </Button>
            </Grid>
            <DropDownButton Name="DevicePicker" Grid.Column="1" Content="{Binding ActiveDeviceName}" FontSize="11" Padding="6,1"
                            MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalAlignment="Center" HorizontalAlignment="Left" Classes="ghost"
                            IsVisible="{Binding HasMultipleDevices}"
                            ToolTip.Tip="{Binding ActiveDeviceName, StringFormat={loc:Text Key=SelectInterfaceTip}}">
              <DropDownButton.ContentTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
              </DropDownButton.ContentTemplate>
              <DropDownButton.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <ItemsControl ItemsSource="{Binding DetectedDevices}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DetectedDeviceItem">
                        <Button Content="{Binding Name}" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left" FontSize="12"
                                Classes="ghost" Click="OnPickDevice" Tag="{Binding}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Flyout>
              </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>
        <WrapPanel Name="HeaderActions" Grid.Column="3" ItemSpacing="8" LineSpacing="4" Margin="8,0,0,0"
                   HorizontalAlignment="Right" ItemsAlignment="End" VerticalAlignment="Center">
          <DropDownButton Name="ProfilesButton" Content="{loc:Text Key=Profiles}" Padding="10,3" FontSize="12" Classes="ghost"
                          ToolTip.Tip="{loc:Text Key=SaveAndRecallCompleteScenesHardwareDSPPlus}">
            <DropDownButton.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel MinWidth="240" Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Name="ProfileNameBox" PlaceholderText="{loc:Text Key=ProfileName}" FontSize="12"/>
                    <Button Grid.Column="1" Content="{loc:Text Key=Save}" Margin="6,0,0,0" FontSize="12"
                            Click="OnProfileSave"/>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Grid ColumnDefinitions="*,Auto">
                          <Button Content="{Binding}" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left" FontSize="12"
                                  Classes="ghost" Click="OnProfileLoad"
                                  ToolTip.Tip="{loc:Text Key=LoadThisProfile}"/>
                          <Button Grid.Column="1" Content="&#x2715;" FontSize="11" Padding="6,3"
                                  Classes="ghost" Click="OnProfileDelete"
                                  Tag="{Binding}" ToolTip.Tip="{loc:Text Key=DeleteThisProfile}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{loc:Text Key=NoProfilesSavedYet}" Classes="h" FontSize="11"
                             IsVisible="{Binding !Profiles.Count}"/>
                  <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0" IsVisible="{Binding !!Profiles.Count}"
                        ToolTip.Tip="{loc:Text Key=RecalledWhenTheInterfaceConnectsDaemonStartA}">
                    <TextBlock Text="{loc:Text Key=OnConnect}" Classes="h" FontSize="11" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" Margin="8,0,0,0" FontSize="12" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding RecallChoices}"
                              SelectedItem="{Binding RecallOnConnectChoice}" IsEnabled="{Binding DeviceConnected}"/>
                  </Grid>
                </StackPanel>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>
          <ToggleButton Name="ArrangeButton" Content="{loc:Text Key=Arrange}" Padding="10,3" FontSize="12" Classes="ghost"
                        Click="OnArrange" IsVisible="{Binding !IsMiniView}"
                        ToolTip.Tip="{loc:Text Key=ShowHandlesToMoveSectionsChannelsAnd}"/>
          <Button Name="FlowButton" Content="{loc:Text Key=Flow}" Padding="10,3" FontSize="12" Classes="ghost"
                  Click="OnFlow" ToolTip.Tip="{loc:Text Key=ShowTheLiveAudioRoutingGraph}"/>
          <Button Name="RestartDaemonButton" Content="{loc:Text Key=RestartDaemon}" Padding="10,3" FontSize="12" Classes="ghost"
                  IsEnabled="{Binding DaemonRestart.CanRestart}" Click="OnRestartDaemon"
                  ToolTip.Tip="{loc:Text Key=RestartTheOpenXLRUserServiceAudioWillBe}"/>
          <TextBlock Name="HeaderVersion" Text="v0.0.0" Classes="h" VerticalAlignment="Center"/>
          <Button Name="AboutButton" Content="{loc:Text Key=About}" Padding="10,3" FontSize="12" Classes="ghost"
                  Click="OnAbout"/>
          <!-- the actions a skin puts in its overflow, moved here from the row
               above: the same controls with the same handlers -->
          <DropDownButton Name="HeaderOverflow" Content="⋯" Padding="10,3" FontSize="12" Classes="ghost" IsVisible="False"
                          AutomationProperties.Name="{loc:Text Key=MoreActions}" ToolTip.Tip="{loc:Text Key=MoreActions}">
            <DropDownButton.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Name="HeaderOverflowItems" Spacing="4" MinWidth="160"/>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>
        </WrapPanel>
      </Grid>
    </Border>

    <!-- the application's own notices, above the whole tree wherever a skin
         puts the header -->
    <StackPanel Name="ApplicationNotices">
    <TextBlock Text="{Binding DaemonRestart.Status}" Classes="h" TextWrapping="Wrap"
               Margin="0,0,0,8" IsVisible="{Binding DaemonRestart.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    <TextBlock Text="{Binding DaemonWarning}" Classes="alert" TextWrapping="Wrap" FontSize="12"
               Margin="0,0,0,8" IsVisible="{Binding DaemonWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

    <Border Classes="card" Margin="0,0,0,8" IsVisible="{Binding Updates.BannerVisible}">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="{Binding Updates.Title}" Classes="info"
                   TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="{loc:Text Key=ViewChanges}" Click="OnUpdates"/>
        <Button Grid.Column="2" Content="{loc:Text Key=Dismiss}" Click="OnDismissUpdate" Classes="ghost"/>
      </Grid>
    </Border>

    <!-- a daemon left running across an upgrade offers the old version's controls -->
    <Border Classes="card" Margin="0,0,0,8" IsVisible="{Binding DaemonVersionMismatch}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{loc:Text Key=RestartDaemon}" Padding="10,3" FontSize="12"
                IsEnabled="{Binding DaemonRestart.CanRestart}"
                VerticalAlignment="Center" Click="OnRestartDaemon"
                ToolTip.Tip="systemctl --user restart openxlr-daemon"/>
        <TextBlock Text="{Binding DaemonVersionNote}" Classes="h" TextWrapping="Wrap"
                   VerticalAlignment="Center" Margin="0,0,12,0"/>
      </DockPanel>
    </Border>

    <!-- shown while Arrange in the header is on -->
    <Button Name="ResetSectionsButton" Content="{loc:Text Key=ResetSections}" Click="OnResetSections" Padding="8,1" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}"
            IsVisible="False" Margin="0,0,0,8" HorizontalAlignment="Left" FontSize="{DynamicResource Ox.Label.FontSize}"
            ToolTip.Tip="{loc:Text Key=PutTheFiveSectionsBackInTheir}"/>
    <!-- in Arrange mode, the sections the skin hides, each with a way back -->
    <WrapPanel Name="HiddenSections" IsVisible="False" Margin="0,0,0,8" ItemSpacing="6" LineSpacing="4">
      <TextBlock Text="{loc:Text Key=HiddenSections}" Classes="h" VerticalAlignment="Center"/>
    </WrapPanel>
    <TextBlock Name="ArrangementNote" Classes="note" TextWrapping="Wrap" IsVisible="False" Margin="0,0,0,8"
               Text="{loc:Text Key=DragAHandleOntoAnotherSectionOr}"/>
    </StackPanel>

    <!-- the five sections, in the order saved in ui.json. A skin's layout may
         place them in its own tree of stacks, grids and docks, built in
         Layout/DesktopLayoutHost.cs from these same cards; a tree wider than
         the window scrolls on its own so the header above keeps the window's
         width. In the classic column this scroller never scrolls and the
         page's own does. A card shows when the window and the skin both let it. -->
    <vm:SectionScroller Name="SectionScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
    <StackPanel Name="SectionCards" Spacing="8">
    <!-- device controls -->
    <Border Classes="card">
      <Border.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="ShowDetailedSections"/>
          <Binding Path="(layout:RegionHost.Shown)" RelativeSource="{RelativeSource Self}"/>
        </MultiBinding>
      </Border.IsVisible>
      <Expander Name="InputsTile" Classes="section" Theme="{StaticResource TileExpanderTheme}" IsExpanded="True">
        <Expander.Header><StackPanel Orientation="Horizontal" Spacing="6">
          <Button Classes="ghost reorderHandle" Content="↕" Tag="InputsTile" AutomationProperties.Name="{loc:Text Key=MoveInputs}"
          ToolTip.Tip="{loc:Text Key=DragToAnotherSectionArrowKeysMove}"/>
          <TextBlock Text="{loc:Text Key=INPUTS}" Classes="h" VerticalAlignment="Center"/>
        </StackPanel></Expander.Header>
      <!-- The hardware panel, or a skin's input rack in its place: one of the
           two shows, both bound to the same properties. -->
      <Panel>
      <views:InputRackView Name="InputRack" IsVisible="False"/>
      <StackPanel Name="HardwarePanel" Classes="dev" Spacing="4">

        <!-- XLR 1. Its binding first; the interface's first input where XLR 1
             carries it; then XLR 1's own software low cut, ClipGuard and inserts,
             whatever feeds it. While another channel carries the interface's
             microphone, or none does, the input moves under the strip's own
             controls with a heading that says where it plays. -->
        <Grid Name="Xlr1Section" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
          <Grid Name="Xlr1Binding" ColumnDefinitions="90,*" IsVisible="{Binding HasXlr1Strip}">
            <TextBlock Text="{Binding Xlr1InputLabel}" Classes="h" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Spacing="2">
              <!-- the chip, then the microphone's EQ and noise removal at the chip's height; a grid,
                   so a long source name trims before the buttons leave the row -->
              <Grid Name="Xlr1ChipRow" ColumnDefinitions="*,Auto,Auto,Auto" HorizontalAlignment="Left">
                <views:BindingChip DataContext="{Binding Xlr1Strip}" HorizontalAlignment="Left"/>
                <Button Name="Xlr1Eq" Grid.Column="1" Content="{loc:Text Key=Eq}" Classes="fx" Margin="6,0,0,0" Padding="6,1" BorderThickness="0" FontSize="11"
                        MinWidth="0" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalContentAlignment="Center"
                        Classes.fxOn="{Binding Xlr1Strip.Eq.IsLit, FallbackValue=False}" Classes.fxOff="{Binding Xlr1Strip.Eq.IsFaulty, FallbackValue=False}"
                        IsVisible="{Binding Xlr1Strip.HasEq, FallbackValue=False}" Tag="xlr1" Click="OnEq"
                        AutomationProperties.Name="{Binding Xlr1Strip.Eq.ButtonName, FallbackValue=''}"
                        ToolTip.Tip="{Binding Xlr1Strip.Eq.ButtonTip, FallbackValue=''}"/>
                <Button Name="Xlr1Noise" Grid.Column="2" Content="{loc:Text Key=NoiseButton}" Classes="fx" Margin="4,0,0,0" Padding="6,1" BorderThickness="0" FontSize="11"
                        MinWidth="0" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalContentAlignment="Center"
                        Classes.fxOn="{Binding Xlr1Strip.Noise.IsLit, FallbackValue=False}" Classes.fxOff="{Binding Xlr1Strip.Noise.IsFaulty, FallbackValue=False}"
                        IsVisible="{Binding Xlr1Strip.HasNoise, FallbackValue=False}"
                        AutomationProperties.Name="{Binding Xlr1Strip.Noise.ButtonName, FallbackValue=''}" ToolTip.Tip="{loc:Text Key=NoiseButtonTip}">
                  <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                      <StackPanel Classes="dev" MaxWidth="360">
                        <views:NoiseRemovalControls DataContext="{Binding Xlr1Strip.Noise}"/>
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
                <Button Name="Xlr1Dynamics" Grid.Column="3" Content="{loc:Text Key=Dynamics}" Classes="fx" Margin="4,0,0,0" Padding="6,1" BorderThickness="0" FontSize="11"
                        MinWidth="0" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalContentAlignment="Center"
                        Classes.fxOn="{Binding Xlr1Strip.Dynamics.IsLit, FallbackValue=False}" Classes.fxOff="{Binding Xlr1Strip.Dynamics.IsFaulty, FallbackValue=False}"
                        IsVisible="{Binding Xlr1Strip.HasDynamics, FallbackValue=False}"
                        AutomationProperties.Name="{Binding Xlr1Strip.Dynamics.ButtonName, FallbackValue=''}" ToolTip.Tip="{loc:Text Key=DynamicsButtonTip}">
                  <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                      <StackPanel Classes="dev" MaxWidth="360">
                        <views:DynamicsControls DataContext="{Binding Xlr1Strip.Dynamics}"/>
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </Grid>
              <TextBlock Text="{Binding Xlr1Strip.BindingWarning}" Classes="hint" FontSize="11" TextWrapping="Wrap"
                         IsVisible="{Binding Xlr1Strip.HasBindingWarning, FallbackValue=False}"/>
            </StackPanel>
          </Grid>
          <!-- an additional interface's input while XLR 1 is bound to it:
               the controls the additional interfaces window draws for it -->
          <Grid Name="Xlr1ExtraUnit" Grid.Row="1" ColumnDefinitions="90,*"
                IsVisible="{Binding Xlr1Strip.CarriesExtraUnit, FallbackValue=False}">
            <TextBlock Text="{loc:Text Key=UnitInputGain}" Classes="h" VerticalAlignment="Top" Margin="0,6,0,0"/>
            <views:WaveUnitControls Grid.Column="1" DataContext="{Binding Xlr1Strip.ExtraUnitInput}"/>
          </Grid>
          <StackPanel Name="Input1Block" Grid.Row="{Binding UnitInput1.BlockRow}" Spacing="4">
            <Grid Name="Input1Heading" ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding UnitInput1.Elsewhere}" Margin="0,4,0,0">
              <TextBlock Text="{Binding UnitInput1.Heading}" Classes="h" TextWrapping="Wrap" VerticalAlignment="Center"/>
              <ToggleButton Name="Input1Fold" Grid.Column="1" Classes="ghost" Padding="6,1" FontSize="11"
                            Content="{Binding UnitInput1.Expanded, Converter={x:Static vm:Converters.Chevron}}"
                            MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                            IsChecked="{Binding UnitInput1.Expanded, Mode=TwoWay}" IsVisible="{Binding UnitInput1.CanFold}"
                            AutomationProperties.Name="{Binding UnitInput1.Heading}"/>
            </Grid>
            <StackPanel Spacing="4" IsVisible="{Binding UnitInput1.ControlsShown}">
              <Grid ColumnDefinitions="90,*,64,Auto">
                <TextBlock Text="{Binding UnitInput1.GainLabel}" Classes="h" VerticalAlignment="Center"/>
                <Slider vm:FaderInput.Step="1" Grid.Column="1" Minimum="0" Maximum="{Binding GainMaxDb}"
                        Value="{Binding GainDb, Mode=TwoWay}" IsEnabled="{Binding !GainLocked}"
                        AutomationProperties.Name="{Binding UnitInput1.GainName}"/>
                <TextBlock Grid.Column="2" Text="{Binding GainText}" Classes="val" VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
                <ToggleButton Grid.Column="3" Content="{loc:Text Key=Lock}" Classes="mute" FontSize="11" Padding="8,2"
                              Margin="6,0,0,0" MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}" IsVisible="{Binding ShowGainLock}"
                              IsChecked="{Binding GainLocked, Mode=TwoWay}" VerticalAlignment="Center"
                              ToolTip.Tip="{loc:Text Key=GainLockTheDaemonRejectsEveryGainChange}"/>
              </Grid>
              <WrapPanel Name="InputControls" ItemSpacing="6" LineSpacing="4">
                <ToggleButton Content="{Binding MuteLabel}" Classes="mute" IsChecked="{Binding Mute, Mode=TwoWay}"
                              IsEnabled="{Binding !PhantomSettling}"
                              ToolTip.Tip="{loc:Text Key=TheDeviceMutesThisInputForAbout13}"/>
                <ToggleButton Content="{loc:Text Key=LowCut}"    IsChecked="{Binding LowCut, Mode=TwoWay}"     IsVisible="{Binding CapLowCut}"/>
                <ToggleButton Content="{loc:Text Key=Expander}"   IsChecked="{Binding Expander, Mode=TwoWay}"   IsVisible="{Binding CapExpander}"/>
                <ToggleButton Content="{loc:Text Key=VoiceTune}" IsChecked="{Binding VoiceTune, Mode=TwoWay}"  IsVisible="{Binding CapVoiceTune}"/>
                <ToggleButton Content="{loc:Text Key=Phantom}"  IsChecked="{Binding Phantom, Mode=TwoWay}"    IsVisible="{Binding CapPhantom}"/>
                <ToggleButton Content="{loc:Text Key=ClipGuard}" IsChecked="{Binding ClipGuard, Mode=TwoWay}" IsVisible="{Binding CapClipGuard}"/>
                <ToggleButton Content="{loc:Text Key=Compressor}" IsChecked="{Binding Compressor, Mode=TwoWay}"
                              IsVisible="{Binding CapCompressor}"/>
              </WrapPanel>
              <Grid ColumnDefinitions="90,*,64" IsVisible="{Binding VoiceTune}">
                <TextBlock Text="{loc:Text Key=VTStrength}" Classes="h" VerticalAlignment="Center"/>
                <Slider vm:FaderInput.Step="1" Grid.Column="1" Minimum="0" Maximum="100"
                        Value="{Binding VoiceTuneStrength, Mode=TwoWay}"/>
                <TextBlock Grid.Column="2" Text="{Binding VoiceTuneStrengthText}" Classes="val"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
              </Grid>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Row="2" Spacing="4">
            <!-- XLR 1's own software low cut and ClipGuard, after its EQ, for a signal with no
                 hardware ones in front of it -->
            <WrapPanel Name="SoftwareControls" ItemSpacing="6" LineSpacing="4" IsVisible="{Binding ShowSoftwareControls}">
              <ToggleButton Content="{Binding SoftLowCutText}" IsVisible="{Binding ShowSoftLowCut}"
                            IsChecked="{Binding SoftLowCutOn, Mode=OneWay}" Click="OnCycleSoftLowCut"
                            ToolTip.Tip="{loc:Text Key=HostSideLowCutForThisDeviceIts}"/>
              <ToggleButton Content="{loc:Text Key=ClipGuard}" IsVisible="{Binding ShowSoftClipGuard}"
                            IsChecked="{Binding SoftClipGuard, Mode=TwoWay}"
                            IsEnabled="{Binding SoftClipGuardAvailable}"
                            ToolTip.Tip="{Binding SoftClipGuardTip}"/>
            </WrapPanel>

            <!-- XLR 1 plugin inserts: plugins in the mic path, after the
                 software low cut and ClipGuard, heard by every mix. The chain
                 window adds, reorders and removes; each plugin's controls open
                 in their own window. -->
            <StackPanel Spacing="4" Margin="0,4,0,0" IsVisible="{Binding HasMixer}">
              <Grid ColumnDefinitions="90,*,Auto">
                <TextBlock Text="{loc:Text Key=Inserts}" Classes="h" VerticalAlignment="Center"
                           ToolTip.Tip="{loc:Text Key=PluginsProcessingXLR1BeforeItReachesThe}"/>
                <Button Grid.Column="2" Content="{Binding Inserts.ButtonText}" Classes="fx" Classes.fxOn="{Binding Inserts.IsProcessing}" Classes.fxOff="{Binding Inserts.IsOff}"
                        Padding="12,3" FontSize="12" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                        Click="OnXlrInserts" ToolTip.Tip="{loc:Text Key=PluginsProcessingXLR1BeforeItReachesThe}"/>
              </Grid>
              <!-- the chain at a glance: LED, name, bypass, controls; adding,
                   ordering and removing live in the chain window -->
              <ItemsControl ItemsSource="{Binding Inserts.Items}" IsVisible="{Binding Inserts.HasItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:InsertViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,3">
                      <skin:StatusLed IsOn="{Binding IsActive}" Kind="Insert" Margin="0,0,8,0"
                                      AutomationProperties.Name="{loc:Text Key=PluginState}"/>
                      <Grid Grid.Column="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                            ColumnSpacing="8" VerticalAlignment="Center" ClipToBounds="True">
                        <TextBlock Text="{Binding Label}" Classes="insertName body" FontSize="12"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}"/>
                        <TextBlock Grid.Column="1" Text="{Binding StateText}" Classes="h" FontSize="11"/>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Error}" Classes="warn"
                                   FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasError}"/>
                      </Grid>
                      <ToggleButton Grid.Column="2" Content="{loc:Text Key=NativeHostLetter}" Classes="insertmini"
                                    IsChecked="{Binding NativeHost, Mode=TwoWay}"
                                    IsVisible="{Binding CanChooseNativeHost}"
                                    IsEnabled="{Binding CanTurnNativeHostOn}"
                                    Margin="4,0,0,0"
                                    AutomationProperties.Name="{loc:Text Key=RunThisPluginInItsOwnProcess}"
                                    ToolTip.Tip="{loc:Text Key=RunThisPluginInItsOwnProcessWhich}"/>
                      <ToggleButton Grid.Column="3" Content="{loc:Text Key=BypassLetter}" Classes="insertmini bypass"
                                    IsChecked="{Binding Bypass, Mode=TwoWay}"
                                    Margin="4,0,2,0"
                                    AutomationProperties.Name="{loc:Text Key=BypassThisPlugin}"
                                    ToolTip.Tip="{loc:Text Key=Bypass}"/>
                      <Button Grid.Column="4" Content="⚙" Classes="insertmini"
                              AutomationProperties.Name="{loc:Text Key=OpenThisPluginSControls}"
                              Click="OnInsertControls" ToolTip.Tip="{Binding ControlsHint}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- XLR 2: the same, on an interface with a second input, or bound to a source
             so that a one-input interface has a second microphone strip -->
        <Grid Name="Xlr2Section" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4" Margin="0,2,0,0" IsVisible="{Binding ShowXlr2Section}">
          <Grid Name="Xlr2Binding" ColumnDefinitions="90,*" IsVisible="{Binding HasXlr2Strip}">
            <TextBlock Text="{Binding Xlr2InputLabel}" Classes="h" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Spacing="2">
              <!-- the chip, then the microphone's EQ and noise removal at the chip's height; a grid,
                   so a long source name trims before the buttons leave the row -->
              <Grid Name="Xlr2ChipRow" ColumnDefinitions="*,Auto,Auto,Auto" HorizontalAlignment="Left">
                <views:BindingChip DataContext="{Binding Xlr2Strip}" HorizontalAlignment="Left"/>
                <Button Name="Xlr2Eq" Grid.Column="1" Content="{loc:Text Key=Eq}" Classes="fx" Margin="6,0,0,0" Padding="6,1" BorderThickness="0" FontSize="11"
                        MinWidth="0" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalContentAlignment="Center"
                        Classes.fxOn="{Binding Xlr2Strip.Eq.IsLit, FallbackValue=False}" Classes.fxOff="{Binding Xlr2Strip.Eq.IsFaulty, FallbackValue=False}"
                        IsVisible="{Binding Xlr2Strip.HasEq, FallbackValue=False}" Tag="xlr2" Click="OnEq"
                        AutomationProperties.Name="{Binding Xlr2Strip.Eq.ButtonName, FallbackValue=''}"
                        ToolTip.Tip="{Binding Xlr2Strip.Eq.ButtonTip, FallbackValue=''}"/>
                <Button Name="Xlr2Noise" Grid.Column="2" Content="{loc:Text Key=NoiseButton}" Classes="fx" Margin="4,0,0,0" Padding="6,1" BorderThickness="0" FontSize="11"
                        MinWidth="0" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalContentAlignment="Center"
                        Classes.fxOn="{Binding Xlr2Strip.Noise.IsLit, FallbackValue=False}" Classes.fxOff="{Binding Xlr2Strip.Noise.IsFaulty, FallbackValue=False}"
                        IsVisible="{Binding Xlr2Strip.HasNoise, FallbackValue=False}"
                        AutomationProperties.Name="{Binding Xlr2Strip.Noise.ButtonName, FallbackValue=''}" ToolTip.Tip="{loc:Text Key=NoiseButtonTip}">
                  <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                      <StackPanel Classes="dev" MaxWidth="360">
                        <views:NoiseRemovalControls DataContext="{Binding Xlr2Strip.Noise}"/>
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
                <Button Name="Xlr2Dynamics" Grid.Column="3" Content="{loc:Text Key=Dynamics}" Classes="fx" Margin="4,0,0,0" Padding="6,1" BorderThickness="0" FontSize="11"
                        MinWidth="0" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalContentAlignment="Center"
                        Classes.fxOn="{Binding Xlr2Strip.Dynamics.IsLit, FallbackValue=False}" Classes.fxOff="{Binding Xlr2Strip.Dynamics.IsFaulty, FallbackValue=False}"
                        IsVisible="{Binding Xlr2Strip.HasDynamics, FallbackValue=False}"
                        AutomationProperties.Name="{Binding Xlr2Strip.Dynamics.ButtonName, FallbackValue=''}" ToolTip.Tip="{loc:Text Key=DynamicsButtonTip}">
                  <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                      <StackPanel Classes="dev" MaxWidth="360">
                        <views:DynamicsControls DataContext="{Binding Xlr2Strip.Dynamics}"/>
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </Grid>
              <TextBlock Text="{Binding Xlr2Strip.BindingWarning}" Classes="hint" FontSize="11" TextWrapping="Wrap"
                         IsVisible="{Binding Xlr2Strip.HasBindingWarning, FallbackValue=False}"/>
            </StackPanel>
          </Grid>
          <!-- an additional interface's input while XLR 2 is bound to it:
               the controls the additional interfaces window draws for it -->
          <Grid Name="Xlr2ExtraUnit" Grid.Row="1" ColumnDefinitions="90,*"
                IsVisible="{Binding Xlr2Strip.CarriesExtraUnit, FallbackValue=False}">
            <TextBlock Text="{loc:Text Key=UnitInputGain}" Classes="h" VerticalAlignment="Top" Margin="0,6,0,0"/>
            <views:WaveUnitControls Grid.Column="1" DataContext="{Binding Xlr2Strip.ExtraUnitInput}"/>
          </Grid>
          <StackPanel Name="Input2Block" Grid.Row="{Binding UnitInput2.BlockRow}" Spacing="4" IsVisible="{Binding HasXlr2}">
            <Grid Name="Input2Heading" ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding UnitInput2.Elsewhere}" Margin="0,4,0,0">
              <TextBlock Text="{Binding UnitInput2.Heading}" Classes="h" TextWrapping="Wrap" VerticalAlignment="Center"/>
              <ToggleButton Name="Input2Fold" Grid.Column="1" Classes="ghost" Padding="6,1" FontSize="11"
                            Content="{Binding UnitInput2.Expanded, Converter={x:Static vm:Converters.Chevron}}"
                            MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                            IsChecked="{Binding UnitInput2.Expanded, Mode=TwoWay}" IsVisible="{Binding UnitInput2.CanFold}"
                            AutomationProperties.Name="{Binding UnitInput2.Heading}"/>
            </Grid>
            <StackPanel Spacing="4" IsVisible="{Binding UnitInput2.ControlsShown}">
              <Grid ColumnDefinitions="90,*,64">
                <TextBlock Text="{Binding UnitInput2.GainLabel}" Classes="h" VerticalAlignment="Center"/>
                <Slider vm:FaderInput.Step="1" Grid.Column="1" Minimum="0" Maximum="{Binding GainMaxDb}"
                        Value="{Binding Gain2Db, Mode=TwoWay}" IsEnabled="{Binding !GainLocked}"
                        AutomationProperties.Name="{Binding UnitInput2.GainName}"/>
                <TextBlock Grid.Column="2" Text="{Binding Gain2Text}" Classes="val" VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
              </Grid>
              <WrapPanel Name="Input2Controls" ItemSpacing="6" LineSpacing="4">
                <ToggleButton Content="{Binding Mute2Label}" Classes="mute" IsChecked="{Binding Mute2, Mode=TwoWay}"
                              IsEnabled="{Binding !PhantomSettling2}"
                              ToolTip.Tip="{loc:Text Key=TheDeviceMutesThisInputForAbout13}"/>
                <ToggleButton Content="{loc:Text Key=LowCut}"    IsChecked="{Binding LowCut2, Mode=TwoWay}"/>
                <ToggleButton Content="{loc:Text Key=Expander}"   IsChecked="{Binding Expander2, Mode=TwoWay}"/>
                <ToggleButton Content="{loc:Text Key=VoiceTune}" IsChecked="{Binding VoiceTune2, Mode=TwoWay}"/>
                <ToggleButton Content="{loc:Text Key=Phantom}"  IsChecked="{Binding Phantom2, Mode=TwoWay}"/>
                <ToggleButton Content="{loc:Text Key=ClipGuard}" IsChecked="{Binding ClipGuard2, Mode=TwoWay}"/>
                <ToggleButton Content="{loc:Text Key=Compressor}" IsChecked="{Binding Compressor2, Mode=TwoWay}"/>
              </WrapPanel>
              <Grid ColumnDefinitions="90,*,64" IsVisible="{Binding VoiceTune2}">
                <TextBlock Text="{loc:Text Key=VTStrength}" Classes="h" VerticalAlignment="Center"/>
                <Slider vm:FaderInput.Step="1" Grid.Column="1" Minimum="0" Maximum="100"
                        Value="{Binding VoiceTuneStrength2, Mode=TwoWay}"/>
                <TextBlock Grid.Column="2" Text="{Binding VoiceTuneStrength2Text}" Classes="val"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
              </Grid>
            </StackPanel>
          </StackPanel>
          <!-- XLR 2 plugin inserts: same chain concept, its own mono filter-chain, after its EQ -->
          <StackPanel Grid.Row="2" Spacing="4" Margin="0,4,0,0" IsVisible="{Binding HasMixer}">
            <Grid ColumnDefinitions="90,*,Auto">
              <TextBlock Text="{loc:Text Key=Inserts}" Classes="h" VerticalAlignment="Center"
                         ToolTip.Tip="{loc:Text Key=PluginsProcessingXLR2BeforeItReachesThe}"/>
              <Button Grid.Column="2" Content="{Binding Inserts2.ButtonText}" Classes="fx" Classes.fxOn="{Binding Inserts2.IsProcessing}" Classes.fxOff="{Binding Inserts2.IsOff}"
                      Padding="12,3" FontSize="12" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                      Tag="xlr2" Click="OnXlrInserts" ToolTip.Tip="{loc:Text Key=PluginsProcessingXLR2BeforeItReachesThe}"/>
            </Grid>
            <!-- the chain at a glance: LED, name, bypass, controls; adding,
                 ordering and removing live in the chain window -->
            <ItemsControl ItemsSource="{Binding Inserts2.Items}" IsVisible="{Binding Inserts2.HasItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:InsertViewModel">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,3">
                    <skin:StatusLed IsOn="{Binding IsActive}" Kind="Insert" Margin="0,0,8,0"
                                    AutomationProperties.Name="{loc:Text Key=PluginState}"/>
                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                          ColumnSpacing="8" VerticalAlignment="Center" ClipToBounds="True">
                      <TextBlock Text="{Binding Label}" Classes="insertName body" FontSize="12"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}"/>
                      <TextBlock Grid.Column="1" Text="{Binding StateText}" Classes="h" FontSize="11"/>
                      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Error}" Classes="warn"
                                 FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasError}"/>
                    </Grid>
                    <ToggleButton Grid.Column="2" Content="{loc:Text Key=NativeHostLetter}" Classes="insertmini"
                                  IsChecked="{Binding NativeHost, Mode=TwoWay}"
                                  IsVisible="{Binding CanChooseNativeHost}"
                                  IsEnabled="{Binding CanTurnNativeHostOn}"
                                  Margin="4,0,0,0"
                                  AutomationProperties.Name="{loc:Text Key=RunThisPluginInItsOwnProcess}"
                                  ToolTip.Tip="{loc:Text Key=RunThisPluginInItsOwnProcessWhich}"/>
                    <ToggleButton Grid.Column="3" Content="{loc:Text Key=BypassLetter}" Classes="insertmini bypass"
                                  IsChecked="{Binding Bypass, Mode=TwoWay}"
                                  Margin="4,0,2,0"
                                  AutomationProperties.Name="{loc:Text Key=BypassThisPlugin}"
                                  ToolTip.Tip="{loc:Text Key=Bypass}"/>
                    <Button Grid.Column="4" Content="⚙" Classes="insertmini"
                            AutomationProperties.Name="{loc:Text Key=OpenThisPluginSControls}"
                            Click="OnInsertControls" ToolTip.Tip="{Binding ControlsHint}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>

        <!-- USB Aux input stage; its readout shows Aux In's volume while that fader moves and for a second after -->
        <Grid Name="AuxInRow" ColumnDefinitions="90,*,64,20,110" Margin="0,2,0,0" IsVisible="{Binding CapAuxInput}">
          <TextBlock Text="{loc:Text Key=USBAuxIn}" Classes="h" VerticalAlignment="Center"/>
          <Slider vm:FaderInput.Step="1" Grid.Column="1" Minimum="-60" Maximum="0"
                  Value="{Binding AuxLevelDb, Mode=TwoWay}" AutomationProperties.Name="{loc:Text Key=USBAuxIn}"/>
          <TextBlock Grid.Column="2" Name="AuxInReadout" Text="{Binding AuxReadout}" Classes="val" VerticalAlignment="Center"
                     HorizontalAlignment="Right" AutomationProperties.Name="{Binding AuxReadoutName}" ToolTip.Tip="{Binding AuxReadoutName}"/>
          <ToggleButton Grid.Column="4" Content="{loc:Text Key=LevelLock}" IsChecked="{Binding AuxLevelLock, Mode=TwoWay}"/>
        </Grid>
        <!-- the Wave XLR Pro's analog Line In, an input of its own; its readout shows Line In's
             volume while that fader moves and for a second after -->
        <Grid Name="LineInRow" ColumnDefinitions="90,*,64,20,110" Margin="0,2,0,0" IsVisible="{Binding ShowLineInRow}">
          <TextBlock Text="{loc:Text Key=LineIn}" Classes="h" VerticalAlignment="Center"/>
          <Slider vm:FaderInput.Step="1" Grid.Column="1" Minimum="0" Maximum="{Binding LineInGainMaxDb}"
                  Value="{Binding LineInGainSliderDb, Mode=TwoWay}" AutomationProperties.Name="{loc:Text Key=LineInGain}"/>
          <TextBlock Grid.Column="2" Name="LineInReadout" Text="{Binding LineInReadout}" Classes="val" VerticalAlignment="Center"
                     HorizontalAlignment="Right" AutomationProperties.Name="{Binding LineInReadoutName}" ToolTip.Tip="{Binding LineInReadoutName}"/>
          <ToggleButton Grid.Column="4" Name="LineInLock" Content="{loc:Text Key=LevelLock}" IsChecked="{Binding LineInLevelLock, Mode=TwoWay}"/>
        </Grid>
        <ItemsControl Name="CaptureInputs" ItemsSource="{Binding CaptureInputs}" IsVisible="{Binding HasMixer}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChannelViewModel">
              <StackPanel Name="CaptureInputBlock" Spacing="4" Margin="0,8,0,0"
                          IsVisible="{Binding DisplayVisible}" Classes.revealed="{Binding Revealed}">
                <!-- the gap sits on the icon, so a name without one lines up with the labels below -->
                <Grid ColumnDefinitions="Auto,*">
                  <vm:LayoutIconBlock Icon="{Binding Appearance.Icon}" Fallback="{Binding Appearance.DefaultIcon}" Margin="0,0,6,0"
                                      Classes="strip" Classes.layoutAccent="{Binding Appearance.HasColour}" IsVisible="{Binding Appearance.HasIcon}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="strip" Classes.layoutAccent="{Binding Appearance.HasColour}"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                </Grid>
                <!-- the source chip, then the microphone's EQ and noise removal at its height, as on XLR 1:
                     the button letters at the size the chip letters its source in, so they stay level -->
                <Grid Name="CaptureChipRow" ColumnDefinitions="*,Auto,Auto,Auto" HorizontalAlignment="Left">
                  <views:CaptureSourceChip HorizontalAlignment="Left"/>
                  <Button Name="CaptureEq" Grid.Column="1" Content="{loc:Text Key=Eq}" Classes="fx" Margin="6,0,0,0" Padding="6,1" BorderThickness="0" FontSize="11"
                          MinWidth="0" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalContentAlignment="Center"
                          Classes.fxOn="{Binding Eq.IsLit, FallbackValue=False}" Classes.fxOff="{Binding Eq.IsFaulty, FallbackValue=False}"
                          IsVisible="{Binding HasEq}" Tag="{Binding Id}" Click="OnEq"
                          AutomationProperties.Name="{Binding Eq.ButtonName, FallbackValue=''}"
                          ToolTip.Tip="{Binding Eq.ButtonTip, FallbackValue=''}"/>
                  <Button Name="CaptureNoise" Grid.Column="2" Content="{loc:Text Key=NoiseButton}" Classes="fx" Margin="4,0,0,0" Padding="6,1" BorderThickness="0" FontSize="11"
                          MinWidth="0" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalContentAlignment="Center"
                          Classes.fxOn="{Binding Noise.IsLit, FallbackValue=False}" Classes.fxOff="{Binding Noise.IsFaulty, FallbackValue=False}"
                          IsVisible="{Binding HasNoise, FallbackValue=False}"
                          AutomationProperties.Name="{Binding Noise.ButtonName, FallbackValue=''}" ToolTip.Tip="{loc:Text Key=NoiseButtonTip}">
                    <Button.Flyout>
                      <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel Classes="dev" MaxWidth="360">
                          <views:NoiseRemovalControls DataContext="{Binding Noise}"/>
                        </StackPanel>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                  <Button Name="CaptureDynamics" Grid.Column="3" Content="{loc:Text Key=Dynamics}" Classes="fx" Margin="4,0,0,0" Padding="6,1" BorderThickness="0" FontSize="11"
                          MinWidth="0" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalContentAlignment="Center"
                          Classes.fxOn="{Binding Dynamics.IsLit, FallbackValue=False}" Classes.fxOff="{Binding Dynamics.IsFaulty, FallbackValue=False}"
                          IsVisible="{Binding HasDynamics, FallbackValue=False}"
                          AutomationProperties.Name="{Binding Dynamics.ButtonName, FallbackValue=''}" ToolTip.Tip="{loc:Text Key=DynamicsButtonTip}">
                    <Button.Flyout>
                      <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel Classes="dev" MaxWidth="360">
                          <views:DynamicsControls DataContext="{Binding Dynamics}"/>
                        </StackPanel>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </Grid>
                <TextBlock Text="{Binding BindingWarning}" Classes="hint" FontSize="11"
                           TextWrapping="Wrap" IsVisible="{Binding HasBindingWarning}"/>
                <!-- the source's own gain, on a source OpenXLR does not drive; its readout shows the
                     channel's volume while that fader moves and for a second after -->
                <Grid Name="CaptureGainRow" ColumnDefinitions="90,*,Auto,64" IsVisible="{Binding ShowsCaptureGain}">
                  <TextBlock Text="{loc:Text Key=UnitInputGain}" Classes="h" VerticalAlignment="Center"/>
                  <Slider Grid.Column="1" vm:FaderInput.Step="1" Minimum="{Binding CaptureGainMinDb}" Maximum="{Binding CaptureGainMaxDb}"
                          Value="{Binding CaptureGainDb, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding CaptureGainName}" ToolTip.Tip="{Binding CaptureGainTip}"/>
                  <TextBlock Grid.Column="3" Name="CaptureGainReadout" Text="{Binding Readout}" Classes="val" VerticalAlignment="Center"
                             HorizontalAlignment="Right" AutomationProperties.Name="{Binding ReadoutName}" ToolTip.Tip="{Binding ReadoutName}"/>
                </Grid>
                <Grid ColumnDefinitions="90,*,Auto,64" IsVisible="{Binding HasVolume}">
                  <TextBlock Text="{loc:Text Key=Volume}" Classes="h" VerticalAlignment="Center"/>
                  <Slider Grid.Column="1" vm:FaderInput.Step="0.01" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}"
                          vm:FaderInput.IsAdjusting="{Binding VolumeAdjusting, Mode=OneWayToSource}"
                          AutomationProperties.Name="{Binding Name, StringFormat={loc:Text Key=ChannelVolumeName}}" ToolTip.Tip="{Binding VolumeTip}"/>
                  <TextBlock Grid.Column="2" Text="&#x24D8;" Classes="h" FontSize="12"
                             VerticalAlignment="Center" IsVisible="{Binding DirectMonitored}" ToolTip.Tip="{Binding VolumeTip}"
                             AutomationProperties.Name="{loc:Text Key=ChannelVolumeMixesOnly}"/>
                  <TextBlock Grid.Column="3" Text="{Binding VolumeText}" Classes="val" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <StackPanel Name="CaptureExtraUnit" Spacing="4" IsVisible="{Binding CarriesExtraUnit}">
                  <TextBlock Text="{Binding ExtraUnitInput.Unit.Name}" Classes="h" TextWrapping="Wrap"/>
                  <Grid ColumnDefinitions="90,*">
                    <TextBlock Text="{loc:Text Key=UnitInputGain}" Classes="h" VerticalAlignment="Top" Margin="0,6,0,0"/>
                    <views:WaveUnitControls Grid.Column="1" DataContext="{Binding ExtraUnitInput}"/>
                  </Grid>
                </StackPanel>
                <views:CaptureInsertsView Labelled="True" Margin="0,4,0,0" IsVisible="{Binding HasInserts}"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      </Panel>
      </Expander>
    </Border>

    <!-- headphone outputs (jack 1 on the front of the unit, jack 2 on the back) -->
    <Border Classes="card">
      <Border.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="ShowDetailedSections"/>
          <Binding Path="(layout:RegionHost.Shown)" RelativeSource="{RelativeSource Self}"/>
        </MultiBinding>
      </Border.IsVisible>
      <Expander Name="HeadphonesTile" Classes="section" Theme="{StaticResource TileExpanderTheme}" IsExpanded="True">
        <Expander.Header><StackPanel Orientation="Horizontal" Spacing="6">
          <Button Classes="ghost reorderHandle" Content="↕" Tag="HeadphonesTile" AutomationProperties.Name="{loc:Text Key=MoveHeadphones}"
          ToolTip.Tip="{loc:Text Key=DragToAnotherSectionArrowKeysMove}"/>
          <TextBlock Text="{loc:Text Key=HEADPHONES}" Classes="h" VerticalAlignment="Center"/>
        </StackPanel></Expander.Header>
      <StackPanel Classes="dev" Spacing="4">
        <Grid Name="HeadphoneControls" ColumnDefinitions="90,*,64,20,90,*,64">
          <Grid Name="Phones1Label" ColumnDefinitions="Auto,*" VerticalAlignment="Center" ToolTip.Tip="{loc:Text Key=FrontJack}"
                DataContext="{Binding Phones1Appearance}" x:DataType="vm:LayoutAppearanceViewModel">
            <vm:LayoutIconBlock Icon="{Binding Icon}" Fallback="{Binding DefaultIcon}" Classes="h" Classes.layoutAccent="{Binding HasColour}"
                                IsVisible="{Binding HasIcon}" Margin="0,0,5,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{loc:Text Key=Phones1}" Classes="h" Classes.layoutAccent="{Binding HasColour}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </Grid>
          <Slider vm:FaderInput.Step="1" Grid.Column="1" Minimum="0" Maximum="100"
                  Value="{Binding HpPercent, Mode=TwoWay}"/>
          <TextBlock Grid.Column="2" Text="{Binding HpText}" Classes="val" VerticalAlignment="Center"
                     HorizontalAlignment="Right"/>
          <Panel Grid.Column="4" IsVisible="{Binding HasHp2}" VerticalAlignment="Center">
            <Grid Name="Phones2Label" ColumnDefinitions="Auto,*" ToolTip.Tip="{loc:Text Key=RearJack}"
                  DataContext="{Binding Phones2Appearance}" x:DataType="vm:LayoutAppearanceViewModel">
              <vm:LayoutIconBlock Icon="{Binding Icon}" Fallback="{Binding DefaultIcon}" Classes="h" Classes.layoutAccent="{Binding HasColour}"
                                  IsVisible="{Binding HasIcon}" Margin="0,0,5,0" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{loc:Text Key=Phones2}" Classes="h" Classes.layoutAccent="{Binding HasColour}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
          </Panel>
          <Slider vm:FaderInput.Step="1" Grid.Column="5" Minimum="0" Maximum="100"
                  Value="{Binding Hp2Percent, Mode=TwoWay}" IsVisible="{Binding HasHp2}"/>
          <TextBlock Grid.Column="6" Text="{Binding Hp2Text}" Classes="val" VerticalAlignment="Center"
                     HorizontalAlignment="Right" IsVisible="{Binding HasHp2}"/>
        </Grid>
        <!-- hardware zero-latency blend between mic direct and PC playback;
             the value column fits the widest readout, "mic +100" -->
        <Grid ColumnDefinitions="90,*,74" IsVisible="{Binding CapCrossfade}">
          <TextBlock Text="{loc:Text Key=MicPC}" Classes="h" VerticalAlignment="Center"
                     ToolTip.Tip="{loc:Text Key=DirectMonitorBlendLeftOnlyYourMicRight}"/>
          <Slider vm:FaderInput.Step="1" Grid.Column="1" Minimum="0" Maximum="200"
                  Value="{Binding Crossfade, Mode=TwoWay}"/>
          <TextBlock x:Name="CrossfadeValue" Grid.Column="2" Text="{Binding CrossfadeText}" Classes="val"
                     VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
        <!-- the blend mixes the interface's own microphone into its jack, wherever that microphone plays in the mixer -->
        <TextBlock Name="CrossfadeNote" Text="{Binding CrossfadeNote}" Classes="hint" FontSize="11" TextWrapping="Wrap"
                   Margin="90,0,0,0" IsVisible="{Binding HasCrossfadeNote}"/>
        <UniformGrid Columns="7">
          <ToggleButton Content="{loc:Text Key=LowImp}" IsChecked="{Binding LowImpedance, Mode=TwoWay}" Margin="0,0,6,0"
                        IsVisible="{Binding CapLowImpedance}"/>
        </UniformGrid>
      </StackPanel>
      </Expander>
    </Border>

    <!-- monitor destination: the device you hear the Monitor mix on -->
    <Border Classes="card">
      <Border.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="HasMixer"/>
          <Binding Path="(layout:RegionHost.Shown)" RelativeSource="{RelativeSource Self}"/>
        </MultiBinding>
      </Border.IsVisible>
      <Expander Name="MonitorTile" Classes="section" Theme="{StaticResource TileExpanderTheme}" IsExpanded="True">
        <Expander.Header>
          <WrapPanel ItemSpacing="6" LineSpacing="6">
            <Button Classes="ghost reorderHandle" Content="↕" Tag="MonitorTile" AutomationProperties.Name="{loc:Text Key=MoveMonitor}"
                    ToolTip.Tip="{loc:Text Key=DragToAnotherSectionArrowKeysMove}"/>
            <TextBlock Text="{loc:Text Key=MONITOR}" Classes="h" VerticalAlignment="Center"/>
            <ToggleButton Name="MonitorMute" Content="{loc:Text Key=Mute}" Classes="mute"
                          IsChecked="{Binding MonitorMuted, Mode=TwoWay}"
                          Padding="8,1" FontSize="{DynamicResource Ox.Label.FontSize}" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalAlignment="Center"
                          AutomationProperties.Name="{loc:Text Key=MuteMonitoring}" ToolTip.Tip="{loc:Text Key=MuteMonitoringTip}"/>
            <ToggleButton Name="OutputBoost" Content="150%" IsChecked="{Binding OutputVolumeRange.Boost, Mode=TwoWay}"
                          Padding="8,1" FontSize="{DynamicResource Ox.Label.FontSize}" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalAlignment="Center"
                          ToolTip.Tip="{loc:Text Key=AllowOutputVolumeAbove100UpTo}"/>
            <TextBlock Text="&#x24D8;" Classes="h" FontSize="12" VerticalAlignment="Center" Margin="0,-1,0,0" Cursor="Help"
                       ToolTip.Tip="{loc:Text Key=MonitorOutputRoutingTip}"/>
          </WrapPanel>
        </Expander.Header>
      <StackPanel Classes="dev" Spacing="4">
        <TextBlock Name="MonitorMicrophonePausePendingNote" Text="{loc:Text Key=MicrophonePausePendingNote}"
                   Classes="warn" TextWrapping="Wrap" IsVisible="{Binding MicrophonePausePending}"/>
        <Grid Name="MonitorControls" ColumnDefinitions="90,*,20,90,*,64" SizeChanged="OnMonitorSizeChanged">
          <TextBlock Name="MonitorDevicesLabel" Text="{loc:Text Key=Devices}" Classes="h" VerticalAlignment="Center"/>
          <DropDownButton Name="MonitorDestination" Grid.Column="1" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left" AutomationProperties.Name="{loc:Text Key=Devices}"
                          Content="{Binding MonitorSummary}" ToolTip.Tip="{Binding MonitorSummary}">
            <DropDownButton.ContentTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </DropDownButton.ContentTemplate>
            <DropDownButton.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <ScrollViewer MaxHeight="400" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding MonitorOutputs}" Width="400">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MonitorOutputItem">
                      <!-- fixed row width under the flyout presenter's default
                           maximum (456 px including its padding): the label
                           trims, the feed picker keeps its place, nothing clips -->
                      <Grid ColumnDefinitions="*,120">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Padding="8,4"
                                  HorizontalAlignment="Stretch" ToolTip.Tip="{Binding Label}">
                          <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                        </CheckBox>
                        <DropDownButton Grid.Column="1" Content="{Binding Feed.Name}"
                                        FontSize="{DynamicResource Ox.Label.FontSize}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsSelected}"
                                        AutomationProperties.Name="{loc:Text Key=ChooseOutputMixes}"
                                        ToolTip.Tip="{Binding Feed.Name}">
                          <DropDownButton.ContentTemplate>
                            <DataTemplate x:DataType="x:String">
                              <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                          </DropDownButton.ContentTemplate>
                          <DropDownButton.Flyout>
                            <Flyout Placement="RightEdgeAlignedTop">
                              <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding FeedMixes}" Width="240">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MonitorMixChoice">
                                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanToggle}"
                                                HorizontalAlignment="Stretch" Padding="8,4" ToolTip.Tip="{Binding Name}">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                      </CheckBox>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </ScrollViewer>
                            </Flyout>
                          </DropDownButton.Flyout>
                        </DropDownButton>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>

          <TextBlock Name="MonitorVolumeLabel" Grid.Column="3" Text="{loc:Text Key=Volume}" Classes="h" VerticalAlignment="Center"/>
          <Slider vm:FaderInput.Step="0.01" Name="OutputVolumeSlider" Grid.Column="4" Minimum="0" Maximum="{Binding OutputVolumeRange.Maximum}" Value="{Binding OutputVolume, Mode=TwoWay}"
                  AutomationProperties.Name="{loc:Text Key=Volume}"/>
          <TextBlock Name="MonitorVolumeReadout" Grid.Column="5" Text="{Binding OutputVolumeText}" Classes="val"
                     VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
        <TextBlock Text="{Binding VolumeRangeError}" IsVisible="{Binding HasVolumeRangeError}"
                   Classes="h" TextWrapping="Wrap"/>
      </StackPanel>
      </Expander>
    </Border>

    <!-- running applications and the channel each is routed to -->
    <Border Classes="card">
      <Border.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="ShowApplications"/>
          <Binding Path="(layout:RegionHost.Shown)" RelativeSource="{RelativeSource Self}"/>
        </MultiBinding>
      </Border.IsVisible>
      <Expander Name="ApplicationsTile" Classes="section" Theme="{StaticResource TileExpanderTheme}" IsExpanded="True">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="ghost reorderHandle" Content="↕" Tag="ApplicationsTile" AutomationProperties.Name="{loc:Text Key=MoveApplications}"
                    ToolTip.Tip="{loc:Text Key=DragToAnotherSectionArrowKeysMove}"/>
            <TextBlock Text="{loc:Text Key=APPLICATIONS}" Classes="h" VerticalAlignment="Center"/>
            <Button Name="ManageApps" Content="{loc:Text Key=Manage}" Padding="8,1" FontSize="11" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalAlignment="Center"
                    IsEnabled="{Binding HasApps}" Click="OnManageApps"/>
            <!-- Enabled whenever shown: the window is also where tab routing is turned on. -->
            <Button Name="ManageBrowserTabs" Content="{loc:Text Key=BrowserTabs}" Padding="8,1" FontSize="11" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalAlignment="Center"
                    IsVisible="{Binding BrowserTabSupport}" Click="OnManageBrowserTabs"
                    ToolTip.Tip="{loc:Text Key=BrowserTabsHint}"/>
          </StackPanel>
        </Expander.Header>
        <!-- the chips, the list or the columns, as the skin's template picks
             (ApplicationChip, ApplicationLine and their panels above) -->
        <ItemsControl Name="ApplicationRows" ItemsSource="{Binding ActiveApps}"
                      ItemsPanel="{StaticResource ApplicationChipsPanel}" ItemTemplate="{StaticResource ApplicationChip}"/>
      </Expander>
    </Border>

    <!-- mixer -->
    <Border Classes="card" IsVisible="{Binding (layout:RegionHost.Shown), RelativeSource={RelativeSource Self}}">
      <Expander Name="SubmixerTile" Classes="section" Theme="{StaticResource TileExpanderTheme}" IsExpanded="True">
        <Expander.Header>
          <WrapPanel ItemSpacing="10" LineSpacing="4">
            <Button Classes="ghost reorderHandle" Content="↕" Tag="SubmixerTile" AutomationProperties.Name="{loc:Text Key=MoveSubmixer}"
                    ToolTip.Tip="{loc:Text Key=DragToAnotherSectionArrowKeysMove}"/>
            <TextBlock Text="{loc:Text Key=SUBMIXER}" Classes="h" VerticalAlignment="Center"/>
            <Button Name="PopOutMixerButton" Content="{loc:Text Key=PopOutMixer}" Padding="8,1" FontSize="11" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalAlignment="Center"
                    Click="OnPopOutMixer" ToolTip.Tip="{loc:Text Key=PopOutMixerHint}">
              <!-- Hidden with no mixer, and while the mixer is in its own window. -->
              <Button.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="HasMixer"/>
                  <Binding Path="!#DetachedMixerNotice.IsVisible"/>
                </MultiBinding>
              </Button.IsVisible>
            </Button>
            <Button Content="{loc:Text Key=EditLayout}" Padding="8,1" FontSize="11" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalAlignment="Center"
                    IsVisible="{Binding HasMixer}" IsEnabled="{Binding CanEditLayout}" Click="OnEditLayout"
                    ToolTip.Tip="{loc:Text Key=AddRenameReorderAndRemoveApplicationChannelsAnd}"/>
            <Button Name="MicSetupButton" Content="{loc:Text Key=MicSetup}" Padding="8,1" FontSize="11" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalAlignment="Center"
                    Click="OnMicSetup" ToolTip.Tip="{loc:Text Key=MicSetupButtonTip}">
              <Button.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="HasMixer"/>
                  <Binding Path="MicSetupInputs.Any"/>
                </MultiBinding>
              </Button.IsVisible>
            </Button>
            <Button Name="DuckingButton" Content="{loc:Text Key=Ducking}" Padding="8,1" FontSize="11" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalAlignment="Center"
                    Click="OnDucking" ToolTip.Tip="{loc:Text Key=DuckingButtonTip}">
              <Button.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="HasMixer"/>
                  <Binding Path="Ducking.IsReported"/>
                </MultiBinding>
              </Button.IsVisible>
            </Button>
            <!-- The soundboard, whether or not SFX exists: the window's Turn on creates it.
                 Lit, as an effects button is, while a clip plays. -->
            <Button Name="SoundboardButton" Content="{loc:Text Key=Soundboard}" Padding="8,1" FontSize="11" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalAlignment="Center"
                    Classes="fx" Classes.fxOn="{Binding Soundboard.AnyPlaying}" Click="OnSoundboard" ToolTip.Tip="{loc:Text Key=SoundboardButtonTip}">
              <Button.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="HasMixer"/>
                  <Binding Path="Soundboard.IsReported"/>
                </MultiBinding>
              </Button.IsVisible>
            </Button>
            <!-- The voice changer, on any microphone the daemon reports it for.
                 Lit, as an effects button is, while a microphone has a voice on. -->
            <Button Name="VoiceChangerButton" Content="{loc:Text Key=VoiceChanger}" Padding="8,1" FontSize="11" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalAlignment="Center"
                    Classes="fx" Classes.fxOn="{Binding VoiceChanger.AnyOn}" Click="OnVoiceChanger" ToolTip.Tip="{loc:Text Key=VoiceChangerButtonTip}">
              <Button.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="HasMixer"/>
                  <Binding Path="VoiceChanger.IsReported"/>
                </MultiBinding>
              </Button.IsVisible>
            </Button>
            <!-- Shown only while something is hidden in the layout editor; a window preference. -->
            <ToggleButton Name="ShowHiddenButton" Content="{loc:Text Key=ShowHidden}" Padding="8,1" FontSize="11"
                          MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalAlignment="Center" HorizontalAlignment="Left"
                          IsChecked="{Binding ShowHidden, Mode=TwoWay}" ToolTip.Tip="{loc:Text Key=ShowHiddenHint}">
              <ToggleButton.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="HasMixer"/>
                  <Binding Path="CanShowHidden"/>
                </MultiBinding>
              </ToggleButton.IsVisible>
            </ToggleButton>
          </WrapPanel>
        </Expander.Header>
      <Grid>
        <StackPanel Name="DetachedMixerNotice" IsVisible="False" Spacing="8">
          <TextBlock Text="{loc:Text Key=MixerDetached}" Classes="note" TextWrapping="Wrap"/>
          <Button Content="{loc:Text Key=DockMixer}" HorizontalAlignment="Left" Click="OnDockMixer"/>
        </StackPanel>
      <ContentControl Name="MixerHost" HorizontalContentAlignment="Stretch">
      <!-- The panel Pop out moves: the channel tiles below, or a skin's mix
           banks in their place (Views/MixerPanel.axaml). -->
      <views:MixerPanel Name="MixerPanel">
      <views:MixerPanel.Header>
      <StackPanel>
        <TextBlock Text="{Binding MixerPlaceholder}" TextWrapping="Wrap"
                   Classes="note" IsVisible="{Binding !HasMixer}"/>

        <!-- the compact and mini views' choices; the view itself is chosen in Options -->
        <StackPanel Spacing="4" Margin="0,0,0,8" IsVisible="{Binding ShowChannelSelector}">
          <WrapPanel>
            <ComboBox Name="CompactChannelPicker" ItemsSource="{Binding Channels}" Margin="0,0,8,4"
                      SelectedItem="{Binding SelectedCompactChannel, Mode=TwoWay}" MinWidth="150" MaxWidth="260"
                      AutomationProperties.Name="{loc:Text Key=ChannelShown}" ToolTip.Tip="{loc:Text Key=TheChannelThisViewShowsHiddenChannels}">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ChannelViewModel"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox Name="CompactMixPicker" ItemsSource="{Binding Mixes}" Margin="0,0,8,4"
                      SelectedItem="{Binding SelectedCompactMix, Mode=TwoWay}" MinWidth="150" MaxWidth="260"
                      IsVisible="{Binding ShowMixSelector}" AutomationProperties.Name="{loc:Text Key=MixShown}"
                      ToolTip.Tip="{loc:Text Key=TheMixThisViewShowsItsMaster}">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:MixViewModel"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </WrapPanel>
          <TextBlock Text="{Binding ViewPreferenceError}" Classes="warn" TextWrapping="Wrap"
                     IsVisible="{Binding ViewPreferenceError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
      </StackPanel>
      </views:MixerPanel.Header>
      <views:MixerPanel.Tiles>
      <DockPanel>
        <!-- Mix masters control the outgoing mixes, separate from the channel sends. -->
        <StackPanel DockPanel.Dock="Bottom" IsVisible="{Binding HasMixer}" Margin="0,10,0,0" Spacing="8">
        <TextBlock Name="OutputMixHeading" Text="{loc:Text Key=OutputMixesHeading}" Classes="h"/>
        <ItemsControl ItemsSource="{Binding Mixes}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MixViewModel">
              <Border Classes="tile" Padding="10" Margin="0,0,8,8" Width="{DynamicResource Ox.Mixer.MixWidth}"
                      IsVisible="{Binding DisplayVisible}" Classes.revealed="{Binding Revealed}">
                <StackPanel Spacing="6">
                  <Button Classes="ghost reorderHandle" Classes.fixedPlace="{Binding !IsEditable}" Content="↔" Tag="{Binding}"
                          HorizontalAlignment="Left" AutomationProperties.Name="{Binding Name, StringFormat={loc:Text Key=MoveItem}}"
                          ToolTip.Tip="{loc:Text Key=DragOntoAnotherMixYouAddedArrow}"/>
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <vm:LayoutIconBlock Icon="{Binding Appearance.Icon}" Fallback="{Binding Appearance.DefaultIcon}" Classes="strip" Classes.layoutAccent="{Binding Appearance.HasColour}"
                               IsVisible="{Binding Appearance.HasIcon}" Margin="0,0,6,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="strip" Classes.layoutAccent="{Binding Appearance.HasColour}"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding VolumeText}" Classes="val"/>
                  </Grid>
                  <StackPanel Spacing="1">
                    <skin:LevelMeter Level="{Binding MeterL}" AutomationProperties.Name="{loc:Text Key=LeftLevel}"/>
                    <skin:LevelMeter Level="{Binding MeterR}" AutomationProperties.Name="{loc:Text Key=RightLevel}"/>
                  </StackPanel>
                  <Slider vm:FaderInput.Step="0.01" Minimum="0" Maximum="{Binding VolumeRange.Maximum}" Value="{Binding Volume, Mode=TwoWay}"/>
                  <Grid ColumnDefinitions="*,Auto">
                    <ToggleButton Content="{loc:Text Key=Mute}" Classes="mute" IsChecked="{Binding Muted, Mode=TwoWay}"/>
                    <ToggleButton Grid.Column="1" Content="150%" IsChecked="{Binding VolumeRange.Boost, Mode=TwoWay}"
                                  IsVisible="{Binding IsMonitor}" Margin="6,0,0,0"
                                  ToolTip.Tip="{loc:Text Key=AllowThisMonitorMixAbove100Up}"/>
                  </Grid>
                  <Button Content="{Binding Inserts.ButtonText}" HorizontalAlignment="Stretch" Classes="fx" Classes.fxOn="{Binding Inserts.IsProcessing}" Classes.fxOff="{Binding Inserts.IsOff}"
                          HorizontalContentAlignment="Center" Padding="8,4" FontSize="12" Click="OnMixInserts"
                          ToolTip.Tip="{loc:Text Key=StereoPluginsProcessingThisMixBeforeItReaches}"/>
                  <!-- the chain at a glance: LED, name, bypass, controls; adding,
                       ordering and removing live in the chain window -->
                  <ItemsControl ItemsSource="{Binding Inserts.Items}" IsVisible="{Binding Inserts.HasItems}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:InsertViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,2,0,0">
                          <skin:StatusLed IsOn="{Binding IsActive}" Kind="Insert" Margin="0,0,6,0"
                                          AutomationProperties.Name="{loc:Text Key=PluginState}"/>
                          <TextBlock Grid.Column="1" Text="{Binding Label}" Classes="insertName body"
                                     FontSize="11" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}"/>
                          <ToggleButton Grid.Column="2" Content="{loc:Text Key=NativeHostLetter}" Classes="insertmini"
                                        IsChecked="{Binding NativeHost, Mode=TwoWay}"
                                        IsVisible="{Binding CanChooseNativeHost}"
                                        IsEnabled="{Binding CanTurnNativeHostOn}"
                                        Margin="4,0,0,0" HorizontalAlignment="Right"
                                        AutomationProperties.Name="{loc:Text Key=RunThisPluginInItsOwnProcess}"
                                        ToolTip.Tip="{loc:Text Key=RunThisPluginInItsOwnProcessWhich}"/>
                          <ToggleButton Grid.Column="3" Content="{loc:Text Key=BypassLetter}" Classes="insertmini bypass"
                                        IsChecked="{Binding Bypass, Mode=TwoWay}"
                                        Margin="4,0,2,0" HorizontalAlignment="Right"
                                        AutomationProperties.Name="{loc:Text Key=BypassThisPlugin}"
                                        ToolTip.Tip="{loc:Text Key=Bypass}"/>
                          <Button Grid.Column="4" Content="⚙" Classes="insertmini"
                                  AutomationProperties.Name="{loc:Text Key=OpenThisPluginSControls}"
                                  Click="OnInsertControls" ToolTip.Tip="{Binding ControlsHint}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ToggleButton Content="{loc:Text Key=ToUSBAuxPort}" IsChecked="{Binding AuxPortEnabled, Mode=TwoWay}"
                                IsVisible="{Binding ShowAuxPortToggle}"
                                ToolTip.Tip="{loc:Text Key=SendThisMixToTheSecondComputerOn}"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>

        <!-- channel strips: one column per channel, one fader per mix -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding HasMixer}">
          <!-- One size scope for every tile's volume row, so a send row sits at
               the same height in every tile. -->
          <ItemsControl Name="ChannelTiles" ItemsSource="{Binding Channels}" Grid.IsSharedSizeScope="True">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ChannelViewModel">
                <!-- A tile out of sight keeps its volume row to itself, so it holds
                     no space open in the tiles that are shown. -->
                <Border Classes="tile" Padding="10" Margin="0,0,8,0" Width="{DynamicResource Ox.Mixer.ChannelWidth}"
                        IsVisible="{Binding DisplayVisible}" Classes.revealed="{Binding Revealed}"
                        Grid.IsSharedSizeScope="{Binding !DisplayVisible}">
                  <StackPanel Spacing="8">
                    <Button Classes="ghost reorderHandle" Classes.fixedPlace="{Binding !IsEditable}" Content="↔" Tag="{Binding}"
                            HorizontalAlignment="Left" AutomationProperties.Name="{Binding Name, StringFormat={loc:Text Key=MoveItem}}"
                            ToolTip.Tip="{loc:Text Key=DragOntoAnotherChannelYouCanEdit}"/>
                    <!-- the icon before the name on one line; the gap sits on the icon, so a
                         name without one starts at the tile's edge -->
                    <Grid Name="ChannelNameLine" ColumnDefinitions="Auto,*">
                      <vm:LayoutIconBlock Name="ChannelIcon" Icon="{Binding Appearance.Icon}" Fallback="{Binding Appearance.DefaultIcon}" Margin="0,0,6,0"
                                          Classes="strip" Classes.layoutAccent="{Binding Appearance.HasColour}"
                                          VerticalAlignment="Center" IsVisible="{Binding Appearance.HasIcon}"/>
                      <TextBlock Name="ChannelName" Grid.Column="1" Text="{Binding Name}" Classes="strip" Classes.layoutAccent="{Binding Appearance.HasColour}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                    </Grid>
                    <!-- stereo level meter (L over R), dB scale -->
                    <StackPanel Spacing="1">
                      <skin:LevelMeter Level="{Binding MeterL}" AutomationProperties.Name="{loc:Text Key=LeftLevel}"/>
                      <skin:LevelMeter Level="{Binding MeterR}" Classes.monoSpare="{Binding MonoMeter}" AutomationProperties.Name="{loc:Text Key=RightLevel}"/>
                    </StackPanel>
                    <!-- the channel's own volume, over every send below it; the row is as
                         tall in every tile, and empty only in a tile whose channel the
                         daemon reports no volume for, while any shown tile has one. On the
                         channel the Wave XLR Pro's direct path carries to the jacks, a mark
                         beside the label and the fader's tooltip say the volume reaches the
                         mixes only. -->
                    <Grid Name="ChannelSendArea">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" SharedSizeGroup="ChannelVolumeRow"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <StackPanel Name="ChannelVolume" Spacing="1" IsVisible="{Binding HasVolume}" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <TextBlock Text="{loc:Text Key=Volume}" Classes="h" FontSize="11"
                                     TextTrimming="CharacterEllipsis" Margin="0,0,4,0"/>
                          <TextBlock Grid.Column="1" Name="ChannelVolumeNote" Text="&#x24D8;" Classes="h" FontSize="12"
                                     Margin="0,-1,4,0" HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Help"
                                     IsVisible="{Binding DirectMonitored}" ToolTip.Tip="{Binding VolumeTip}"
                                     AutomationProperties.Name="{loc:Text Key=ChannelVolumeMixesOnly}"/>
                          <TextBlock Grid.Column="2" Text="{Binding VolumeText}" Classes="val" FontSize="11"/>
                        </Grid>
                        <Slider vm:FaderInput.Step="0.01" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}"
                                vm:FaderInput.IsAdjusting="{Binding VolumeAdjusting, Mode=OneWayToSource}"
                                AutomationProperties.Name="{Binding Name, StringFormat={loc:Text Key=ChannelVolumeName}}"
                                ToolTip.Tip="{Binding VolumeTip}"/>
                      </StackPanel>
                      <ItemsControl Grid.Row="1" ItemsSource="{Binding Sends}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SendViewModel">
                            <StackPanel Margin="0,0,0,8" Spacing="1" IsVisible="{Binding DisplayVisible}" Classes.revealed="{Binding MixRevealed}">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding MixName}" Classes="h" FontSize="11"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MixName}" Margin="0,0,4,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding LevelText}" Classes="val" FontSize="11"/>
                              </Grid>
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <Slider vm:FaderInput.Step="0.01" Minimum="0" Maximum="1" Value="{Binding Level, Mode=TwoWay}"
                                        VerticalAlignment="Center"/>
                                <ToggleButton Grid.Column="1" Classes="mute mutemini" IsChecked="{Binding Muted, Mode=TwoWay}"
                                              Padding="7,2" FontSize="11" MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}" VerticalAlignment="Center"/>
                              </Grid>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
      </views:MixerPanel.Tiles>
      </views:MixerPanel>
      </ContentControl>
      </Grid>
      </Expander>
    </Border>
    </StackPanel>
    </vm:SectionScroller>
  </StackPanel>
  </ScrollViewer>
</Window>
