<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenXLR.UI"
        x:Class="OpenXLR.UI.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="OpenXLR" Width="1040" Height="900" MinHeight="640"
        Icon="avares://OpenXLR.UI/Assets/icon.png"
        Background="#16181d">

  <!-- flat rectangular fader knobs instead of the round Fluent thumb: the
       Fluent slider sizes its thumb from these theme resources -->
  <Window.Resources>
    <x:Double x:Key="SliderHorizontalThumbWidth">22</x:Double>
    <x:Double x:Key="SliderHorizontalThumbHeight">10</x:Double>
    <x:Double x:Key="SliderVerticalThumbWidth">10</x:Double>
    <x:Double x:Key="SliderVerticalThumbHeight">22</x:Double>
    <CornerRadius x:Key="SliderThumbCornerRadius">2</CornerRadius>

    <ControlTheme x:Key="TileExpanderTheme" TargetType="Expander">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Template">
        <ControlTemplate>
          <DockPanel>
            <!-- ClickMode=Press: the default Release mode re-hit-tests the
                 pointer position on release through a path that misses over
                 the chevron glyph at fractional display scaling, silently
                 dropping the click; the press pipeline is reliable -->
            <ToggleButton DockPanel.Dock="Top" HorizontalAlignment="Stretch" Cursor="Hand"
                          ClickMode="Press"
                          IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Grid ColumnDefinitions="*,Auto" Background="Transparent" Margin="0,0,0,4">
                    <ContentPresenter Content="{Binding $parent[Expander].Header}"
                                      VerticalAlignment="Center"/>
                    <!-- decorative: hit-testable glyph ink makes the button's
                         release-position check flaky, eating the click -->
                    <TextBlock Grid.Column="1" Classes="h" VerticalAlignment="Center" IsHitTestVisible="False"
                               Text="{Binding $parent[Expander].IsExpanded, Converter={x:Static vm:Converters.Chevron}}"/>
                  </Grid>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              IsVisible="{TemplateBinding IsExpanded}"/>
          </DockPanel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Slider /template/ Thumb">
      <Setter Property="CornerRadius" Value="2"/>
    </Style>
    <Style Selector="TextBlock.h">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#8b93a7"/>
    </Style>
    <Style Selector="TextBlock.val">
      <Setter Property="Foreground" Value="#e6e9f0"/>
      <Setter Property="FontFamily" Value="monospace"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#1d2027"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,9"/>
    </Style>
    <!-- compact device-control rows: shorter sliders and buttons than the
         theme default so the fixed cards stay small (the submixer keeps its
         own sizing) -->
    <Style Selector="StackPanel.dev Slider">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="StackPanel.dev ToggleButton">
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <!-- collapsible tiles: a flat expander whose header looks like the old card title -->
    <Style Selector="Expander.tile">
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="IsExpanded" Value="True"/>
    </Style>
    <Style Selector="ToggleButton">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="8,5"/>
    </Style>
    <!-- mute buttons: green while audio passes, red when muted. The compact
         strip buttons also swap their letter: O = open, M = muted. -->
    <Style Selector="ToggleButton.mutemini">
      <Setter Property="Content" Value="O"/>
    </Style>
    <Style Selector="ToggleButton.mutemini:checked">
      <Setter Property="Content" Value="M"/>
    </Style>
    <Style Selector="ToggleButton.mute">
      <Setter Property="Background" Value="#1e5c3a"/>
      <Setter Property="Foreground" Value="#d9efe2"/>
    </Style>
    <Style Selector="ToggleButton.mute:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#27754b"/>
    </Style>
    <Style Selector="ToggleButton.mute:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#a03434"/>
      <Setter Property="Foreground" Value="#f6dede"/>
    </Style>
  </Window.Styles>

  <!-- MaxWidth keeps sliders and dropdowns a sane length on an ultrawide or when
       maximized; without it a fader stretches across the whole screen. Every
       card sizes to its content; the page scrolls when the window is shorter. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="16" MaxWidth="1300" HorizontalAlignment="Center">

    <!-- header -->
    <Border Classes="card" Margin="0,0,0,8">
      <Grid ColumnDefinitions="Auto,8,*,Auto">
        <Button Name="OptionsButton" Content="⚙" FontSize="18" Padding="8,4"
                VerticalAlignment="Center" Background="Transparent"
                Click="OnOptions" ToolTip.Tip="Options"/>
        <StackPanel Grid.Column="2">
          <TextBlock Text="OpenXLR" FontSize="20" FontWeight="Bold" Foreground="#e6e9f0"/>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                     Fill="{Binding DeviceConnected, Converter={x:Static vm:Converters.BoolToBrush}}"/>
            <TextBlock Text="{Binding StatusLine}" Classes="h" VerticalAlignment="Center"
                       IsVisible="{Binding !HasMultipleDevices}"/>
            <DropDownButton Name="DevicePicker" Content="{Binding ActiveDeviceName}" FontSize="11" Padding="6,1"
                            MinHeight="0" VerticalAlignment="Center" Background="Transparent"
                            IsVisible="{Binding HasMultipleDevices}"
                            ToolTip.Tip="More than one supported interface is attached; pick which one OpenXLR drives">
              <DropDownButton.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <ItemsControl ItemsSource="{Binding DetectedDevices}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DetectedDeviceItem">
                        <Button Content="{Binding Name}" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left" FontSize="12"
                                Background="Transparent" Click="OnPickDevice" Tag="{Binding}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Flyout>
              </DropDownButton.Flyout>
            </DropDownButton>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <DropDownButton Content="Profiles" Padding="10,3" FontSize="12" Background="Transparent"
                          ToolTip.Tip="Save and recall complete scenes: hardware DSP plus the whole submix">
            <DropDownButton.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel MinWidth="240" Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Name="ProfileNameBox" PlaceholderText="profile name" FontSize="12"/>
                    <Button Grid.Column="1" Content="Save" Margin="6,0,0,0" FontSize="12"
                            Click="OnProfileSave"/>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Grid ColumnDefinitions="*,Auto">
                          <Button Content="{Binding}" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left" FontSize="12"
                                  Background="Transparent" Click="OnProfileLoad"
                                  ToolTip.Tip="Load this profile"/>
                          <Button Grid.Column="1" Content="&#x2715;" FontSize="11" Padding="6,3"
                                  Background="Transparent" Click="OnProfileDelete"
                                  Tag="{Binding}" ToolTip.Tip="Delete this profile"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="no profiles saved yet" Classes="h" FontSize="11"
                             IsVisible="{Binding !Profiles.Count}"/>
                  <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0" IsVisible="{Binding !!Profiles.Count}"
                        ToolTip.Tip="Recalled when the interface connects: daemon start, a replug or power cycle, or switching to it">
                    <TextBlock Text="On connect" Classes="h" FontSize="11" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" Margin="8,0,0,0" FontSize="12" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding RecallChoices}"
                              SelectedItem="{Binding RecallOnConnectChoice}"/>
                  </Grid>
                </StackPanel>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>
          <Button Content="Flow" Padding="10,3" FontSize="12" Background="Transparent"
                  Click="OnFlow" ToolTip.Tip="Show the live audio routing graph"/>
          <Button Content="Restart daemon" Padding="10,3" FontSize="12" Background="Transparent"
                  IsEnabled="{Binding DaemonRestart.CanRestart}" Click="OnRestartDaemon"
                  ToolTip.Tip="Restart the OpenXLR user service. Audio will be interrupted briefly."/>
          <TextBlock Name="HeaderVersion" Text="v0.0.0" Classes="h" VerticalAlignment="Center"/>
          <Button Content="About" Padding="10,3" FontSize="12" Background="Transparent"
                  Click="OnAbout"/>
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock Text="{Binding DaemonRestart.Status}" Classes="h" TextWrapping="Wrap"
               Margin="0,0,0,8" IsVisible="{Binding DaemonRestart.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

    <!-- a daemon left running across an upgrade offers the old version's controls -->
    <Border Classes="card" Margin="0,0,0,8" IsVisible="{Binding DaemonVersionMismatch}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Restart daemon" Padding="10,3" FontSize="12"
                IsEnabled="{Binding DaemonRestart.CanRestart}"
                VerticalAlignment="Center" Click="OnRestartDaemon"
                ToolTip.Tip="systemctl --user restart openxlr-daemon"/>
        <TextBlock Text="{Binding DaemonVersionNote}" Classes="h" TextWrapping="Wrap"
                   VerticalAlignment="Center" Margin="0,0,12,0"/>
      </DockPanel>
    </Border>

    <!-- device controls -->
    <Border Classes="card" Margin="0,0,0,8">
      <Expander Name="InputsTile" Classes="tile" Theme="{StaticResource TileExpanderTheme}" IsExpanded="True">
        <Expander.Header><TextBlock Text="INPUTS" Classes="h"/></Expander.Header>
      <StackPanel Classes="dev" Spacing="4">

        <!-- XLR 1 -->
        <Grid ColumnDefinitions="90,*,64,Auto">
          <TextBlock Text="XLR 1 gain" Classes="h" VerticalAlignment="Center"/>
          <Slider Grid.Column="1" Minimum="0" Maximum="80" TickFrequency="1" IsSnapToTickEnabled="True"
                  Value="{Binding GainDb, Mode=TwoWay}" IsEnabled="{Binding !GainLocked}"/>
          <TextBlock Grid.Column="2" Text="{Binding GainText}" Classes="val" VerticalAlignment="Center"
                     HorizontalAlignment="Right"/>
          <ToggleButton Grid.Column="3" Content="Lock" Classes="mute" FontSize="11" Padding="8,2"
                        Margin="6,0,0,0" MinWidth="0" IsVisible="{Binding ShowGainLock}"
                        IsChecked="{Binding GainLocked, Mode=TwoWay}" VerticalAlignment="Center"
                        ToolTip.Tip="Gain lock: the daemon rejects every gain change while set"/>
        </Grid>
        <UniformGrid Columns="7">
          <ToggleButton Content="{Binding MuteLabel}" Classes="mute" IsChecked="{Binding Mute, Mode=TwoWay}" Margin="0,0,6,0"
                        IsEnabled="{Binding !PhantomSettling}"
                        ToolTip.Tip="The device mutes this input for about 13 seconds around every 48V change and unmutes it itself"/>
          <ToggleButton Content="Low Cut"    IsChecked="{Binding LowCut, Mode=TwoWay}"     Margin="0,0,6,0" IsVisible="{Binding CapLowCut}"/>
          <ToggleButton Content="{Binding SoftLowCutText}" Margin="0,0,6,0" IsVisible="{Binding ShowSoftLowCut}"
                        IsChecked="{Binding SoftLowCutOn, Mode=OneWay}" Click="OnCycleSoftLowCut"
                        ToolTip.Tip="Host-side low cut for this device (its DSP lives in software); cycles Off, 80 Hz, 120 Hz"/>
          <ToggleButton Content="ClipGuard" Margin="0,0,6,0" IsVisible="{Binding ShowSoftClipGuard}"
                        IsChecked="{Binding SoftClipGuard, Mode=TwoWay}"
                        IsEnabled="{Binding SoftClipGuardAvailable}"
                        ToolTip.Tip="{Binding SoftClipGuardTip}"/>
          <ToggleButton Content="Expander"   IsChecked="{Binding Expander, Mode=TwoWay}"   Margin="0,0,6,0" IsVisible="{Binding CapExpander}"/>
          <ToggleButton Content="Voice Tune" IsChecked="{Binding VoiceTune, Mode=TwoWay}"  Margin="0,0,6,0" IsVisible="{Binding CapVoiceTune}"/>
          <ToggleButton Content="Phantom"  IsChecked="{Binding Phantom, Mode=TwoWay}"    Margin="0,0,6,0" IsVisible="{Binding CapPhantom}"/>
          <ToggleButton Content="ClipGuard" IsChecked="{Binding ClipGuard, Mode=TwoWay}" Margin="0,0,6,0" IsVisible="{Binding CapClipGuard}"/>
          <ToggleButton Content="Compressor" IsChecked="{Binding Compressor, Mode=TwoWay}" IsVisible="{Binding CapCompressor}"/>
        </UniformGrid>
        <Grid ColumnDefinitions="90,*,64" IsVisible="{Binding VoiceTune}">
          <TextBlock Text="VT strength" Classes="h" VerticalAlignment="Center"/>
          <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                  Value="{Binding VoiceTuneStrength, Mode=TwoWay}"/>
          <TextBlock Grid.Column="2" Text="{Binding VoiceTuneStrengthText}" Classes="val"
                     VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <!-- XLR 1 plugin inserts: LV2 plugins in the mic path, after the
             software low cut and ClipGuard, heard by every mix. The picker
             and each plugin's controls open in their own windows. -->
        <StackPanel Spacing="4" Margin="0,4,0,0" IsVisible="{Binding HasMixer}">
          <Grid ColumnDefinitions="90,*,Auto">
            <TextBlock Text="Inserts" Classes="h" VerticalAlignment="Center"
                       ToolTip.Tip="LV2 plugins processing XLR 1 before it reaches the mixes"/>
            <TextBlock Grid.Column="1" Text="{Binding Inserts.Summary}" Classes="h" FontSize="11" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="Add plugin…" Padding="12,3" FontSize="12" MinHeight="0" Click="OnAddInsert"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding Inserts.Items}" IsVisible="{Binding Inserts.HasItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InsertViewModel">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,3">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                             Fill="{Binding IsActive, Converter={x:Static vm:Converters.ActiveLed}}"/>
                    <TextBlock Text="{Binding Label}" Foreground="#e6e9f0" FontSize="12"/>
                    <TextBlock Text="{Binding StateText}" Classes="h" FontSize="11"/>
                    <TextBlock Text="{Binding Error}" Foreground="#e0a05a" FontSize="11" IsVisible="{Binding HasError}"/>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Controls" Padding="8,1" MinHeight="0" FontSize="11" Margin="0,0,4,0"
                          Click="OnInsertControls" ToolTip.Tip="Open this plugin's controls in a window"/>
                  <ToggleButton Grid.Column="2" Content="Bypass" IsChecked="{Binding Bypass, Mode=TwoWay}"
                                Padding="8,1" MinHeight="0" FontSize="11" Margin="0,0,4,0"/>
                  <Button Grid.Column="3" Content="▲" Padding="6,1" MinHeight="0" FontSize="10" Margin="0,0,2,0"
                          Click="OnInsertUp" ToolTip.Tip="Move earlier in the chain"/>
                  <Button Grid.Column="4" Content="▼" Padding="6,1" MinHeight="0" FontSize="10" Margin="0,0,4,0"
                          Click="OnInsertDown" ToolTip.Tip="Move later in the chain"/>
                  <Button Grid.Column="5" Content="✕" Padding="6,1" MinHeight="0" FontSize="10"
                          Click="OnInsertRemove" ToolTip.Tip="Remove this insert"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- XLR 2 -->
        <Grid ColumnDefinitions="90,*,64" Margin="0,2,0,0" IsVisible="{Binding HasXlr2}">
          <TextBlock Text="XLR 2 gain" Classes="h" VerticalAlignment="Center"/>
          <Slider Grid.Column="1" Minimum="0" Maximum="80" TickFrequency="1" IsSnapToTickEnabled="True"
                  Value="{Binding Gain2Db, Mode=TwoWay}" IsEnabled="{Binding !GainLocked}"/>
          <TextBlock Grid.Column="2" Text="{Binding Gain2Text}" Classes="val" VerticalAlignment="Center"
                     HorizontalAlignment="Right"/>
        </Grid>
        <UniformGrid Columns="7" IsVisible="{Binding HasXlr2}">
          <ToggleButton Content="{Binding Mute2Label}" Classes="mute" IsChecked="{Binding Mute2, Mode=TwoWay}" Margin="0,0,6,0"
                        IsEnabled="{Binding !PhantomSettling2}"
                        ToolTip.Tip="The device mutes this input for about 13 seconds around every 48V change and unmutes it itself"/>
          <ToggleButton Content="Low Cut"    IsChecked="{Binding LowCut2, Mode=TwoWay}"     Margin="0,0,6,0"/>
          <ToggleButton Content="Expander"   IsChecked="{Binding Expander2, Mode=TwoWay}"   Margin="0,0,6,0"/>
          <ToggleButton Content="Voice Tune" IsChecked="{Binding VoiceTune2, Mode=TwoWay}"  Margin="0,0,6,0"/>
          <ToggleButton Content="Phantom"  IsChecked="{Binding Phantom2, Mode=TwoWay}"    Margin="0,0,6,0"/>
          <ToggleButton Content="ClipGuard" IsChecked="{Binding ClipGuard2, Mode=TwoWay}" Margin="0,0,6,0"/>
          <ToggleButton Content="Compressor" IsChecked="{Binding Compressor2, Mode=TwoWay}"/>
        </UniformGrid>
        <!-- XLR 2 plugin inserts: same chain concept, its own mono filter-chain -->
        <StackPanel IsVisible="{Binding HasXlr2}">
        <StackPanel Spacing="4" Margin="0,4,0,0" IsVisible="{Binding HasMixer}">
          <Grid ColumnDefinitions="90,*,Auto">
            <TextBlock Text="Inserts" Classes="h" VerticalAlignment="Center"
                       ToolTip.Tip="LV2 plugins processing XLR 2 before it reaches the mixes"/>
            <TextBlock Grid.Column="1" Text="{Binding Inserts2.Summary}" Classes="h" FontSize="11" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="Add plugin…" Padding="12,3" FontSize="12" MinHeight="0" Tag="xlr2" Click="OnAddInsert"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding Inserts2.Items}" IsVisible="{Binding Inserts2.HasItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InsertViewModel">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,3">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                             Fill="{Binding IsActive, Converter={x:Static vm:Converters.ActiveLed}}"/>
                    <TextBlock Text="{Binding Label}" Foreground="#e6e9f0" FontSize="12"/>
                    <TextBlock Text="{Binding StateText}" Classes="h" FontSize="11"/>
                    <TextBlock Text="{Binding Error}" Foreground="#e0a05a" FontSize="11" IsVisible="{Binding HasError}"/>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Controls" Padding="8,1" MinHeight="0" FontSize="11" Margin="0,0,4,0"
                          Click="OnInsertControls" ToolTip.Tip="Open this plugin's controls in a window"/>
                  <ToggleButton Grid.Column="2" Content="Bypass" IsChecked="{Binding Bypass, Mode=TwoWay}"
                                Padding="8,1" MinHeight="0" FontSize="11" Margin="0,0,4,0"/>
                  <Button Grid.Column="3" Content="▲" Padding="6,1" MinHeight="0" FontSize="10" Margin="0,0,2,0"
                          Click="OnInsertUp" ToolTip.Tip="Move earlier in the chain"/>
                  <Button Grid.Column="4" Content="▼" Padding="6,1" MinHeight="0" FontSize="10" Margin="0,0,4,0"
                          Click="OnInsertDown" ToolTip.Tip="Move later in the chain"/>
                  <Button Grid.Column="5" Content="✕" Padding="6,1" MinHeight="0" FontSize="10"
                          Click="OnInsertRemove" ToolTip.Tip="Remove this insert"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        </StackPanel>

        <Grid ColumnDefinitions="90,*,64" IsVisible="{Binding VoiceTune2}">
          <TextBlock Text="VT strength" Classes="h" VerticalAlignment="Center"/>
          <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                  Value="{Binding VoiceTuneStrength2, Mode=TwoWay}"/>
          <TextBlock Grid.Column="2" Text="{Binding VoiceTuneStrength2Text}" Classes="val"
                     VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <!-- USB Aux input stage -->
        <Grid ColumnDefinitions="90,*,64,20,110" Margin="0,2,0,0" IsVisible="{Binding CapAuxInput}">
          <TextBlock Text="USB Aux in" Classes="h" VerticalAlignment="Center"/>
          <Slider Grid.Column="1" Minimum="-60" Maximum="0"
                  Value="{Binding AuxLevelDb, Mode=TwoWay}"/>
          <TextBlock Grid.Column="2" Text="{Binding AuxLevelText}" Classes="val" VerticalAlignment="Center"
                     HorizontalAlignment="Right"/>
          <ToggleButton Grid.Column="4" Content="Level Lock" IsChecked="{Binding AuxLevelLock, Mode=TwoWay}"/>
        </Grid>
      </StackPanel>
      </Expander>
    </Border>

    <!-- headphone outputs (jack 1 on the front of the unit, jack 2 on the back) -->
    <Border Classes="card" Margin="0,0,0,8">
      <Expander Name="HeadphonesTile" Classes="tile" Theme="{StaticResource TileExpanderTheme}" IsExpanded="True">
        <Expander.Header><TextBlock Text="HEADPHONES" Classes="h"/></Expander.Header>
      <StackPanel Classes="dev" Spacing="4">
        <Grid ColumnDefinitions="90,*,64,20,90,*,64">
          <TextBlock Text="Phones 1" Classes="h" VerticalAlignment="Center" ToolTip.Tip="Front jack"/>
          <Slider Grid.Column="1" Minimum="0" Maximum="100"
                  Value="{Binding HpPercent, Mode=TwoWay}"/>
          <TextBlock Grid.Column="2" Text="{Binding HpText}" Classes="val" VerticalAlignment="Center"
                     HorizontalAlignment="Right"/>
          <TextBlock Grid.Column="4" Text="Phones 2" Classes="h" VerticalAlignment="Center" ToolTip.Tip="Rear jack"
                     IsVisible="{Binding HasHp2}"/>
          <Slider Grid.Column="5" Minimum="0" Maximum="100"
                  Value="{Binding Hp2Percent, Mode=TwoWay}" IsVisible="{Binding HasHp2}"/>
          <TextBlock Grid.Column="6" Text="{Binding Hp2Text}" Classes="val" VerticalAlignment="Center"
                     HorizontalAlignment="Right" IsVisible="{Binding HasHp2}"/>
        </Grid>
        <!-- hardware zero-latency blend between mic direct and PC playback;
             the value column fits the widest readout, "mic +100" -->
        <Grid ColumnDefinitions="90,*,74" IsVisible="{Binding CapCrossfade}">
          <TextBlock Text="Mic ↔ PC" Classes="h" VerticalAlignment="Center"
                     ToolTip.Tip="Direct-monitor blend: left = only your mic, right = only PC audio"/>
          <Slider Grid.Column="1" Minimum="0" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True"
                  Value="{Binding Crossfade, Mode=TwoWay}"/>
          <TextBlock Grid.Column="2" Text="{Binding CrossfadeText}" Classes="val"
                     VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
        <UniformGrid Columns="7">
          <ToggleButton Content="Low Imp." IsChecked="{Binding LowImpedance, Mode=TwoWay}" Margin="0,0,6,0"
                        IsVisible="{Binding CapLowImpedance}"/>
        </UniformGrid>
      </StackPanel>
      </Expander>
    </Border>

    <!-- monitor destination: the device you hear the Monitor mix on -->
    <Border Classes="card" Margin="0,0,0,8" IsVisible="{Binding HasMixer}">
      <Expander Name="MonitorTile" Classes="tile" Theme="{StaticResource TileExpanderTheme}" IsExpanded="True">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="MONITOR" Classes="h" VerticalAlignment="Center"/>
            <TextBlock Text="&#x24D8;" Classes="h" FontSize="12" VerticalAlignment="Center" Margin="0,-1,0,0" Cursor="Help"
                       ToolTip.Tip="Tick every device the Monitor mix should play on. The Wave XLR Pro's own outputs (Headphones 1/2, USB Aux, Line Out) switch the hardware when ticked. The USB Aux port is fed by the dedicated Aux mix in the submixer instead. XLR 1, XLR 2 and Line In feed their channels automatically. System default devices for apps are set in Options."/>
          </StackPanel>
        </Expander.Header>
      <StackPanel Classes="dev" Spacing="4">
        <Grid ColumnDefinitions="90,*,20,90,*,64">
          <TextBlock Text="Devices" Classes="h" VerticalAlignment="Center"/>
          <DropDownButton Grid.Column="1" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          Content="{Binding MonitorSummary}">
            <DropDownButton.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <ItemsControl ItemsSource="{Binding MonitorOutputs}" MinWidth="320">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MonitorOutputItem">
                      <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                Padding="8,4" HorizontalAlignment="Stretch"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Flyout>
            </DropDownButton.Flyout>
          </DropDownButton>

          <TextBlock Grid.Column="3" Text="Volume" Classes="h" VerticalAlignment="Center"/>
          <Slider Grid.Column="4" Minimum="0" Maximum="1" Value="{Binding OutputVolume, Mode=TwoWay}"/>
          <TextBlock Grid.Column="5" Text="{Binding OutputVolumeText}" Classes="val"
                     VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
      </StackPanel>
      </Expander>
    </Border>

    <!-- running applications and the channel each is routed to -->
    <Border Classes="card" Margin="0,0,0,8" IsVisible="{Binding HasMixer}">
      <Expander Name="ApplicationsTile" Classes="tile" Theme="{StaticResource TileExpanderTheme}" IsExpanded="True">
        <Expander.Header><TextBlock Text="APPLICATIONS" Classes="h"/></Expander.Header>
      <StackPanel Spacing="8">
        <ItemsControl ItemsSource="{Binding ActiveApps}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AppStreamViewModel">
              <Border Background="#23262f" CornerRadius="6" Padding="8,6" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                           Fill="{Binding Active, Converter={x:Static vm:Converters.BoolToBrush}}"
                           ToolTip.Tip="{Binding StatusText}"/>
                  <TextBlock Text="{Binding Label}" Foreground="#e6e9f0" VerticalAlignment="Center"/>
                  <ComboBox ItemsSource="{Binding Channels}" MinWidth="110"
                            SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                     Text="Running audio-capable apps appear here (green light = playing) and are routed automatically. Changing one is remembered."
                     FontSize="11" Foreground="#6b7285"/>
          <Button Grid.Column="1" Content="Manage…" Padding="12,4" Margin="8,0,0,0"
                  Click="OnManageApps" IsEnabled="{Binding HasApps}"/>
        </Grid>
      </StackPanel>
      </Expander>
    </Border>

    <!-- mixer -->
    <Border Classes="card">
      <Expander Name="SubmixerTile" Classes="tile" Theme="{StaticResource TileExpanderTheme}" IsExpanded="True">
        <Expander.Header><TextBlock Text="SUBMIXER" Classes="h"/></Expander.Header>
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8" IsVisible="{Binding HasMixer}">
          <TextBlock Text="Create application channels and virtual outputs; every change is applied to PipeWire."
                     FontSize="11" Foreground="#6b7285" VerticalAlignment="Center" TextWrapping="Wrap"/>
          <Button Grid.Column="1" Content="Channels &amp; outputs…" Padding="12,4" Margin="8,0,0,0"
                  IsEnabled="{Binding CanEditLayout}" Click="OnMixerSetup"/>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="{Binding MixerPlaceholder}" TextWrapping="Wrap"
                   Foreground="#6b7285" IsVisible="{Binding !HasMixer}"/>

        <!-- master row -->
        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Mixes}" IsVisible="{Binding HasMixer}"
                      Margin="0,10,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:MixViewModel">
              <Border Background="#23262f" CornerRadius="6" Padding="10" Margin="0,0,8,0"
                      IsVisible="{Binding Visible}">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Name}" Foreground="#e6e9f0" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding VolumeText}" Classes="val"/>
                  </Grid>
                  <StackPanel Spacing="1">
                    <Border Background="#14161b" CornerRadius="2" Height="4">
                      <Border Background="#3ecf7a" CornerRadius="2" HorizontalAlignment="Stretch"
                              RenderTransformOrigin="0,0.5"
                              RenderTransform="{Binding MeterL, Converter={x:Static vm:Converters.MeterScale}}"/>
                    </Border>
                    <Border Background="#14161b" CornerRadius="2" Height="4">
                      <Border Background="#3ecf7a" CornerRadius="2" HorizontalAlignment="Stretch"
                              RenderTransformOrigin="0,0.5"
                              RenderTransform="{Binding MeterR, Converter={x:Static vm:Converters.MeterScale}}"/>
                    </Border>
                  </StackPanel>
                  <Slider Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}"/>
                  <ToggleButton Content="Mute mix" Classes="mute" IsChecked="{Binding Muted, Mode=TwoWay}"/>
                  <Button Content="{Binding Inserts.ButtonText}" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Center" Padding="8,4" FontSize="12" Click="OnMixInserts"
                          ToolTip.Tip="Stereo LV2 plugins processing this mix before it reaches its outputs"/>
                  <!-- the chain at a glance: LED, name, bypass, controls; adding,
                       ordering and removing live in the chain window -->
                  <ItemsControl ItemsSource="{Binding Inserts.Items}" IsVisible="{Binding Inserts.HasItems}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:InsertViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,2,0,0">
                          <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Fill="{Binding IsActive, Converter={x:Static vm:Converters.ActiveLed}}"/>
                          <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="#e6e9f0" FontSize="11"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}"/>
                          <ToggleButton Grid.Column="2" Content="B" IsChecked="{Binding Bypass, Mode=TwoWay}"
                                        Padding="6,0" MinHeight="0" MinWidth="0" FontSize="10" Margin="4,0,2,0"
                                        HorizontalAlignment="Right" ToolTip.Tip="Bypass"/>
                          <Button Grid.Column="3" Content="⚙" Padding="6,0" MinHeight="0" MinWidth="0" FontSize="10"
                                  Click="OnInsertControls" ToolTip.Tip="Open this plugin's controls"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ToggleButton Content="To USB Aux port" IsChecked="{Binding AuxPortEnabled, Mode=TwoWay}"
                                IsVisible="{Binding IsAuxPort}"
                                ToolTip.Tip="Send this mix to the second computer on the USB Aux port. Enabling briefly interrupts the interface's audio while its stream restarts."/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- channel strips: one column per channel, one fader per mix -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding HasMixer}">
          <!-- MinHeight keeps every send visible; the ScrollViewer scrolls when
               the window is too short rather than clipping the strips. -->
          <ItemsControl ItemsSource="{Binding Channels}" MinHeight="290">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ChannelViewModel">
                <Border Background="#23262f" CornerRadius="6" Padding="10" Margin="0,0,8,0" Width="132"
                        IsVisible="{Binding Visible}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Name}" Foreground="#e6e9f0" FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <!-- stereo level meter (L over R), dB scale -->
                    <StackPanel Spacing="1">
                      <Border Background="#14161b" CornerRadius="2" Height="4">
                        <Border Background="#3ecf7a" CornerRadius="2" HorizontalAlignment="Stretch"
                                RenderTransformOrigin="0,0.5"
                                RenderTransform="{Binding MeterL, Converter={x:Static vm:Converters.MeterScale}}"/>
                      </Border>
                      <Border Background="#14161b" CornerRadius="2" Height="4">
                        <Border Background="#3ecf7a" CornerRadius="2" HorizontalAlignment="Stretch"
                                RenderTransformOrigin="0,0.5"
                                RenderTransform="{Binding MeterR, Converter={x:Static vm:Converters.MeterScale}}"/>
                      </Border>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Sends}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SendViewModel">
                          <StackPanel Margin="0,0,0,8" Spacing="1" IsVisible="{Binding Visible}">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding MixName}" Classes="h" FontSize="11"
                                         TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MixName}"/>
                              <TextBlock Grid.Column="1" Text="{Binding LevelText}" Classes="val" FontSize="11"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                              <Slider Minimum="0" Maximum="1" Value="{Binding Level, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                              <ToggleButton Grid.Column="1" Classes="mute mutemini" IsChecked="{Binding Muted, Mode=TwoWay}"
                                            Padding="7,2" FontSize="11" MinWidth="0" VerticalAlignment="Center"/>
                            </Grid>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
      </Expander>
    </Border>
  </StackPanel>
  </ScrollViewer>
</Window>
