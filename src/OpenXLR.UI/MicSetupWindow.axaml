<Window xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:OpenXLR.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenXLR.UI"
        xmlns:views="using:OpenXLR.UI.Views"
        xmlns:skin="using:OpenXLR.UI.Skinning"
        x:Class="OpenXLR.UI.MicSetupWindow" x:DataType="vm:MicSetupViewModel"
        Title="{loc:Text Key=MicSetup}" Width="640" SizeToContent="Height" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Ox.Window.Background}">
  <!-- Mic setup for one microphone, one step at a time: where the microphone
       goes, the level before any processing, a take heard raw and processed,
       then the EQ, filters, plugins and presets that shape it. Every colour,
       size and radius is an Ox.* token or a control theme; the waveform and
       the embedded EQ graph draw with the EQ editor's colours. The window
       sizes itself to the step shown, up to the screen's height; see the
       code behind. -->
  <DockPanel Margin="16">
    <skin:LitText DockPanel.Dock="Top" Text="{loc:Text Key=MicSetup}" Classes="title" Margin="0,0,0,8"/>

    <!-- the steps, free to jump between: the lit one is shown -->
    <ItemsControl DockPanel.Dock="Top" Name="MicSetupSteps" ItemsSource="{Binding Steps}" Margin="0,0,0,12">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel ItemSpacing="6" LineSpacing="4"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:MicSetupStepItem">
          <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=OneWay}" Click="OnStep" Padding="14,5"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- what the session reports, the daemon's refusal, and closing -->
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
      <TextBlock Name="MicSetupError" Text="{Binding Error}" TextWrapping="Wrap" Classes="warn"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="{loc:Text Key=MicSetupClosingDiscards}" Classes="hint" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Name="MicSetupClose" Content="{loc:Text Key=Close}" Padding="18,6" Click="OnClose" VerticalAlignment="Center"/>
      </Grid>
    </StackPanel>

    <ScrollViewer Name="MicSetupScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Panel Name="MicSetupContent" Margin="0,0,16,0">
        <!-- Position: tips for the unit the microphone is on, and its phantom power -->
        <StackPanel Name="MicSetupPosition" Spacing="12" IsVisible="{Binding ShowsPosition}">
          <!-- the microphone to set up, while the mixer has more than one: a change moves the whole window to it -->
          <Grid Name="MicSetupPicker" ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding ShowsPicker}">
            <TextBlock Text="{loc:Text Key=MicSetupMicrophone}" Classes="h" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" Name="MicSetupInput" ItemsSource="{Binding Inputs.Items, FallbackValue={x:Null}}"
                      SelectedItem="{Binding Picked, Mode=OneWay}" SelectionChanged="OnPickInput" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="{loc:Text Key=MicSetupMicrophoneName}" ToolTip.Tip="{loc:Text Key=MicSetupMicrophoneTip}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MicSetupInput">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <TextBlock Name="MicSetupPositionIntro" Text="{Binding PositionIntro}" Classes="body" TextWrapping="Wrap"/>
          <Border Classes="tile" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="{loc:Text Key=MicSetupPlacement}" Classes="h"/>
              <ItemsControl Name="MicSetupTips" ItemsSource="{Binding PositionTips}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" Classes="body" TextWrapping="Wrap"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <!-- phantom power, where the microphone is not the unit's own capsule -->
          <Border Classes="tile" Padding="12" Name="MicSetupPhantomTile" IsVisible="{Binding ShowsPhantom}">
            <StackPanel Spacing="8">
              <TextBlock Text="{loc:Text Key=MicSetupPhantomPower}" Classes="h"/>
              <TextBlock Text="{loc:Text Key=MicSetupPhantomHint}" Classes="hint" TextWrapping="Wrap"/>
              <WrapPanel Name="MicSetupPhantom" ItemSpacing="8" LineSpacing="4" IsVisible="{Binding HasPhantom}">
                <ToggleButton Name="MicSetupUnitPhantom" Content="{loc:Text Key=Phantom}"
                              IsChecked="{Binding Unit.Phantom, Mode=TwoWay, FallbackValue=False}" IsVisible="{Binding Unit.CapPhantom, FallbackValue=False}"
                              AutomationProperties.Name="{loc:Text Key=MicSetupPhantomName}" ToolTip.Tip="{loc:Text Key=MicSetupPhantomName}"/>
                <ToggleButton Name="MicSetupExtraPhantom" Content="{loc:Text Key=Phantom}"
                              IsChecked="{Binding ExtraUnit.Phantom, Mode=TwoWay, FallbackValue=False}" IsVisible="{Binding ExtraUnit.HasPhantom, FallbackValue=False}"
                              IsEnabled="{Binding ExtraUnit.CanControl, FallbackValue=False}"
                              AutomationProperties.Name="{loc:Text Key=MicSetupPhantomName}" ToolTip.Tip="{loc:Text Key=MicSetupPhantomName}"/>
                <TextBlock Text="{loc:Text Key=PhantomPowerSettling}" Classes="hint" VerticalAlignment="Center"
                           IsVisible="{Binding Unit.PhantomSettling, FallbackValue=False}"/>
                <TextBlock Text="{loc:Text Key=PhantomPowerSettling}" Classes="hint" VerticalAlignment="Center"
                           IsVisible="{Binding ExtraUnit.PhantomSettling, FallbackValue=False}"/>
              </WrapPanel>
              <TextBlock Name="MicSetupPhantomElsewhere" Text="{loc:Text Key=MicSetupPhantomElsewhere}" Classes="hint" TextWrapping="Wrap"
                         IsVisible="{Binding PhantomElsewhere}"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Level: the microphone before any processing, the target band and the clipping warning -->
        <StackPanel Name="MicSetupLevel" Spacing="12" IsVisible="{Binding ShowsLevel}">
          <TextBlock Text="{loc:Text Key=MicSetupLevelHint}" Classes="hint" TextWrapping="Wrap"/>
          <Border Classes="tile" Padding="12">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{loc:Text Key=MicSetupBeforeEffects}" Classes="h" VerticalAlignment="Center"/>
                <skin:LitText Grid.Column="1" Name="MicSetupPeakValue" Text="{Binding PeakText}" Classes="val" VerticalAlignment="Center"/>
              </Grid>
              <!-- the meter, with the band speech should peak in drawn under it: -18 to -6 dBFS on a -60 to 0 scale -->
              <Grid RowDefinitions="Auto,Auto">
                <skin:LevelMeter Name="MicSetupMeter" Level="{Binding InputPeak}" Height="22"
                                 AutomationProperties.Name="{loc:Text Key=MicSetupBeforeEffects}"/>
                <Grid Grid.Row="1" ColumnDefinitions="7*,2*,1*" Margin="0,3,0,0">
                  <Border Grid.Column="1" Name="MicSetupTarget" Height="6" Background="{DynamicResource Ox.Eq.CurveFill}"
                          BorderBrush="{DynamicResource Ox.Eq.Curve}" BorderThickness="1"
                          CornerRadius="{DynamicResource Ox.Meter.CornerRadius}" ToolTip.Tip="{loc:Text Key=MicSetupTargetTip}"/>
                </Grid>
              </Grid>
              <skin:LevelMeter Name="MicSetupRms" Level="{Binding InputLevel}" AutomationProperties.Name="{loc:Text Key=MicSetupAverage}"
                               ToolTip.Tip="{loc:Text Key=MicSetupAverage}"/>
              <TextBlock Text="{loc:Text Key=MicSetupTargetTip}" Classes="hint" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                  <skin:StatusLed Name="MicSetupClipLed" IsOn="{Binding Clipped}" Kind="Power" AutomationProperties.AccessibilityView="Raw"/>
                  <TextBlock Grid.Column="1" Name="MicSetupClipStatus" Text="{Binding ClipStatus}" Classes="body"
                             Classes.warn="{Binding Clipped}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
                <Button Grid.Column="1" Name="MicSetupClip" Content="{loc:Text Key=MicSetupClip}" Click="OnClearClip"
                        IsEnabled="{Binding Clipped}" ToolTip.Tip="{loc:Text Key=MicSetupClipTip}" Padding="10,4"/>
              </Grid>
            </StackPanel>
          </Border>
          <!-- the interface's gain, where the channel carries an input that has one -->
          <Border Classes="tile" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="{loc:Text Key=MicSetupGain}" Classes="h"/>
              <CheckBox Name="MicSetupGainLock" Content="{loc:Text Key=LockInputGain}"
                        IsVisible="{Binding Unit.CanSetGainLock, FallbackValue=False}"
                        IsChecked="{Binding Unit.GainLocked, Mode=TwoWay, FallbackValue=False}"
                        ToolTip.Tip="{loc:Text Key=GainLockTheDaemonRejectsEveryGainChange}"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CarriesUnit}">
                <Slider Name="MicSetupUnitGain" vm:FaderInput.Step="1" Minimum="0" Maximum="{Binding Unit.GainMaxDb, FallbackValue=80}"
                        Value="{Binding Unit.GainDb, Mode=TwoWay, FallbackValue=0}" IsEnabled="{Binding !Unit.GainLocked, FallbackValue=False}"
                        AutomationProperties.Name="{Binding Unit.GainName, FallbackValue=''}"/>
                <NumericUpDown Grid.Column="1" Name="MicSetupUnitGainValue" Minimum="0" Maximum="{Binding Unit.GainMaxDb, FallbackValue=80}"
                               Value="{Binding Unit.GainDb, Mode=TwoWay, FallbackValue=0}" IsEnabled="{Binding !Unit.GainLocked, FallbackValue=False}"
                               FormatString="0" Increment="1" MinWidth="92" VerticalAlignment="Center"
                               AutomationProperties.Name="{Binding Unit.GainName, FallbackValue=''}"/>
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CarriesExtraUnit}">
                <Slider Name="MicSetupExtraGain" vm:FaderInput.Step="1" Minimum="0" Maximum="{Binding ExtraUnit.GainMaxDb, FallbackValue=80}"
                        Value="{Binding ExtraUnit.GainDb, Mode=TwoWay, FallbackValue=0}" IsEnabled="{Binding ExtraUnit.CanAdjustGain, FallbackValue=False}"
                        AutomationProperties.Name="{Binding ExtraUnit.GainName, FallbackValue=''}"/>
                <NumericUpDown Grid.Column="1" Name="MicSetupExtraGainValue" Minimum="0" Maximum="{Binding ExtraUnit.GainMaxDb, FallbackValue=80}"
                               Value="{Binding ExtraUnit.GainDb, Mode=TwoWay, FallbackValue=0}" IsEnabled="{Binding ExtraUnit.CanAdjustGain, FallbackValue=False}"
                               FormatString="0" Increment="1" MinWidth="92" VerticalAlignment="Center"
                               AutomationProperties.Name="{Binding ExtraUnit.GainName, FallbackValue=''}"/>
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding CaptureInput.ShowsCaptureGain, FallbackValue=False}">
                <Slider Name="MicSetupCaptureGain" vm:FaderInput.Step="1" Minimum="{Binding CaptureInput.CaptureGainMinDb, FallbackValue=-60}"
                        Maximum="{Binding CaptureInput.CaptureGainMaxDb, FallbackValue=10}"
                        Value="{Binding CaptureInput.CaptureGainDb, Mode=TwoWay, FallbackValue=0}"
                        AutomationProperties.Name="{Binding CaptureInput.CaptureGainName, FallbackValue=''}"
                        ToolTip.Tip="{Binding CaptureInput.CaptureGainTip}"/>
                <NumericUpDown Grid.Column="1" Name="MicSetupCaptureGainValue" Minimum="{Binding CaptureInput.CaptureGainMinDb, FallbackValue=-60}"
                               Maximum="{Binding CaptureInput.CaptureGainMaxDb, FallbackValue=10}"
                               Value="{Binding CaptureInput.CaptureGainDb, Mode=TwoWay, FallbackValue=0}"
                               FormatString="0.#" Increment="1" MinWidth="92" VerticalAlignment="Center"
                               AutomationProperties.Name="{Binding CaptureInput.CaptureGainName, FallbackValue=''}"/>
              </Grid>
              <TextBlock Text="{loc:Text Key=MicSetupGainLocked}" Classes="hint" TextWrapping="Wrap"
                         IsVisible="{Binding ExtraUnit.Unit.GainLocked, FallbackValue=False}"/>
              <TextBlock Name="MicSetupNoGain" Text="{loc:Text Key=MicSetupNoGain}" Classes="hint" TextWrapping="Wrap" IsVisible="{Binding NoGain}"/>
            </StackPanel>
          </Border>
          <!-- Suggest gain: five seconds of speech measured, a gain proposed, nothing written until accepted -->
          <Border Classes="tile" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="{loc:Text Key=MicSetupSuggestGain}" Classes="h"/>
              <TextBlock Text="{loc:Text Key=MicSetupSuggestHint}" Classes="hint" TextWrapping="Wrap"/>
              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button Name="MicSetupSuggestGain" Content="{loc:Text Key=MicSetupSuggestGain}" IsEnabled="{Binding CanSuggestGain}" Click="OnSuggestGain"/>
                <Button Name="MicSetupAcceptGain" Content="{loc:Text Key=MicSetupAcceptGain}" IsVisible="{Binding CanAcceptGain}" Click="OnAcceptGain"/>
                <Button Name="MicSetupDiscardGain" Content="{loc:Text Key=MicSetupDiscardGain}" IsVisible="{Binding CanDiscardGain}" Click="OnDiscardGain"/>
              </WrapPanel>
              <TextBlock Name="MicSetupSuggestMeasured" Text="{Binding SuggestMeasured}" Classes="body" TextWrapping="Wrap"
                         IsVisible="{Binding SuggestMeasured, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <TextBlock Name="MicSetupSuggestAdvice" Text="{Binding SuggestAdvice}" Classes="body" TextWrapping="Wrap"
                         IsVisible="{Binding SuggestAdvice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <TextBlock Name="MicSetupSuggestBlocked" Text="{Binding SuggestBlocked}" Classes="warn" TextWrapping="Wrap"
                         IsVisible="{Binding SuggestBlocked, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Listen: a take, its waveform, raw and processed, and hearing yourself -->
        <StackPanel Name="MicSetupListen" Spacing="12" IsVisible="{Binding ShowsListen}">
          <TextBlock Text="{loc:Text Key=MicSetupListenHint}" Classes="hint" TextWrapping="Wrap"/>
          <TextBlock Name="MicSetupStatus" Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource Ox.Text.Primary}"/>
          <WrapPanel Name="MicSetupActions" ItemSpacing="8" LineSpacing="8">
            <Button Content="{loc:Text Key=Record}" IsEnabled="{Binding CanRecord}" Click="OnRecord"
                    ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding UnitNote}"/>
            <Button Content="{loc:Text Key=MicSetupLoopTake}" IsEnabled="{Binding CanLoop}" Click="OnLoop"
                    ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding UnitNote}"/>
            <Button Content="{loc:Text Key=MicSetupLiveMic}" IsEnabled="{Binding CanLive}" Click="OnLive"
                    ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding UnitNote}"/>
            <Button Content="{loc:Text Key=StopAndDiscard}" IsEnabled="{Binding CanStop}" Click="OnStop"/>
          </WrapPanel>
          <!-- the Wave XLR Pro builds the mixes its jacks play, and the checks wait for this computer -->
          <TextBlock Name="MicSetupUnitNote" Text="{Binding UnitNote}" Classes="hint" TextWrapping="Wrap" IsVisible="{Binding HasUnitNote}"/>
          <vm:TakeWaveform Name="MicSetupWaveform" Height="96" Peaks="{Binding Peaks}" Position="{Binding Position}"
                           CornerRadius="{DynamicResource Ox.Eq.CornerRadius}" AutomationProperties.Name="{loc:Text Key=MicSetupWaveform}"/>
          <TextBlock Text="{loc:Text Key=MicSetupNoTake}" Classes="hint" TextWrapping="Wrap" IsVisible="{Binding !HasTake}"/>

          <Border Classes="tile" Padding="12">
            <StackPanel Spacing="8">
              <!-- two sides of one switch: the lit side is the daemon's, a press asks for its side -->
              <WrapPanel Name="MicSetupCompare" ItemSpacing="6" LineSpacing="4" IsEnabled="{Binding CanSwitch}">
                <TextBlock Text="{loc:Text Key=MicSetupCompare}" Classes="h" VerticalAlignment="Center"/>
                <ToggleButton Name="MicSetupProcessed" Content="{loc:Text Key=MicSetupProcessed}" IsChecked="{Binding ListenProcessed, Mode=OneWay}"
                              Click="OnProcessed"/>
                <ToggleButton Name="MicSetupRaw" Content="{loc:Text Key=MicSetupRaw}" IsChecked="{Binding ListenRaw, Mode=OneWay}"
                              Click="OnRaw"/>
              </WrapPanel>
              <TextBlock Text="{loc:Text Key=MicSetupCompareHint}" Classes="hint" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <Border Classes="tile" Padding="12">
            <StackPanel Spacing="8">
              <CheckBox Name="MicSetupHearMyself" IsChecked="{Binding HearMyself, Mode=OneWay}" IsEnabled="{Binding CanSwitch}" Click="OnHearMyself">
                <TextBlock Text="{loc:Text Key=MicSetupHearMyself}" TextWrapping="Wrap"/>
              </CheckBox>
              <TextBlock Name="MicSetupLatency" Text="{Binding LatencyText}" Classes="hint" TextWrapping="Wrap"/>
              <TextBlock Text="{loc:Text Key=MicSetupProDirect}" Classes="hint" TextWrapping="Wrap" IsVisible="{Binding ProDirect}"/>
              <TextBlock Name="MicSetupNotHeard" Text="{loc:Text Key=MicSetupNotHeard}" Classes="warn" TextWrapping="Wrap" IsVisible="{Binding NotHeard}"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Shape: presets, the EQ curve, low cut and ClipGuard, and the plugins, all heard live -->
        <StackPanel Name="MicSetupShape" Spacing="12" IsVisible="{Binding ShowsShape}">
          <TextBlock Text="{loc:Text Key=MicSetupShapeHint}" Classes="hint" TextWrapping="Wrap"/>

          <!-- starting presets: each one is one EQ change, and the last can be undone;
               the one the EQ holds is lit, as a chosen toggle is everywhere -->
          <Border Classes="tile" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="{loc:Text Key=MicSetupPresets}" Classes="h"/>
              <ItemsControl Name="MicSetupPresetList" ItemsSource="{Binding Presets}" IsEnabled="{Binding CanApplyPreset}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="4"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MicSetupPresetItem">
                    <ToggleButton Name="MicSetupPreset" Content="{Binding Name}" IsChecked="{Binding IsActive, Mode=OneWay}" Click="OnPreset"
                                  Padding="14,5" ToolTip.Tip="{Binding Hint}"
                                  AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Hint}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Name="MicSetupPresetStatus" Text="{Binding PresetStatus}" Classes="hint" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Name="MicSetupUndoPreset" Content="{loc:Text Key=MicSetupUndoPreset}" IsEnabled="{Binding CanUndoPreset}"
                        Click="OnUndoPreset" VerticalAlignment="Center" ToolTip.Tip="{loc:Text Key=MicSetupUndoPresetTip}"
                        AutomationProperties.Name="{loc:Text Key=MicSetupUndoPreset}" AutomationProperties.HelpText="{loc:Text Key=MicSetupUndoPresetTip}"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- noise removal: first in the microphone's stage, ahead of the EQ, heard live -->
          <Border Classes="tile" Padding="12">
            <StackPanel Spacing="8">
              <Panel IsVisible="{Binding HasNoise}">
                <views:NoiseRemovalControls Name="MicSetupNoise" DataContext="{Binding Noise}"/>
              </Panel>
              <StackPanel Spacing="8" IsVisible="{Binding NoNoise}">
                <TextBlock Text="{loc:Text Key=NoiseRemoval}" Classes="h"/>
                <TextBlock Name="MicSetupNoNoise" Text="{loc:Text Key=MicSetupNoNoise}" Classes="hint" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- the microphone EQ: the editor's own graph on the channel's own model -->
          <Border Classes="tile" Padding="12">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{loc:Text Key=MicSetupEq}" Classes="h" VerticalAlignment="Center"/>
                <WrapPanel Grid.Column="1" Name="MicSetupEqActions" ItemSpacing="6" LineSpacing="4" IsVisible="{Binding HasEq}">
                  <ToggleButton Name="MicSetupEqSwitch" Content="{loc:Text Key=EqSwitch}" IsChecked="{Binding Eq.Enabled, Mode=TwoWay, FallbackValue=False}"
                                AutomationProperties.Name="{Binding Eq.ButtonName, FallbackValue=''}" ToolTip.Tip="{loc:Text Key=EqSwitchTip}"/>
                  <Button Name="MicSetupEqEditor" Content="{loc:Text Key=MicSetupEqEditor}" Click="OnEqEditor"
                          AutomationProperties.Name="{loc:Text Key=MicSetupEqEditorTip}" ToolTip.Tip="{loc:Text Key=MicSetupEqEditorTip}"/>
                </WrapPanel>
              </Grid>
              <Panel IsVisible="{Binding HasEq}">
                <vm:EqGraph Name="MicSetupEqGraph" DataContext="{Binding Eq}" Height="180"
                            CurveThickness="{DynamicResource Ox.Eq.CurveThickness}" BandCurveThickness="{DynamicResource Ox.Eq.BandCurveThickness}"
                            HandleSize="{DynamicResource Ox.Eq.HandleSize}" LabelFontSize="{DynamicResource Ox.Eq.LabelFontSize}"
                            CornerRadius="{DynamicResource Ox.Eq.CornerRadius}" MinimumTarget="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                            AutomationProperties.Name="{loc:Text Key=EqGraphName}"/>
              </Panel>
              <TextBlock Name="MicSetupEqStatus" Text="{Binding Eq.Status, FallbackValue=''}" Classes="hint" TextWrapping="Wrap" IsVisible="{Binding HasEq}"/>
              <TextBlock Name="MicSetupNoEq" Text="{loc:Text Key=MicSetupNoEq}" Classes="hint" TextWrapping="Wrap" IsVisible="{Binding NoEq}"/>
            </StackPanel>
          </Border>

          <!-- low cut and ClipGuard: the unit's, before the take, and XLR 1's software ones, after the EQ -->
          <Border Classes="tile" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="{loc:Text Key=MicSetupFilters}" Classes="h"/>
              <WrapPanel Name="MicSetupUnitFilters" ItemSpacing="6" LineSpacing="4" IsVisible="{Binding HasUnitFilters}">
                <ToggleButton Content="{loc:Text Key=LowCut}" IsChecked="{Binding Unit.LowCut, Mode=TwoWay, FallbackValue=False}"
                              IsVisible="{Binding Unit.CapLowCut, FallbackValue=False}" AutomationProperties.Name="{loc:Text Key=MicSetupUnitLowCut}"
                              ToolTip.Tip="{loc:Text Key=MicSetupUnitLowCut}"/>
                <ToggleButton Content="{loc:Text Key=ClipGuard}" IsChecked="{Binding Unit.ClipGuard, Mode=TwoWay, FallbackValue=False}"
                              IsVisible="{Binding Unit.CapClipGuard, FallbackValue=False}" AutomationProperties.Name="{loc:Text Key=MicSetupUnitClipGuard}"
                              ToolTip.Tip="{loc:Text Key=MicSetupUnitClipGuard}"/>
                <ToggleButton Content="{loc:Text Key=LowCut}" IsChecked="{Binding ExtraUnit.LowCut, Mode=TwoWay, FallbackValue=False}"
                              IsVisible="{Binding ExtraUnit.HasLowCut, FallbackValue=False}" IsEnabled="{Binding ExtraUnit.CanControl, FallbackValue=False}"
                              AutomationProperties.Name="{loc:Text Key=MicSetupUnitLowCut}" ToolTip.Tip="{loc:Text Key=MicSetupUnitLowCut}"/>
                <ToggleButton Content="{loc:Text Key=ClipGuard}" IsChecked="{Binding ExtraUnit.ClipGuard, Mode=TwoWay, FallbackValue=False}"
                              IsVisible="{Binding ExtraUnit.HasClipGuard, FallbackValue=False}" IsEnabled="{Binding ExtraUnit.CanControl, FallbackValue=False}"
                              AutomationProperties.Name="{loc:Text Key=MicSetupUnitClipGuard}" ToolTip.Tip="{loc:Text Key=MicSetupUnitClipGuard}"/>
              </WrapPanel>
              <TextBlock Text="{loc:Text Key=MicSetupUnitFiltersHint}" Classes="hint" TextWrapping="Wrap" IsVisible="{Binding HasUnitFilters}"/>
              <WrapPanel Name="MicSetupSoftwareFilters" ItemSpacing="6" LineSpacing="4" IsVisible="{Binding HasSoftwareFilters}">
                <ToggleButton Content="{Binding Software.SoftLowCutText, FallbackValue=''}" IsVisible="{Binding Software.ShowSoftLowCut, FallbackValue=False}"
                              IsChecked="{Binding Software.SoftLowCutOn, Mode=OneWay, FallbackValue=False}" Click="OnCycleSoftLowCut"
                              AutomationProperties.Name="{loc:Text Key=MicSetupSoftwareLowCut}" ToolTip.Tip="{loc:Text Key=HostSideLowCutForThisDeviceIts}"/>
                <ToggleButton Content="{loc:Text Key=ClipGuard}" IsVisible="{Binding Software.ShowSoftClipGuard, FallbackValue=False}"
                              IsChecked="{Binding Software.SoftClipGuard, Mode=TwoWay, FallbackValue=False}"
                              IsEnabled="{Binding Software.SoftClipGuardAvailable, FallbackValue=False}"
                              AutomationProperties.Name="{loc:Text Key=MicSetupSoftwareClipGuard}" ToolTip.Tip="{Binding Software.SoftClipGuardTip, FallbackValue=''}"/>
              </WrapPanel>
              <TextBlock Text="{loc:Text Key=MicSetupSoftwareFiltersHint}" Classes="hint" TextWrapping="Wrap" IsVisible="{Binding HasSoftwareFilters}"/>
              <TextBlock Name="MicSetupNoFilters" Text="{loc:Text Key=MicSetupNoFilters}" Classes="hint" TextWrapping="Wrap" IsVisible="{Binding NoFilters}"/>
            </StackPanel>
          </Border>

          <!-- the channel's plugins: bypass, the editor, remove and add effect; the chain window does the rest -->
          <Border Classes="tile" Padding="12" IsVisible="{Binding Chain, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="8" IsEnabled="{Binding Chain.CanEditEffects, FallbackValue=False}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{loc:Text Key=MicSetupEffects}" Classes="h" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Name="MicSetupAddEffect" Content="{loc:Text Key=MicSetupAddEffect}" Click="OnAddEffect"
                        AutomationProperties.Name="{loc:Text Key=MicSetupAddEffect}" ToolTip.Tip="{loc:Text Key=MicSetupAddEffectTip}"/>
              </Grid>
              <TextBlock Name="MicSetupNoEffects" Text="{loc:Text Key=NoInsertsYet}" Classes="hint" TextWrapping="Wrap"
                         IsVisible="{Binding !Chain.HasItems, FallbackValue=False}"/>
              <ItemsControl Name="MicSetupInserts" ItemsSource="{Binding Chain.Items, FallbackValue={x:Null}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:InsertViewModel">
                    <StackPanel Spacing="4">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                        <skin:StatusLed IsOn="{Binding IsActive}" Kind="Insert" VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding StateText}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Label}" Classes="body" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" ToolTip.Tip="{Binding Label}"/>
                        <ToggleButton Grid.Column="2" Name="MicSetupBypass" Content="{loc:Text Key=Bypass}" IsChecked="{Binding Bypass, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding Label, StringFormat={loc:Text Key=MicSetupBypassName}}"/>
                        <Button Grid.Column="3" Name="MicSetupInsertEditor" Content="{loc:Text Key=MicSetupEditor}" Click="OnInsertEditor"
                                ToolTip.Tip="{Binding ControlsHint}"
                                AutomationProperties.Name="{Binding Label, StringFormat={loc:Text Key=MicSetupEditorName}}"/>
                        <Button Grid.Column="4" Name="MicSetupRemoveInsert" Content="✕" Classes="danger" Click="OnInsertRemove"
                                ToolTip.Tip="{loc:Text Key=RemovePlugin}"
                                AutomationProperties.Name="{Binding Label, StringFormat={loc:Text Key=MicSetupRemoveName}}"/>
                      </Grid>
                      <TextBlock Text="{Binding Error}" Classes="warn" TextWrapping="Wrap" IsVisible="{Binding HasError}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{loc:Text Key=MicSetupEffectsHint}" Classes="hint" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Panel>
    </ScrollViewer>
  </DockPanel>
</Window>
