<Window xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:OpenXLR.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenXLR.UI.FlowWindow"
        Title="{loc:Text Key=OpenXLRAudioFlow}" SizeToContent="WidthAndHeight" MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Ox.Flow.Background}">
  <!-- The graph's colours are the application's Ox.Flow.* tokens. The cards
       and the routes are built in code, which reads the same tokens and
       rebuilds when the skin changes. -->
  <Window.Styles>
    <Style Selector="Button.flowNode">
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.flowNode:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Ox.Flow.NodeHoverBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Ox.Flow.NodeHoverBorderBrush}"/>
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto" Margin="28,24,28,18">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
      <StackPanel Spacing="5">
        <TextBlock Text="{loc:Text Key=AudioFlow}" FontSize="{DynamicResource UiText.FontSize24}" FontWeight="SemiBold" Foreground="{DynamicResource Ox.Flow.Text}"/>
        <TextBlock Name="FlowHint" Text="{loc:Text Key=ClickAnyElementToTraceItsSignalPath}" FontSize="{DynamicResource UiText.FontSize12}" Foreground="{DynamicResource Ox.Flow.TextDim}"/>
        <!-- the device whose clock the mixer's graph runs on, and a
             microphone resampled to it -->
        <TextBlock Name="FlowClock" FontSize="{DynamicResource UiText.FontSize12}" Foreground="{DynamicResource Ox.Flow.TextDim}" IsVisible="False"/>
        <TextBlock Name="FlowClockWarning" FontSize="{DynamicResource UiText.FontSize12}" Foreground="{DynamicResource Ox.Text.Warning}"
                   TextWrapping="Wrap" IsVisible="False"/>
      </StackPanel>
      <Button Name="ClearSelection" Grid.Column="1" Content="{loc:Text Key=ClearSelection}" Click="OnClearSelection"
              VerticalAlignment="Center" FontSize="{DynamicResource UiText.FontSize12}" Background="{DynamicResource Ox.Flow.Card}" Foreground="{DynamicResource Ox.Flow.Text}"
              CornerRadius="4" Padding="12,7" IsEnabled="False"/>
    </Grid>
    <ScrollViewer Name="GraphScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <Canvas Name="GraphCanvas" Background="Transparent"/>
    </ScrollViewer>
    <WrapPanel Grid.Row="2" Margin="0,18,0,0">
      <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,22,8">
        <Path Width="20" Height="3" Data="M0,1 L20,1" Stroke="{DynamicResource Ox.Flow.Input}" StrokeThickness="2"/>
        <TextBlock Text="{loc:Text Key=InputToChannel}" FontSize="{DynamicResource UiText.FontSize11}" Foreground="{DynamicResource Ox.Flow.TextDim}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,22,8">
        <Path Width="20" Height="3" Data="M0,1 L20,1" Stroke="{DynamicResource Ox.Flow.Channel}" StrokeThickness="2"/>
        <TextBlock Text="{loc:Text Key=ChannelToMix}" FontSize="{DynamicResource UiText.FontSize11}" Foreground="{DynamicResource Ox.Flow.TextDim}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,22,8">
        <Path Width="20" Height="3" Data="M0,1 L20,1" Stroke="{DynamicResource Ox.Flow.Output}" StrokeThickness="2"/>
        <TextBlock Text="{loc:Text Key=MixToOutput}" FontSize="{DynamicResource UiText.FontSize11}" Foreground="{DynamicResource Ox.Flow.TextDim}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,22,8">
        <Path Width="20" Height="3" Data="M0,1 L20,1" Stroke="{DynamicResource Ox.Flow.Muted}" StrokeThickness="2" StrokeDashArray="3,3"/>
        <TextBlock Text="{loc:Text Key=MutedInactive}" FontSize="{DynamicResource UiText.FontSize11}" Foreground="{DynamicResource Ox.Flow.TextDim}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,0,22,8">
        <Path Width="20" Height="3" Data="M0,1 L20,1" Stroke="{DynamicResource Ox.Flow.Muted}" StrokeThickness="2" Opacity="0.3"/>
        <TextBlock Text="{loc:Text Key=NotInPath}" FontSize="{DynamicResource UiText.FontSize11}" Foreground="{DynamicResource Ox.Flow.TextDim}"/>
      </StackPanel>
    </WrapPanel>
  </Grid>
</Window>
