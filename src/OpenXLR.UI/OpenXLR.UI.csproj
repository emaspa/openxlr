<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);OPENXLR_UI</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../packaging/openxlr-daemon.service" LogicalName="OpenXLR.StartupUnit" />
    <!-- Shared with the daemon (see the file): XDG paths and private atomic writes. -->
    <Compile Include="../OpenXLR.Core/OpenXlrPaths.cs" Link="OpenXlrPaths.cs" />
    <Compile Include="../OpenXLR.Core/ControlConnection.cs" Link="ControlConnection.cs" />
    <Compile Include="../OpenXLR.Core/ControlSocketListener.cs" Link="ControlSocketListener.cs" />
    <Compile Include="../OpenXLR.Core/DaemonLock.cs" Link="DaemonLock.cs" />
    <Compile Include="../OpenXLR.Core/DaemonProbe.cs" Link="DaemonProbe.cs" />
    <Compile Include="../OpenXLR.Core/ProcessRunner.cs" Link="ProcessRunner.cs" />
    <Compile Include="../OpenXLR.Core/FlatpakEnvironment.cs" Link="FlatpakEnvironment.cs" />
    <Compile Include="../OpenXLR.Core/InstallationReceipt.cs" Link="InstallationReceipt.cs" />
    <Compile Include="../OpenXLR.Core/InstallationHistory.cs" Link="InstallationHistory.cs" />
    <Compile Include="../OpenXLR.Core/RegularFile.cs" Link="RegularFile.cs" />
    <Compile Include="../OpenXLR.Core/Mixing/PipeWireSnapshot.cs" Link="PipeWireSnapshot.cs" />
    <Compile Include="../OpenXLR.Core/RuntimeSnapshot.cs" Link="RuntimeSnapshot.cs" />
    <!-- Shared with the daemon: Wine's USB driver stays off in a prefix we start. -->
    <Compile Include="../OpenXLR.Core/WineDllOverrides.cs" Link="WineDllOverrides.cs" />
    <!-- Shared with the terminal mixer: the saved Material mode. -->
    <Compile Include="../OpenXLR.Core/AppearanceModes.cs" Link="AppearanceModes.cs" />
    <!-- Shared with the daemon and the terminal mixer: the built-in icon set. -->
    <Compile Include="../OpenXLR.Core/Mixing/LayoutIcons.cs" Link="LayoutIcons.cs" />
    <!-- Shared with the terminal mixer: the colour palette offered beside a colour field. -->
    <Compile Include="../OpenXLR.Core/Mixing/LayoutColours.cs" Link="LayoutColours.cs" />
    <!-- Shared with the daemon: the microphone EQ's model, snapping and curve,
         so the editor draws and steps exactly what the daemon runs. -->
    <Compile Include="../OpenXLR.Core/Mixing/MicEq.cs" Link="MicEq.cs" />
    <Compile Include="../OpenXLR.Core/Mixing/MicNoise.cs" Link="MicNoise.cs" />
    <Compile Include="../OpenXLR.Core/Mixing/MicVoice.cs" Link="MicVoice.cs" />
    <Compile Include="../OpenXLR.Core/Mixing/MicDynamics.cs" Link="MicDynamics.cs" />
    <Compile Include="../OpenXLR.Core/Mixing/EqResponse.cs" Link="EqResponse.cs" />
    <!-- Shared with the daemon: the built-in EQ profiles Mic setup offers and the EQ editor lists. -->
    <Compile Include="../OpenXLR.Core/Mixing/EqPresets.cs" Link="EqPresets.cs" />
    <!-- Shared with the daemon: the browser native host forwards only the
         origins the daemon accepts, in the form it reports them. -->
    <Compile Include="../OpenXLR.Core/Mixing/BrowserOrigin.cs" Link="BrowserOrigin.cs" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" Exclude="Assets/Skins/**;Assets/Appearance/**"/>
    <!-- The skins the application ships with. They are read through the
         assembly's own manifest rather than through the asset loader, so the
         same code path works in a test with no rendering platform, and every
         packaging channel carries them without a rule of its own. -->
    <!-- Material's light palette: skin data in the same format, not a skin of
         its own, so it is not listed in the picker. The terminal mixer reads
         the same file. -->
    <EmbeddedResource Include="Assets/Appearance/material-light.json" LogicalName="OpenXLR.UI.Assets.Appearance.material-light.json"/>
    <EmbeddedResource Include="Assets/Skins/*/skin.json" LogicalName="OpenXLR.UI.Assets.Skins.$([System.String]::Copy('%(RecursiveDir)').TrimEnd('/')).skin.json"/>
    <!-- A built-in skin's images, named by their path below Assets/Skins so
         SkinEmbeddedAssets finds "<id>/art/plate.png" for the id's skin and
         for no other. The test project embeds its fixture skin the same way. -->
    <EmbeddedResource Include="Assets/Skins/*/**/*.png;Assets/Skins/*/**/*.jpg;Assets/Skins/*/**/*.jpeg"
                      LogicalName="OpenXLR.UI.Assets.SkinFiles/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenXLR.Tests" />
  </ItemGroup>
</Project>
