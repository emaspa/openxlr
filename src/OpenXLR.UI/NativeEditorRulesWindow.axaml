<Window xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:OpenXLR.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenXLR.UI"
        x:Class="OpenXLR.UI.NativeEditorRulesWindow"
        Title="{loc:Text Key=NativeEditorCompatibility}" Width="780" Height="590" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Ox.Window.Background}">
  <Grid Margin="18" RowDefinitions="Auto,12,*,12,Auto,10,Auto,12,Auto">
    <StackPanel Spacing="6">
      <TextBlock Text="{loc:Text Key=NativeEditorCompatibility}" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock Text="{loc:Text Key=UseOpenXLRControlsForPluginsWhoseOwnEditor}"
                 FontSize="12" Foreground="{DynamicResource Ox.Text.Secondary}" TextWrapping="Wrap"/>
      <TextBlock Text="{loc:Text Key=ReleaseDefaultsCanChangeAsCompatibilityImprovesYour}"
                 FontSize="12" Foreground="{DynamicResource Ox.Text.Secondary}" TextWrapping="Wrap"/>
    </StackPanel>
    <Border Grid.Row="2" Background="{DynamicResource Ox.Card.Background}" CornerRadius="8" Padding="8">
      <Grid>
        <ListBox Name="RuleList" SelectionChanged="OnRuleSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NativeEditorRuleRow">
              <StackPanel Spacing="3" Margin="0,5,12,5">
                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{DynamicResource Ox.Text.Secondary}" TextWrapping="Wrap"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Name="EmptyRules" Text="{loc:Text Key=NoNativeEditorsAreBlocked}" Margin="8" Foreground="{DynamicResource Ox.Text.Secondary}" IsHitTestVisible="False"/>
      </Grid>
    </Border>
    <WrapPanel Grid.Row="4">
      <Button Name="BlockSelected" Content="{loc:Text Key=UseOpenXLRControls}" Click="OnBlockSelected" Padding="12,5" Margin="0,0,8,4" IsEnabled="False"/>
      <Button Name="AllowSelected" Content="{loc:Text Key=AllowNativeEditor}" Click="OnAllowSelected" Padding="12,5" Margin="0,0,8,4" IsEnabled="False"/>
      <Button Name="DefaultSelected" Content="{loc:Text Key=UseReleaseDefault}" Click="OnDefaultSelected" Padding="12,5" Margin="0,0,0,4" IsEnabled="False"/>
    </WrapPanel>
    <TextBlock Grid.Row="6" Name="RuleDetail" FontSize="12" Foreground="{DynamicResource Ox.Text.Secondary}" TextWrapping="Wrap" MaxHeight="72"/>
    <StackPanel Grid.Row="8" Spacing="8">
      <Grid ColumnDefinitions="*,8,Auto">
        <AutoCompleteBox Name="PluginPicker" PlaceholderText="{loc:Text Key=FindAnInstalledPlugin}" MinimumPrefixLength="0"
                         FilterMode="Contains" SelectionChanged="OnPluginSelected"/>
        <Button Grid.Column="2" Name="AddRule" Content="{loc:Text Key=UseOpenXLRControls}" Click="OnAddRule" Padding="12,5" IsEnabled="False"/>
      </Grid>
      <TextBlock Text="{loc:Text Key=ChangesApplyTheNextTimeAnEditorIs}"
                 FontSize="12" Foreground="{DynamicResource Ox.Text.Secondary}" TextWrapping="Wrap"/>
      <Grid ColumnDefinitions="*,12,Auto,8,Auto">
        <ScrollViewer MaxHeight="80" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <TextBlock Name="Status" FontSize="12" Foreground="{DynamicResource Ox.Text.Warning}" TextWrapping="Wrap" Margin="0,0,12,0"/>
        </ScrollViewer>
        <Button Grid.Column="2" Content="{loc:Text Key=Refresh}" Padding="12,6" Click="OnRefresh"/>
        <Button Grid.Column="4" Content="{loc:Text Key=Close}" Padding="18,6" Click="OnClose"/>
      </Grid>
    </StackPanel>
  </Grid>
</Window>
