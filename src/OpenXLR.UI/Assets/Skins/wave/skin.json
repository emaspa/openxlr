    "Ox.Font.Family": "sans-serif",
    "Ox.Led.On": "#41d793",
    "Ox.Led.Off": "#5b687a",
    "Ox.Led.Alert": "#ff657c",
    "Ox.Meter.Fill": "#41d793",
    "Ox.Meter.Warning": "#ffd166",
    "Ox.Meter.Hot": "#ff657c",
