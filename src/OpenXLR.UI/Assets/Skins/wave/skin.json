    "Ox.Eq.CurveFill": "#3360c7ff",
    "Ox.Eq.Band1": "#60c7ff",
    "Ox.Eq.Band2": "#41d793",
    "Ox.Eq.Band3": "#ffd166",
    "Ox.Eq.Band4": "#c5a2ff",
    "Ox.Eq.HandleOff": "#a6b2c4",
    "Ox.Eq.HandleRing": "#eef3fb",
