    "Ox.Matrix.MutedOpacity": 0.3,
    "Ox.Label.FontSize": 12,
    "Ox.Label.FontWeight": "SemiBold",
    "Ox.Title.FontSize": 18,
    "Ox.Main.FaderMaxWidth": 640,
    "Ox.Mixer.TileMaxWidth": 420,
    "Ox.Matrix.CellMaxWidth": 800,
    "Ox.AppColumns.TileMaxWidth": 720
  },
  "layout": {
    "version": 1,
    "main": {
      "kind": "stack",
      "id": "desk",
      "orientation": "vertical",
      "spacing": 8,
      "children": [
        {
          "kind": "grid",
          "id": "mixes",
          "spacing": 8,
          "columns": [
            {
              "star": 1
            },
            {
              "size": 360
            }
          ],
          "rows": [
            "auto",
            "auto"
          ],
          "children": [
            {
              "kind": "region",
              "region": "headphones",
              "row": 0,
              "column": 0
            },
            {
              "kind": "region",
              "region": "monitor",
              "row": 0,
              "column": 1
            },
            {
              "kind": "region",
              "region": "submixer",
              "row": 1,
              "column": 0,
              "columnSpan": 2
            }
          ]
        },
        {
          "kind": "region",
          "region": "inputs"
        },
        {
          "kind": "region",
          "region": "applications"
        }
      ]
    },
    "regions": {
      "header": {
        "actions": [
          "profiles",
          "history",
          "flow",
          "arrange",
          "restart-daemon",
          "version",
          "about"
        ]
      },
      "monitor": {
        "template": "output-toolbar"
      },
      "submixer": {
        "template": "mix-matrix",
        "matrix": {
          "rowHead": {
            "parts": [
              "identity",
              "binding",
              "mute",
              "gain",
              "meter",
              "processing",
              "effects"
            ],
            "label": {
              "style": "icon-and-text"
            }
          },
          "columnHead": {
            "parts": [
              "identity",
              "outputs",
              "mute",
              "master",
              "effects"
            ],
            "label": {
              "style": "icon-and-text"
            }
          },
          "cell": {
            "parts": [
              "mute",
              "fader",
              "value"
            ],
            "muted": "dim",
            "valuePlacement": "over-fader"
          },
          "meter": "under-fader"
        },
        "popOut": {
          "default": "docked"
        }
      },
      "inputs": {
        "visibility": "hidden"
      },
      "applications": {
        "template": "application-columns",
        "perColumn": 4
      }
    }
  }
}
