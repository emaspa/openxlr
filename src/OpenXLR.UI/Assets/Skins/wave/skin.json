    "Ox.Meter.HotLevel": 0.9,
    "Ox.Mute.Background": "#2b3340",
    "Ox.Mute.Foreground": "#eef3fb",
    "Ox.Mute.BackgroundPointerOver": "#394556",
    "Ox.Mute.BackgroundChecked": "#2b3340",
    "Ox.Mute.ForegroundChecked": "#ff7a8e",
    "Ox.Mute.BorderBrush": "#4c596c",
    "Ox.Mute.BorderThickness": 1,
    "Ox.Fader.Track": "#384353",
