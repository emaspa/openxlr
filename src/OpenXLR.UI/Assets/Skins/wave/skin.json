    "Ox.Fader.Thumb.BorderThickness": 0,
    "Ox.Fader.Thumb.Width": 8,
    "Ox.Fader.Thumb.Height": 12,
    "Ox.Fader.Thumb.CornerRadius": 2,
    "Ox.Fader.Thumb.Grip": "#00000000",
    "Ox.Fader.Thumb.GripLength": 0,
    "Ox.Control.Background": "#2b3340",
    "Ox.Control.BackgroundPointerOver": "#394556",
    "Ox.Control.BackgroundPressed": "#202631",
    "Ox.Control.BackgroundChecked": "#123f5c",
    "Ox.Control.BackgroundDisabled": "#252c37",
    "Ox.Control.Foreground": "#eef3fb",
    "Ox.Control.ForegroundChecked": "#a5e0ff",
    "Ox.Control.ForegroundDisabled": "#a6b2c4",
    "Ox.Control.BorderBrush": "#4c596c",
    "Ox.Control.BorderBrushPointerOver": "#60c7ff",
    "Ox.Control.BorderBrushDisabled": "#384353",
    "Ox.Control.BorderThickness": 1,
