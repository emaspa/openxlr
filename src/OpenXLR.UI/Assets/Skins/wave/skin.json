{
  "$schema": "https://raw.githubusercontent.com/emaspa/openxlr/main/docs/skin.schema.json",
  "schema": 1,
  "id": "wave",
  "name": "Wave",
  "description": "A dark mixer: grey faders, green meters and each input against every mix.",
  "author": "OpenXLR",
  "controls": {
    "button": "flat",
    "fader": "console",
    "meter": "continuous",
    "led": "flat",
    "mute": "flat"
  },
