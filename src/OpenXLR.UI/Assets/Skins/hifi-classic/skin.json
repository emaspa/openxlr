  "schema": 1,
  "id": "hifi-classic",
  "name": "Hi-Fi Classic",
  "description": "Hi-Fi with a classic green display: brushed black faceplates, green VFD meters that turn yellow and then red, backlit keys, glowing lens lamps and red indexes on machined fader caps.",
  "author": "OpenXLR",
