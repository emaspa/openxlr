    "size": {
      "width": 1668,
      "height": 1174
    }
  },
  "controls": {
    "button": "cap",
    "fader": "console",
    "meter": "segmented",
    "led": "lens",
    "mute": "cap",
    "check": "key",
    "chip": "badge"
  },
