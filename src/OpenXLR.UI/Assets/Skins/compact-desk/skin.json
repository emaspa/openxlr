    "Ox.Meter.CornerRadius": 2,
    "Ox.Meter.Height": 3,
    "Ox.Meter.WarningLevel": 0.7,
    "Ox.Meter.HotLevel": 0.9,
    "Ox.Mute.Background": "#2f2f2f",
    "Ox.Mute.Foreground": "#e6e6e6",
    "Ox.Mute.BackgroundPointerOver": "#383838",
    "Ox.Mute.BackgroundChecked": "#2f2f2f",
    "Ox.Mute.ForegroundChecked": "#f87171",
    "Ox.Mute.BorderBrush": "#3a3a3a",
    "Ox.Mute.BorderThickness": 1,
    "Ox.Fader.Track": "#445266",
    "Ox.Fader.Fill": "#75a9e0",
    "Ox.Fader.TrackHeight": 4,
    "Ox.Fader.TrackCornerRadius": 2,
    "Ox.Fader.Thumb.Background": "#edf2f8",
    "Ox.Fader.Thumb.BorderBrush": "#0a0a0a",
    "Ox.Fader.Thumb.BorderThickness": 1,
    "Ox.Fader.Thumb.Width": 16,
    "Ox.Fader.Thumb.Height": 16,
    "Ox.Fader.Thumb.CornerRadius": 8,
    "Ox.Fader.Thumb.Grip": "#00000000",
    "Ox.Fader.Thumb.GripLength": 0,
    "Ox.Control.Background": "#293340",
    "Ox.Control.BackgroundPointerOver": "#354359",
    "Ox.Control.BackgroundPressed": "#262626",
    "Ox.Control.BackgroundChecked": "#1e3a5f",
    "Ox.Control.BackgroundDisabled": "#262626",
    "Ox.Control.Foreground": "#e6e6e6",
    "Ox.Control.ForegroundChecked": "#93c5fd",
    "Ox.Control.ForegroundDisabled": "#a3a3a3",
    "Ox.Control.BorderBrush": "#435167",
    "Ox.Control.BorderBrushPointerOver": "#3b82f6",
    "Ox.Control.BorderBrushDisabled": "#2a2a2a",
