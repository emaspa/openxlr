    "Ox.Matrix.RowHeight": 42,
    "Ox.Matrix.MutedBackground": "#4def4444",
    "Ox.Matrix.MutedForeground": "#ffffff",
    "Ox.Matrix.MutedOpacity": 0.55,
    "Ox.AppColumns.NameWidth": 144,
    "Ox.AppColumns.TileMaxWidth": 720
  },
  "layout": {
    "version": 1,
    "main": {
      "kind": "stack",
      "id": "desk",
      "orientation": "vertical",
      "spacing": 12,
      "children": [
        {
          "kind": "grid",
          "id": "mixes",
          "spacing": 12,
          "columns": [
            {
              "size": 600
            },
            {
              "star": 1
            }
          ],
          "rows": [
            "auto",
            "auto"
          ],
          "children": [
            {
              "kind": "region",
              "region": "headphones",
              "row": 0,
              "column": 0
            },
            {
              "kind": "region",
              "region": "monitor",
              "row": 0,
              "column": 1
            },
            {
              "kind": "region",
              "region": "submixer",
              "row": 1,
              "column": 0,
              "columnSpan": 2
            }
          ]
        },
        {
          "kind": "region",
          "region": "inputs"
        },
        {
          "kind": "region",
          "region": "applications"
        }
      ]
    },
    "regions": {
      "header": {
        "actions": [
          "profiles",
          "flow",
          "arrange"
        ],
        "overflow": [
          "restart-daemon",
          "version",
          "about"
        ]
      },
      "monitor": {
        "template": "output-toolbar"
      },
      "submixer": {
        "template": "mix-matrix",
        "matrix": {
          "rowHead": {
            "parts": [
              "identity",
              "binding",
              "mute",
              "gain",
              "meter",
              "processing",
              "effects"
            ],
            "label": {
              "style": "icon-and-text"
            }
          },
          "columnHead": {
            "parts": [
              "identity",
              "outputs",
              "mute",
              "master",
              "effects"
            ],
            "label": {
              "style": "icon-and-text"
            }
          },
          "cell": {
            "parts": [
              "mute",
              "fader",
              "value"
            ],
            "muted": "dim",
            "valuePlacement": "over-fader"
          },
          "meter": "under-fader"
        },
        "popOut": {
          "default": "docked"
        }
      },
      "inputs": {
        "visibility": "hidden"
      },
      "applications": {
        "template": "application-columns",
        "perColumn": 1
      }
    }
  }
}
