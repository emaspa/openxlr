{
  "$schema": "https://raw.githubusercontent.com/emaspa/openxlr/main/docs/skin.schema.json",
  "schema": 1,
  "id": "compact-desk",
  "name": "Compact Desk",
  "description": "A dark, readable matrix desk with longer faders, clear channel names and compact application tiles.",
  "author": "OpenXLR",
  "controls": {
    "button": "flat",
    "fader": "console",
    "meter": "continuous",
    "led": "flat",
    "mute": "flat"
  },
  "tokens": {
    "Ox.Window.Background": "#14181e",
    "Ox.Card.Background": "#1c222b",
    "Ox.Card.BorderBrush": "#303a48",
    "Ox.Card.BorderThickness": 1,
    "Ox.Card.CornerRadius": 8,
    "Ox.Tile.Background": "#252e3a",
    "Ox.Tile.BorderBrush": "#344151",
    "Ox.Tile.BorderThickness": 1,
    "Ox.Tile.CornerRadius": 6,
    "Ox.Dialog.Background": "#1c222b",
    "Ox.Danger.Background": "#dc2626",
