    "Ox.Link.Foreground": "#60a5fa",
    "Ox.Link.ForegroundPointerOver": "#93c5fd",
    "Ox.Font.Family": "sans-serif",
    "Ox.Led.On": "#4ade80",
    "Ox.Led.Off": "#404040",
    "Ox.Led.Alert": "#ef4444",
    "Ox.Meter.Fill": "#4ade80",
    "Ox.Meter.Warning": "#facc15",
    "Ox.Meter.Hot": "#ef4444",
