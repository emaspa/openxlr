    "Ox.Eq.ZoneB": "#0fe6e6e6",
    "Ox.Eq.ZoneLabel": "#8c8c8c",
    "Ox.Eq.Curve": "#e6e6e6",
    "Ox.Eq.CurveFill": "#3360a5fa",
    "Ox.Eq.Band1": "#60a5fa",
    "Ox.Eq.Band2": "#4ade80",
    "Ox.Eq.Band3": "#fbbf24",
    "Ox.Eq.Band4": "#c084fc",
