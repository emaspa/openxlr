{
  "$schema": "https://raw.githubusercontent.com/emaspa/openxlr/main/docs/skin.schema.json",
  "schema": 1,
  "id": "vfd-amber",
  "name": "VFD Amber",
  "description": "A vacuum fluorescent display behind smoked glass: amber phosphor readouts over their unlit segments, glowing bargraph meters that turn red at the top, printed legends and the fine grid of the tube.",
  "author": "OpenXLR",
  "controls": {
    "button": "cap",
    "fader": "console",
    "meter": "segmented",
    "led": "lens",
    "mute": "cap",
    "check": "key",
    "chip": "badge"
  },
