    "Ox.Fader.Thumb.Height": 14,
    "Ox.Fader.Thumb.CornerRadius": 7,
    "Ox.Fader.Thumb.Grip": "#00000000",
    "Ox.Fader.Thumb.GripLength": 0,
    "Ox.Control.Background": "#2f2f2f",
    "Ox.Control.BackgroundPointerOver": "#383838",
    "Ox.Control.BackgroundPressed": "#262626",
    "Ox.Control.BackgroundChecked": "#4b3722",
    "Ox.Control.BackgroundDisabled": "#262626",
