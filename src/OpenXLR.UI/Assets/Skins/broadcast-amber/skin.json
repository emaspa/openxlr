{
  "$schema": "https://raw.githubusercontent.com/emaspa/openxlr/main/docs/skin.schema.json",
  "schema": 1,
  "id": "broadcast-amber",
  "name": "Broadcast Amber",
  "description": "Broadcast with orange accents: the same mix matrix and dark neutral palette, with orange meters, lamps, checked keys and links in place of the green and blue ones",
  "author": "OpenXLR",
  "window": {
    "size": {
      "width": 1224,
      "height": 1141
    }
  },
  "controls": {
    "button": "flat",
    "fader": "console",
    "meter": "continuous",
    "led": "flat",
    "mute": "flat"
  },
  "tokens": {
    "Ox.Window.Background": "#1b1b1b",
    "Ox.Card.Background": "#222222",
