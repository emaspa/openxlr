    "Ox.Text.Alert": "#facc15",
    "Ox.Text.Info": "#ffb76f",
    "Ox.Link.Foreground": "#f5aa5f",
    "Ox.Link.ForegroundPointerOver": "#ffdab4",
    "Ox.Font.Family": "sans-serif",
    "Ox.Led.On": "#ff9f3f",
