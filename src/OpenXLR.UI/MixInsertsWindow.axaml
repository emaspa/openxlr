<Window xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:OpenXLR.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenXLR.UI"
        xmlns:skin="using:OpenXLR.UI.Skinning"
        x:Class="OpenXLR.UI.MixInsertsWindow"
        x:DataType="vm:InsertsViewModel"
        Title="{Binding Title, StringFormat={loc:Text Key=InsertsTitle}}" Width="560" Height="360" MinWidth="440" MinHeight="220"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Ox.Window.Background}">

  <!-- Disabled while a pasted chain, preset or A/B slot is being applied. -->
  <DockPanel Margin="16" IsEnabled="{Binding CanEditEffects}">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="{Binding Title}" FontSize="{DynamicResource UiText.FontSize16}" FontWeight="Bold" Foreground="{DynamicResource Ox.Text.Primary}"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
        <TextBlock Text="{Binding ChainHint}" Classes="h" FontSize="{DynamicResource UiText.FontSize11}" TextWrapping="Wrap"/>
        <!-- the Wave XLR Pro builds this mix for its jacks and runs no insert there -->
        <TextBlock Name="MixInsertsUnitNote" Text="{Binding UnitNote}" Classes="hint" FontSize="{DynamicResource UiText.FontSize11}" TextWrapping="Wrap"
                   Margin="0,4,0,0" IsVisible="{Binding HasUnitNote}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top">
        <Button Name="AddInsert" Content="{loc:Text Key=AddPlugin}" Padding="12,4" HorizontalAlignment="Stretch" Click="OnAddInsert"
                IsEnabled="{Binding CanAddPlugins}" ToolTip.ShowOnDisabled="True" ToolTip.Tip="{Binding UnitNote}"/>
        <Button Name="EffectWorkflow" Content="{loc:Text Key=PresetsAndAB}" Padding="12,4" HorizontalAlignment="Stretch" Click="OnWorkflow"
                IsEnabled="{Binding CanAddPlugins}" ToolTip.Tip="{loc:Text Key=CopyAndPasteEffectsCompareTwoSettings}"/>
      </StackPanel>
    </Grid>
    <Button DockPanel.Dock="Bottom" Content="{loc:Text Key=Close}" HorizontalAlignment="Right" Padding="18,6" Margin="0,10,0,0" Click="OnClose"/>
    <TextBlock DockPanel.Dock="Top" Text="{Binding WorkflowError}" TextWrapping="Wrap" Margin="0,0,0,8"
               Foreground="{DynamicResource Ox.Text.Warning}"
               IsVisible="{Binding WorkflowError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    <Button DockPanel.Dock="Top" Name="MicSetup" Content="{loc:Text Key=MicSetup}" IsVisible="{Binding CanMicSetup}" HorizontalAlignment="Left" Margin="0,0,0,8" Click="OnMicSetup"/>
    <TextBlock DockPanel.Dock="Top" Text="{loc:Text Key=NoInsertsYet}" Classes="h" IsVisible="{Binding !HasItems}"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" AllowAutoHide="False">
      <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,10,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:InsertViewModel">
            <Border Classes="tile" Padding="10" Margin="0,0,0,8">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <skin:StatusLed IsOn="{Binding IsActive}" Kind="Insert"
                                  AutomationProperties.Name="{loc:Text Key=PluginState}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Label}" Classes="insertName" Foreground="{DynamicResource Ox.Text.Primary}" FontSize="{DynamicResource UiText.FontSize12}"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}"/>
                  <TextBlock Grid.Column="2" Text="{Binding StateText}" Classes="h" FontSize="{DynamicResource UiText.FontSize11}"/>
                </Grid>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Ox.Text.Warning}" FontSize="{DynamicResource UiText.FontSize11}"
                           TextWrapping="Wrap" IsVisible="{Binding HasError}"/>
                <WrapPanel>
                  <Button Name="InsertPluginUi" Content="{loc:Text Key=PluginUI}" Padding="8,3" MinHeight="0" FontSize="{DynamicResource Ox.Label.FontSize}" Margin="0,0,6,0"
                          Click="OnInsertPluginUi" IsVisible="{Binding NativeEditorSupported}" IsEnabled="{Binding NativeEditorAvailable}"
                          ToolTip.Tip="{loc:Text Key=OpenThisPluginSOwnEditorOnThe}"/>
                  <Button Content="{loc:Text Key=Controls}" Padding="8,3" MinHeight="0" FontSize="{DynamicResource Ox.Label.FontSize}" Margin="0,0,6,0" Click="OnInsertControls"/>
                  <Button Content="{loc:Text Key=Copy}" Padding="8,3" MinHeight="0" FontSize="{DynamicResource Ox.Label.FontSize}" Margin="0,0,6,0"
                          Click="OnCopyInsert" ToolTip.Tip="{loc:Text Key=CopyThisEffectToPasteOnAny}"/>
                  <Button Content="{loc:Text Key=Rename}" Padding="8,3" MinHeight="0" FontSize="{DynamicResource Ox.Label.FontSize}" Margin="0,0,6,0"
                          Click="OnRenameInsert" ToolTip.Tip="{loc:Text Key=ChangeTheNameThisEffectShowsThe}"/>
                  <ToggleButton Content="{loc:Text Key=Bypass}" IsChecked="{Binding Bypass, Mode=TwoWay}"
                                Padding="8,3" MinHeight="0" FontSize="{DynamicResource Ox.Label.FontSize}" Margin="0,0,6,0"/>
                  <Button Content="▲" Padding="6,3" MinHeight="0" FontSize="{DynamicResource UiText.FontSize10}" Margin="0,0,4,0" Click="OnInsertUp"
                          AutomationProperties.Name="{loc:Text Key=MovePluginUp}" ToolTip.Tip="{loc:Text Key=MoveUp}"/>
                  <Button Content="▼" Padding="6,3" MinHeight="0" FontSize="{DynamicResource UiText.FontSize10}" Margin="0,0,6,0" Click="OnInsertDown"
                          AutomationProperties.Name="{loc:Text Key=MovePluginDown}" ToolTip.Tip="{loc:Text Key=MoveDown}"/>
                  <Button Content="✕" Classes="danger" Padding="6,3" MinHeight="0" FontSize="{DynamicResource UiText.FontSize10}" Click="OnInsertRemove"
                          AutomationProperties.Name="{loc:Text Key=RemovePlugin}" ToolTip.Tip="{loc:Text Key=RemovePlugin}"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
