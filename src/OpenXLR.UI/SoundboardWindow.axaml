<Window xmlns="https://github.com/avaloniaui"
        xmlns:skin="using:OpenXLR.UI.Skinning"
        xmlns:loc="using:OpenXLR.UI.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenXLR.UI"
        x:Class="OpenXLR.UI.SoundboardWindow" x:DataType="vm:SoundboardViewModel"
        Title="{loc:Text Key=Soundboard}" Width="760" Height="620" MinWidth="440" MinHeight="400"
        Background="{DynamicResource Ox.Window.Background}"
        DragDrop.AllowDrop="True">
  <!-- The soundboard: the switch, SFX's own volume as the board's master, Stop all, Add,
       the library's export and import, Restore starter sounds, the pages as tabs once there is more than one,
       then one pad per clip of the page shown, in library order. Sound files and folders
       dropped on the window are added, a folder as a page of its own. A pad is a key in the skin's button
       face, sized by the Ox.Soundboard.* tokens and filled with the clip's own colour when it has one,
       with a ring while it plays and a bar for how far along it is. Every colour, size and radius is
       an Ox.* token or the clip's own colour. -->
  <Window.Styles>
    <!-- the mixer's own styles: the layout accent SFX's colour tints its name with, and control sizing -->
    <StyleInclude Source="avares://OpenXLR.UI/MixerStyles.axaml"/>
    <Style Selector="Button.soundPad">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="CornerRadius" Value="{DynamicResource Ox.Soundboard.PadCornerRadius}"/>
    </Style>
    <Style Selector="ProgressBar.soundProgress">
      <Setter Property="Foreground" Value="{DynamicResource Ox.Soundboard.Progress}"/>
      <Setter Property="Background" Value="{DynamicResource Ox.Meter.Track}"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="{DynamicResource Ox.Soundboard.ProgressHeight}"/>
      <Setter Property="Height" Value="{DynamicResource Ox.Soundboard.ProgressHeight}"/>
    </Style>
    <!-- A filled pad: lettering that reads on the clip's colour, a layer over the fill that
         answers the pointer and a press in place of the face it hides, and a menu button
         whose face lets the colour through, whatever face the skin gives a ghost button. -->
    <Style Selector="Button.soundPad TextBlock.onLight">
      <Setter Property="Foreground" Value="{DynamicResource Ox.Soundboard.ForegroundOnLight}"/>
    </Style>
    <Style Selector="Button.soundPad TextBlock.onDark">
      <Setter Property="Foreground" Value="{DynamicResource Ox.Soundboard.ForegroundOnDark}"/>
    </Style>
    <Style Selector="Button.soundPadMenu.onLight">
      <Setter Property="Foreground" Value="{DynamicResource Ox.Soundboard.ForegroundOnLight}"/>
      <Setter Property="Background" Value="{DynamicResource Ox.Soundboard.MenuBackground}"/>
    </Style>
    <Style Selector="Button.soundPadMenu.onDark">
      <Setter Property="Foreground" Value="{DynamicResource Ox.Soundboard.ForegroundOnDark}"/>
      <Setter Property="Background" Value="{DynamicResource Ox.Soundboard.MenuBackground}"/>
    </Style>
    <Style Selector="Button.soundPad:pointerover Border.soundPadShade">
      <Setter Property="Background" Value="{DynamicResource Ox.Soundboard.FillPointerOver}"/>
    </Style>
    <Style Selector="Button.soundPad:pressed Border.soundPadShade">
      <Setter Property="Background" Value="{DynamicResource Ox.Soundboard.FillPressed}"/>
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
      <skin:LitText Text="{loc:Text Key=Soundboard}" Classes="title" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <CheckBox Grid.Column="1" Name="SoundboardEnabled" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center"
                IsVisible="{Binding CanImport}"
                AutomationProperties.Name="{loc:Text Key=SoundboardSwitch}" ToolTip.Tip="{loc:Text Key=SoundboardSwitchTip}">
        <TextBlock Text="{loc:Text Key=SoundboardSwitch}"/>
      </CheckBox>
    </Grid>

    <!-- Why the pads cannot play; the switch above turns the board on, creating SFX when it is gone -->
    <StackPanel DockPanel.Dock="Top" Name="SoundboardNoticeArea" Spacing="6" Margin="0,0,0,8" IsVisible="{Binding HasNotice}">
      <TextBlock Name="SoundboardNotice" Text="{Binding Notice}" Classes="hint" Classes.warn="{Binding NoticeWarns}" TextWrapping="Wrap"/>
    </StackPanel>

    <!-- The master: SFX's own channel volume, the very fader the strip draws -->
    <StackPanel DockPanel.Dock="Top" Name="SoundboardMaster" Spacing="4" Margin="0,0,0,8" IsVisible="{Binding ShowsMaster}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" IsVisible="{Binding HasMaster}">
        <Grid Name="SoundboardChannelName" ColumnDefinitions="Auto,*" VerticalAlignment="Center" MaxWidth="160"
              DataContext="{Binding Channel}" x:DataType="vm:ChannelViewModel">
          <vm:LayoutIconBlock Icon="{Binding Appearance.Icon}" Fallback="{Binding Appearance.DefaultIcon}" Classes="h"
                              Classes.layoutAccent="{Binding Appearance.HasColour}" IsVisible="{Binding Appearance.HasIcon}"
                              Margin="0,0,6,0" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="h" Classes.layoutAccent="{Binding Appearance.HasColour}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
        </Grid>
        <Slider Grid.Column="1" Name="SoundboardVolume" vm:FaderInput.Step="0.01" Minimum="0" Maximum="1"
                Value="{Binding Channel.Volume, Mode=TwoWay, FallbackValue=0}"
                vm:FaderInput.IsAdjusting="{Binding Channel.VolumeAdjusting, Mode=OneWayToSource, FallbackValue=False}"
                AutomationProperties.Name="{Binding MasterName}" ToolTip.Tip="{Binding MasterHint}"/>
        <skin:LitText Grid.Column="2" Name="SoundboardVolumeText" Text="{Binding Channel.VolumeText, FallbackValue=''}" Classes="val"
                      VerticalAlignment="Center" MinWidth="40" TextAlignment="Right"/>
      </Grid>
      <TextBlock Name="SoundboardMasterHint" Text="{Binding MasterHint}" Classes="hint" TextWrapping="Wrap"/>
    </StackPanel>

    <WrapPanel DockPanel.Dock="Top" Name="SoundboardActions" ItemSpacing="6" LineSpacing="4" Margin="0,0,0,8"
               IsVisible="{Binding ShowsBoard}">
      <Button Name="SoundboardStopAll" Content="{loc:Text Key=SoundboardStopAll}" Click="OnStopAll"
              Classes.fxOn="{Binding AnyPlaying}" Classes="fx" IsEnabled="{Binding CanStop}"
              ToolTip.Tip="{loc:Text Key=SoundboardStopAllTip}"/>
      <Button Name="SoundboardAddFiles" Content="{loc:Text Key=SoundboardAddFiles}" Click="OnAddFiles"
              IsEnabled="{Binding CanAdd}" ToolTip.ShowOnDisabled="True" ToolTip.Tip="{loc:Text Key=SoundboardAddFilesTip}"/>
      <Button Name="SoundboardAddFolder" Content="{loc:Text Key=SoundboardAddFolder}" Click="OnAddFolder"
              IsEnabled="{Binding CanAdd}" ToolTip.ShowOnDisabled="True" ToolTip.Tip="{loc:Text Key=SoundboardAddFolderTip}"/>
      <Button Name="SoundboardCancelImport" Content="{loc:Text Key=SoundboardCancelImport}" Click="OnCancelImport"
              IsVisible="{Binding Importing}" ToolTip.Tip="{loc:Text Key=SoundboardCancelImportTip}"/>
      <Button Name="SoundboardExportLibrary" Content="{loc:Text Key=SoundboardExportLibrary}" Click="OnExportLibrary"
              IsEnabled="{Binding CanExport}" ToolTip.ShowOnDisabled="True" ToolTip.Tip="{loc:Text Key=SoundboardExportLibraryTip}"/>
      <Button Name="SoundboardImportLibrary" Content="{loc:Text Key=SoundboardImportLibrary}" Click="OnImportLibrary"
              IsEnabled="{Binding CanAdd}" ToolTip.ShowOnDisabled="True" ToolTip.Tip="{loc:Text Key=SoundboardImportLibraryTip}"/>
      <Button Name="SoundboardRestoreStarter" Content="{loc:Text Key=SoundboardRestoreStarter}" Click="OnRestoreStarter"
              IsEnabled="{Binding CanAdd}" ToolTip.ShowOnDisabled="True" ToolTip.Tip="{loc:Text Key=SoundboardRestoreStarterTip}"/>
    </WrapPanel>

    <!-- The pages, one tab each, and the shown page's menu: rename it, or move its clips to Main -->
    <Grid DockPanel.Dock="Top" Name="SoundboardPageBar" ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,0,0,8"
          IsVisible="{Binding ShowsPages}">
      <ItemsControl Name="SoundboardPages" ItemsSource="{Binding Pages}" AutomationProperties.Name="{loc:Text Key=SoundboardPages}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel ItemSpacing="4" LineSpacing="4"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SoundPageViewModel">
            <Button Name="SoundboardPageTab" Classes="fx" Classes.fxOn="{Binding IsSelected}" Click="OnPage" MaxWidth="240"
                    AutomationProperties.Name="{Binding Title}" ToolTip.Tip="{Binding Title}">
              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Grid.Column="1" Name="SoundboardPageMenu" Classes="ghost" Content="⋯" Click="OnPageMenu" VerticalAlignment="Top"
              IsEnabled="{Binding CanEditPage}" Width="28" Height="24" Padding="0"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
              MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}"
              ToolTip.ShowOnDisabled="True" AutomationProperties.Name="{loc:Text Key=SoundboardPageMenu}"
              ToolTip.Tip="{loc:Text Key=SoundboardPageMenuTip}"/>
    </Grid>

    <!-- What the last import or change came to, then Close -->
    <StackPanel DockPanel.Dock="Bottom" Name="SoundboardFooter" Spacing="8" Margin="0,10,0,0">
      <!-- while files are dragged over the window: where a drop puts them -->
      <TextBlock Name="SoundboardDropHint" Text="{Binding DropHint}" Classes="hint" TextWrapping="Wrap" IsVisible="{Binding Dropping}"/>
      <!-- a long report, a folder's refusals one per line, scrolls in its own area; the right margin
           keeps the overlay scroll bar off the text -->
      <ScrollViewer Name="SoundboardStatusScroll" IsVisible="{Binding HasStatus}" MaxHeight="132"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <TextBlock Name="SoundboardStatus" Text="{Binding Status}" Classes="hint" Classes.warn="{Binding StatusWarns}"
                             TextWrapping="Wrap" Margin="0,0,16,0"/>
      </ScrollViewer>
      <Button Name="SoundboardClose" Content="{loc:Text Key=Close}" HorizontalAlignment="Right" Padding="18,6" Click="OnClose" IsCancel="True"/>
    </StackPanel>

    <Panel>
      <TextBlock Name="SoundboardEmpty" Text="{loc:Text Key=SoundboardEmpty}" Classes="hint" TextWrapping="Wrap"
                 IsVisible="{Binding ShowsEmpty}"/>
      <ScrollViewer Name="SoundboardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- the right margin keeps the overlay scroll bar off the last column of pads -->
        <ItemsControl Name="SoundboardPads" ItemsSource="{Binding PageClips}" Margin="0,0,16,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SoundClipViewModel">
              <Panel Name="SoundPadCell" Width="{DynamicResource Ox.Soundboard.PadWidth}" Height="{DynamicResource Ox.Soundboard.PadHeight}">
                <vm:SoundPad Name="SoundPad" Classes="soundPad" Classes.playing="{Binding Playing}" IsEnabled="{Binding CanPlay}"
                             ToolTip.ShowOnDisabled="True" AutomationProperties.Name="{Binding PadName}"
                             AutomationProperties.HelpText="{Binding HelpText}" ToolTip.Tip="{Binding Tip}">
                  <Panel Name="SoundPadFace">
                  <!-- the clip's colour over the whole face, and the layer that lightens it under the pointer -->
                  <Border Name="SoundPadFill" Background="{Binding Appearance.Accent}" IsVisible="{Binding Filled}"
                          CornerRadius="{DynamicResource Ox.Soundboard.PadCornerRadius}"/>
                  <Border Name="SoundPadShade" Classes="soundPadShade" IsVisible="{Binding Filled}"
                          CornerRadius="{DynamicResource Ox.Soundboard.PadCornerRadius}"/>
                  <Grid RowDefinitions="Auto,*,Auto,Auto">
                    <!-- the top row keeps the menu button's room, which Touch sizing enlarges, so the
                         button never covers the name; on a pad that cannot play, which keeps the
                         plain face so its name and warning read, the clip's colour runs along it -->
                    <Grid ColumnDefinitions="*,Auto">
                      <Border Name="SoundPadColour" Height="{DynamicResource Ox.Soundboard.ProgressHeight}" Background="{Binding Appearance.Accent}"
                              IsVisible="{Binding Tinted}" Margin="10,0,6,0" VerticalAlignment="Center"/>
                      <Panel Grid.Column="1" Name="SoundPadMenuRoom" Width="28" Height="24"
                             MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}"/>
                    </Grid>
                    <!-- a grid, not a horizontal stack: the name gets what the icon leaves, and wraps -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="10,0,10,0" VerticalAlignment="Top">
                      <vm:LayoutIconBlock Name="SoundPadIcon" Icon="{Binding Appearance.Icon}" Fallback="{Binding Appearance.DefaultIcon}" Classes="strip"
                                          Classes.onLight="{Binding FillIsLight}" Classes.onDark="{Binding FillIsDark}"
                                          IsVisible="{Binding Appearance.HasIcon}" Margin="0,0,6,0" VerticalAlignment="Top"/>
                      <TextBlock Grid.Column="1" Name="SoundPadName" Text="{Binding Name}" TextWrapping="Wrap" MaxLines="{Binding NameLines}"
                                 Classes.onLight="{Binding FillIsLight}" Classes.onDark="{Binding FillIsDark}"
                                 TextTrimming="CharacterEllipsis" FontWeight="{DynamicResource Ox.Label.FontWeight}"/>
                    </Grid>
                    <!-- the length and mode on one line; a reason the clip cannot load gets up to three -->
                    <TextBlock Grid.Row="2" Name="SoundPadDetail" Text="{Binding Detail}" Classes="hint" Classes.warn="{Binding HasError}"
                               Classes.onLight="{Binding FillIsLight}" Classes.onDark="{Binding FillIsDark}"
                               FontSize="{DynamicResource Ox.Label.FontSize}" Margin="10,2,10,4" TextWrapping="Wrap"
                               MaxLines="{Binding DetailLines}" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Grid.Row="3" Name="SoundPadProgress" Classes="soundProgress" Minimum="0" Maximum="1"
                                 Value="{Binding Position}" IsVisible="{Binding Playing}" Margin="10,0,10,8"
                                 AutomationProperties.AccessibilityView="Raw"/>
                  </Grid>
                  </Panel>
                </vm:SoundPad>
                <!-- a ring while a voice plays the clip, over the face whatever its state -->
                <Border Name="SoundPadRing" IsHitTestVisible="False" IsVisible="{Binding Playing}"
                        BorderBrush="{DynamicResource Ox.Soundboard.Playing}" BorderThickness="{DynamicResource Ox.Soundboard.PlayingThickness}"
                        CornerRadius="{DynamicResource Ox.Soundboard.PadCornerRadius}"/>
                <Button Name="SoundPadMenu" Classes="ghost soundPadMenu" Classes.onLight="{Binding FillIsLight}" Classes.onDark="{Binding FillIsDark}"
                        Content="⋯" Click="OnPadMenu"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Width="28" Height="24" Padding="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        MinWidth="{DynamicResource Ox.Mixer.SmallControlMinSize}" MinHeight="{DynamicResource Ox.Mixer.SmallControlMinSize}"
                        AutomationProperties.Name="{Binding MenuName}" ToolTip.Tip="{loc:Text Key=SoundClipMenuTip}"/>
              </Panel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</Window>
