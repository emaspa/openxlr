  "layout": {
    "version": 1,
    "main": {
      "kind": "stack",
      "id": "rack",
      "orientation": "vertical",
      "spacing": 6,
      "children": [
        {
          "kind": "grid",
          "id": "amplifier",
          "spacing": 6,
          "columns": [
            {
              "star": 1
            },
            {
              "size": 340
            }
          ],
          "rows": [
            "auto"
          ],
          "children": [
            {
              "kind": "region",
              "region": "headphones",
              "row": 0,
              "column": 0
            },
            {
              "kind": "region",
              "region": "monitor",
              "row": 0,
              "column": 1
            }
          ]
        },
        {
          "kind": "grid",
          "id": "deck",
          "spacing": 6,
          "columns": [
            {
              "star": 1
            },
            {
              "size": 950
            }
          ],
          "rows": [
            "auto"
          ],
          "children": [
            {
              "kind": "stack",
              "id": "preamp",
              "orientation": "vertical",
              "spacing": 6,
              "row": 0,
              "column": 0,
              "children": [
                {
                  "kind": "region",
                  "region": "inputs"
                },
                {
                  "kind": "region",
                  "region": "applications"
                }
              ]
            },
            {
              "kind": "region",
              "region": "submixer",
              "row": 0,
              "column": 1
            }
          ]
        }
      ]
    },
    "regions": {
      "monitor": {
        "template": "output-toolbar"
      },
      "submixer": {
        "template": "mix-banks",
        "orientation": "vertical",
        "visibleBanks": 3,
        "selectionDefaults": [
          "monitor",
          "stream",
          "chat"
        ],
        "picker": "buttons",
        "strip": {
          "template": "vertical-strip",
          "partsOrder": [
            "identity",
            "value",
            "meter",
            "fader",
            "mute"
          ],
          "fader": {
            "orientation": "vertical",
            "direction": "normal"
          },
          "meter": {
            "orientation": "vertical",
            "placement": "beside-fader"
          },
          "label": {
            "style": "icon-and-text"
          }
        },
        "master": {
          "template": "master-strip"
        }
      },
      "applications": {
        "template": "application-columns",
        "perColumn": 3
      }
    }
  }
}
