<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="run-script.sh" CopyToOutputDirectory="PreserveNewest" />
    <None Update="skin-rack-keys.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Built-in skins for the tests, compiled into this assembly under the
       names the application gives its own (OpenXLR.UI.csproj), so
       SkinCatalog.BuiltIn reads them through the same code path.
       SkinPackageTests holds the two sets of names to each other. -->
  <ItemGroup>
    <EmbeddedResource Include="Fixtures/Skins/*/skin.json" LogicalName="OpenXLR.UI.Assets.Skins.$([System.String]::Copy('%(RecursiveDir)').TrimEnd('/')).skin.json"/>
    <EmbeddedResource Include="Fixtures/Skins/*/**/*.png;Fixtures/Skins/*/**/*.jpg;Fixtures/Skins/*/**/*.jpeg"
                      LogicalName="OpenXLR.UI.Assets.SkinFiles/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OpenXLR.Core/OpenXLR.Core.csproj" />
    <ProjectReference Include="../OpenXLR.Daemon/OpenXLR.Daemon.csproj" />
    <ProjectReference Include="../OpenXLR.Tui/OpenXLR.Tui.csproj" />
    <ProjectReference Include="../OpenXLR.UI/OpenXLR.UI.csproj" />
  </ItemGroup>
</Project>
